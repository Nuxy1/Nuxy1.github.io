---
// The concept-demonstration gallery (Creative Studio brief, Phase 6). Three made-up brands, each labelled as a
// fictional concept demonstration on its card and again in the player: never presented as client work.
//
// It exists only when all three demos have real, checked video files listed in data/cinematic-manifest.json; with
// any missing it renders nothing (a page asks data/cinematic.ts `demosReady` before it links to the gallery).
// Nothing plays by itself and no video file is requested until a visitor presses play: the cards are posters. One
// player (a <dialog>) plays one video at a time, with the browser's own controls, captions when the demo has them,
// Escape to close and focus returned to the card. Without JavaScript the play button is a plain link to the MP4.
import Icon from "./Icon.astro";
import { demos, demoLabel, demoNote, quoteHref, quoteParam } from "../data/creative";
import { demoOf, demosReady, clock } from "../data/cinematic";

const items = demos.map((d) => ({ d, m: demoOf(d.id) }));
const hasGallery = demosReady(demos.map((d) => d.id));
const similar = (request: string) => `${quoteHref}&${quoteParam}=${request}`;
const mp4 = (sources: { src: string; type: string }[]) => (sources.find((s) => s.type === "video/mp4") ?? sources[0]).src;
---
{hasGallery && (
  <div class="cg">
    <p class="cg-note"><Icon name="info" /><span>{demoNote}</span></p>
    <ul class="cg-grid" role="list">
      {items.map(({ d, m }) => m && (
        <li class="panel cg-card reveal">
          <a class:list={["cg-play", { tall: m.height > m.width }]} href={mp4(m.sources)} data-demo={JSON.stringify({ title: d.title, poster: m.poster.src, sources: m.sources, width: m.width, height: m.height, captions: m.captions?.src, vertical: m.vertical && { poster: m.vertical.poster.src, sources: m.vertical.sources, width: m.vertical.width, height: m.vertical.height }, similar: similar(d.request) })} data-track="creative_demo_play">
            {m.height > m.width && <img class="cg-back" src={m.poster.src} alt="" width={m.width * 0.75} height={m.height * 0.75} loading="lazy" decoding="async" aria-hidden="true" />}
            <img src={m.poster.src} alt="" width={m.width * 0.75} height={m.height * 0.75} loading="lazy" decoding="async" />
            <span class="cg-button" aria-hidden="true"><Icon name="play" /></span>
            <span class="cg-time" aria-hidden="true">{clock(m.duration)}</span>
            <span class="sr-only">Play {d.title}: {Math.round(m.duration)}-second {d.category.toLowerCase()} concept{m.audio ? ", with sound" : ""}</span>
          </a>
          <div class="cg-body">
            <p class="cg-label">{demoLabel}</p>
            <h3>{d.title}</h3>
            <p class="cg-cat">{d.category}</p>
            <p class="cg-text">{d.text}</p>
            <a class="button secondary" href={similar(d.request)} data-track="cta_creative_similar">Request Similar Project<span class="sr-only">: {d.category.toLowerCase()} like {d.title}</span></a>
          </div>
        </li>
      ))}
    </ul>

    <dialog class="cg-dialog" aria-labelledby="cg-dialog-title" data-demo-player>
      <div class="cg-frame">
        <div class="cg-head">
          <div>
            <p class="cg-label">{demoLabel}</p>
            <h3 id="cg-dialog-title" data-title></h3>
          </div>
          <button class="cg-close" type="button" data-close aria-label="Close video"><Icon name="x" /></button>
        </div>
        <video controls playsinline preload="none" data-video></video>
        <div class="cg-foot">
          <p>A made-up brand, shown as an example of the work. Not a client project.</p>
          <a class="button" href={quoteHref} data-similar data-track="cta_creative_similar">Request Similar Project</a>
        </div>
      </div>
    </dialog>
  </div>
  <script>
    type Cut = { poster: string; sources: { src: string; type: string }[]; width: number; height: number };
    type Demo = Cut & { title: string; captions?: string; vertical?: Cut; similar: string };
    const own = (src: unknown): src is string => typeof src === "string" && /^\/media\/[a-z0-9-]+\.(mp4|webm|webp|vtt)$/.test(src);

    for (const dialog of document.querySelectorAll<HTMLDialogElement>("[data-demo-player]")) {
      if (typeof dialog.showModal !== "function") continue; // (a very old browser: the play buttons stay plain links)
      const video = dialog.querySelector<HTMLVideoElement>("[data-video]")!;
      const title = dialog.querySelector<HTMLElement>("[data-title]")!;
      const again = dialog.querySelector<HTMLAnchorElement>("[data-similar]")!;
      const empty = () => { video.pause(); video.replaceChildren(); video.removeAttribute("poster"); video.load(); };

      for (const link of dialog.parentElement!.querySelectorAll<HTMLAnchorElement>("[data-demo]")) {
        link.addEventListener("click", (e) => {
          if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return; // (open in a new tab still works)
          let demo: Demo;
          try { demo = JSON.parse(link.dataset.demo!); } catch { return; }
          // A phone held upright gets the 9:16 cut when the demo has one.
          const cut = demo.vertical && matchMedia("(orientation: portrait) and (max-width: 720px)").matches ? demo.vertical : demo;
          const sources = cut.sources.filter((s) => own(s.src));
          if (!sources.length) return;
          e.preventDefault();
          empty();
          for (const s of sources) { const el = document.createElement("source"); el.src = s.src; el.type = s.type; video.append(el); }
          if (own(demo.captions)) {
            const track = document.createElement("track");
            track.kind = "captions"; track.srclang = "en"; track.label = "English"; track.src = demo.captions; track.default = true;
            video.append(track);
          }
          if (own(cut.poster)) video.poster = cut.poster;
          video.width = cut.width; video.height = cut.height;
          video.style.aspectRatio = `${cut.width} / ${cut.height}`;
          dialog.classList.toggle("tall", cut.height > cut.width);
          title.textContent = demo.title;
          again.href = /^\/contact\/\?[a-z0-9=&.~-]+$/.test(demo.similar) ? demo.similar : "/contact/";
          dialog.showModal();
          document.dispatchEvent(new Event("nuxy:player")); // (the background loops stop: scripts/cinematic.ts)
          video.load();
          video.play().catch(() => { /* the visitor can press play on the controls */ });
        });
      }
      dialog.querySelector("[data-close]")!.addEventListener("click", () => dialog.close());
      // (a click on the dimmed page around the player closes it; the dialog element itself is only that backdrop)
      dialog.addEventListener("click", (e) => { if (e.target === dialog) dialog.close(); });
      // Closing by the button, Escape or the backdrop: stop the sound and let go of the file.
      dialog.addEventListener("close", () => { empty(); document.dispatchEvent(new Event("nuxy:player")); });
      document.addEventListener("visibilitychange", () => { if (document.hidden) video.pause(); });
    }
  </script>
)}

<style>
  .cg-note { display: flex; align-items: flex-start; gap: 10px; max-width: 70ch; margin-bottom: 24px; color: var(--body); font-size: 0.9375rem; }
  .cg-note :global(.icon) { flex: none; margin-top: 0.2em; color: var(--cyan); }
  .cg-grid { display: grid; gap: 20px; margin: 0; padding: 0; list-style: none; }
  @media (min-width: 720px) { .cg-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1080px) { .cg-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .cg-card { display: flex; flex-direction: column; overflow: hidden; }

  .cg-play { position: relative; display: block; aspect-ratio: 16 / 9; background: #060b16; }
  .cg-play img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  /* (a 9:16 demo keeps its whole frame, centred on the dark panel, rather than being cropped to a strip) */
  .cg-play.tall img { object-fit: contain; }
  /* (the same poster again, enlarged and blurred, fills the sides so a tall demo doesn't sit between two dead black bars; one file, one request) */
  .cg-play { overflow: hidden; }
  .cg-play.tall img.cg-back { object-fit: cover; filter: blur(26px) brightness(1.5) saturate(1.15); transform: scale(1.3); }
  .cg-play::after { content: ""; position: absolute; inset: 0; background: linear-gradient(to top, rgba(6, 11, 22, 0.55), rgba(6, 11, 22, 0) 45%); }
  .cg-button { position: absolute; z-index: 1; top: 50%; left: 50%; display: grid; place-items: center; width: 60px; height: 60px; margin: -30px 0 0 -30px; border-radius: 50%; background: var(--button); color: #fff; box-shadow: var(--shadow); transition: transform var(--dur-1) var(--ease-out); }
  .cg-button :global(.icon) { width: 26px; height: 26px; margin-left: 3px; }
  .cg-play:hover .cg-button { transform: scale(1.06); }
  /* (the ring is drawn on the layer above the poster: on the button itself the picture would cover it) */
  .cg-play:focus-visible { outline: none; }
  .cg-play:focus-visible::after { outline: 2px solid var(--focus); outline-offset: -2px; }
  .cg-time { position: absolute; z-index: 1; right: 12px; bottom: 10px; padding: 2px 8px; border-radius: var(--r-full); background: rgba(6, 11, 22, 0.8); color: #fff; font-size: 0.8125rem; font-variant-numeric: tabular-nums; }

  .cg-body { display: flex; flex: 1; flex-direction: column; gap: 8px; padding: clamp(18px, 2.5vw, 24px); }
  .cg-label { color: var(--cyan); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; }
  .cg-body h3 { font-size: 1.25rem; letter-spacing: 0.02em; }
  .cg-cat { color: var(--muted); font-size: 0.875rem; }
  .cg-text { color: var(--body); }
  .cg-body .button { align-self: flex-start; margin-top: auto; }
  .cg-body .cg-text { margin-bottom: 10px; }
  @media (max-width: 479px) { .cg-body .button { align-self: stretch; } }

  .cg-dialog { width: min(100vw - 24px, 1040px); max-width: none; max-height: calc(100dvh - 24px); margin: auto; padding: 0; overflow: auto; border: 1px solid var(--hairline-strong); border-radius: var(--r-lg); background: var(--bg-2); color: var(--body); }
  .cg-dialog.tall { width: min(100vw - 24px, 460px); }
  .cg-dialog::backdrop { background: rgba(2, 6, 23, 0.82); }
  .cg-frame { display: grid; gap: 14px; padding: clamp(14px, 2.5vw, 22px); }
  .cg-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; }
  .cg-head h3 { margin-top: 4px; font-size: 1.1875rem; letter-spacing: 0.02em; }
  .cg-close { display: grid; place-items: center; flex: none; width: 44px; height: 44px; border: 1px solid var(--hairline); border-radius: 12px; background: transparent; color: var(--ink); cursor: pointer; }
  .cg-close:hover { border-color: var(--hairline-strong); }
  .cg-close:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  .cg-close :global(.icon) { width: 20px; height: 20px; }
  /* (width and height both follow the file's own shape, so a tall video on a short screen has no black bars) */
  .cg-dialog video { display: block; width: auto; height: auto; max-width: 100%; max-height: calc(100dvh - 250px); margin-inline: auto; border-radius: 10px; background: #000; }
  .cg-foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 20px; }
  .cg-foot p { flex: 1 1 240px; color: var(--muted); font-size: 0.875rem; }
  @media (max-width: 479px) { .cg-foot .button { flex: 1 1 100%; } }
</style>
