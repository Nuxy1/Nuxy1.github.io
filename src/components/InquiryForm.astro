---
// The quote request form. It posts to the agent's src/inquiry.js (data/site.ts inquiryUrl), which checks it again,
// saves it and emails the business inbox. The page says "received" only when the server answers with a reference;
// any failure says NOT sent and offers the same answers as a ready-to-send email instead.
// Without JavaScript it is an ordinary form: the server shows its own error page or the thank-you page.
// Rules mirror FIELDS in the inquiry service's src/inquiry.js (private business repo): change both together.
// fv=2 tells the server this page asks "What do you need?" (the answers in data/services.ts `wants`, five of them shown); a page loaded
// before that question existed sends no fv and is accepted without it. A service's "Get a Free Quote" link opens
// /contact/?service=<id> (it is named at the top and picks its answer), and ?want=<id> picks an answer directly.
// The package estimator opens /contact/?services=<id>,<id>: all of them are named at the top and listed in the
// project box (the server takes one service id, so the first is sent as the service and the list travels as text).
// Any service, smaller or larger version, bundle or plan can be named; a retired id names the plan that replaced it
// and is sent as it came, so the owner sees the link was an old one.
// The Creative Studio estimator opens /contact/?want=creative&cq=<code> (data/creative-estimate.ts): the code is
// checked against the same rules the estimator used and the starting price is worked out again here, never read from
// the address. The choices are named at the top and written into the project box as plain text; no service id is sent.
import Icon from "./Icon.astro";
import { inquiryUrl, inbox } from "../data/site";
import { groups, plans, variants, bundles, retired, wants, wantsShown, wantOf } from "../data/services";
import { ask } from "../lib/request";
import { rules as creativeRules, creativeWant, quoteParam } from "../data/creative";
import { formLevels, goals, levelById } from "../data/tiers";
import { leadSources } from "../data/case-studies";
// (where a visitor came from, when a client project's "Get a Free Quote" named it: ?from=<id>, sent as "lead". Only the
// shown projects' ids are offered; with none the field isn't on the page at all. The inquiry service keeps the same list.)
const hasLeads = Object.keys(leadSources).length > 0;
// ?level=<id> from a website level's button (data/tiers.ts) picks that level, shows the website questions and names it
// at the top; with no answer to "What do you need?" yet it picks "Website".
const levelNames = Object.fromEntries([...formLevels.map((l) => [l.id, l.id === "unsure" ? "" : `the ${levelById[l.id as keyof typeof levelById].name} website level (${levelById[l.id as keyof typeof levelById].price.toLowerCase()})`])]);

// (everything a link can ask about: its name and price for the note, which answer it picks, and for a retired id
// the name it had)
const asked: Record<string, { name: string; price: string; want: string; was?: string }> = Object.fromEntries(
  [...groups.flatMap((g) => g.items), ...variants, ...bundles, ...plans].map((s) => [s.id, { name: s.name, price: s.price, want: wantOf(s.id) }]),
);
const oldNames: Record<string, string> = { "automation-care": "Automation care" };
for (const [id, now] of Object.entries(retired)) asked[id] = { ...asked[now], was: oldNames[id] ?? id };
---
<div class="inq" data-inquiry data-leads={hasLeads ? JSON.stringify(leadSources) : undefined} data-services={JSON.stringify(asked)} data-creative={JSON.stringify(creativeRules)} data-creative-param={quoteParam} data-creative-want={creativeWant} data-levels={JSON.stringify(levelNames)}>
  <form class="inq-form" aria-labelledby="contact-title" method="post" action={inquiryUrl} accept-charset="UTF-8" data-endpoint={inquiryUrl}>
    <p class="inq-legend">Required unless marked optional. Takes about two minutes.</p>

    <div class="inq-about" hidden data-about>
      <p><Icon name="info" /><span>You’re asking about <strong data-about-name></strong>.</span></p>
      <button class="inq-link" type="button" data-about-clear><span data-about-clear-label>Not this one</span><span class="sr-only" data-about-clear-more>: remove it from the request</span></button>
    </div>
    <input type="hidden" name="service" value="" />
    {hasLeads && <input type="hidden" name="lead" value="" />}

    <fieldset class="field picks" id="f-want" aria-describedby="f-want-help f-want-err">
      <legend>What do you need?</legend>
      <p class="help" id="f-want-help">Pick the closest one. You can explain below.</p>
      <p class="err" id="f-want-err" hidden></p>
      <div class="pick-grid">
        {wants.map((w) => (
          <label class="pick" hidden={!wantsShown.includes(w.id)}><input type="radio" name="want" value={w.id} required disabled={!wantsShown.includes(w.id)} /><span>{w.label}</span></label>
        ))}
      </div>
    </fieldset>

    <div class="inq-grid">
      <div class="field">
        <label for="f-name">Your name</label>
        <input id="f-name" name="name" type="text" autocomplete="name" required maxlength="100" aria-describedby="f-name-err" />
        <p class="err" id="f-name-err" hidden></p>
      </div>
      <div class="field">
        <label for="f-business">Business name</label>
        <input id="f-business" name="business" type="text" autocomplete="organization" required maxlength="120" aria-describedby="f-business-err" />
        <p class="err" id="f-business-err" hidden></p>
      </div>
      <div class="field">
        <label for="f-type">Type of business <span class="opt">(optional)</span></label>
        <input id="f-type" name="type" type="text" maxlength="80" autocomplete="off" list="f-type-list" aria-describedby="f-type-help f-type-err" />
        <datalist id="f-type-list">
          {["Landscaping & lawn care", "Cleaning", "Plumbing", "HVAC", "Electrical", "Contractor & remodeling", "Barber, salon or spa", "Auto repair", "Restaurant or café", "Retail shop", "Office or professional services"].map((t) => <option value={t} />)}
        </datalist>
        <p class="help" id="f-type-help">For example: plumbing, house cleaning, barber shop.</p>
        <p class="err" id="f-type-err" hidden></p>
      </div>
      <div class="field">
        <label for="f-website">Current website <span class="opt">(optional)</span></label>
        <input id="f-website" name="website" type="text" inputmode="url" autocomplete="url" maxlength="200" spellcheck="false" placeholder="yourbusiness.com" aria-describedby="f-website-help f-website-err" />
        <p class="help" id="f-website-help">If you have one.</p>
        <p class="err" id="f-website-err" hidden></p>
      </div>
      <div class="field">
        <label for="f-email">Email</label>
        <input id="f-email" name="email" type="email" autocomplete="email" inputmode="email" required maxlength="254" spellcheck="false" aria-describedby="f-email-help f-email-err" />
        <p class="help" id="f-email-help">Where we send your written plan and price.</p>
        <p class="err" id="f-email-err" hidden></p>
        <div class="tip" aria-live="polite" data-email-tip>
          <div class="tip-box" hidden data-tip-box>
            <p>Did you mean <strong data-tip-address></strong>?</p>
            <div class="tip-actions">
              <button class="inq-link" type="button" data-tip-use>Yes, fix it</button>
              <button class="inq-link" type="button" data-tip-keep>No, it’s right</button>
            </div>
          </div>
        </div>
      </div>
      <div class="field">
        <label for="f-phone">Phone <span class="opt">(optional)</span></label>
        <input id="f-phone" name="phone" type="tel" autocomplete="tel" maxlength="40" aria-describedby="f-phone-help f-phone-err" />
        <p class="help" id="f-phone-help">Only if you’d like a call.</p>
        <p class="err" id="f-phone-err" hidden></p>
      </div>
    </div>

    <div class="field">
      <label for="f-need">Tell us about your project</label>
      <textarea id="f-need" name="need" rows="5" required minlength="10" maxlength="3000" aria-describedby="f-need-help f-need-err"></textarea>
      <p class="help" id="f-need-help">A few sentences is plenty. For example: “Our website is out of date and hard to use on phones,” or “We miss calls while we’re on jobs.”</p>
      <p class="err" id="f-need-err" hidden></p>
    </div>

    <fieldset class="field radios" aria-describedby="f-scope-help f-scope-err">
      <legend>A one-time build, ongoing management, or both? <span class="opt">(optional)</span></legend>
      <p class="help" id="f-scope-help">Management is always optional: what we build is yours either way.</p>
      {Object.entries({ "one-time": "One-time setup", management: "Ongoing management", both: "Both", unsure: "Not sure yet" }).map(([v, l]) => (
        <label><input type="radio" name="scope" value={v} /> {l}</label>
      ))}
      <p class="err" id="f-scope-err" hidden></p>
    </fieldset>

    <!-- (for a website only: shown, and sent, once "What do you need?" is a website answer or a level link opened the
    form; while hidden it is disabled, so nothing in it travels) -->
    <fieldset class="field inq-web" data-web hidden disabled>
      <legend>About the website <span class="opt">(optional)</span></legend>
      <p class="help">Not sure which level you need? Choose “I’m not sure yet” and we’ll recommend one. <a href="/web-design/#levels" target="_blank" rel="noopener">Compare the levels<span class="sr-only"> (opens in a new tab)</span></a></p>
      <!-- (one under the other, full width: side by side, a closed select cut its answer short; every answer fits a
      320-pixel phone, tests/contact-form.test.mjs measures them) -->
      <div class="field">
        <label for="f-level">Website level</label>
        <select id="f-level" name="level" aria-describedby="f-level-err">
          <option value="">Choose one</option>
          {formLevels.map((l) => <option value={l.id}>{l.label}</option>)}
        </select>
        <p class="err" id="f-level-err" hidden></p>
      </div>
      <div class="field">
        <label for="f-goal">Main goal</label>
        <select id="f-goal" name="goal" aria-describedby="f-goal-err">
          <option value="">Choose one</option>
          {goals.map((g) => <option value={g.id}>{g.label}</option>)}
        </select>
        <p class="err" id="f-goal-err" hidden></p>
      </div>
      <div class="field">
        <label for="f-features">Features you have in mind</label>
        <textarea id="f-features" name="features" rows="2" maxlength="600" aria-describedby="f-features-help f-features-err"></textarea>
        <p class="help" id="f-features-help">For example: online booking, a shop, a 3D product view, a members area.</p>
        <p class="err" id="f-features-err" hidden></p>
      </div>
    </fieldset>
    <!-- (without JavaScript the website questions above stay hidden, so the level, the one answer a level link is
    about, gets its own plain field here; with JavaScript on, noscript content is never built) -->
    <noscript>
      <div class="field">
        <label for="f-level-ns">Website level <span class="opt">(optional)</span></label>
        <select id="f-level-ns" name="level">
          <option value="">Choose one</option>
          {formLevels.map((l) => <option value={l.id}>{l.label}</option>)}
        </select>
      </div>
    </noscript>

    <details class="inq-more">
      <summary><Icon name="plus" />More details <span class="opt">(optional)</span></summary>
      <div class="inq-grid">
        <div class="field">
          <label for="f-timeline">Timeline <span class="opt">(optional)</span></label>
          <select id="f-timeline" name="timeline" aria-describedby="f-timeline-err">
            <option value="">No fixed date</option>
            <option value="asap">As soon as possible</option>
            <option value="month">Within a month</option>
            <option value="quarter">In 1–3 months</option>
            <option value="later">Later than 3 months</option>
          </select>
          <p class="err" id="f-timeline-err" hidden></p>
        </div>
        <div class="field">
          <label for="f-budget">Budget <span class="opt">(optional)</span></label>
          <select id="f-budget" name="budget" aria-describedby="f-budget-err">
            <option value="">Prefer not to say</option>
            <option value="unsure">Not sure yet</option>
            <option value="lt500">Under $500</option>
            <option value="500-1000">$500–$1,000</option>
            <option value="1000-3000">$1,000–$3,000</option>
            <option value="3000-6000">$3,000–$6,000</option>
            <option value="6000-12000">$6,000–$12,000</option>
            <option value="gt12000">Over $12,000</option>
          </select>
          <p class="err" id="f-budget-err" hidden></p>
        </div>
      </div>
      <fieldset class="field radios" aria-describedby="f-contact-err">
        <legend>Best way to reach you <span class="opt">(optional)</span></legend>
        <label><input type="radio" name="contact" value="email" /> Email</label>
        <label><input type="radio" name="contact" value="phone" /> Phone</label>
        <label><input type="radio" name="contact" value="either" /> Either</label>
        <p class="err" id="f-contact-err" hidden></p>
      </fieldset>
      <div class="field">
        <label for="f-tools">Tools you use now <span class="opt">(optional)</span></label>
        <input id="f-tools" name="tools" type="text" maxlength="400" aria-describedby="f-tools-help f-tools-err" />
        <p class="help" id="f-tools-help">Phone, booking, CRM, invoicing, email, website builder… for example: Gmail, Square, Jobber, Wix.</p>
        <p class="err" id="f-tools-err" hidden></p>
      </div>
    </details>

    <!-- (people never see this field; automated senders fill it in) -->
    <div class="hp" aria-hidden="true">
      <label for="f-hp">Leave this empty</label>
      <input id="f-hp" name="nx_hp" type="text" tabindex="-1" autocomplete="off" />
    </div>
    <input type="hidden" name="t" value="" />
    <input type="hidden" name="fv" value="2" />

    <div class="field check">
      <label for="f-consent"><input id="f-consent" name="consent" type="checkbox" value="yes" aria-describedby="f-consent-help f-consent-err" /> <span>It’s OK to follow up about this request if I don’t answer right away <span class="opt">(optional)</span></span></label>
      <p class="help" id="f-consent-help">Without it, we only reply to this request.</p>
      <p class="err" id="f-consent-err" hidden></p>
    </div>

    <p class="inq-privacy"><Icon name="lockSimple" /><span>We use what you send only to reply about your project. It is never sold, shared or added to a mailing list. <a href="/policies/#privacy">Privacy policy</a></span></p>

    <div class="inq-actions">
      <button class="button" type="submit" data-submit><span data-label>Request my free quote</span><Icon name="paperPlaneTilt" /></button>
      <p class="inq-alt">or email <a href={ask()}>{inbox}</a></p>
    </div>
    <p class="inq-next"><Icon name="checkCircle" /><span>You’ll receive a written recommendation and price. No sales call is required.</span></p>
    <p class="sr-only" role="status" aria-live="polite" data-status></p>
  </form>

  <div class="inq-done" tabindex="-1" hidden data-done>
    <span class="inq-badge ok"><Icon name="checkCircle" /></span>
    <h2>Thanks, We Got Your Request</h2>
    <p>Your reference is <strong class="inq-ref" data-ref></strong>. We’ll reply to <strong data-email></strong> within one business day with what we’d build, what it costs and what we’d need from you.</p>
    <p class="note">Nothing is charged and nothing happens until you agree to a written plan. If our reply doesn’t arrive, check your spam folder or email <a href={`mailto:${inbox}`}>{inbox}</a> with your reference.</p>
  </div>

  <div class="inq-fail" tabindex="-1" role="alert" hidden data-fail>
    <span class="inq-badge bad"><Icon name="warningCircle" /></span>
    <h2>Your Request Was NOT Sent</h2>
    <p data-fail-text>Something went wrong on our side.</p>
    <p>Your answers are still in the form. You can try again, or send them as an email: it opens with everything filled in.</p>
    <div class="inq-fail-actions">
      <a class="button" href={ask()} data-mailto><Icon name="envelopeSimple" />Email it instead</a>
      <button class="button secondary" type="button" data-retry><Icon name="arrowCounterClockwise" />Back to the form</button>
    </div>
  </div>
</div>

<style>
  .inq-form { display: grid; gap: 20px; }
  .inq-legend { color: var(--muted); font-size: 0.9375rem; }
  .inq-grid { display: grid; gap: 20px; }
  @media (min-width: 640px) { .inq-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .field { display: grid; gap: 6px; align-content: start; min-width: 0; }
  .field > label, .field > legend { color: var(--ink); font-size: 0.9375rem; font-weight: 600; }
  .opt { color: var(--muted); font-weight: 400; }
  .field input:not([type="radio"]):not([type="checkbox"]), .field select, .field textarea {
    width: 100%; min-height: 48px; padding: 11px 14px; border: 1px solid var(--field-line); border-radius: 10px;
    background: var(--field); color: var(--ink); font-size: 1rem; line-height: 1.4;
    transition: border-color 160ms ease-out, box-shadow 160ms ease-out;
  }
  .field textarea { min-height: 132px; resize: vertical; }
  .inq-web { gap: 16px; }
  .inq-web[hidden] { display: none; }
  .inq-web .help a { color: var(--cyan); }
  #f-features { min-height: 84px; }
  .field select { appearance: none; padding-right: 36px; background-image: linear-gradient(45deg, transparent 50%, var(--muted) 50%), linear-gradient(135deg, var(--muted) 50%, transparent 50%); background-position: calc(100% - 20px) 21px, calc(100% - 15px) 21px; background-size: 5px 5px; background-repeat: no-repeat; }
  .field input::placeholder { color: var(--placeholder); }
  .field input:hover, .field select:hover, .field textarea:hover { border-color: var(--field-line-hover); }
  .field input:focus, .field select:focus, .field textarea:focus { outline: 2px solid transparent; /* (shows in forced-colors mode, where the shadow ring is dropped) */ border-color: var(--blue-line); box-shadow: 0 0 0 3px rgb(var(--blue-rgb) / 0.35); }
  .field [aria-invalid="true"] { border-color: var(--bad); }
  .field [aria-invalid="true"]:focus { box-shadow: 0 0 0 3px rgba(248, 113, 113, 0.3); }
  .help { color: var(--muted); font-size: 0.875rem; line-height: 1.45; }
  .err { display: flex; gap: 6px; color: var(--bad); font-size: 0.875rem; font-weight: 500; line-height: 1.45; }
  fieldset.field { margin: 0; padding: 0; border: 0; min-width: 0; }
  fieldset.field > legend { padding: 0; margin-bottom: 6px; }
  fieldset.radios { display: flex; flex-wrap: wrap; column-gap: 24px; row-gap: 0; }
  .radios .err { flex-basis: 100%; }
  .radios label { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; color: var(--body); cursor: pointer; }
  .check > label { display: flex; align-items: flex-start; gap: 10px; min-height: 44px; padding-top: 10px; color: var(--body); font-weight: 400; cursor: pointer; }
  .check input[type="checkbox"] { margin-top: 0.1em; }
  .check .help { padding-left: 30px; }
  .radios .help { flex-basis: 100%; }
  /* Radios and checkboxes drawn in the palette (the native ones come out warm grey on a dark page). Still real inputs:
     keyboard, form posting and screen readers are unchanged, and forced-colors mode gets the native control back. */
  .field input[type="radio"], .field input[type="checkbox"] {
    appearance: none; -webkit-appearance: none; display: inline-grid; place-content: center; width: 20px; height: 20px; margin: 0; flex: none;
    border: 1.5px solid var(--field-line); background: var(--field); cursor: pointer; transition: border-color 160ms ease-out, background-color 160ms ease-out;
  }
  .field input[type="radio"] { border-radius: 50%; }
  .field input[type="checkbox"] { border-radius: 5px; }
  .field input[type="radio"]::before, .field input[type="checkbox"]::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: #fff; transform: scale(0); transition: transform 140ms ease-out; }
  .field input[type="checkbox"]::before { width: 12px; height: 12px; border-radius: 0; clip-path: polygon(13% 47%, 0 62%, 38% 100%, 100% 22%, 86% 9%, 37% 70%); }
  .field input[type="radio"]:hover, .field input[type="checkbox"]:hover { border-color: var(--field-line-hover); }
  .field input[type="radio"]:checked, .field input[type="checkbox"]:checked { border-color: var(--blue-line); background: var(--blue); }
  .field input[type="radio"]:checked::before, .field input[type="checkbox"]:checked::before { transform: scale(1); }
  @media (prefers-reduced-motion: reduce) { .field input[type="radio"], .field input[type="checkbox"], .field input[type="radio"]::before, .field input[type="checkbox"]::before { transition: none; } }
  @media (forced-colors: active) { .field input[type="radio"], .field input[type="checkbox"] { appearance: auto; -webkit-appearance: auto; } .field input[type="radio"]::before, .field input[type="checkbox"]::before { display: none; } }
  .radios input:focus-visible, .check input:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  /* "What do you need?": five big choices, two across when there's room (a sixth when a link names a hidden one) */
  .picks > legend { font-size: 1rem; }
  .pick-grid { display: grid; gap: 10px 20px; margin-top: 4px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr)); }
  /* (five is an odd count: while all five others are hidden, the last answer runs the full row instead of sitting alone in half of it) */
  .pick-grid:has(.pick[hidden] ~ .pick[hidden] ~ .pick[hidden] ~ .pick[hidden] ~ .pick[hidden]) .pick:last-child { grid-column: 1 / -1; }
  .pick {
    display: flex; align-items: center; gap: 12px; min-height: 52px; padding: 12px 16px;
    border: 1px solid var(--field-line); border-radius: 10px; background: var(--field); color: var(--ink);
    font-weight: 500; cursor: pointer; transition: border-color 160ms ease-out, background-color 160ms ease-out;
  }
  .pick > span { text-wrap: balance; } /* (a long answer that wraps breaks evenly instead of leaving one word alone) */
  .pick:hover { border-color: var(--field-line-hover); }
  .pick:has(input:checked) { border-color: var(--blue-line); background: rgb(var(--blue-rgb) / 0.14); }
  .pick:has(input:focus-visible) { outline: 2px solid transparent; box-shadow: 0 0 0 3px rgb(var(--blue-rgb) / 0.35); }
  .pick input:focus-visible { outline: none; }
  .picks[data-invalid] .pick { border-color: var(--bad); }
  .inq-about { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 4px 16px; padding: 6px 8px 6px 16px; border: 1px solid var(--hairline-strong); border-radius: var(--r-md); background: rgb(var(--blue-rgb) / 0.08); }
  .inq-about[hidden] { display: none; }
  .inq-about p { display: flex; gap: 10px; align-items: flex-start; padding: 8px 0; color: var(--body); line-height: 1.5; }
  .inq-about p .icon { margin-top: 0.15em; color: var(--cyan); flex: none; }
  .inq-about strong { color: var(--ink); }
  .inq-link { display: inline-flex; align-items: center; min-height: 44px; padding: 0 8px; border: 0; border-radius: 8px; background: none; color: var(--link); font: inherit; font-size: 0.9375rem; font-weight: 600; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
  .inq-link:hover { color: var(--ink); }
  .inq-link:focus-visible { outline: 2px solid var(--blue); outline-offset: 1px; }
  .tip-box { display: grid; gap: 2px; margin-top: 4px; padding: 10px 8px 4px 14px; border: 1px solid rgb(var(--cyan-rgb) / 0.35); border-radius: 8px; background: rgb(var(--cyan-rgb) / 0.08); }
  .tip-box[hidden] { display: none; }
  .tip-box p { color: var(--body); font-size: 0.9375rem; overflow-wrap: anywhere; }
  .tip-box strong { color: var(--ink); }
  .tip-actions { display: flex; flex-wrap: wrap; gap: 0 8px; margin-left: -8px; }
  .inq-more { border: 1px solid var(--hairline); border-radius: var(--r-md); background: rgb(12 21 35 / 0.5); }
  .inq-more > summary { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; min-height: 52px; padding: 12px 16px; color: var(--ink); font-weight: 600; cursor: pointer; list-style: none; }
  .inq-more > summary::-webkit-details-marker { display: none; }
  .inq-more > summary .icon { color: var(--cyan); transition: transform 200ms var(--ease); }
  .inq-more[open] > summary .icon { transform: rotate(45deg); }
  .inq-more[open] { padding-bottom: 16px; }
  .inq-more > .inq-grid, .inq-more > .field { padding-inline: 16px; }
  .inq-more > * + * { margin-top: 16px; }
  .hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .inq-privacy { display: flex; gap: 10px; align-items: flex-start; color: var(--muted); font-size: 0.875rem; line-height: 1.5; }
  .inq-privacy .icon { margin-top: 0.1em; color: var(--cyan); }
  .inq-next { display: flex; gap: 10px; align-items: flex-start; margin-top: -8px; color: var(--body); font-size: 0.9375rem; line-height: 1.5; }
  .inq-next .icon { margin-top: 0.15em; color: var(--ok, var(--cyan)); flex: none; }
  .inq-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; }
  .inq-actions .button[aria-busy="true"] { opacity: 0.8; cursor: progress; }
  .inq-actions .button[aria-busy="true"] .icon { animation: spin 900ms linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .inq-alt { color: var(--muted); font-size: 0.9375rem; overflow-wrap: anywhere; }
  .inq-done, .inq-fail { display: grid; gap: 14px; justify-items: start; outline: none; scroll-margin-top: calc(clamp(20px, 4vw, 36px) + 8px); } /* (the card edge stays below the sticky header) */
  .inq-done h2, .inq-fail h2 { font-size: clamp(1.5rem, 1.2rem + 1.2vw, 1.875rem); }
  .inq-badge { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; }
  .inq-badge .icon { width: 28px; height: 28px; }
  .inq-badge.ok { background: rgba(52, 211, 153, 0.14); color: var(--ok); }
  .inq-badge.bad { background: rgba(248, 113, 113, 0.14); color: var(--bad); }
  .inq-ref { font-family: var(--mono); letter-spacing: 0.02em; }
  .inq-fail-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 4px; }
  @media (max-width: 479px) { .inq-actions .button, .inq-fail-actions .button { width: 100%; } }
  @media (prefers-reduced-motion: reduce) { .inq-actions .button[aria-busy="true"] .icon { animation: none; } .pick { transition: none; } }
</style>

<script>
  import { askWith } from "../lib/request";
  import { emailTypo } from "../lib/email-typo";
  import type { CreativeRules } from "../data/creative-estimate";

  type Rule = { required?: boolean; min?: number; max: number; test?: (v: string) => boolean; label: string; problem?: string; missing?: string };
  // (the same rules as the server, in the order the fields appear; it checks everything again)
  const RULES: Record<string, Rule> = {
    want: { required: true, max: 40, label: "What you need", missing: "Choose what you need." },
    name: { required: true, max: 100, label: "Your name" },
    business: { required: true, max: 120, label: "Business name" },
    type: { max: 80, label: "Type of business" },
    website: { max: 200, label: "Website", test: (v) => /^(https?:\/\/)?([a-z0-9-]+\.)+[a-z]{2,}(:\d{2,5})?(\/\S*)?$/i.test(v), problem: "Enter a web address like yourbusiness.com, or leave it empty." },
    email: { required: true, max: 254, label: "Email", test: (v) => /^[^\s@<>"(),;:\\[\]]+@[^\s@<>"'(),;:\\[\]]+\.[a-z]{2,}$/i.test(v), problem: "Enter an email address like name@business.com." },
    phone: { max: 40, label: "Phone", test: (v) => /^[0-9+().\-\s x]+$/i.test(v) && (v.match(/\d/g) ?? []).length >= 7, problem: "Enter a phone number with at least 7 digits, or leave it empty." },
    need: { required: true, min: 10, max: 3000, label: "Project description" },
    tools: { max: 400, label: "Tools you use now" },
    features: { max: 600, label: "Features you have in mind" },
  };
  // (the answers to "What do you need?" that are about a website: they show the website questions)
  const WEB = ["new-website", "redesign", "shopify", "other"];
  // (the email the customer can send instead when sending fails: their answers as readable lines)
  const LABELS: [string, string][] = [["want", "What I need"], ["name", "Name"], ["business", "Business name"], ["type", "Type of business"], ["website", "Website"], ["email", "Email"], ["phone", "Phone"], ["scope", "One-time or ongoing"], ["level", "Website level"], ["goal", "Main goal"], ["features", "Features I have in mind"], ["timeline", "When"], ["budget", "Budget"], ["contact", "Best way to reach me"], ["tools", "Tools I use now"], ["consent", "OK to follow up"], ["need", "About my project"]];

  for (const root of document.querySelectorAll<HTMLElement>("[data-inquiry]")) {
    const form = root.querySelector("form")!;
    const endpoint = form.dataset.endpoint!;
    const button = form.querySelector<HTMLButtonElement>("[data-submit]")!;
    const label = button.querySelector("[data-label]")!;
    const idle = label.textContent ?? "";
    const status = form.querySelector("[data-status]")!;
    const done = root.querySelector<HTMLElement>("[data-done]")!;
    const fail = root.querySelector<HTMLElement>("[data-fail]")!;
    const opened = performance.now();
    const picks = form.querySelector<HTMLElement>("#f-want")!;
    const radio = (value: string) => form.querySelector<HTMLInputElement>(`input[name="want"][value="${value}"]`);
    const chosen = () => form.querySelector<HTMLInputElement>('input[name="want"]:checked');
    // (five answers show; the other five wait hidden and switched off until a link names one, which shows it: approvals 88)
    const showPick = (r: HTMLInputElement | null) => {
      if (r?.disabled) { r.disabled = false; r.closest("label")!.hidden = false; }
      return r;
    };
    const field = (name: string) => (name === "want" ? null : (form.elements.namedItem(name) as HTMLInputElement | null));
    const valueOf = (name: string) => (name === "want" ? chosen()?.value ?? "" : field(name)?.value ?? "");
    // (where focus goes for a field: the chosen answer, or the first one, for "What do you need?")
    const focusOf = (name: string): HTMLElement | null => (name === "want" ? chosen() ?? form.querySelector<HTMLInputElement>('input[name="want"]:enabled') : field(name));
    form.noValidate = true; // (our own messages, next to each field)

    // ?service=<id> from a service's "Get a Free Quote" link: named at the top, and its answer picked (only real ids).
    // ?services=<id>,<id> from the package estimator: the same for several, and the list is written into the project
    // box (only when it is empty), where the visitor can change it. Nothing is sent until they press the button.
    const services: Record<string, { name: string; price: string; want: string; was?: string }> = JSON.parse(root.dataset.services ?? "{}");
    const params = new URLSearchParams(location.search);
    const real = (x: string) => /^[a-z0-9-]{1,40}$/.test(x) && Object.prototype.hasOwnProperty.call(services, x);
    const ids = [...new Set([params.get("service") ?? "", ...params.getAll("services").flatMap((v) => v.split(","))].filter(real))].slice(0, 12);
    const id = ids[0] ?? "";
    const service = id ? services[id] : null;
    const about = form.querySelector<HTMLElement>("[data-about]")!;
    const serviceInput = field("service")!;
    const need = field("need")!;
    let listed = ""; // (the line this page wrote into the project box, so "Not these" can take it back out)
    if (service) {
      serviceInput.value = id;
      const names = ids.map((x) => services[x].name);
      about.querySelector("[data-about-name]")!.textContent =
        ids.length > 1 ? `${names.slice(0, -1).join(", ")} and ${names[names.length - 1]}` : `${service.name} (${service.price})${service.was ? `, which replaced ${service.was}` : ""}`;
      if (ids.length > 1) {
        about.querySelector("[data-about-clear-label]")!.textContent = "Not these";
        about.querySelector("[data-about-clear-more]")!.textContent = ": remove them from the request";
        if (!need.value.trim()) need.value = listed = `I’d like a price for: ${names.join(", ")}.\n`;
      }
      about.hidden = false;
    }
    // ?cq=<code> from the Creative Studio estimator: only a code that passes the estimator's own rules is used, and
    // the price shown is worked out here from those rules. It travels to the owner as text in the project box.
    // The sums are loaded only when the address carries a code, so every other visit to the form asks for no
    // extra file (a second file loaded by this one costs about 150 ms of Lighthouse's largest-paint time).
    let creativeRules: CreativeRules | null = null;
    try { creativeRules = JSON.parse(root.dataset.creative ?? "null"); } catch { /* (no estimator rules: no code is read) */ }
    const code = service ? "" : params.get(root.dataset.creativeParam ?? "") ?? "";
    if (code && creativeRules) {
      const rules = creativeRules;
      import("../data/creative-estimate").then(({ decode, quote, describe, priceText }) => {
        const choice = decode(code, rules);
        // (what became of the code, readable on the form itself; the page's tests wait on it)
        root.dataset.estimate = choice ? "shown" : "refused";
        if (!choice) return;
        const summary = describe(choice, rules), price = priceText(quote(choice, rules));
        about.querySelector("[data-about-name]")!.textContent = `${summary.split("; ")[0]} (estimated starting price ${price})`;
        if (!need.value.trim()) need.value = listed = `I’d like a quote for: ${summary}.\nEstimator’s starting price: ${price} (an estimate, not a quote).\n`;
        about.hidden = false;
        // (an estimator link always names its answer; this covers a code that arrives without one)
        const creative = radio(root.dataset.creativeWant ?? "");
        if (creative && !chosen()) showPick(creative)!.checked = true;
      }).catch(() => { root.dataset.estimate = "unread"; /* (the file did not load: the form works as it does with no code) */ });
    }
    const want = params.get("want") ?? "";
    // ?from=<id>: the lead source, only an id the page lists (it stays when the visitor changes what they ask about)
    const leads: Record<string, string> = JSON.parse(root.dataset.leads ?? "{}");
    const from = params.get("from") ?? "";
    const leadInput = field("lead");
    if (leadInput && /^[a-z0-9-]{1,40}$/.test(from) && Object.prototype.hasOwnProperty.call(leads, from)) leadInput.value = from;
    // (several services: the answer most of them belong to, the first one on a tie)
    const answers = ids.map((x) => services[x].want);
    const times = (w: string) => answers.filter((x) => x === w).length;
    const common = answers.reduce((best, w) => (times(w) > times(best) ? w : best), answers[0] ?? "");
    const levelNames: Record<string, string> = JSON.parse(root.dataset.levels ?? "{}");
    const levelAsked = params.get("level") ?? "";
    const level = /^[a-z]{1,20}$/.test(levelAsked) && Object.prototype.hasOwnProperty.call(levelNames, levelAsked) ? levelAsked : "";
    const pick = /^[a-z-]{1,20}$/.test(want) && radio(want) ? want : common || (level ? "new-website" : "");
    if (pick && radio(pick)) showPick(radio(pick))!.checked = true;
    showPick(chosen()); // (an answer the browser put back after Back is shown too, so what is sent is what is seen)
    // The website questions: shown (and sent) for a website answer, or after a level link; hidden and disabled otherwise.
    const web = form.querySelector<HTMLFieldSetElement>("[data-web]")!;
    // (a level link shows them until the visitor picks an answer of their own; from then on the answer decides)
    let forced = Boolean(level);
    const syncWeb = () => {
      const on = forced || WEB.includes(chosen()?.value ?? "");
      web.hidden = web.disabled = !on;
    };
    let levelShown = false;
    if (level) {
      field("level")!.value = level;
      // (a level is named at the top only when no service already is)
      if (!service && levelNames[level]) {
        about.querySelector("[data-about-name]")!.textContent = levelNames[level];
        levelShown = true;
        about.hidden = false;
      }
    }
    syncWeb();
    picks.addEventListener("change", () => { forced = false; syncWeb(); });
    about.querySelector("[data-about-clear]")!.addEventListener("click", () => {
      serviceInput.value = "";
      // (a named level is taken back out of its question too)
      if (levelShown) { field("level")!.value = ""; levelShown = false; }
      about.hidden = true;
      // (the address forgets it too, so loading the page again does not bring back what the customer took out)
      const url = new URL(location.href);
      for (const key of ["service", "services", "level", root.dataset.creativeParam ?? ""]) url.searchParams.delete(key);
      history.replaceState(history.state, "", url);
      if (listed && need.value.trim() === listed.trim()) need.value = "";
      focusOf("want")?.focus();
      status.textContent = "Removed. Choose what you need, or describe it below.";
    });

    // contact_started: once, at the first answer the visitor gives (only the event name and page travel: Base.astro)
    let started = false;
    const start = () => { if (!started) { started = true; (window as any).nuxyTrack?.("contact_started"); } };
    form.addEventListener("input", start);
    form.addEventListener("change", start);

    const show = (name: string, message: string) => {
      const err = form.querySelector<HTMLElement>(`#f-${name}-err`);
      if (!err) return false;
      if (name === "want") picks.toggleAttribute("data-invalid", Boolean(message));
      else field(name)?.setAttribute?.("aria-invalid", message ? "true" : "false");
      err.textContent = message;
      err.hidden = !message;
      return true;
    };
    const check = (name: string) => {
      const r = RULES[name];
      const v = valueOf(name).trim();
      const length = [...v].length;
      let message = "";
      if (!v) message = r.required ? r.missing ?? `${r.label} is required.` : "";
      else if (length > r.max) message = `${r.label} is too long (${r.max} characters at most).`;
      else if (r.min && length < r.min) message = `Please write a little more (at least ${r.min} characters).`;
      else if (r.test && !r.test(v)) message = r.problem ?? "";
      show(name, message);
      return !message;
    };
    // (fields are checked when you leave them, and re-checked as you type once they've shown an error)
    for (const name of Object.keys(RULES)) {
      if (name === "want") continue;
      const input = field(name);
      input?.addEventListener("blur", () => input.value.trim() && check(name));
      input?.addEventListener("input", () => input.getAttribute("aria-invalid") === "true" && check(name));
    }
    picks.addEventListener("change", () => picks.hasAttribute("data-invalid") && check("want"));

    // A likely typo in a well-known email domain is offered as a question; the address changes only if they say yes.
    const email = field("email")!;
    const tip = form.querySelector<HTMLElement>("[data-tip-box]")!;
    const tipAddress = tip.querySelector<HTMLElement>("[data-tip-address]")!;
    let kept = "";
    email.addEventListener("blur", () => {
      const v = email.value.trim();
      const fix = RULES.email.test!(v) && v.toLowerCase() !== kept ? emailTypo(v) : "";
      if (fix) tipAddress.textContent = `${v.slice(0, v.lastIndexOf("@") + 1)}${fix}`;
      tip.hidden = !fix;
    });
    email.addEventListener("input", () => { tip.hidden = true; });
    tip.querySelector("[data-tip-use]")!.addEventListener("click", () => {
      email.value = tipAddress.textContent ?? email.value;
      tip.hidden = true;
      check("email");
      email.focus();
      status.textContent = `Email changed to ${email.value}.`;
    });
    tip.querySelector("[data-tip-keep]")!.addEventListener("click", () => {
      kept = email.value.trim().toLowerCase();
      tip.hidden = true;
      email.focus();
    });

    const setBusy = (busy: boolean) => {
      button.disabled = busy;
      button.setAttribute("aria-busy", String(busy));
      label.textContent = busy ? "Sending…" : idle;
      status.textContent = busy ? "Sending your request…" : "";
    };
    // (what each answer reads as: the chosen option's words for the choices, what was typed for the rest)
    const answerOf = (name: string) => {
      if (name === "consent") return form.querySelector<HTMLInputElement>("#f-consent")?.checked ? "Yes" : "";
      if (name === "want" || name === "contact" || name === "scope") return form.querySelector(`input[name="${name}"]:checked`)?.closest("label")?.textContent?.trim() ?? "";
      const el = field(name) as unknown as HTMLSelectElement | null;
      if (el?.tagName === "SELECT") return el.value ? el.selectedOptions[0]?.textContent?.trim() ?? "" : "";
      return el?.value ?? "";
    };
    const failed = (text: string) => {
      const picked = services[serviceInput.value];
      fail.querySelector("[data-fail-text]")!.textContent = text;
      // (long messages are cut so the email link still opens everywhere)
      fail.querySelector<HTMLAnchorElement>("[data-mailto]")!.href = askWith(LABELS.map(([k, l]) => [l, answerOf(k).slice(0, 1500)]), picked ? { name: picked.name, price: picked.price } : undefined);
      form.hidden = true;
      fail.hidden = false;
      fail.focus();
      fail.scrollIntoView({ block: "start", behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
    };
    fail.querySelector("[data-retry]")!.addEventListener("click", () => {
      fail.hidden = true;
      form.hidden = false;
      button.focus();
    });
    const reveal = (el: HTMLElement | null) => {
      const details = el?.closest("details");
      if (details && !details.open) details.open = true;
      // (for a group of choices, its question and message scroll into view, not only the choice that gets focus)
      const group = el?.closest("fieldset");
      el?.focus({ preventScroll: Boolean(group) });
      group?.scrollIntoView({ block: "start" });
    };

    let sending = false;
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (sending) return; // (a second click while the first is on its way)
      const bad = Object.keys(RULES).filter((name) => !check(name));
      if (bad.length) {
        reveal(focusOf(bad[0]));
        status.textContent = `${bad.length === 1 ? "One field needs" : `${bad.length} fields need`} fixing.`;
        return;
      }
      field("t")!.value = String(Math.round(performance.now() - opened));
      sending = true;
      setBusy(true);
      const controller = new AbortController();
      const timer = setTimeout(() => controller.abort(), 15_000);
      try {
        const res = await fetch(endpoint, { method: "POST", body: new URLSearchParams(new FormData(form) as unknown as Record<string, string>), headers: { accept: "application/json" }, signal: controller.signal, credentials: "omit" });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.ok && /^NX-\d{6}-[A-Z0-9]{4}$/.test(data.ref ?? "")) {
          done.querySelector("[data-ref]")!.textContent = data.ref;
          done.querySelector("[data-email]")!.textContent = email.value.trim();
          form.hidden = true;
          done.hidden = false;
          done.focus();
          done.scrollIntoView({ block: "start", behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
          (window as any).nuxyTrack?.("form_submit");
          (window as any).nuxyTrack?.("contact_completed");
          form.reset();
          return;
        }
        if (res.status === 400 && data.errors) {
          // (shown next to their fields; an error for a field this page doesn't have can't be fixed here, so it fails)
          const shown = Object.keys(data.errors).filter((name) => show(name, String(data.errors[name])));
          if (shown.length) {
            reveal(focusOf(shown[0]) ?? form.querySelector<HTMLElement>(`[name="${shown[0]}"]`));
            status.textContent = "Some fields need fixing.";
            return;
          }
        }
        failed(data.message || "Something went wrong on our side.");
      } catch (error) {
        failed((error as Error).name === "AbortError"
          ? "Our server took too long to answer, so we can’t confirm it arrived. Please treat it as not sent."
          : "Your browser couldn’t reach our server (the connection may be down, or something blocked it).");
      } finally {
        clearTimeout(timer);
        sending = false;
        setBusy(false);
      }
    });
  }
</script>
