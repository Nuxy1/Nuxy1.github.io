---
// The Nuxy "N" mark: the original path and four ring nodes, white on a round blue badge. With label="" it is decoration
// (the link around it already says "Nuxy Automation"), so screen readers skip it instead of meeting an unnamed image.
interface Props {
  class?: string;
  label?: string;
}
const { class: className, label = "Nuxy Automation" } = Astro.props;
const a11y = label ? { role: "img", "aria-label": label } : { "aria-hidden": "true" };
---
<svg class={className} viewBox="0 0 800 800" {...a11y}>
  <circle cx="400" cy="400" r="400" fill="#2563EB" />
  <path d="M222 588 V212 L578 588 V212" fill="none" stroke="#fff" stroke-width="72" stroke-linecap="round" stroke-linejoin="round" />
  <g fill="#fff">
    <circle cx="222" cy="588" r="62" /><circle cx="222" cy="212" r="62" /><circle cx="578" cy="588" r="62" /><circle cx="578" cy="212" r="62" />
  </g>
  <g fill="#2563EB">
    <circle cx="222" cy="588" r="24" /><circle cx="222" cy="212" r="24" /><circle cx="578" cy="588" r="24" /><circle cx="578" cy="212" r="24" />
  </g>
</svg>
