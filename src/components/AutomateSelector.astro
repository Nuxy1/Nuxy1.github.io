---
// "What Do You Want to Automate?": the visitor picks a goal and sees the three services that fit it best (owner's
// motion brief, 2026-11-11). It is a fixed list per goal, not an AI request: each list names catalogue ids in order
// of fit, an id that isn't in the catalogue is skipped, and every name, price and fact comes from data/services.ts.
//
// The goals are radio buttons and CSS shows the chosen goal's cards, so it works without JavaScript (where :has()
// isn't supported, every goal's cards show one list after another). The six lists share one cell, so switching never
// moves the page; the cards fade in one after another when motion is on.
import Icon from "./Icon.astro";
import type { IconName } from "./Icon.astro";
import { serviceById } from "../data/services";
import type { Service } from "../data/services";

type Goal = { id: string; label: string; icon: IconName; ids: string[] };
const goals: Goal[] = [
  { id: "calls", label: "Stop missing calls", icon: "phoneX", ids: ["ai-receptionist", "missed-calls", "ai-replies"] },
  { id: "leads", label: "Get more leads", icon: "funnel", ids: ["lead-qualification", "follow-up", "google-profile", "reviews"] },
  { id: "appointments", label: "Book more appointments", icon: "calendarCheck", ids: ["booking", "deposits", "lead-qualification"] },
  { id: "follow", label: "Follow up automatically", icon: "paperPlaneTilt", ids: ["estimate-follow-up", "follow-up", "quotes", "email-list", "reviews"] },
  { id: "website", label: "Improve my website", icon: "browser", ids: ["new-website", "site-fixes", "online-shop"] },
  { id: "connect", label: "Connect my software", icon: "plugsConnected", ids: ["integrations", "crm-system", "data", "invoices"] },
];
type Svc = Service & { monthly?: string };
const picks = goals.map((g) => ({ ...g, services: g.ids.map((id) => serviceById[id] as Svc | undefined).filter((s): s is Svc => Boolean(s)).slice(0, 3) }));
const lower = (t: string) => t.charAt(0).toLowerCase() + t.slice(1);
---
<section class="as section" id="what-to-automate" aria-labelledby="as-h">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow">Find your fit</p>
      <h2 id="as-h">What Do You Want to Automate?</h2>
      <p>Pick a goal to see the services that fit it, with their published prices. It’s a fixed list from our catalogue, not a guess about your business, and a quote is always free.</p>
    </div>

    <fieldset class="as-goals reveal">
      <legend class="sr-only">Choose a goal</legend>
      {picks.map((g, i) => (
        <label class="as-goal"><input type="radio" name="as-goal" value={g.id} checked={i === 0} /><Icon name={g.icon} /><span>{g.label}</span></label>
      ))}
    </fieldset>

    <div class="as-panels reveal">
      {picks.map((g) => (
        <div class="as-panel" id={`as-${g.id}`} role="region" aria-labelledby={`as-${g.id}-h`}>
          <h3 class="as-panel-h" id={`as-${g.id}-h`}>Best fits to {lower(g.label)}</h3>
          <ul class="as-cards">
            {g.services.map((s, k) => (
              <li class="as-card" style={`--k:${k}`}>
                <div class="as-top">
                  <span class="as-icon"><Icon name={s.icon} /></span>
                  {k === 0 && <span class="chip">Best fit</span>}
                </div>
                <h4 class="as-name">{s.name}</h4>
                <p class="as-fixes">Fixes: {lower(s.fixes)}</p>
                <p class="as-text">{s.text}</p>
                <details class="as-more">
                  <summary>What’s involved<span class="sr-only">: {s.name}</span><Icon name="caretDown" /></summary>
                  <dl>
                    <div><dt>Suits</dt><dd>{s.who}</dd></div>
                    <div><dt>We need from you</dt><dd>{s.needs}</dd></div>
                    <div><dt>Other companies’ costs</dt><dd>{s.costs}</dd></div>
                  </dl>
                </details>
                <div class="as-foot">
                  <p class="as-price"><span class="sr-only">Price: </span>{s.price}{s.monthly ? <span class="note"> + {s.monthly}</span> : <span class="note">{s.addon ? " add-on" : " one-time"}</span>}</p>
                  <div class="as-links">
                    <a class="text-link" href={`/solutions/#${s.id}`} data-track="service_details">Details<span class="sr-only">: {s.name}</span></a>
                    <a class="button small" href={`/contact/?service=${s.id}`} data-track="cta_selector">Get a quote<span class="sr-only">: {s.name}</span></a>
                  </div>
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* six goals: one column, then two rows of three (never five and a lone sixth) */
  .as-goals { display: grid; gap: 8px; margin: 0 0 22px; padding: 0; border: 0; min-width: 0; }
  @media (min-width: 560px) { .as-goals { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 760px) { .as-goals { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .as-goal {
    position: relative; display: flex; align-items: center; gap: 10px; min-height: 52px; padding: 8px 14px;
    border: 1px solid var(--hairline); border-radius: var(--r-md); background: var(--bg-2); color: var(--body); font-size: 0.9375rem; font-weight: 600; cursor: pointer;
  }
  .as-goal input { position: absolute; inset: 0; margin: 0; opacity: 0; cursor: inherit; }
  .as-goal :global(.icon) { flex: none; width: 1.25em; height: 1.25em; color: var(--muted); }
  .as-goal:hover { border-color: var(--hairline-strong); color: var(--ink); }
  .as-goal:has(input:checked) { border-color: var(--blue); background: rgba(37, 99, 235, 0.14); color: var(--ink); }
  .as-goal:has(input:checked) :global(.icon) { color: var(--cyan); }
  .as-goal:has(input:focus-visible) { outline: 2px solid var(--focus); outline-offset: 2px; }

  .as-panels { display: grid; }
  .as-panel { grid-area: 1 / 1; min-width: 0; visibility: hidden; }
  .as-panel-h { margin-bottom: 14px; color: var(--muted); font-size: 0.9375rem; font-weight: 600; }
  #what-to-automate:has(input[value="calls"]:checked) #as-calls,
  #what-to-automate:has(input[value="leads"]:checked) #as-leads,
  #what-to-automate:has(input[value="appointments"]:checked) #as-appointments,
  #what-to-automate:has(input[value="follow"]:checked) #as-follow,
  #what-to-automate:has(input[value="website"]:checked) #as-website,
  #what-to-automate:has(input[value="connect"]:checked) #as-connect { display: block; visibility: visible; }
  /* with the cards in one column the lists differ a lot in height, so a phone shows only the chosen list (no tall
     empty cell under a short one); from 900px they keep sharing one cell, so switching never moves the page */
  @media (max-width: 899px) { .as-panel { grid-area: auto; display: none; } }
  @supports not selector(:has(*)) { .as-panels { gap: 32px; } .as-panel { grid-area: auto; display: block; visibility: visible; } .as-goals { display: none; } }

  .as-cards { display: grid; gap: 16px; list-style: none; }
  @media (min-width: 900px) { .as-cards { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .as-card {
    display: flex; flex-direction: column; gap: 10px; min-width: 0; padding: 22px;
    border: 1px solid var(--hairline); border-radius: var(--r-lg); background: var(--panel);
  }
  /* a hidden list's cards wait faded, then come in one after another when their goal is picked */
  :global(html[data-motion]:not([data-motion="reduced"])) .as-card { transition: opacity var(--dur-3) var(--ease-out), transform var(--dur-3) var(--ease-out); }
  :global(html[data-motion]:not([data-motion="reduced"])) .as-panel .as-card { opacity: 0; transform: translateY(10px); }
  #what-to-automate:has(input[value="calls"]:checked) #as-calls .as-card,
  #what-to-automate:has(input[value="leads"]:checked) #as-leads .as-card,
  #what-to-automate:has(input[value="appointments"]:checked) #as-appointments .as-card,
  #what-to-automate:has(input[value="follow"]:checked) #as-follow .as-card,
  #what-to-automate:has(input[value="website"]:checked) #as-website .as-card,
  #what-to-automate:has(input[value="connect"]:checked) #as-connect .as-card { opacity: 1; transform: none; transition-delay: calc(var(--k) * 70ms); }
  /* on a phone the chosen list appears from display:none, so its cards start from faded (browsers without
     @starting-style just show them) */
  @media (max-width: 899px) { @starting-style { :global(html[data-motion]:not([data-motion="reduced"])) .as-panel .as-card { opacity: 0; transform: translateY(10px); } } }

  .as-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 4px; }
  .as-icon { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 10px; background: var(--accent-soft); color: var(--link); }
  .as-icon :global(.icon) { width: 22px; height: 22px; }
  .as-name { font-size: 1.125rem; }
  .as-fixes { color: var(--cyan); font-size: 0.875rem; font-weight: 500; }
  .as-text { color: var(--body); font-size: 0.9375rem; }

  .as-more { border-top: 1px solid var(--hairline-soft); }
  .as-more summary {
    display: flex; align-items: center; justify-content: space-between; gap: 8px; min-height: 44px; list-style: none;
    color: var(--link); font-size: 0.9375rem; font-weight: 600; cursor: pointer;
  }
  .as-more summary::-webkit-details-marker { display: none; }
  .as-more summary :global(.icon) { width: 1em; height: 1em; }
  .as-more[open] summary :global(.icon) { transform: rotate(180deg); }
  .as-more summary:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; border-radius: 4px; }
  .as-more dl { display: grid; gap: 10px; margin: 0 0 4px; font-size: 0.875rem; }
  .as-more dt { color: var(--muted); font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.02em; }
  .as-more dd { margin: 2px 0 0; color: var(--body); }
  /* opening fades the facts in; the height itself never animates */
  :global(html[data-motion]:not([data-motion="reduced"])) .as-more[open] dl { animation: as-fade var(--dur-2) var(--ease-out); }
  :global(html[data-motion]:not([data-motion="reduced"])) .as-more summary :global(.icon) { transition: transform var(--dur-2) var(--ease-out); }
  @keyframes as-fade { from { opacity: 0; } to { opacity: 1; } }

  .as-foot { display: grid; gap: 12px; margin-top: auto; padding-top: 14px; border-top: 1px solid var(--hairline-soft); }
  .as-price { color: var(--ink); font-size: 1.125rem; font-weight: 650; letter-spacing: -0.01em; }
  .as-price .note { color: var(--muted); font-size: 0.875rem; font-weight: 500; letter-spacing: 0; }
  .as-links { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 16px; }
  .as-links .text-link { display: inline-flex; align-items: center; min-height: 44px; }
</style>
