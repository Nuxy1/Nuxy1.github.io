  /* the document settles in, then the steps follow one after another (not under reduced motion: the global rule zeroes it) */
  :global(:root[data-tier="1"]) .dc:not([hidden]) .dc-doc, :global(:root[data-tier="2"]) .dc:not([hidden]) .dc-doc { animation: dc-doc 520ms cubic-bezier(0.16, 1, 0.3, 1) both; }
