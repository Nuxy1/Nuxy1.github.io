  /* with room, Nuxy's section is a slim band under the document: the heading and the two links share the top line,
     the steps run in one row under them (the links stay last in the source, so the reading order is unchanged) */
  .dc { container: dc / inline-size; }
  @container dc (min-width: 760px) {
    .dc-nuxy { grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 14px 24px; padding: 18px 24px 20px; }
