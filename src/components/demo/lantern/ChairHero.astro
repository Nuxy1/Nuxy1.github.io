---
// Lantern Row's hero: the red leather chair under a hanging lantern, drawn as layered SVG (wall, mirror, lantern,
// floor, chair, tool tray) so the layers can move at different depths. Tiers (lib/demo/tier.ts): 1 = pointer depth
// + dust drifting in the lantern light (canvas, 30 fps); 2 = pointer depth on a mouse, lantern sway in CSS; 3 and no
// JavaScript = the still picture. The "available today" board sits over the scene and works without JavaScript.
import { base, barbers, board, slotLabel } from "../../../data/demos/lantern";

// perspective floor: tile rows at equal depth steps toward a vanishing point behind the chair
const vx = 320, vy = 250, top = 470;
const depth = [0, 1, 2, 3, 4, 5].map((k) => 1 / (1 - k * 0.13));
const cols = Array.from({ length: 15 }, (_, i) => (i - 7) * 58);
const tiles: { d: string; dark: boolean }[] = [];
for (let k = 0; k < depth.length - 1; k++) {
  const s0 = depth[k], s1 = depth[k + 1];
  const y0 = vy + (top - vy) * s0, y1 = vy + (top - vy) * s1;
  for (let j = 0; j < cols.length - 1; j++) {
    const p = [[vx + cols[j] * s0, y0], [vx + cols[j + 1] * s0, y0], [vx + cols[j + 1] * s1, y1], [vx + cols[j] * s1, y1]];
    tiles.push({ d: `M${p.map((q) => q.map((n) => n.toFixed(1)).join(" ")).join("L")}Z`, dark: (j + k) % 2 === 0 });
  }
}
const panels = [18, 136, 254, 372, 490];
---
<section class="lr-hero" data-lr-hero aria-labelledby="lr-hero-h">
  <div class="lr-wrap lr-hero-in">
    <div class="lr-hero-copy">
      <p class="lr-kicker">Three chairs on Lantern Row</p>
      <h1 id="lr-hero-h">Sharp cuts, on your&nbsp;time.</h1>
      <p class="lr-lead">Three barbers, five cuts and an honest price list. Pick a chair and a time in under a minute, and get a reminder the day before.</p>
      <div class="lr-hero-ctas">
        <a class="lr-btn" href={`${base}/booking/`}>Book a chair</a>
        <a class="lr-btn lr-btn-line" href={`${base}/services/`}>See the menu</a>
      </div>
      <p class="lr-demo-note">Demonstration booking: nothing is reserved or sent.</p>
    </div>

    <div class="lr-stage">
      <div class="lr-scene" aria-hidden="true">
        <svg viewBox="0 0 640 680" preserveAspectRatio="xMidYMax slice" role="presentation" focusable="false">
          <defs>
            <linearGradient id="lr-g-wall" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#17130f" /><stop offset="1" stop-color="#211b15" /></linearGradient>
            <linearGradient id="lr-g-brass" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#f0d08a" /><stop offset="0.45" stop-color="#a87d3a" /><stop offset="0.7" stop-color="#e3be74" /><stop offset="1" stop-color="#6e5025" /></linearGradient>
            <linearGradient id="lr-g-glass" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#2d2822" /><stop offset="1" stop-color="#110f0c" /></linearGradient>
            <linearGradient id="lr-g-leather" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#b8493c" /><stop offset="0.55" stop-color="#8e2f28" /><stop offset="1" stop-color="#5a1c18" /></linearGradient>
            <linearGradient id="lr-g-leather-side" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#5a1c18" /><stop offset="0.3" stop-color="#a63a30" /><stop offset="0.7" stop-color="#a63a30" /><stop offset="1" stop-color="#4f1814" /></linearGradient>
            <linearGradient id="lr-g-chrome" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#55514a" /><stop offset="0.3" stop-color="#f4f0e7" /><stop offset="0.55" stop-color="#8f8a80" /><stop offset="0.8" stop-color="#e0dbd0" /><stop offset="1" stop-color="#4b4842" /></linearGradient>
            <radialGradient id="lr-g-glow" cx="0.5" cy="0.5" r="0.5"><stop offset="0" stop-color="#f3cf86" stop-opacity="0.42" /><stop offset="0.35" stop-color="#e7b866" stop-opacity="0.16" /><stop offset="1" stop-color="#e7b866" stop-opacity="0" /></radialGradient>
            <radialGradient id="lr-g-flame" cx="0.5" cy="0.6" r="0.5"><stop offset="0" stop-color="#fff4d6" /><stop offset="0.5" stop-color="#f2c56c" /><stop offset="1" stop-color="#c47a2c" /></radialGradient>
            <radialGradient id="lr-g-shadow" cx="0.5" cy="0.5" r="0.5"><stop offset="0" stop-color="#000" stop-opacity="0.65" /><stop offset="1" stop-color="#000" stop-opacity="0" /></radialGradient>
            <linearGradient id="lr-g-floorfade" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#14110e" stop-opacity="0.7" /><stop offset="0.4" stop-color="#14110e" stop-opacity="0" /></linearGradient>
            <clipPath id="lr-c-mirror"><path d="M182 300V158a138 138 0 0 1 276 0v142Z" /></clipPath>
          </defs>

          <!-- the back wall: panelling, brass chair rail, a shelf of tonics -->
          <g class="lr-l lr-l-wall">
            <rect x="-40" y="-20" width="720" height="510" fill="url(#lr-g-wall)" />
            {Array.from({ length: 14 }, (_, i) => <path d={`M${i * 48 + 6} 0V330`} stroke="#2a231b" stroke-width="1" />)}
            <rect x="-40" y="330" width="720" height="150" fill="#1b1611" />
            {panels.map((x) => <rect x={x} y="350" width="104" height="102" fill="none" stroke="#33291f" stroke-width="2" />)}
            <rect x="-40" y="326" width="720" height="6" fill="url(#lr-g-brass)" opacity="0.8" />
            <rect x="-40" y="462" width="720" height="10" fill="#0e0c0a" />
            <g transform="translate(38 222)">
              <rect x="0" y="40" width="96" height="6" fill="#3a2f22" />
              <rect x="10" y="8" width="16" height="32" rx="3" fill="#3b5246" /><rect x="13" y="0" width="10" height="9" fill="#a87d3a" />
              <rect x="34" y="14" width="20" height="26" rx="4" fill="#6b3b22" /><rect x="39" y="6" width="10" height="9" fill="#2a231b" />
              <rect x="62" y="4" width="14" height="36" rx="3" fill="#c9b48a" opacity="0.75" /><rect x="64" y="-4" width="10" height="9" fill="#a87d3a" />
            </g>
          </g>

          <!-- the gilt mirror, catching the lantern -->
          <g class="lr-l lr-l-mirror">
            <path d="M182 300V158a138 138 0 0 1 276 0v142Z" fill="url(#lr-g-glass)" />
            <g clip-path="url(#lr-c-mirror)">
              <ellipse cx="410" cy="150" rx="120" ry="110" fill="url(#lr-g-glow)" />
              <circle cx="404" cy="146" r="6" fill="#f3cf86" opacity="0.7" />
              <path d="M200 300 330 60h26L226 300Z" fill="#fff" opacity="0.035" />
              <path d="M240 300 370 60h10L250 300Z" fill="#fff" opacity="0.03" />
            </g>
            <path d="M182 300V158a138 138 0 0 1 276 0v142" fill="none" stroke="url(#lr-g-brass)" stroke-width="14" />
            <path d="M174 304V158a146 146 0 0 1 292 0v146" fill="none" stroke="#6e5025" stroke-width="1.5" />
            <path d="M311 14l9-12 9 12-9 8Z" fill="url(#lr-g-brass)" />
            <rect x="170" y="300" width="300" height="10" fill="url(#lr-g-brass)" />
          </g>

          <!-- the floor -->
          <g class="lr-l lr-l-floor">
            <rect x="-40" y="470" width="720" height="230" fill="#1a1612" />
            {tiles.map((t) => <path d={t.d} fill={t.dark ? "#0f0d0b" : "#2a241d"} />)}
            <rect x="-40" y="470" width="720" height="230" fill="url(#lr-g-floorfade)" />
            <ellipse cx="320" cy="640" rx="210" ry="34" fill="url(#lr-g-shadow)" />
          </g>

          <!-- the hanging lantern and its light -->
          <g class="lr-l lr-l-lantern">
            <ellipse class="lr-glow" cx="532" cy="170" rx="250" ry="230" fill="url(#lr-g-glow)" />
            <g class="lr-sway">
              <path d="M532 -10V96" stroke="#6e5025" stroke-width="2" stroke-dasharray="5 3" />
              <path d="M514 96h36l-6 12h-24Z" fill="url(#lr-g-brass)" />
              <path d="M512 108h40l6 72h-52Z" fill="#2a2116" stroke="url(#lr-g-brass)" stroke-width="3" />
              <path d="M520 114h24l4 60h-32Z" fill="#f2c56c" opacity="0.28" />
              <path class="lr-flame" d="M532 128c9 13 9 26 0 36-9-10-9-23 0-36Z" fill="url(#lr-g-flame)" />
              <path d="M532 108v72" stroke="#a87d3a" stroke-width="1.5" opacity="0.7" />
              <path d="M504 180h56l-8 10h-40Z" fill="url(#lr-g-brass)" />
            </g>
          </g>

          <!-- the chair: chrome base, red leather -->
          <g class="lr-l lr-l-chair">
            <ellipse cx="320" cy="634" rx="122" ry="20" fill="url(#lr-g-chrome)" />
            <ellipse cx="320" cy="628" rx="112" ry="15" fill="#c9c4b9" />
            <ellipse cx="320" cy="628" rx="96" ry="10" fill="#6c685f" opacity="0.5" />
            <rect x="301" y="540" width="38" height="90" fill="url(#lr-g-chrome)" />
            <path d="M282 514h76l-12 34h-52Z" fill="url(#lr-g-chrome)" />
            <!-- headrest on its stem -->
            <rect x="314" y="208" width="12" height="54" fill="url(#lr-g-chrome)" />
            <rect x="268" y="176" width="104" height="44" rx="20" fill="url(#lr-g-leather)" />
            <path d="M282 186h76" stroke="#fff" stroke-opacity="0.14" stroke-width="3" stroke-linecap="round" />
            <!-- backrest with channel stitching and buttons -->
            <path d="M226 482V292c0-28 20-44 44-44h100c24 0 44 16 44 44v190Z" fill="url(#lr-g-leather)" />
            <path d="M226 482V292c0-28 20-44 44-44" fill="none" stroke="#5a1c18" stroke-width="5" />
            <path d="M414 482V292c0-28-20-44-44-44" fill="none" stroke="#5a1c18" stroke-width="5" />
            {[264, 302, 338, 376].map((x) => <g><path d={`M${x} 262V470`} stroke="#5f1d19" stroke-width="2.5" /><path d={`M${x + 3} 262V470`} stroke="#d0614f" stroke-opacity="0.28" stroke-width="1.5" /></g>)}
            {[283, 320, 357].flatMap((x) => [306, 366, 426].map((y) => <circle cx={x} cy={y} r="3.6" fill="#4f1814" />))}
            <path d="M242 290c4-22 18-30 36-30" stroke="#fff" stroke-opacity="0.16" stroke-width="5" fill="none" stroke-linecap="round" />
            <!-- arms: chrome brackets under padded rests -->
            <path d="M188 452c0-6 4-10 10-10h40v74h-22c-14 0-28-12-28-30Z" fill="url(#lr-g-chrome)" opacity="0.92" />
            <path d="M452 452c0-6-4-10-10-10h-40v74h22c14 0 28-12 28-30Z" fill="url(#lr-g-chrome)" opacity="0.92" />
            <rect x="166" y="418" width="88" height="30" rx="14" fill="url(#lr-g-leather)" />
            <rect x="386" y="418" width="88" height="30" rx="14" fill="url(#lr-g-leather)" />
            <rect x="160" y="420" width="24" height="26" rx="12" fill="#efe6d3" /><rect x="456" y="420" width="24" height="26" rx="12" fill="#efe6d3" />
            <path d="M188 424h56M396 424h56" stroke="#fff" stroke-opacity="0.18" stroke-width="3" stroke-linecap="round" />
            <!-- the seat cushion -->
            <path d="M208 470h224c10 0 16 8 14 18l-6 26c-2 8-8 12-16 12H216c-8 0-14-4-16-12l-6-26c-2-10 4-18 14-18Z" fill="url(#lr-g-leather-side)" />
            <path d="M214 474h212" stroke="#fff" stroke-opacity="0.2" stroke-width="3" stroke-linecap="round" />
            <path d="M206 504h228" stroke="#5a1c18" stroke-width="2" stroke-dasharray="3 4" />
            <!-- the pump lever -->
            <path d="M440 506l40-38" stroke="url(#lr-g-chrome)" stroke-width="7" stroke-linecap="round" />
            <circle cx="484" cy="464" r="9" fill="#1b1612" stroke="url(#lr-g-chrome)" stroke-width="3" />
            <!-- footrest -->
            <path d="M256 526v58M384 526v58" stroke="url(#lr-g-chrome)" stroke-width="8" />
            <path d="M232 584h176l10 18H222Z" fill="url(#lr-g-chrome)" />
            {[0, 1, 2, 3, 4, 5, 6, 7].map((i) => <path d={`M${250 + i * 20} 588l-2 10`} stroke="#5b5750" stroke-width="2" />)}
          </g>

          <!-- the tool tray in the foreground: comb, folded razor, scissors -->
          <g class="lr-l lr-l-tray">
            <path d="M-30 622h250l18 70H-30Z" fill="#1d1813" />
            <path d="M-30 618h254l4 10H-30Z" fill="url(#lr-g-brass)" />
            <g transform="translate(18 604) rotate(-6)">
              <rect width="78" height="10" rx="2" fill="#2b2b2b" />
              {Array.from({ length: 18 }, (_, i) => <path d={`M${4 + i * 4} 10v8`} stroke="#2b2b2b" stroke-width="2" />)}
            </g>
            <g transform="translate(108 600) rotate(4)">
              <rect width="74" height="12" rx="6" fill="#3a2414" />
              <path d="M8 6h56" stroke="#6b4426" stroke-width="1.5" />
              <path d="M70 2h26c4 0 6 6 2 9l-28 1Z" fill="url(#lr-g-chrome)" />
            </g>
            <g transform="translate(176 590) rotate(-24)" fill="none" stroke="url(#lr-g-chrome)" stroke-width="4">
              <circle cx="8" cy="8" r="7" /><circle cx="8" cy="26" r="7" />
              <path d="M14 12l46 6M14 22l46-4" stroke-linecap="round" />
            </g>
          </g>
        </svg>
        <canvas class="lr-dust" width="1" height="1"></canvas>
      </div>

      <aside class="lr-today" aria-labelledby="lr-today-h" data-today>
        <div class="lr-today-head">
          <h2 class="lr-label" id="lr-today-h"><span data-today-day>Available today</span></h2>
          <span class="lr-today-dot" aria-hidden="true"></span>
        </div>
        <ul role="list" class="lr-today-list">
          {barbers.map((b) => (
            <li>
              <span class="lr-mono" style={`--tone:${b.tone}`} aria-hidden="true">{b.name[0]}</span>
              <span class="lr-today-name">{b.name}<small>Chair {b.chair}</small></span>
              {board[b.id].length
                ? board[b.id].map((t) => <a class="lr-today-time" href={`${base}/booking/?barber=${b.id}&day=0&time=${t}`}>{slotLabel(t)}<span class="sr-only">: book with {b.name}</span></a>)
                : <span class="lr-today-full">Fully booked</span>}
            </li>
          ))}
        </ul>
        <a class="lr-link lr-today-wait" href={`${base}/booking/?barber=julian#waitlist`}>Join cancellation list <span aria-hidden="true">→</span></a>
        <p class="lr-today-note">Demo times: the board looks the same every day.</p>
      </aside>
    </div>
  </div>
</section>

<style>
  .lr-hero { position: relative; overflow: hidden; padding-block: clamp(28px, 5vw, 64px) clamp(56px, 7vw, 96px); background: radial-gradient(80% 70% at 75% 20%, #241c13, transparent 70%), var(--lr-bg); }
  .lr-hero-in { display: grid; gap: clamp(28px, 4vw, 56px); align-items: center; }
  @media (min-width: 1024px) { .lr-hero-in { grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr); } }
  .lr-hero-copy { display: grid; gap: 22px; justify-items: start; }
  .lr-hero-copy h1 { max-width: 11ch; }
  .lr-hero-ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 6px; }
  @media (max-width: 419px) { .lr-hero-ctas { width: 100%; } .lr-hero-ctas .lr-btn { flex: 1 1 100%; } }

  .lr-stage { position: relative; display: grid; gap: 16px; }
  .lr-scene { position: relative; aspect-ratio: 640 / 680; max-height: min(78vh, 720px); width: 100%; overflow: hidden; border: 1px solid var(--lr-line); background: #14110e; }
  .lr-scene svg { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .lr-scene::after { content: ""; position: absolute; inset: 0; pointer-events: none; box-shadow: inset 0 0 120px rgba(0, 0, 0, 0.55); }
  .lr-dust { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; opacity: 0; transition: opacity 600ms ease-out; mix-blend-mode: screen; }
  .lr-hero.has-dust .lr-dust { opacity: 1; }

  /* depth: each layer moves by its own share of the pointer (tiers 1-2 set --px/--py on a mouse) */
  .lr-l { transform: translate(calc(var(--px, 0) * var(--dx) * 1px), calc(var(--py, 0) * var(--dy) * 1px)); }
  .lr-l-wall { --dx: -5; --dy: -3; }
  .lr-l-mirror { --dx: -8; --dy: -4; }
  .lr-l-floor { --dx: 0; --dy: 0; }
  .lr-l-lantern { --dx: -12; --dy: -5; }
  .lr-l-chair { --dx: 6; --dy: 3; }
  .lr-l-tray { --dx: 22; --dy: 8; }
  .lr-sway { transform-box: view-box; transform-origin: 532px 0; }
  :root[data-tier="1"] .lr-hero.is-live .lr-sway, :root[data-tier="2"] .lr-hero.is-live .lr-sway { animation: lr-sway 7s ease-in-out infinite; }
  :root[data-tier="1"] .lr-hero.is-live .lr-glow, :root[data-tier="2"] .lr-hero.is-live .lr-glow { animation: lr-glow 3.4s ease-in-out infinite; }
  :root[data-tier="1"] .lr-hero.is-live .lr-flame, :root[data-tier="2"] .lr-hero.is-live .lr-flame { transform-box: fill-box; transform-origin: 50% 100%; animation: lr-flame 1.6s ease-in-out infinite; }
  @keyframes lr-sway { 0%, 100% { transform: rotate(1.6deg); } 50% { transform: rotate(-1.6deg); } }
  @keyframes lr-glow { 0%, 100% { opacity: 1; } 45% { opacity: 0.86; } 60% { opacity: 0.94; } }
  @keyframes lr-flame { 0%, 100% { transform: scale(1, 1); } 40% { transform: scale(0.94, 1.06); } 70% { transform: scale(1.03, 0.97); } }

  /* the today board */
  .lr-today { position: relative; display: grid; gap: 4px; padding: 18px 20px 14px; background: rgba(15, 13, 11, 0.96); border: 1px solid var(--lr-line); box-shadow: 0 30px 60px rgba(0, 0, 0, 0.5); }
  .lr-today::before { content: ""; position: absolute; inset: 5px; border: 1px solid rgba(201, 164, 92, 0.22); pointer-events: none; }
  @media (min-width: 1024px) { .lr-today { position: absolute; left: -40px; bottom: 36px; width: 300px; } }
  @media (min-width: 640px) and (max-width: 1023px) { .lr-today { position: absolute; left: 20px; bottom: 20px; width: 300px; } }
  .lr-today-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding-bottom: 8px; border-bottom: 1px solid var(--lr-line); }
  .lr-today-head h2 { font-family: "Sofia XC", sans-serif; font-size: 1rem; font-weight: 700; letter-spacing: 0.18em; line-height: 1.2; }
  .lr-today-dot { width: 8px; height: 8px; border-radius: 50%; background: #7fbf7a; box-shadow: 0 0 0 4px rgba(127, 191, 122, 0.16); }
  .lr-today-list li { display: grid; grid-template-columns: 36px 1fr auto; align-items: center; gap: 12px; padding: 8px 0; border-bottom: 1px dotted var(--lr-line); }
  .lr-mono { display: grid; place-items: center; width: 36px; height: 36px; border: 1px solid var(--tone); color: var(--tone); font-family: "Bodoni Moda", Georgia, serif; font-size: 1.125rem; font-weight: 600; border-radius: 50%; }
  .lr-today-name { display: grid; font-weight: 600; line-height: 1.2; }
  .lr-today-name small { font-size: 0.8125rem; font-weight: 450; color: var(--lr-mute); }
  .lr-today-time { display: inline-flex; align-items: center; min-height: 44px; padding: 0 14px; border: 1px solid var(--lr-brass); color: var(--lr-brass-2); font-family: "Sofia XC", sans-serif; font-weight: 700; font-size: 1.125rem; letter-spacing: 0.06em; text-decoration: none; transition: background-color 160ms ease-out, color 160ms ease-out; }
  .lr-today-time:hover { background: var(--lr-brass); color: var(--lr-ink); }
  .lr-today-full { font-family: "Sofia XC", sans-serif; font-weight: 700; font-size: 1rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--lr-mute); text-decoration: line-through; text-decoration-color: var(--lr-red); }
  .lr-today-wait { font-size: 1rem; }
  .lr-today-note { font-size: 0.8125rem; color: var(--lr-mute); }
</style>

<script>
  import { whileTier, tier } from "../../../lib/demo/tier";
  import { loop, pointer, fit } from "../../../lib/demo/loop";
  import { boardDay, dayName } from "../../../data/demos/lantern";

  const hero = document.querySelector<HTMLElement>("[data-lr-hero]");
  if (hero) {
    // the board says which day it shows: today until Marcus's 2:30 has gone, then the next open day
    const now = new Date();
    const day = dayName(boardDay(now), now);
    const label = hero.querySelector<HTMLElement>("[data-today-day]");
    if (label) label.textContent = `Available ${day === "Today" ? "today" : day === "Tomorrow" ? "tomorrow" : day}`;

    new IntersectionObserver(([e]) => hero.classList.toggle("is-live", e.isIntersecting)).observe(hero);
    const scene = hero.querySelector<HTMLElement>(".lr-scene")!;
    const fine = matchMedia("(pointer: fine)");

    whileTier(2, () => {
      if (!fine.matches) return;
      const ptr = pointer(hero);
      let lx = 9, ly = 9;
      const run = loop(scene, () => {
        const p = ptr.ease(0.06);
        if (Math.abs(p.x - lx) < 0.001 && Math.abs(p.y - ly) < 0.001) return;
        lx = p.x; ly = p.y;
        scene.style.setProperty("--px", p.x.toFixed(4));
        scene.style.setProperty("--py", p.y.toFixed(4));
      }, { fps: 60 });
      return () => { run.stop(); ptr.stop(); scene.style.setProperty("--px", "0"); scene.style.setProperty("--py", "0"); };
    });

    // tier 1: dust turning slowly in the lantern light
    whileTier(1, () => {
      const canvas = scene.querySelector<HTMLCanvasElement>(".lr-dust");
      const ctx = canvas?.getContext("2d");
      if (!canvas || !ctx || tier() !== 1) return;
      type Mote = { x: number; y: number; r: number; vx: number; vy: number; ph: number };
      let motes: Mote[] = [], W = 0, H = 0, k = 1;
      const build = () => {
        ({ w: W, h: H, k } = fit(canvas));
        let s = 7;
        const r = () => { s = (s * 16807) % 2147483647; return (s - 1) / 2147483646; };
        motes = Array.from({ length: 46 }, () => ({ x: r() * W, y: r() * H * 0.8, r: 0.6 + r() * 1.6, vx: (r() - 0.5) * 0.012, vy: -0.004 - r() * 0.01, ph: r() * 6.28 }));
      };
      build();
      const ro = new ResizeObserver(build);
      ro.observe(canvas);
      hero.classList.add("has-dust");
      const run = loop(canvas, (t, dt) => {
        ctx.setTransform(k, 0, 0, k, 0, 0);
        ctx.clearRect(0, 0, W, H);
        // brightest near the lantern (upper right of the scene)
        const lx = W * 0.83, ly = H * 0.25, reach = Math.max(W, H) * 0.55;
        for (const m of motes) {
          m.x += (m.vx + Math.sin(t * 0.0004 + m.ph) * 0.006) * dt;
          m.y += m.vy * dt;
          if (m.y < -4) { m.y = H * 0.85; m.x = Math.random() * W; }
          if (m.x < -4) m.x = W + 4; else if (m.x > W + 4) m.x = -4;
          const d = Math.hypot(m.x - lx, m.y - ly) / reach;
          const a = Math.max(0, 1 - d) * (0.55 + 0.45 * Math.sin(t * 0.0015 + m.ph));
          if (a < 0.03) continue;
          ctx.fillStyle = `rgba(243, 207, 134, ${a.toFixed(3)})`;
          ctx.beginPath(); ctx.arc(m.x, m.y, m.r, 0, 6.283); ctx.fill();
        }
      }, { fps: 30 });
      return () => { run.stop(); ro.disconnect(); hero.classList.remove("has-dust"); ctx.clearRect(0, 0, canvas.width, canvas.height); };
    });
  }
</script>
