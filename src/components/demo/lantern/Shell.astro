---
// Lantern Row's frame on every page: a dark header with its own navigation (a folding menu on phones that works
// without JavaScript), the phone dock (Book a chair / Call) and the footer with hours, address and the
// fictional-business line. The design system lives here as global styles under body.lr: Bodoni Moda for headings and
// reading text (the self-hosted file is the text cut, sturdy enough at 16 px on charcoal), Sofia Sans Extra Condensed
// (sentence case) for the shop's signage voice: labels, navigation, buttons and prices; soot, charcoal, cream, brass
// and oxblood from the redesign brief (docs/demo-redesign-brief-2026-11.md); square corners, thin brass rules and
// menu-board leaders.
import DemoSite from "../../../layouts/DemoSite.astro";
import { base, nav, phone, callNote, hours, address, email, directionsNote } from "../../../data/demos/lantern";
import { hoursSummary } from "../../../lib/demo/lantern-hours";

interface Props { title?: string; description: string; current?: string }
const { title, description, current } = Astro.props;
const here = (href: string) => (current && href.endsWith(`/${current}/`) ? "page" : undefined);
---
<DemoSite slug="lantern-row-barbers" theme="#14110e" title={title} description={description} bodyClass="lr"
  fonts={["/fonts/bodoni-moda-var.woff2", "/fonts/sofia-xc-700.woff2", "/fonts/inter-var-latin.woff2"]}>
  <header class="lr-top">
    <div class="lr-wrap lr-top-in">
      <a class="lr-logo" href={`${base}/`} aria-label="Lantern Row Barbers, home">
        <svg viewBox="0 0 32 40" width="24" height="30" aria-hidden="true"><path d="M10 6h12M12 6V3h8v3M8 10h16l-2 22H10Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /><path d="M16 15c3 4 3 8 0 11-3-3-3-7 0-11Z" fill="#e7c37a" /><path d="M10 36h12" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        <span class="lr-wordmark">Lantern Row<small> Barbers</small></span>
      </a>
      <nav class="lr-nav" aria-label="Main">
        {nav.map((n) => <a href={n.href} aria-current={here(n.href)}>{n.label}</a>)}
      </nav>
      <a class="lr-btn lr-btn-ox lr-btn-sm lr-top-book" href={`${base}/booking/`} aria-current={here(`${base}/booking/`)}>Book a chair</a>
      <details class="lr-menu">
        <summary aria-label="Menu"><span></span><span></span></summary>
        <div class="lr-menu-panel">
          <a href={`${base}/`}>Home</a>
          {nav.map((n) => <a href={n.href} aria-current={here(n.href)}>{n.label}</a>)}
          <a href={`${base}/booking/`} aria-current={here(`${base}/booking/`)}>Book a chair</a>
        </div>
      </details>
    </div>
  </header>

  <main id="main"><slot /></main>

  <!-- the footer is a colophon, centred like the last page of a book: the name in Bodoni, a brass rule with a diamond,
       the week as one timetable line, the address stacked one line each like a letterhead, then the small print in
       italic -->
  <footer class="lr-foot">
    <div class="lr-wrap lr-foot-in">
      <p class="lr-foot-name">Lantern Row Barbers</p>
      <p class="lr-foot-sub">Three chairs, one street, since the lantern went up.</p>
      <span class="lr-foot-rule" aria-hidden="true"></span>
      <p class="sr-only">Opening hours</p>
      <dl class="lr-foot-times">{hoursSummary(hours).map((h) => <div><dt>{h.days}</dt><dd class={h.open ? undefined : "off"}>{h.open ?? "Closed"}</dd></div>)}</dl>
      <address class="lr-foot-addr">
        <a href={`${base}/contact/`} data-demo-action={directionsNote}>{address}</a>
        <a href={`${base}/contact/`} data-demo-action={callNote}>{phone}</a>
        <a href={`${base}/contact/`} data-demo-action={`Demo: on a real site this writes to ${email}.`}>{email}</a>
      </address>
      <p class="lr-foot-wait"><a class="lr-link" href={`${base}/booking/#waitlist`}>Join the cancellation list</a></p>
      <p class="lr-foot-demo">Lantern Row Barbers is a fictional business. This is an interactive demonstration website built by{" "}
        <a href="/" target="_top">Nuxy Automation</a>: nothing here can be booked or bought, and nothing you type is sent. The
        photographs were generated for this demonstration: they show no real shop, barber or client.</p>
    </div>
  </footer>

  {/* the phone dock: not on the booking page itself, where it would only cover the form */}
  {current !== "booking" && (
  <nav class="lr-dock" aria-label="Quick actions">
    <a href={`${base}/contact/`} data-demo-action={callNote}><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /></svg>Call</a>
    <a class="lr-dock-main" href={`${base}/booking/`}>Book a chair</a>
  </nav>
  )}
</DemoSite>

<style is:global>
  @font-face { font-family: "Bodoni Moda"; src: url("/fonts/bodoni-moda-var.woff2") format("woff2"); font-weight: 400 900; font-display: swap; }
  @font-face { font-family: "Sofia XC"; src: url("/fonts/sofia-xc-700.woff2") format("woff2"); font-weight: 700; font-display: swap; }
  html { color-scheme: dark; }
  body.lr {
    --lr-ink: #121110; --lr-bg: #1c1a19; --lr-panel: #242120; --lr-panel-2: #2b2826; --lr-line: #433d36; --lr-line-soft: #2f2b28;
    --lr-cream: #efe6d6; --lr-soft: #c5bba9; --lr-mute: #aba193; --lr-brass: #b8925a; --lr-brass-2: #d6b27a; --lr-ox: #6e1f24; --lr-red: #a23f3a;
    --lr-ease: cubic-bezier(0.2, 0.7, 0.2, 1);
    --demo-ring: var(--lr-brass-2); /* 8:1 on the charcoal */
    background: var(--lr-bg); color: var(--lr-cream); caret-color: var(--lr-brass-2); accent-color: var(--lr-brass);
    font-family: "Bodoni Moda", "Didot", "Bodoni 72", Georgia, serif; font-size: 1.0625rem; line-height: 1.62; font-variant-numeric: lining-nums;
    /* the shipped Bodoni has a weight axis but no optical-size axis, so its display-cut hairlines thin out at reading
       sizes; a touch over the regular weight keeps the running text solid on the charcoal */
    font-weight: 450;
  }
  body.lr ::selection { background: var(--lr-brass-2); color: var(--lr-ink); }
  :where(.lr) :is(h1, h2, h3, .lr-display) { font-family: "Bodoni Moda", "Didot", "Bodoni 72", Georgia, serif; font-weight: 600; line-height: 1.02; letter-spacing: -0.01em; text-wrap: balance; }
  :where(.lr) h1 { font-size: clamp(2.75rem, 7vw, 6.25rem); font-weight: 500; }
  :where(.lr) h2 { font-size: clamp(2.125rem, 4.4vw, 3.75rem); font-weight: 500; }
  :where(.lr) h3 { font-size: 1.5rem; }
  :where(.lr) :is(p, figcaption, li, dd) { text-wrap: pretty; }
  :where(.lr) a { color: inherit; }
  :where(.lr) :focus-visible { outline: 2px solid var(--demo-ring); outline-offset: 3px; }
  .lr-wrap { width: min(1240px, 100% - 40px); margin-inline: auto; }
  .lr-section { padding-block: clamp(56px, 7vw, 104px); }
  .lr-rule { border-top: 1px solid var(--lr-line-soft); }
  /* small labels, buttons and prices share the condensed face, in sentence case like a sign-writer's hand */
  .lr-label { font-family: "Sofia XC", "Arial Narrow", sans-serif; font-weight: 700; letter-spacing: 0.03em; font-size: 1.0625rem; line-height: 1.2; color: var(--lr-brass); }
  .lr-lead { font-size: clamp(1.0625rem, 1.5vw, 1.25rem); color: var(--lr-soft); max-width: 56ch; }
  .lr-head { display: grid; gap: 16px; margin-bottom: clamp(36px, 5vw, 64px); max-width: 780px; }
  /* the Bodoni's low x-height (0.46 em against Inter's 0.55) needs a step up at the small end */
  .lr-fine { font-size: 0.9375rem; font-weight: 500; color: var(--lr-mute); }
  .lr-demo-note { display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; border: 1px solid var(--lr-line); color: var(--lr-soft); font-size: 0.9375rem; font-weight: 500; }
  /* the dot sits on the first line, full size, when the note wraps */
  .lr-demo-note::before { content: ""; flex: none; align-self: flex-start; width: 6px; height: 6px; margin-top: calc(0.5lh - 3px); border-radius: 50%; background: var(--lr-brass); }

  .lr-btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 52px; padding: 0 28px; border: 0; border-radius: 2px; background: var(--lr-brass); color: var(--lr-ink); font-family: "Sofia XC", "Arial Narrow", sans-serif; font-weight: 700; font-size: 1.3125rem; letter-spacing: 0.03em; text-decoration: none; white-space: nowrap; cursor: pointer; transition: background-color 200ms var(--lr-ease), transform 200ms var(--lr-ease), box-shadow 200ms var(--lr-ease); }
  .lr-btn:hover { background: var(--lr-brass-2); box-shadow: 0 10px 30px rgba(214, 178, 122, 0.16); transform: translateY(-1px); }
  .lr-btn:active { transform: scale(0.98); }
  .lr-btn-line { background: transparent; color: var(--lr-cream); box-shadow: inset 0 0 0 1px var(--lr-line); }
  .lr-btn-line:hover { background: rgba(184, 146, 90, 0.1); box-shadow: inset 0 0 0 1px var(--lr-brass); }
  /* the one action that moves you on (every "Book ...", Continue, Review, Confirm, Join the list) wears the chairs'
     oxblood leather with a brass edge, so the primary looks the same in every flow; plain brass is left for the
     occasional secondary action, and the outline for Back and the like. Cream on --lr-ox is 9.0:1, on the --lr-red
     hover 5.1:1 */
  .lr-btn-ox { background: var(--lr-ox); color: var(--lr-cream); box-shadow: inset 0 0 0 1px var(--lr-brass); }
  .lr-btn-ox:hover { background: var(--lr-red); box-shadow: inset 0 0 0 1px var(--lr-brass-2), 0 10px 30px rgba(110, 31, 36, 0.35); }
  .lr-btn-sm { min-height: 44px; padding: 0 18px; font-size: 1.1875rem; }
  .lr-link { display: inline-flex; align-items: center; min-height: 44px; font-family: "Sofia XC", sans-serif; font-weight: 700; font-size: 1.25rem; letter-spacing: 0.03em; color: var(--lr-brass-2); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 7px; text-decoration-color: rgba(214, 178, 122, 0.45); transition: color 160ms ease-out, text-decoration-color 160ms ease-out; }
  .lr-link:hover { color: var(--lr-cream); text-decoration-color: var(--lr-cream); }

  /* header */
  .lr-top { position: sticky; top: 0; z-index: 30; background: var(--lr-ink); border-bottom: 1px solid var(--lr-line-soft); view-transition-name: lr-top; }
  .lr-top-in { display: flex; align-items: center; gap: 28px; min-height: 72px; }
  .lr-logo { display: flex; align-items: center; gap: 12px; color: var(--lr-brass); text-decoration: none; margin-right: auto; }
  .lr-wordmark { display: grid; font-family: "Bodoni Moda", Georgia, serif; font-weight: 600; font-size: 1.375rem; line-height: 1; color: var(--lr-cream); }
  /* the second line is the shop's painted-glass script, not a tracked caps label */
  .lr-wordmark small { font-style: italic; font-weight: 500; font-size: 0.9375rem; letter-spacing: 0.02em; color: var(--lr-brass-2); margin-top: 3px; }
  .lr-nav { display: flex; gap: 6px; }
  .lr-nav a { position: relative; display: inline-flex; align-items: center; min-height: 44px; padding: 0 12px; font-family: "Sofia XC", sans-serif; font-weight: 700; font-size: 1.25rem; letter-spacing: 0.03em; text-decoration: none; color: var(--lr-soft); transition: color 160ms ease-out; }
  .lr-nav a::after { content: ""; position: absolute; left: 12px; right: 12px; bottom: 8px; height: 1px; background: var(--lr-brass); transform: scaleX(0); transform-origin: left; transition: transform 240ms var(--lr-ease); }
  .lr-nav a:hover, .lr-nav a[aria-current="page"] { color: var(--lr-cream); }
  .lr-nav a:hover::after, .lr-nav a[aria-current="page"]::after { transform: scaleX(1); }
  .lr-menu { display: none; position: relative; }
  .lr-menu summary { display: grid; place-content: center; gap: 7px; width: 48px; height: 48px; border: 1px solid var(--lr-line); border-radius: 2px; list-style: none; cursor: pointer; }
  .lr-menu summary::-webkit-details-marker { display: none; }
  .lr-menu summary span { display: block; width: 20px; height: 1.5px; background: var(--lr-cream); transition: transform 200ms var(--lr-ease); }
  .lr-menu[open] summary span:nth-child(1) { transform: translateY(4.25px) rotate(45deg); }
  .lr-menu[open] summary span:nth-child(2) { transform: translateY(-4.25px) rotate(-45deg); }
  .lr-menu-panel { position: absolute; right: 0; top: calc(100% + 12px); display: grid; width: min(280px, calc(100vw - 40px)); padding: 8px; background: var(--lr-panel-2); border: 1px solid var(--lr-line); box-shadow: 0 24px 48px rgba(0, 0, 0, 0.5); }
  .lr-menu-panel a { display: flex; align-items: center; min-height: 48px; padding: 0 14px; font-family: "Sofia XC", sans-serif; font-weight: 700; font-size: 1.3125rem; letter-spacing: 0.03em; text-decoration: none; }
  .lr-menu-panel a:hover, .lr-menu-panel a[aria-current="page"] { background: rgba(184, 146, 90, 0.14); color: var(--lr-brass-2); }
  @media (max-width: 899px) { .lr-nav { display: none; } .lr-menu { display: block; } }
  @media (max-width: 479px) { .lr-top-book { display: none; } }

  /* footer: the colophon (see the markup). The timetable's columns are parted by brass diamonds, never middle dots */
  .lr-foot { background: var(--lr-ink); border-top: 1px solid var(--lr-line-soft); color: var(--lr-soft); padding: clamp(64px, 9vw, 112px) 0 120px; text-align: center; }
  .lr-foot-in { display: grid; justify-items: center; }
  .lr-foot-name { font-family: "Bodoni Moda", Georgia, serif; font-size: clamp(2.5rem, 1.5rem + 4vw, 4.75rem); font-weight: 500; letter-spacing: -0.01em; line-height: 1; color: var(--lr-cream); text-wrap: balance; }
  .lr-foot-sub { margin-top: 16px; font-family: "Bodoni Moda", Georgia, serif; font-size: 1.1875rem; font-style: italic; color: var(--lr-soft); text-wrap: balance; }
  .lr-foot-rule { position: relative; display: block; width: min(360px, 72%); height: 1px; margin: clamp(32px, 4vw, 44px) 0; background: linear-gradient(to right, transparent, var(--lr-brass) 24% 76%, transparent); }
  .lr-foot-rule::after { content: ""; position: absolute; left: 50%; top: 50%; width: 9px; height: 9px; border: 1px solid var(--lr-brass); background: var(--lr-ink); transform: translate(-50%, -50%) rotate(45deg); }
  .lr-foot-times { display: flex; flex-wrap: wrap; justify-content: center; gap: 24px 72px; }
  .lr-foot-times > div { position: relative; display: grid; gap: 6px; }
  .lr-foot-times > div + div::before { content: ""; position: absolute; left: -36px; top: 50%; width: 6px; height: 6px; background: var(--lr-brass); transform: translate(-50%, -50%) rotate(45deg); }
  .lr-foot-times dt { font-family: "Sofia XC", "Arial Narrow", sans-serif; font-size: 1.0625rem; font-weight: 700; letter-spacing: 0.03em; color: var(--lr-brass-2); }
  .lr-foot-times dd { font-family: "Bodoni Moda", Georgia, serif; font-size: 1.3125rem; color: var(--lr-cream); font-variant-numeric: lining-nums tabular-nums; }
  .lr-foot-times dd.off { font-style: italic; color: var(--lr-mute); }
  /* the address block: street, phone and email one under another, no separators; each line is a 44 px target */
  .lr-foot-addr { display: grid; justify-items: center; margin-top: clamp(36px, 5vw, 52px); font-style: normal; }
  .lr-foot-addr a { display: inline-flex; align-items: center; min-height: 44px; font-family: "Bodoni Moda", Georgia, serif; font-size: 1.1875rem; color: var(--lr-cream); text-decoration: none; font-variant-numeric: lining-nums tabular-nums; transition: color 160ms ease-out; }
  .lr-foot-addr a:hover { color: var(--lr-brass-2); }
  .lr-foot-wait { margin-top: 10px; }
  /* a phone stacks the timetable, the diamonds moving above each entry */
  @media (max-width: 759px) {
    .lr-foot-times { flex-direction: column; gap: 40px; }
    .lr-foot-times > div + div::before { left: 50%; top: -20px; }
  }
  .lr-foot-demo { max-width: 58ch; margin-top: clamp(36px, 5vw, 52px); font-family: "Bodoni Moda", Georgia, serif; font-size: 0.9375rem; font-style: italic; line-height: 1.65; color: var(--lr-soft); text-wrap: pretty; }
  .lr-foot-demo a { color: var(--lr-brass-2); }
  /* the contact page's hours table */
  .lr-hours { display: grid; gap: 0; font-size: 1rem; font-variant-numeric: tabular-nums; }
  .lr-hours div { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding: 8px 0; border-bottom: 1px solid var(--lr-line-soft); }
  .lr-hours dd { color: var(--lr-cream); }
  .lr-hours dd.off { color: var(--lr-mute); }
  @media (min-width: 900px) { .lr-foot { padding-bottom: 80px; } }

  /* phone dock */
  .lr-dock { position: fixed; left: 12px; right: 12px; bottom: calc(12px + env(safe-area-inset-bottom)); z-index: 35; display: grid; grid-template-columns: 1fr 2fr; gap: 6px; padding: 6px; background: var(--lr-ink); border: 1px solid var(--lr-line); box-shadow: 0 16px 36px rgba(0, 0, 0, 0.55); }
  .lr-dock a { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 48px; font-family: "Sofia XC", sans-serif; font-weight: 700; font-size: 1.3125rem; letter-spacing: 0.03em; text-decoration: none; color: var(--lr-cream); }
  .lr-dock .lr-dock-main { background: var(--lr-ox); color: var(--lr-cream); box-shadow: inset 0 0 0 1px var(--lr-brass); }
  @media (min-width: 900px) { .lr-dock { display: none; } }
  /* a phone on its side: the header already carries Book a chair, and the dock would take a sixth of the screen */
  @media (max-height: 500px) and (min-width: 480px) { .lr-dock { display: none; } }
  /* it steps aside while the page's own Book button is on screen (lib/demo/dock.ts) */
  .lr-dock[data-away] { visibility: hidden; transform: translateY(calc(100% + 24px)); }
  @media (prefers-reduced-motion: no-preference) {
    .lr-dock[data-live] { transition: transform 0.3s var(--lr-ease), visibility 0s; }
    .lr-dock[data-live][data-away] { transition: transform 0.2s ease-in, visibility 0s 0.2s; }
    :root[data-tier="3"] .lr-dock { transition: none; }
  }
  /* the dock is 62px tall (6 + 48 + 6 + 2 border) and 12px above the bottom: a focused field scrolls clear of it (WCAG 2.4.11) */
  @media (max-width: 899px) { html { scroll-padding-bottom: calc(90px + env(safe-area-inset-bottom, 0px)); } }
  @media (max-width: 899px) { .lr .demo-toast { bottom: 92px; } }

  /* menu board: name ........ price */
  .lr-board { display: grid; gap: 0 64px; }
  @media (min-width: 860px) { .lr-board { grid-template-columns: 1fr 1fr; } }
  .lr-item { display: grid; gap: 6px; padding-block: 22px; border-bottom: 1px solid var(--lr-line-soft); }
  .lr-item-line { display: flex; align-items: baseline; gap: 12px; }
  .lr-item-line h3 { font-size: clamp(1.375rem, 2vw, 1.75rem); }
  .lr-dots { flex: 1; min-width: 16px; border-bottom: 1px dotted var(--lr-line); transform: translateY(-6px); }
  .lr-price { font-family: "Sofia XC", sans-serif; font-weight: 700; font-size: 1.625rem; letter-spacing: 0.04em; color: var(--lr-brass-2); }
  .lr-item p { color: var(--lr-soft); }

  /* fields, shared by the booking and the cancellation list */
  .lr-fields { display: grid; gap: 16px; }
  @media (min-width: 640px) { .lr-fields { grid-template-columns: 1fr 1fr; } .lr-field-wide { grid-column: 1 / -1; } }
  .lr-field { display: grid; gap: 8px; font-weight: 600; font-size: 1rem; }
  .lr-field input, .lr-field select { width: 100%; min-height: 50px; padding: 12px 14px; border: 1px solid var(--lr-line); border-radius: 2px; background: var(--lr-ink); color: var(--lr-cream); font: inherit; font-weight: 450; transition: border-color 160ms ease-out, box-shadow 160ms ease-out; }
  .lr-field input::placeholder { color: var(--lr-mute); } /* 7.4:1 on the field's ink */
  .lr-field input:focus, .lr-field select:focus { outline: 2px solid transparent; outline-offset: 2px; border-color: var(--lr-brass); box-shadow: 0 0 0 3px rgba(184, 146, 90, 0.3); }
  .lr-field :is(input, select)[aria-invalid="true"] { border-color: #e0715f; box-shadow: 0 0 0 3px rgba(224, 113, 95, 0.22); }
  .lr-field :is(input, select)[aria-invalid="true"]:focus { box-shadow: 0 0 0 2px #e0715f, 0 0 0 5px rgba(224, 113, 95, 0.3); }
  /* a choice group left empty (lib/demo/stepper flag() marks its block): a square rule round the cards, off the layout */
  [data-step] [data-invalid] { outline: 2px solid #e0715f; outline-offset: 6px; }
  .lr-field small { font-weight: 450; color: var(--lr-mute); }
  .lr-err { min-height: 0; color: #f0a090; font-weight: 600; }
  .lr-err:empty { display: none; }
  /* choice tiles: a hidden radio or checkbox and its box */
  .lr-pick { position: relative; display: block; cursor: pointer; }
  .lr-pick input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: pointer; }
  .lr-pick > span { display: grid; gap: 4px; align-content: center; min-height: 52px; height: 100%; padding: 12px 14px; border: 1px solid var(--lr-line); background: var(--lr-ink); transition: border-color 160ms ease-out, background-color 160ms ease-out; }
  .lr-pick:hover > span { border-color: #6b5a3a; }
  .lr-pick input:checked + span { border-color: var(--lr-brass); background: #2c241b; box-shadow: inset 0 0 0 1px var(--lr-brass); }
  .lr-pick input:focus-visible + span { outline: 2px solid var(--demo-ring); outline-offset: 3px; }
  .lr-pick input:disabled + span { border-style: dashed; color: #6f6656; cursor: not-allowed; }
  .lr-pick input:disabled { cursor: not-allowed; }

  /* closing band */
  .lr-band { position: relative; overflow: hidden; display: grid; gap: 20px; justify-items: start; --band-pad: clamp(32px, 5vw, 72px); padding: var(--band-pad); background: linear-gradient(180deg, rgba(110, 31, 36, 0.22), transparent 70%), var(--lr-panel); border: 1px solid var(--lr-line); }
  .lr-band h2 { max-width: 16ch; }
  .lr-band p { color: var(--lr-soft); max-width: 52ch; }
  /* wide screens: the headline holds the left half, the reason and the button sit across a brass rule on the right,
     so the panel is set edge to edge instead of leaving its right half empty */
  @media (min-width: 900px) {
