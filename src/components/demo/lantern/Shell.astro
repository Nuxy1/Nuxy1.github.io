  }
  /* a band lit by a photo (last child, so the counting above still holds). Phones: the photo heads the panel edge to
     edge. Wide screens: it fills the panel behind the words and fades out before them, so the words always sit on the
     plain panel. */
  .lr-band-lamp > .lr-band-ph { order: -1; justify-self: stretch; margin: calc(-1 * var(--band-pad)) calc(-1 * var(--band-pad)) 4px; aspect-ratio: 4 / 3; border-bottom: 1px solid var(--lr-line); }
  .lr-band-lamp > .lr-band-ph img { object-position: 30% 50%; }
  @media (min-width: 900px) {
