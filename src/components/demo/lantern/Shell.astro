    .lr-band > :nth-child(2) { grid-row: 2; }
    .lr-band > :nth-child(3) { grid-row: 3; }
    /* a band with only a headline and a button: a wider headline, the button centred on it */
    .lr-band:has(> :last-child:nth-child(2)) { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); }
    .lr-band:has(> :last-child:nth-child(2)) > h2 { max-width: 22ch; }
