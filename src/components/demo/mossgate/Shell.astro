<script>
  import { dockStepsAside } from "../../../lib/demo/dock";
  dockStepsAside(document.querySelector<HTMLElement>(".mg-dock"));
  const menu = document.querySelector<HTMLDetailsElement>(".mg-menu");
  menu?.addEventListener("click", (e) => { if ((e.target as Element).closest("a")) menu.open = false; });
