---
// Quillfern's frame on every page: a paper header with its own navigation and the cart (its count comes from this
// browser's demo cart), a folding menu on phones that works without JavaScript, and the footer with the studio, the
// care notes and the fictional-business line. The design system lives here as global styles under body.qf:
// Fraunces for reading and headings (soft, high-contrast at display sizes), the system face for prices and controls;
// warm wax and paper, umber and night for the dark rooms, amber flame and ember for action, fern green for stock;
// arch-topped frames (the shape of the label on every jar), hairline rules, square-shouldered buttons.
import DemoSite from "../../../layouts/DemoSite.astro";
import { base, nav, phone, email, callNote, emailNote, studio } from "../../../data/demos/quillfern";

interface Props { title?: string; description: string; current?: string; dark?: boolean }
const { title, description, current, dark = false } = Astro.props;
const here = (href: string) => (current && (href.endsWith(`/${current}/`)) ? "page" : undefined);
---
<DemoSite slug="quillfern-candles" theme={dark ? "#1d1611" : "#fbf6ee"} title={title} description={description} bodyClass="qf" fonts={["/fonts/fraunces-var.woff2"]}>
  <header class:list={["qf-top", { "is-dark": dark }]}>
    <div class="qf-wrap qf-top-in">
      <a class="qf-logo" href={`${base}/`} aria-label="Quillfern Candle Co., home">
        <svg viewBox="0 0 36 40" width="30" height="34" aria-hidden="true"><path d="M3 39V16A15 15 0 0 1 33 16V39Z" fill="currentColor" /><path d="M18 33V21M18 29l-4-3.2M18 29l4-3.2M18 25l-3-2.4M18 25l3-2.4" fill="none" stroke="var(--qf-logo-on)" stroke-width="1.7" stroke-linecap="round" /><path d="M18 6c2.2 2.3 3 4 3 5.4a3 3 0 0 1-6 0c0-1.4.8-3.1 3-5.4Z" fill="#e8a03a" /></svg>
        <span class="qf-wordmark">Quillfern<small> Candle Co.</small></span>
      </a>
      <nav class="qf-nav" aria-label="Main">
        {nav.map((n) => <a href={n.href} aria-current={here(n.href)}>{n.label}</a>)}
      </nav>
      <a class="qf-cart-link" href={`${base}/cart/`} aria-current={here(`${base}/cart/`)} data-qf-cart-link>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M5 8h14l-1.2 11.1a2 2 0 0 1-2 1.9H8.2a2 2 0 0 1-2-1.9Z M9 8V6.5a3 3 0 0 1 6 0V8" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" /></svg>
        <span class="qf-cart-word">Cart</span>
        <span class="qf-count" data-qf-count hidden>0</span><span class="sr-only" data-qf-count-sr>, empty</span>
      </a>
      <details class="qf-menu">
        <summary aria-label="Menu"><span></span><span></span></summary>
        <div class="qf-menu-panel">
          <a href={`${base}/`}>Home</a>
          {nav.map((n) => <a href={n.href} aria-current={here(n.href)}>{n.label}</a>)}
          <a href={`${base}/cart/`} aria-current={here(`${base}/cart/`)}>Cart</a>
        </div>
      </details>
    </div>
  </header>

  <main id="main"><slot /></main>

  <footer class="qf-foot">
    <div class="qf-wrap qf-foot-in">
      <div class="qf-foot-brand">
        <p class="qf-foot-name">Quillfern Candle Co.</p>
        <p>Six scents, poured by hand in small batches.</p>
        <p class="qf-foot-demo">Quillfern Candle Co. is a fictional business. This is a demonstration store built by{" "}
          <a href="/" target="_top">Nuxy Automation</a>: nothing here can be bought, no card is ever asked for, and the
          cart lives only in this browser.</p>
      </div>
      <div>
        <p class="qf-label">The studio</p>
        <p>{studio.street}, {studio.town} <span class="qf-foot-mute">(a made-up town)</span></p>
        <dl class="qf-hours">{studio.hours.map(([d, h]) => <div><dt>{d}</dt><dd>{h}</dd></div>)}</dl>
      </div>
      <div>
        <p class="qf-label">Shop</p>
        <ul role="list" class="qf-foot-links">
          <li><a href={`${base}/shop/`}>All candles</a></li>
          <li><a href={`${base}/shop/#scents`}>Find your scent</a></li>
          <li><a href={`${base}/cart/`}>Cart</a></li>
          <li><a href="#call" data-demo-action={callNote}>{phone}</a></li>
          <li><a href="#email" data-demo-action={emailNote}>{email}</a></li>
        </ul>
      </div>
    </div>
  </footer>
</DemoSite>

<style is:global>
  @font-face { font-family: "Fraunces"; src: url("/fonts/fraunces-var.woff2") format("woff2"); font-weight: 100 900; font-display: swap; }
  body.qf {
    --qf-night: #1d1611; --qf-umber: #2d221c; --qf-umber-2: #3d2f26; --qf-wax: #f5ecdd; --qf-paper: #fbf6ee; --qf-cream: #fffcf6;
    --qf-amber: #e8a03a; --qf-amber-2: #f4bf6a; --qf-ember: #a8461f; --qf-ember-2: #8c3816; --qf-fern: #4f6a4a; --qf-fern-soft: #e3e9dc;
    --qf-ink: #2a1f19; --qf-soft: #5e5047; --qf-mute: #6e6158; --qf-line: #e2d5c1; --qf-line-2: #cdbca3;
    --qf-ui: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    --qf-ease: cubic-bezier(0.22, 0.7, 0.2, 1);
    --qf-logo-on: var(--qf-wax);
    --dc-bg: var(--qf-cream); --dc-ink: var(--qf-ink); --dc-soft: var(--qf-soft); --dc-line: var(--qf-line); --dc-accent: var(--qf-umber); --dc-on-accent: var(--qf-wax); --dc-panel: var(--qf-wax); --dc-radius: 6px; --dc-btn-radius: 4px;
    background: var(--qf-paper); color: var(--qf-ink); font-family: "Fraunces", Georgia, "Times New Roman", serif; font-size: 1.0625rem; line-height: 1.6;
    font-variation-settings: "SOFT" 50, "WONK" 0;
  }
  :where(.qf) :is(h1, h2, h3) { font-weight: 560; letter-spacing: -0.02em; line-height: 1.06; color: var(--qf-umber); text-wrap: balance; font-variation-settings: "SOFT" 100, "WONK" 1; }
  :where(.qf) h1 { font-size: clamp(2.6rem, 1.5rem + 4.6vw, 5.4rem); font-weight: 480; letter-spacing: -0.035em; }
  :where(.qf) h2 { font-size: clamp(2rem, 1.35rem + 2.6vw, 3.4rem); font-weight: 500; }
  :where(.qf) h3 { font-size: 1.375rem; letter-spacing: -0.01em; }
  :where(.qf) p { text-wrap: pretty; }
  :where(.qf) a { color: inherit; }
  :where(.qf) :focus-visible { outline: 3px solid #2563eb; outline-offset: 3px; }
  .qf-ui { font-family: var(--qf-ui); }
  /* no double-tap zoom wait on anything that is pressed */
  :where(.qf) :is(a, button, label, input, select, summary) { touch-action: manipulation; }
  .qf-num { font-family: var(--qf-ui); font-variant-numeric: tabular-nums; }
  .qf-wrap { width: min(1240px, 100% - 48px); margin-inline: auto; }
  @media (max-width: 479px) { .qf-wrap { width: calc(100% - 32px); } }
  .qf-section { padding-block: clamp(64px, 9vw, 128px); }
  .qf-label { font-family: var(--qf-ui); font-size: 0.8125rem; font-weight: 650; letter-spacing: 0.14em; text-transform: uppercase; color: var(--qf-ember); }
  .qf-lead { font-size: clamp(1.125rem, 1rem + 0.45vw, 1.3125rem); color: var(--qf-soft); max-width: 52ch; }
  .qf-head { display: grid; gap: 14px; margin-bottom: clamp(32px, 5vw, 56px); max-width: 720px; }
  .qf-fine { font-family: var(--qf-ui); font-size: 0.875rem; color: var(--qf-mute); }
  .qf-demo-note { display: inline-flex; align-items: flex-start; gap: 8px; justify-self: start; padding: 6px 12px; border: 1px dashed var(--qf-line-2); border-radius: 4px; font-family: var(--qf-ui); font-size: 0.8125rem; font-weight: 550; color: var(--qf-soft); }
  .qf-demo-note::before { content: ""; flex: none; width: 6px; height: 6px; margin-top: 0.5em; margin-top: calc((1lh - 6px) / 2); border-radius: 50%; background: var(--qf-amber); }
  /* the arch: every product frame has the label's rounded top */
  .qf-arch { border-radius: 999px 999px 6px 6px / 46% 46% 6px 6px; overflow: hidden; }

  .qf-btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 52px; padding: 0 26px; border: 0; border-radius: 4px; background: var(--qf-umber); color: var(--qf-wax); font-family: var(--qf-ui); font-size: 1rem; font-weight: 650; letter-spacing: 0.01em; text-decoration: none; white-space: nowrap; cursor: pointer; transition: background-color 200ms var(--qf-ease), transform 200ms var(--qf-ease), box-shadow 200ms var(--qf-ease); }
  .qf-btn:hover { background: var(--qf-umber-2); transform: translateY(-1px); box-shadow: 0 10px 24px rgba(45, 34, 28, 0.22); }
  .qf-btn:active { transform: scale(0.98); }
  .qf-btn:disabled { opacity: 0.5; cursor: not-allowed; transform: none; box-shadow: none; }
  .qf-btn-flame { background: var(--qf-amber); color: var(--qf-night); }
  .qf-btn-flame:hover { background: var(--qf-amber-2); box-shadow: 0 10px 28px rgba(232, 160, 58, 0.3); }
  .qf-btn-line { background: transparent; color: var(--qf-umber); box-shadow: inset 0 0 0 1.5px var(--qf-line-2); }
  .qf-btn-line:hover { background: var(--qf-cream); box-shadow: inset 0 0 0 1.5px var(--qf-umber); }
  .qf-btn-sm { min-height: 44px; padding: 0 16px; font-size: 0.9375rem; }
  .qf-link { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; font-family: var(--qf-ui); font-weight: 650; color: var(--qf-ember); text-decoration: underline; text-decoration-thickness: 1.5px; text-underline-offset: 5px; }
  .qf-link span { transition: transform 200ms var(--qf-ease); }
  .qf-link:hover span { transform: translateX(4px); }

  /* header */
  .qf-top { position: sticky; top: 0; z-index: 30; background: color-mix(in srgb, var(--qf-paper) 96%, transparent); border-bottom: 1px solid var(--qf-line); color: var(--qf-umber); view-transition-name: qf-top; }
  .qf-top.is-dark { background: color-mix(in srgb, var(--qf-night) 96%, transparent); border-bottom-color: rgba(245, 236, 221, 0.12); color: var(--qf-wax); --qf-logo-on: var(--qf-night); }
  .qf-top-in { display: flex; align-items: center; gap: 28px; min-height: 72px; }
  .qf-logo { display: flex; align-items: center; gap: 10px; margin-right: auto; text-decoration: none; color: inherit; }
  .qf-wordmark { display: grid; font-size: 1.5rem; font-weight: 520; line-height: 0.95; letter-spacing: -0.02em; font-variation-settings: "SOFT" 100, "WONK" 1; }
  .qf-wordmark small { font-family: var(--qf-ui); font-size: 0.6875rem; font-weight: 650; letter-spacing: 0.2em; text-transform: uppercase; opacity: 0.75; margin-top: 4px; }
  .qf-nav { display: flex; gap: 2px; }
  .qf-nav a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 14px; font-family: var(--qf-ui); font-size: 0.9375rem; font-weight: 550; text-decoration: none; opacity: 0.82; border-bottom: 1.5px solid transparent; transition: opacity 160ms ease-out, border-color 160ms ease-out; }
  .qf-nav a:hover { opacity: 1; border-bottom-color: currentColor; }
  .qf-nav a[aria-current="page"] { opacity: 1; border-bottom-color: var(--qf-amber); }
  .qf-cart-link { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 14px; border-radius: 4px; box-shadow: inset 0 0 0 1.5px currentColor; font-family: var(--qf-ui); font-weight: 650; font-size: 0.9375rem; text-decoration: none; transition: background-color 160ms ease-out; }
  .qf-cart-link:hover { background: rgba(232, 160, 58, 0.14); }
  .qf-count { display: inline-grid; place-items: center; min-width: 24px; height: 24px; padding: 0 6px; border-radius: 12px; background: var(--qf-amber); color: var(--qf-night); font-size: 0.8125rem; font-weight: 750; font-variant-numeric: tabular-nums; }
  .qf-count.bump { animation: qf-bump 360ms var(--qf-ease); }
  @keyframes qf-bump { 40% { transform: scale(1.3); } }
  .qf-menu { display: none; position: relative; }
  .qf-menu summary { display: grid; place-content: center; gap: 6px; width: 48px; height: 48px; border-radius: 4px; box-shadow: inset 0 0 0 1.5px currentColor; list-style: none; cursor: pointer; }
  .qf-menu summary::-webkit-details-marker { display: none; }
  .qf-menu summary span { display: block; width: 18px; height: 1.5px; background: currentColor; transition: transform 200ms var(--qf-ease); }
  .qf-menu[open] summary span:nth-child(1) { transform: translateY(3.75px) rotate(45deg); }
  .qf-menu[open] summary span:nth-child(2) { transform: translateY(-3.75px) rotate(-45deg); }
  .qf-menu-panel { position: absolute; right: 0; top: calc(100% + 12px); display: grid; width: min(280px, calc(100vw - 32px)); padding: 8px; border-radius: 6px; background: var(--qf-cream); color: var(--qf-umber); box-shadow: 0 0 0 1px var(--qf-line), 0 24px 48px rgba(29, 22, 17, 0.2); }
  .qf-menu-panel a { display: flex; align-items: center; min-height: 48px; padding: 0 14px; border-radius: 4px; font-family: var(--qf-ui); font-weight: 600; text-decoration: none; }
  .qf-menu-panel a:hover, .qf-menu-panel a[aria-current="page"] { background: var(--qf-wax); }
  @media (max-width: 899px) { .qf-nav { display: none; } .qf-menu { display: block; } .qf-top-in { gap: 10px; } }
  @media (max-width: 379px) { .qf-cart-word { display: none; } .qf-wordmark { font-size: 1.3125rem; } }

  /* footer */
  .qf-foot { background: var(--qf-night); color: #d9ccb8; padding: 72px 0 96px; }
  .qf-foot-in { display: grid; gap: 40px; grid-template-columns: 1.4fr 1fr 1fr; }
  @media (max-width: 767px) { .qf-foot-in { grid-template-columns: 1fr; } }
  .qf-foot-brand { display: grid; gap: 10px; align-content: start; }
  .qf-foot-name { font-size: 1.75rem; font-weight: 500; letter-spacing: -0.02em; color: var(--qf-wax); font-variation-settings: "SOFT" 100, "WONK" 1; }
  .qf-foot-demo { margin-top: 10px; padding: 14px 16px; border: 1px solid rgba(245, 236, 221, 0.16); border-radius: 6px; font-family: var(--qf-ui); font-size: 0.9375rem; line-height: 1.55; }
  .qf-foot a { color: var(--qf-wax); }
  .qf-foot .qf-label { color: var(--qf-amber-2); margin-bottom: 12px; }
  .qf-foot-mute { color: #a8998a; }
  .qf-hours { margin-top: 10px; }
  .qf-hours div { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding: 8px 0; border-bottom: 1px solid rgba(245, 236, 221, 0.12); font-family: var(--qf-ui); font-size: 0.9375rem; }
  .qf-hours dd { color: var(--qf-wax); }
  .qf-foot-links { display: grid; }
  .qf-foot-links a { display: inline-flex; align-items: center; min-height: 44px; font-family: var(--qf-ui); text-decoration: none; }
  .qf-foot-links a:hover { text-decoration: underline; text-underline-offset: 4px; }

  /* fields */
  .qf-fields { display: grid; gap: 16px; }
  @media (min-width: 620px) { .qf-fields.two { grid-template-columns: 1fr 1fr; } .qf-field-wide { grid-column: 1 / -1; } }
  .qf-field { display: grid; gap: 7px; font-family: var(--qf-ui); font-weight: 600; font-size: 0.9375rem; color: var(--qf-umber); }
  .qf-field :is(input, select, textarea) { width: 100%; min-height: 50px; padding: 12px 14px; border: 1.5px solid var(--qf-line-2); border-radius: 4px; background: var(--qf-cream); color: var(--qf-ink); font: inherit; font-weight: 450; transition: border-color 160ms ease-out, box-shadow 160ms ease-out; }
  .qf-field textarea { resize: vertical; min-height: 96px; }
  .qf-field :is(input, select, textarea):focus { outline: none; border-color: var(--qf-umber); box-shadow: 0 0 0 4px rgba(232, 160, 58, 0.3); }
  .qf-field :is(input, select, textarea)[aria-invalid="true"] { border-color: #b3261e; box-shadow: 0 0 0 4px rgba(179, 38, 30, 0.14); }
  .qf-field small { font-weight: 450; color: var(--qf-mute); }
  .qf-err { font-family: var(--qf-ui); color: #a3271d; font-weight: 650; }
  .qf-err:empty { display: none; }
  /* choice tiles: a hidden radio and its box */
  .qf-pick { position: relative; display: block; cursor: pointer; }
  .qf-pick input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: pointer; }
  .qf-pick > span { display: grid; gap: 2px; align-content: center; min-height: 52px; height: 100%; padding: 10px 14px; border-radius: 4px; background: var(--qf-cream); box-shadow: inset 0 0 0 1.5px var(--qf-line-2); font-family: var(--qf-ui); font-weight: 650; color: var(--qf-ink); transition: box-shadow 160ms ease-out, background-color 160ms ease-out, transform 160ms var(--qf-ease); }
  .qf-pick > span small { font-weight: 450; font-size: 0.8125rem; color: var(--qf-mute); }
  .qf-pick:hover > span { box-shadow: inset 0 0 0 1.5px var(--qf-umber); }
  .qf-pick input:checked + span { background: var(--qf-wax); box-shadow: inset 0 0 0 2px var(--qf-umber); }
  .qf-pick input:active + span { transform: scale(0.98); }
  .qf-pick input:focus-visible + span { outline: 3px solid #2563eb; outline-offset: 3px; }
  .qf-pick input:disabled + span { background: transparent; box-shadow: none; outline: 1.5px dashed var(--qf-line-2); outline-offset: -1.5px; color: #84776d; cursor: not-allowed; }
  .qf-pick input:disabled { cursor: not-allowed; }

  /* quantity: − 2 + */
  /* cart and checkout: the summary card, the totals list and the empty state */
  :where(.qf) .qf-sum { display: grid; gap: 16px; padding: clamp(20px, 3vw, 28px); border-radius: 6px; background: var(--qf-cream); box-shadow: 0 0 0 1px var(--qf-line); }
  :where(.qf) .qf-sum-h { font-size: 1.5rem; }
  :where(.qf) .qf-totals { display: grid; margin: 0; }
  :where(.qf) .qf-totals div { display: flex; justify-content: space-between; gap: 12px; padding: 8px 0; font-size: 0.9375rem; color: var(--qf-soft); }
  :where(.qf) .qf-totals div[hidden] { display: none; }
  :where(.qf) .qf-totals dd { margin: 0; color: var(--qf-ink); }
  :where(.qf) .qf-totals .qf-total { margin-top: 4px; padding-top: 13px; border-top: 1px solid var(--qf-line-2); font-size: 1.125rem; font-weight: 700; color: var(--qf-umber); }
  :where(.qf) .qf-totals .qf-total dd { color: var(--qf-umber); }
  :where(.qf) .qf-cart-empty { display: grid; justify-items: center; gap: 14px; max-width: 460px; margin: 24px auto 40px; text-align: center; }
  :where(.qf) .qf-cart-empty[hidden] { display: none; }
  :where(.qf) .qf-cart-empty p { color: var(--qf-soft); }
  .qf-qty { display: inline-grid; grid-template-columns: 44px 44px 44px; align-items: center; border-radius: 4px; box-shadow: inset 0 0 0 1.5px var(--qf-line-2); background: var(--qf-cream); font-family: var(--qf-ui); }
  .qf-qty button { display: grid; place-items: center; width: 44px; height: 44px; border: 0; background: none; color: var(--qf-umber); font-size: 1.25rem; cursor: pointer; border-radius: 4px; }
  .qf-qty button:hover:not(:disabled) { background: var(--qf-wax); }
  .qf-qty button:disabled { color: #b7a998; cursor: not-allowed; }
  .qf-qty output, .qf-qty input { width: 44px; text-align: center; font-weight: 700; font-variant-numeric: tabular-nums; }

  .qf-stock { display: inline-flex; align-items: center; gap: 7px; font-family: var(--qf-ui); font-size: 0.875rem; font-weight: 600; color: var(--qf-fern); }
  .qf-stock::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: currentColor; }
  .qf-stock.low { color: var(--qf-ember); }
  .qf-stock.out { color: var(--qf-mute); }

  /* reveal on scroll (tiers 1-2; tier 3 and no JavaScript show everything) */
  :root[data-tier="1"] .qf-rise, :root[data-tier="2"] .qf-rise { opacity: 0; transform: translateY(16px); transition: opacity 400ms var(--qf-ease), transform 400ms var(--qf-ease); transition-delay: var(--d, 0ms); }
  :root[data-tier="1"] .qf-rise.in, :root[data-tier="2"] .qf-rise.in { opacity: 1; transform: none; }
  @media (max-width: 899px) { .qf .demo-toast { bottom: 24px; } }
</style>

<script>
  import { onCart } from "../../../lib/demo/quillfern-store";
  import { totals } from "../../../lib/demo/quillfern-cart";

  const count = document.querySelector<HTMLElement>("[data-qf-count]");
  const sr = document.querySelector<HTMLElement>("[data-qf-count-sr]");
  let last = -1;
  onCart((c) => {
    const n = totals(c).count;
    if (count) {
      count.textContent = String(n);
      count.hidden = n === 0;
      if (last >= 0 && n > last) { count.classList.remove("bump"); void count.offsetWidth; count.classList.add("bump"); }
    }
    if (sr) sr.textContent = n === 0 ? ", empty" : `, ${n} item${n === 1 ? "" : "s"}`;
    last = n;
  });

  const els = [...document.querySelectorAll<HTMLElement>(".qf-rise")];
  if ("IntersectionObserver" in window) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); }
    }, { rootMargin: "0px 0px -8% 0px" });
    const above = els.map((el) => el.getBoundingClientRect().top < innerHeight); // read all, then write
    els.forEach((el, i) => { if (above[i]) el.classList.add("in"); else io.observe(el); });
  } else els.forEach((el) => el.classList.add("in"));
  const menu = document.querySelector<HTMLDetailsElement>(".qf-menu");
  menu?.addEventListener("click", (e) => { if ((e.target as Element).closest("a")) menu.open = false; });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && menu?.open) { menu.open = false; menu.querySelector("summary")?.focus(); } });
</script>
