---
// One of the example websites (data/demo-sites.ts) shown on a computer with a phone in front, from the thumbnails in
// public/images/examples/. Used in the hero of the homepage, /websites/, /get-a-website/ and /ecommerce/, and for each example on /portfolio/. The caption says the business is made up.
import Icon from "./Icon.astro";
import { demoSiteBySlug, shotSrcset } from "../data/demo-sites";

interface Props {
  slug: string;
  /** further down a page (the portfolio): load when near, not first */
  lazy?: boolean;
}
const { slug, lazy = false } = Astro.props;
const load = lazy ? { loading: "lazy" as const } : { fetchpriority: "high" as const };
const demo = demoSiteBySlug[slug];
const what = demo.project === "E-commerce store" ? "store" : "website";
// How wide each picture is drawn (measured on /websites/ and /get-a-website/): the computer 246px at 320 wide, 316 at
// 390, 641 at 768, 414 at 1024, 490 at 1440; the phone in front 90 to 96px on phones, 174 at 768, 115 to 140 on desktops.
const deskSizes = "(min-width: 1200px) 490px, (min-width: 1024px) 41vw, (min-width: 720px) 84vw, calc(100vw - 74px)";
const phoneSizes = "(min-width: 1024px) 140px, (min-width: 720px) 175px, 96px";
---
<figure class="shot" aria-label={`Example ${what} for a made-up ${demo.kind.toLowerCase()}, on a computer and a phone`}>
  <span class="frame desk">
    <span class="frame-bar" aria-hidden="true"><i></i><i></i><i></i></span>
    <img src={`/images/examples/${slug}-desktop.webp`} srcset={shotSrcset(slug, "desktop")} sizes={deskSizes} alt="" width="800" height="500" decoding="async" {...load} />
  </span>
  <span class="frame phone">
    <img src={`/images/examples/${slug}-phone.webp`} srcset={shotSrcset(slug, "phone")} sizes={phoneSizes} alt="" width="390" height="780" decoding="async" loading={lazy ? "lazy" : undefined} />
  </span>
  <figcaption><Icon name="info" />Example {what} for a made-up business</figcaption>
</figure>

<style>
  .shot { position: relative; margin: 0; padding-right: clamp(40px, 9%, 88px); padding-bottom: 28px; }
  .frame { display: block; border: 1px solid var(--hairline-strong); background: var(--surface-strong); overflow: hidden; box-shadow: var(--shadow); }
  .frame img { display: block; width: 100%; height: auto; }
  .desk { border-radius: 12px; }
  .frame-bar { display: flex; gap: 6px; padding: 9px 12px; border-bottom: 1px solid var(--hairline); background: var(--panel); }
  .frame-bar i { width: 8px; height: 8px; border-radius: 50%; background: var(--hairline-strong); }
  .phone { position: absolute; right: 0; bottom: 0; width: clamp(96px, 27%, 180px); border-radius: 18px; border-width: 3px; border-color: var(--hairline); }
  /* kept clear of the phone, which overlaps the bottom-right corner (on a small screen it would cover the words) */
  figcaption { display: inline-flex; align-items: flex-start; gap: 6px; max-width: 70%; margin-top: 14px; color: var(--muted); font-size: 0.8125rem; }
  figcaption :global(.icon) { flex: none; margin-top: 0.2em; }
</style>
