---
import { titleCase } from "../../lib/title-case";
// The Immersive scroll metaphor: one small web page drawn four ways, flat → layers → depth → immersive, beside four
// short steps that say which level each one is. On a wide screen with motion on, the drawing stays in view while the
// steps scroll past and moves to each step's state as it reaches the middle of the screen. The page scrolls
// normally the whole time: nothing is pinned to the wheel and the scrollbar is never taken away.
// On phones, with motion reduced, or without JavaScript, each step shows its own still drawing instead. The drawing
// is decoration (aria-hidden); the steps' words carry the meaning. Transform and opacity only (DESIGN.md "Motion").
const steps = [
  { state: "flat", name: "Flat", level: "Business", text: "Everything a customer needs, in a clear order, on one calm surface. Fast to load and easy to use." },
  { state: "layers", name: "Layers", level: "Signature", text: "Images, words and buttons sit on their own layers and move a little as you scroll, so the page feels made, not assembled." },
  { state: "depth", name: "Depth", level: "Immersive", text: "Perspective brings the product forward. Real-time 3D appears where it helps the story, never as decoration." },
  { state: "immersive", name: "Immersive", level: "Immersive and Flagship", text: "The page becomes a scene to explore: the product in the middle, with the information around it as you move." },
];
// the drawing's parts and how far each one lifts off the page (0 = the page itself)
const planes: [string, number][] = [["bg", 0], ["nav", 1], ["h1", 3], ["h2", 2], ["btn", 4], ["img", 2], ["c1", 1], ["c2", 2], ["c3", 1], ["obj", 6]];
---
<div class="ds" data-ds>
  <div class="ds-stage" aria-hidden="true">
    <div class="ds-box">
      <div class="ds-scene" data-state="flat" data-ds-scene>
        {planes.map(([p, d]) => <span class:list={["ds-pl", `ds-${p}`]} style={`--d:${d}`}></span>)}
      </div>
    </div>
  </div>
  <ol class="ds-steps" role="list">
    {steps.map((s, i) => (
      <li class="ds-step" data-ds-step={s.state}>
        <div class="ds-mini" aria-hidden="true">
          <div class="ds-scene" data-state={s.state}>
            {planes.map(([p, d]) => <span class:list={["ds-pl", `ds-${p}`]} style={`--d:${d}`}></span>)}
          </div>
        </div>
        <p class="ds-num">{String(i + 1).padStart(2, "0")} · {s.level}</p>
        <h4>{titleCase(s.name)}</h4>
        <p>{s.text}</p>
      </li>
    ))}
  </ol>
</div>

<style>
  .ds { display: grid; gap: 32px; }
  .ds-stage { display: none; }
  .ds-steps { list-style: none; display: grid; gap: 40px; }
  .ds-step { display: grid; gap: 8px; max-width: 460px; }
  .ds-num { color: var(--cyan); font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; }
  .ds-step h4 { font-size: 1.5rem; }
  .ds-step p:last-child { color: var(--body); }
  .ds-mini { --w: min(100%, 300px); margin-bottom: 14px; padding: 28px 0; display: grid; place-items: center; border: 1px solid var(--hairline-soft); border-radius: var(--r-lg); background: var(--bg-2); overflow: hidden; }

  /* Wide screen, script running, motion on: the drawing stays beside the steps */
  @media (min-width: 1024px) {
    :global(html[data-motion]:not([data-motion="reduced"])) .ds.on { grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: 56px; }
    :global(html[data-motion]:not([data-motion="reduced"])) .ds.on .ds-stage { display: block; }
    :global(html[data-motion]:not([data-motion="reduced"])) .ds.on .ds-mini { display: none; }
    :global(html[data-motion]:not([data-motion="reduced"])) .ds.on .ds-step { min-height: 62vh; align-content: center; opacity: 0.7; transition: opacity var(--dur-3, 380ms) ease; }
    :global(html[data-motion]:not([data-motion="reduced"])) .ds.on .ds-step.now { opacity: 1; }
    :global(html[data-motion]:not([data-motion="reduced"])) .ds.on .ds-steps { gap: 0; padding-block: 8vh; }
  }
  .ds-stage { position: sticky; top: calc(50vh - 190px); align-self: start; }
  .ds-box { --w: 440px; display: grid; place-items: center; height: 380px; border: 1px solid var(--hairline-soft); border-radius: var(--r-lg); background: var(--bg-2); overflow: hidden; }

  /* The drawing: a small page of plain shapes */
  .ds-scene { position: relative; width: var(--w); aspect-ratio: 3 / 2; transform-style: preserve-3d; transition: transform 800ms var(--ease-out, ease); }
  .ds-pl { position: absolute; border-radius: 4px; background: var(--surface-strong); transform-style: preserve-3d; transition: transform 800ms var(--ease-out, ease); }
  .ds-pl::before { content: ""; position: absolute; inset: 0; border-radius: inherit; opacity: 0; transition: opacity 500ms ease; }
  .ds-bg { inset: 0; border-radius: 8px; background: var(--panel); border: 1px solid var(--hairline); }
  .ds-nav { top: 6%; left: 6%; width: 88%; height: 6%; }
  .ds-h1 { top: 20%; left: 6%; width: 44%; height: 10%; }
  .ds-h2 { top: 34%; left: 6%; width: 32%; height: 5%; }
  .ds-btn { top: 45%; left: 6%; width: 18%; height: 9%; border-radius: 99px; }
  .ds-img { top: 18%; left: 56%; width: 38%; height: 46%; }
  .ds-c1 { top: 72%; left: 6%; width: 26%; height: 20%; }
  .ds-c2 { top: 72%; left: 36%; width: 26%; height: 20%; }
  .ds-c3 { top: 72%; left: 66%; width: 28%; height: 20%; }
  .ds-obj { top: 14%; left: 61%; width: 28%; aspect-ratio: 1; border-radius: 50%; background: none; opacity: 0; transition: transform 800ms var(--ease-out, ease), opacity 500ms ease; }
  /* the object is a speaker seen from the front: a rim, a cone and a dust cap (flat rings, no glow) */
  .ds-obj::before { opacity: 1; border-radius: 50%; background: radial-gradient(circle, #cbd5e1 0 13%, #334155 14% 18%, #1e293b 19% 52%, #475569 53% 57%, #0f172a 58% 92%, var(--placeholder) 93% 100%); }

  /* colour arrives from the second state on */
  .ds-h1::before { background: var(--ink); }
  .ds-h2::before { background: var(--muted); }
  .ds-btn::before { background: var(--button); }
  .ds-img::before { background: linear-gradient(160deg, #1e3a5f, #0f1d33 70%); }
  .ds-nav::before, .ds-c1::before, .ds-c2::before, .ds-c3::before { background: #22324f; }
  .ds-scene:not([data-state="flat"]) .ds-pl::before { opacity: 1; }

  /* layers: each part lifts up and to the left by how far off the page it is, over a hard offset edge */
  .ds-scene[data-state="layers"] .ds-pl:not(.ds-bg) { transform: translate(calc(var(--d) * -2px), calc(var(--d) * -3px)); }
  .ds-pl:not(.ds-bg, .ds-obj)::after { content: ""; position: absolute; inset: 0; z-index: -1; border-radius: inherit; background: #070d18; transform: translate(4px, 5px); opacity: 0; transition: opacity 500ms ease; }
  .ds-scene:not([data-state="flat"]) .ds-pl::after { opacity: 0.8; }

  /* depth: the page tips back and the parts stand off it */
  .ds-scene[data-state="depth"] { transform: rotateX(30deg) rotateZ(-10deg); }
  .ds-scene[data-state="depth"] .ds-pl:not(.ds-bg) { transform: translateZ(calc(var(--d) * 9px)); }
  .ds-scene[data-state="depth"] .ds-obj { opacity: 1; transform: translateZ(40px) rotateX(-30deg); }

  /* immersive: further round, the parts spread out and the product comes up into the scene */
  .ds-scene[data-state="immersive"] { transform: rotateX(52deg) rotateZ(-26deg) scale(0.86); }
  .ds-scene[data-state="immersive"] .ds-pl:not(.ds-bg) { transform: translateZ(calc(var(--d) * 16px)); }
  .ds-scene[data-state="immersive"] .ds-obj { opacity: 1; transform: translateZ(120px) rotateX(-52deg) scale(1.25); }
  .ds-scene[data-state="immersive"] .ds-img { transform: translateZ(28px); }

  .ds-box, .ds-mini { perspective: 1100px; }
  /* the still drawings never animate */
  .ds-mini .ds-scene, .ds-mini .ds-pl, .ds-mini .ds-pl::before, .ds-mini .ds-pl::after { transition: none; }
  @media (prefers-reduced-motion: reduce) { .ds-scene, .ds-pl, .ds-pl::before, .ds-pl::after, .ds-step { transition: none !important; } }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-ds]")) {
    const scene = root.querySelector<HTMLElement>("[data-ds-scene]")!;
    const steps = [...root.querySelectorAll<HTMLElement>("[data-ds-step]")];
    // a step is "now" while it crosses a thin band across the middle of the screen
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        const el = e.target as HTMLElement;
        steps.forEach((s) => s.classList.toggle("now", s === el));
        scene.dataset.state = el.dataset.dsStep!;
      }
    }, { rootMargin: "-45% 0px -45% 0px" });
    steps.forEach((s) => io.observe(s));
    steps[0].classList.add("now");
    root.classList.add("on");
  }
</script>
