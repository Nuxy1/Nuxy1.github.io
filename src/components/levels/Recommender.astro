---
// "Find your website level": five questions, one at a time, then a suggested level with the reason and a
// "Discuss My Project" button that opens the form with that level chosen. The rules are data/level-finder.ts
// (also run by tests/levels.test.mjs); this script imports that file only, never the service catalogue.
// It never turns anyone away: every answer set ends in a level and a way to start. Nothing is sent anywhere; the
// counts are `website_recommender_started` (first answer) and `website_recommender_completed` (a result shown),
// name and page only. Without JavaScript the questions are not shown; a short guide and a button stand in.
import Icon from "../Icon.astro";
import { questions, levels } from "../../data/tiers";
const pages = Object.fromEntries(levels.map((l) => [l.id, { page: l.page ?? "/web-design/#levels", href: l.href, price: l.price, name: l.name }]));
---
<div class="rec panel" data-rec data-levels={JSON.stringify(pages)}>
  <div class="rec-static" data-rec-static>
    <p><strong>Not sure where you fit?</strong> Most local businesses that want calls and bookings do best with Business. If you need to stand out, look at Signature. If the first impression is the whole pitch, Immersive. Tell us about your project and we’ll suggest the level that fits, honestly, even if it’s the smaller one.</p>
    <a class="button" href="/contact/?level=unsure" data-track="tier_selected">Discuss My Project</a>
  </div>

  <form class="rec-quiz" data-rec-quiz hidden>
    <div class="rec-top">
      <p class="rec-count" data-rec-count aria-live="polite">Question 1 of {questions.length}</p>
      <span class="rec-progress" aria-hidden="true"><i data-rec-bar></i></span>
    </div>
    {questions.map((q, i) => (
      <fieldset class="rec-q" data-rec-q={q.id} hidden={i > 0}>
        <legend>{q.text}</legend>
        <div class="rec-answers">
          {q.answers.map((a) => (
            <label class="rec-a">
              <input type="radio" name={q.id} value={a.id} />
              <span>{a.text}</span>
            </label>
          ))}
        </div>
      </fieldset>
    ))}
    <div class="rec-nav">
      <button class="button secondary small" type="button" data-rec-back disabled><Icon name="caretLeft" />Back</button>
      <button class="button small" type="submit" data-rec-next disabled><span data-rec-next-label>Next</span><Icon name="caretRight" /></button>
    </div>
  </form>

  <div class="rec-result" data-rec-result hidden tabindex="-1">
    <p class="eyebrow">Our suggestion</p>
    <h3 data-rec-name></h3>
    <p class="rec-price" data-rec-price></p>
    <p class="rec-reason" data-rec-reason></p>
    <p class="rec-extra">We confirm the right level with you in writing before anything starts. Every level can add automation.</p>
    <div class="rec-actions">
      <a class="button" href="/contact/?level=unsure" data-rec-cta data-track="tier_selected">Discuss My Project</a>
      <a class="text-link" href="/web-design/" data-rec-page>See what it includes<Icon name="arrowRight" /></a>
      <button class="text-link rec-again" type="button" data-rec-again><Icon name="arrowCounterClockwise" />Start again</button>
    </div>
  </div>
</div>

<style>
  .rec { padding: clamp(20px, 4vw, 36px); max-width: 760px; }
  .rec-static { display: grid; gap: 18px; justify-items: start; }
  .rec-top { display: grid; gap: 8px; margin-bottom: 18px; }
  .rec-count { color: var(--muted); font-size: 0.875rem; font-weight: 600; }
  .rec-progress { display: block; height: 4px; border-radius: 2px; background: var(--hairline); overflow: hidden; }
  .rec-progress i { display: block; height: 100%; width: 100%; background: var(--link); transform-origin: left; transform: scaleX(0.2); transition: transform var(--dur-2, 240ms) var(--ease-out, ease); }
  .rec-q { margin: 0; padding: 0; border: 0; min-width: 0; }
  .rec-q legend { padding: 0; margin-bottom: 14px; color: var(--ink); font-size: 1.25rem; font-weight: 650; letter-spacing: -0.02em; }
  .rec-answers { display: grid; gap: 8px; }
  .rec-a { position: relative; display: flex; align-items: center; gap: 12px; min-height: 52px; padding: 12px 16px; border: 1px solid var(--hairline); border-radius: var(--r-md); background: var(--bg-2); color: var(--ink); cursor: pointer; transition: border-color 160ms ease, background-color 160ms ease; }
  .rec-a:hover { border-color: var(--hairline-strong); }
  .rec-a input { flex: none; width: 18px; height: 18px; margin: 0; accent-color: var(--button); }
  .rec-a:has(input:checked) { border-color: var(--link); background: var(--accent-soft); }
  .rec-a:has(input:focus-visible) { outline: 2px solid var(--focus); outline-offset: 2px; }
  .rec-nav { display: flex; justify-content: space-between; gap: 12px; margin-top: 16px; }
  .rec-nav [data-rec-back][disabled] { visibility: hidden; }
  .rec-nav [data-rec-next][disabled] { opacity: 0.45; cursor: default; }
  .rec-result { display: grid; gap: 10px; justify-items: start; outline: none; }
  .rec-result .eyebrow { margin: 0; }
  .rec-result h3 { font-size: 1.75rem; }
  .rec-price { color: var(--ink); font-weight: 600; }
  .rec-reason { max-width: 60ch; }
  .rec-extra { color: var(--muted); font-size: 0.9375rem; }
  .rec-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; margin-top: 8px; }
  .rec-again { padding: 0; border: 0; background: none; color: var(--link); cursor: pointer; min-height: 44px; }
  @media (prefers-reduced-motion: reduce) { .rec-progress i { transition: none; } }
</style>

<script>
  import { recommend } from "../../data/level-finder";
  type Info = { page: string; href: string; price: string; name: string };
  const track = (e: string) => (window as unknown as { nuxyTrack?: (e: string) => void }).nuxyTrack?.(e);

  for (const root of document.querySelectorAll<HTMLElement>("[data-rec]")) {
    const info = JSON.parse(root.dataset.levels!) as Record<string, Info>;
    const quiz = root.querySelector<HTMLFormElement>("[data-rec-quiz]")!;
    const steps = [...quiz.querySelectorAll<HTMLFieldSetElement>("[data-rec-q]")];
    const count = root.querySelector<HTMLElement>("[data-rec-count]")!;
    const bar = root.querySelector<HTMLElement>("[data-rec-bar]")!;
    const back = root.querySelector<HTMLButtonElement>("[data-rec-back]")!;
    const next = root.querySelector<HTMLButtonElement>("[data-rec-next]")!;
    const nextLabel = next.querySelector<HTMLElement>("[data-rec-next-label]")!;
    const result = root.querySelector<HTMLElement>("[data-rec-result]")!;
    const answers: Record<string, string> = {};
    let at = 0;
    let started = false;

    const go = (i: number, focus = true) => {
      at = i;
      steps.forEach((s, j) => (s.hidden = j !== i));
      count.textContent = `Question ${i + 1} of ${steps.length}`;
      bar.style.transform = `scaleX(${(i + 1) / steps.length})`;
      back.disabled = i === 0;
      next.disabled = !answers[steps[i].dataset.recQ!];
      nextLabel.textContent = i === steps.length - 1 ? "See my level" : "Next";
      if (focus) (steps[i].querySelector<HTMLInputElement>("input:checked") ?? steps[i].querySelector<HTMLInputElement>("input"))!.focus();
    };

    const advance = () => (at < steps.length - 1 ? go(at + 1) : finish());
    const finish = () => {
      const r = recommend(answers);
      const l = info[r.level];
      root.querySelector("[data-rec-name]")!.textContent = l.name;
      root.querySelector("[data-rec-price]")!.textContent = l.price;
      root.querySelector("[data-rec-reason]")!.textContent = r.reason;
      root.querySelector<HTMLAnchorElement>("[data-rec-cta]")!.href = l.href;
      const page = root.querySelector<HTMLAnchorElement>("[data-rec-page]")!;
      page.href = l.page;
      page.firstChild!.textContent = `See what ${l.name} includes`;
      quiz.hidden = true;
      result.hidden = false;
      result.focus();
      track("website_recommender_completed");
    };

    // A tap or click on an answer moves straight on. With a keyboard, arrow keys choose and Enter (or Next)
    // continues, so every answer can be read before moving on.
    let pointer = false;
    quiz.addEventListener("pointerdown", () => (pointer = true));
    quiz.addEventListener("keydown", () => (pointer = false));
    quiz.addEventListener("change", (e) => {
      const input = e.target as HTMLInputElement;
      answers[input.name] = input.value;
      next.disabled = false;
      if (!started) { started = true; track("website_recommender_started"); }
      if (pointer) { const from = at; setTimeout(() => at === from && !quiz.hidden && advance(), 160); }
    });
    quiz.addEventListener("submit", (e) => { e.preventDefault(); if (answers[steps[at].dataset.recQ!]) advance(); });
    back.addEventListener("click", () => go(Math.max(0, at - 1)));
    root.querySelector("[data-rec-again]")!.addEventListener("click", () => {
      for (const k of Object.keys(answers)) delete answers[k];
      quiz.reset();
      result.hidden = true;
      quiz.hidden = false;
      go(0);
    });

    root.querySelector<HTMLElement>("[data-rec-static]")!.hidden = true;
    quiz.hidden = false;
    go(0, false);
  }
</script>
