---
// The example websites and the example store (data/demo-sites.ts) as cards, each opening its desktop/phone viewer at
// /examples/<slug>/. Used on the homepage, /websites/, /ecommerce/ and /demos/. The note under the cards is part of the
// component on purpose: the cards never appear without saying they are made-up businesses.
import Icon from "./Icon.astro";
import { demoSites, shotSrcset } from "../data/demo-sites";

interface Props {
  level?: "h3" | "h4";
  /** show only these demos (by slug), in this order; all of them when left out */
  only?: string[];
}
const { level = "h3", only } = Astro.props;
const H = level;
const list = only ? only.map((slug) => demoSites.find((d) => d.slug === slug)!) : demoSites;
// Three cards sit in a row of three; any other number in rows of two, so no card is left alone on a row.
const cols = list.length % 3 === 0 ? 3 : 2;
const hasStore = list.some((d) => d.project === "E-commerce store");
// How wide a card's picture is drawn (.grid-2/.grid-3 and .wrap in Base.astro): one card per row, then two from
// 720px; in threes, three from 1024px. Grid of three measured: 286px at 320 wide, 356 at 390, 341 at 768, 299 at
// 1024, 358 at 1440. Grid of two: 550px from 1200 wide, half the screen less the gutters from 720.
const sizes = cols === 3
  ? "(min-width: 1200px) 360px, (min-width: 1024px) calc(33vw - 40px), (min-width: 720px) calc(46vw - 10px), calc(100vw - 34px)"
  : "(min-width: 1200px) 550px, (min-width: 720px) calc(50vw - 50px), calc(100vw - 34px)";
---
<ul class:list={["demo-grid", cols === 3 ? "grid-3" : "grid-2"]} role="list">
  {list.map((d) => (
    <li class="demo-site reveal">
      <span class="demo-shot">
        <img src={`/images/examples/${d.slug}-desktop.webp`} srcset={shotSrcset(d.slug, "desktop")} sizes={sizes} alt="" width="800" height="500" loading="lazy" decoding="async" />
      </span>
      <span class="demo-meta">
        <span class="demo-kind"><Icon name={d.icon} />{d.kind} · demonstration</span>
        <H class="demo-name"><a href={`/examples/${d.slug}/`} data-track="example_open">{d.name}</a></H>
        <span class="demo-project">{d.project}</span>
        <span class="demo-sum">{d.summary}</span>
        <span class="text-link" aria-hidden="true">View on desktop and phone<Icon name="arrowRight" /></span>
      </span>
    </li>
  ))}
</ul>
<p class="note demo-note"><Icon name="info" /><span>These are examples for made-up businesses, built to show the layout, features and finish we aim for. They are not clients.{hasStore && " The candle shop is a design example: you can fill its cart, but checkout is switched off, so nothing can be bought."} Your own site is built in your own account (Squarespace or Wix for a website, Shopify or Square Online for a store), so the details follow what that platform can do.</span></p>

<style>
  .demo-grid { list-style: none; margin: 0; padding: 0; }
  .demo-site { position: relative; display: flex; flex-direction: column; border: 1px solid var(--hairline); border-radius: var(--r-lg); background: var(--panel); overflow: hidden; transition: border-color 160ms ease-out, transform 220ms var(--ease); }
  .demo-site:hover { border-color: var(--hairline-strong); transform: translateY(-2px); }
  .demo-site:focus-within { border-color: var(--focus); }
  .demo-shot { display: block; aspect-ratio: 16 / 10; background: var(--surface-strong); border-bottom: 1px solid var(--hairline); overflow: hidden; }
  .demo-shot img { width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .demo-meta { display: flex; flex-direction: column; gap: 8px; padding: 20px; flex: 1; }
  .demo-kind { display: inline-flex; align-items: center; gap: 6px; color: var(--cyan); font-size: 0.8125rem; font-weight: 600; }
  .demo-name { font-size: 1.125rem; font-weight: 650; letter-spacing: -0.01em; }
  /* the whole card is the link's hit area; the heading link stays the one thing a screen reader announces */
  .demo-name a { color: var(--ink); text-decoration: none; }
  .demo-name a::after { content: ""; position: absolute; inset: 0; border-radius: inherit; }
  .demo-name a:focus-visible { outline: none; }
  .demo-name a:focus-visible::after { outline: 2px solid var(--focus); outline-offset: -2px; }
  .demo-project { margin-top: -4px; color: var(--muted); font-size: 0.875rem; font-weight: 600; }
  .demo-sum { color: var(--body); font-size: 0.9375rem; flex: 1; }
  .demo-site .text-link { margin-top: 6px; color: var(--link); }
  .demo-note { display: flex; align-items: flex-start; gap: 8px; margin-top: 20px; max-width: 80ch; }
  .demo-note :global(.icon) { flex: none; margin-top: 0.2em; width: 1.05em; height: 1.05em; }
  @media (prefers-reduced-motion: reduce) { .demo-site, .demo-site:hover { transition: none; transform: none; } }
</style>
