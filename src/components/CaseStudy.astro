---
// The card for one real client project (data/case-studies.ts), on the home page and /portfolio/, linking to its
// project page (/portfolio/<slug>/). It is shown only when `publishable()` passes (the client's written consent plus
// the four checks), or in the stage build for an entry that still waits on that approval (`isStaged`); then the card
// says so. It renders nothing otherwise, so a half-checked entry can't reach a page.
// The live link is shown only when the client agreed to a link as well (`liveLink`, checks.url). The card's category,
// summary and highlights come from `card`; without one it falls back to the project type, the problem and `built`.
import Icon from "./Icon.astro";
import CaseCover from "./CaseCover.astro";
import { isStaged, liveLink, publishable } from "../data/case-studies";
import type { CaseStudyData } from "../data/case-studies";

interface Props { study: CaseStudyData }
const { study: c } = Astro.props;
const ok = publishable(c);
const staged = !ok && Boolean(c) && isStaged(c);
const link = ok ? liveLink(c) : undefined;
const h = `case-${c?.slug}-h`;
const category = c?.card?.category ?? c?.projectType;
const summary = c?.card?.description ?? c?.problem;
const points = c?.card?.highlights ?? c?.built ?? [];
---
{(ok || staged) && (
  <article class="case cs" id={`case-${c.slug}`} aria-labelledby={h} data-staged={staged ? "" : undefined}>
    {/* the cover opens the project too, for a mouse or a tap; View Project is the one link keyboards and screen readers get */}
    <a class="cs-cover" href={`/portfolio/${c.slug}/`} tabindex="-1" aria-hidden="true" data-track="case_study_open_cover"><CaseCover study={c} /></a>
    <div class="cs-copy">
      <p class="cs-tags">
        <span class="cs-real"><Icon name="briefcase" />Real Client Website</span>
        <span class="cs-cat">{category}</span>
      </p>
      <h3 id={h} translate="no">{c.business}</h3>
      <p class="cs-meta">{c.industry}{c.location ? ` in ${c.location}` : ""}</p>
      <p class="cs-desc">{summary}</p>
      {points.length > 0 && <ul class="ticks cs-ticks" role="list">{points.map((p) => <li><Icon name="check" />{p}</li>)}</ul>}
      {staged && <p class="cs-staged"><Icon name="lockSimple" /><span><strong>Staged preview, not published.</strong> It goes live only once the client approves the pictures and details in writing.</span></p>}
      <div class="cs-actions">
        <a class="button" href={`/portfolio/${c.slug}/`} data-track="case_study_open">View Project<span class="sr-only">: {c.business}</span><Icon name="arrowRight" /></a>
        {link && <a class="button secondary" href={link} target="_blank" rel="noopener" data-track="case_study_live">Visit Live Website<span class="sr-only"> of {c.business} (opens in a new tab)</span><Icon name="arrowUpRight" /></a>}
      </div>
    </div>
  </article>
)}

<style>
  .cs {
    position: relative; display: grid; gap: clamp(24px, 4vw, 48px); align-items: center; scroll-margin-top: 16px;
    padding: clamp(20px, 4vw, 40px); border: 1px solid rgb(var(--blue-rgb) / 0.4); border-radius: var(--r-lg);
    background: linear-gradient(160deg, var(--accent-soft), transparent 55%), var(--panel);
    transition: border-color var(--dur-1) ease;
  }
  /* no shadow, glow or lift (DESIGN.md keeps the glow for a hovered filled button, and only the cover and the button
     are links): the border brightens instead */
  .cs:hover, .cs:focus-within { border-color: var(--blue-line); }
  .cs-cover { display: block; color: inherit; }
  @media (min-width: 960px) { .cs { grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); } }

  .cs-tags { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; }
  .cs-real { display: inline-flex; align-items: center; gap: 6px; padding: 4px 12px 4px 10px; border: 1px solid var(--blue-line); border-radius: var(--r-full); background: var(--accent-soft); color: var(--ink); font-size: 0.8125rem; font-weight: 600; }
  .cs-real :global(.icon) { color: var(--cyan); }
  .cs-cat { color: var(--cyan); font-size: 0.875rem; font-weight: 600; }
  .cs h3 { margin-top: 14px; font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.5rem); }
  .cs-meta { margin-top: 4px; color: var(--muted); font-size: 0.9375rem; }
  .cs-desc { margin-top: 14px; max-width: 54ch; color: var(--body); }
  .cs-ticks { display: grid; gap: 8px; margin-top: 18px; color: var(--body); font-size: 0.9375rem; }
  /* a plain note, not a box inside the card */
  .cs-staged { display: flex; gap: 8px; align-items: flex-start; margin-top: 18px; color: var(--body); font-size: 0.875rem; }
  .cs-staged :global(.icon) { flex: none; margin-top: 0.2em; color: var(--cyan); }
  .cs-staged strong { color: var(--ink); font-weight: 600; }
  .cs-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
  @media (max-width: 479px) { .cs-actions .button { width: 100%; } }
</style>
