---
// A Phosphor icon (regular weight) inlined, so it takes the text colour and costs no request. Decorative: the
// words beside it say what it means.
import arrowRight from "@phosphor-icons/core/assets/regular/arrow-right.svg?raw";
import calendarCheck from "@phosphor-icons/core/assets/regular/calendar-check.svg?raw";
import chatCircleText from "@phosphor-icons/core/assets/regular/chat-circle-text.svg?raw";
import check from "@phosphor-icons/core/assets/regular/check.svg?raw";
import copy from "@phosphor-icons/core/assets/regular/copy.svg?raw";
import creditCard from "@phosphor-icons/core/assets/regular/credit-card.svg?raw";
import desktop from "@phosphor-icons/core/assets/regular/desktop.svg?raw";
import envelopeSimple from "@phosphor-icons/core/assets/regular/envelope-simple.svg?raw";
import gift from "@phosphor-icons/core/assets/regular/gift.svg?raw";
import githubLogo from "@phosphor-icons/core/assets/regular/github-logo.svg?raw";
import list from "@phosphor-icons/core/assets/regular/list.svg?raw";
import magnifyingGlass from "@phosphor-icons/core/assets/regular/magnifying-glass.svg?raw";
import mapPin from "@phosphor-icons/core/assets/regular/map-pin.svg?raw";
import phoneX from "@phosphor-icons/core/assets/regular/phone-x.svg?raw";
import star from "@phosphor-icons/core/assets/regular/star.svg?raw";
import wrench from "@phosphor-icons/core/assets/regular/wrench.svg?raw";
import briefcase from "@phosphor-icons/core/assets/regular/briefcase.svg?raw";
import broom from "@phosphor-icons/core/assets/regular/broom.svg?raw";
import chartLineUp from "@phosphor-icons/core/assets/regular/chart-line-up.svg?raw";
import clipboardText from "@phosphor-icons/core/assets/regular/clipboard-text.svg?raw";
import coffee from "@phosphor-icons/core/assets/regular/coffee.svg?raw";
import envelopeOpen from "@phosphor-icons/core/assets/regular/envelope-open.svg?raw";
import forkKnife from "@phosphor-icons/core/assets/regular/fork-knife.svg?raw";
import hammer from "@phosphor-icons/core/assets/regular/hammer.svg?raw";
import handshake from "@phosphor-icons/core/assets/regular/handshake.svg?raw";
import lightning from "@phosphor-icons/core/assets/regular/lightning.svg?raw";
import mapTrifold from "@phosphor-icons/core/assets/regular/map-trifold.svg?raw";
import plugsConnected from "@phosphor-icons/core/assets/regular/plugs-connected.svg?raw";
import receipt from "@phosphor-icons/core/assets/regular/receipt.svg?raw";
import robot from "@phosphor-icons/core/assets/regular/robot.svg?raw";
import shieldCheck from "@phosphor-icons/core/assets/regular/shield-check.svg?raw";
import shoppingBag from "@phosphor-icons/core/assets/regular/shopping-bag.svg?raw";
import sparkle from "@phosphor-icons/core/assets/regular/sparkle.svg?raw";
import storefront from "@phosphor-icons/core/assets/regular/storefront.svg?raw";
import squaresFour from "@phosphor-icons/core/assets/regular/squares-four.svg?raw";
import caretDown from "@phosphor-icons/core/assets/regular/caret-down.svg?raw";
import plus from "@phosphor-icons/core/assets/regular/plus.svg?raw";
import table from "@phosphor-icons/core/assets/regular/table.svg?raw";
import bellSimple from "@phosphor-icons/core/assets/regular/bell-simple.svg?raw";
import paperPlaneTilt from "@phosphor-icons/core/assets/regular/paper-plane-tilt.svg?raw";
import checkCircle from "@phosphor-icons/core/assets/regular/check-circle.svg?raw";
import globeSimple from "@phosphor-icons/core/assets/regular/globe-simple.svg?raw";
import arrowUpRight from "@phosphor-icons/core/assets/regular/arrow-up-right.svg?raw";
import question from "@phosphor-icons/core/assets/regular/question.svg?raw";
import clock from "@phosphor-icons/core/assets/regular/clock.svg?raw";
import sealCheck from "@phosphor-icons/core/assets/regular/seal-check.svg?raw";

const icons = { arrowRight, calendarCheck, chatCircleText, check, copy, creditCard, desktop, envelopeSimple, gift, githubLogo, list, magnifyingGlass, mapPin, phoneX, star, wrench, briefcase, broom, chartLineUp, clipboardText, coffee, envelopeOpen, forkKnife, hammer, handshake, lightning, mapTrifold, plugsConnected, receipt, robot, shieldCheck, shoppingBag, sparkle, storefront, squaresFour, caretDown, plus, table, bellSimple, paperPlaneTilt, checkCircle, globeSimple, arrowUpRight, question, clock, sealCheck };
export type IconName = keyof typeof icons;
interface Props {
  name: IconName;
  class?: string;
}
const { name, class: className = "icon" } = Astro.props;
const svg = icons[name].replace("<svg ", `<svg class="${className}" aria-hidden="true" focusable="false" `);
---
<Fragment set:html={svg} />
