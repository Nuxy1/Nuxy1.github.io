---
// A Phosphor icon (regular weight) inlined, so it takes the text colour and costs no request. Decorative: the
// words beside it say what it means. Each icon is drawn once per page (its first use carries <g id="i-name">) and
// every later use points at that drawing with <use>, so the home page ships 46 drawings instead of 166 (F7).
import arrowRight from "@phosphor-icons/core/assets/regular/arrow-right.svg?raw";
import calendarCheck from "@phosphor-icons/core/assets/regular/calendar-check.svg?raw";
import chatCircleText from "@phosphor-icons/core/assets/regular/chat-circle-text.svg?raw";
import check from "@phosphor-icons/core/assets/regular/check.svg?raw";
import copy from "@phosphor-icons/core/assets/regular/copy.svg?raw";
import creditCard from "@phosphor-icons/core/assets/regular/credit-card.svg?raw";
import desktop from "@phosphor-icons/core/assets/regular/desktop.svg?raw";
import envelopeSimple from "@phosphor-icons/core/assets/regular/envelope-simple.svg?raw";
import gift from "@phosphor-icons/core/assets/regular/gift.svg?raw";
import githubLogo from "@phosphor-icons/core/assets/regular/github-logo.svg?raw";
import list from "@phosphor-icons/core/assets/regular/list.svg?raw";
import magnifyingGlass from "@phosphor-icons/core/assets/regular/magnifying-glass.svg?raw";
import mapPin from "@phosphor-icons/core/assets/regular/map-pin.svg?raw";
import phoneX from "@phosphor-icons/core/assets/regular/phone-x.svg?raw";
import star from "@phosphor-icons/core/assets/regular/star.svg?raw";
import wrench from "@phosphor-icons/core/assets/regular/wrench.svg?raw";
import briefcase from "@phosphor-icons/core/assets/regular/briefcase.svg?raw";
import broom from "@phosphor-icons/core/assets/regular/broom.svg?raw";
import chartLineUp from "@phosphor-icons/core/assets/regular/chart-line-up.svg?raw";
import clipboardText from "@phosphor-icons/core/assets/regular/clipboard-text.svg?raw";
import coffee from "@phosphor-icons/core/assets/regular/coffee.svg?raw";
import envelopeOpen from "@phosphor-icons/core/assets/regular/envelope-open.svg?raw";
import forkKnife from "@phosphor-icons/core/assets/regular/fork-knife.svg?raw";
import hammer from "@phosphor-icons/core/assets/regular/hammer.svg?raw";
import handshake from "@phosphor-icons/core/assets/regular/handshake.svg?raw";
import lightning from "@phosphor-icons/core/assets/regular/lightning.svg?raw";
import mapTrifold from "@phosphor-icons/core/assets/regular/map-trifold.svg?raw";
import plugsConnected from "@phosphor-icons/core/assets/regular/plugs-connected.svg?raw";
import receipt from "@phosphor-icons/core/assets/regular/receipt.svg?raw";
import robot from "@phosphor-icons/core/assets/regular/robot.svg?raw";
import shieldCheck from "@phosphor-icons/core/assets/regular/shield-check.svg?raw";
import shoppingBag from "@phosphor-icons/core/assets/regular/shopping-bag.svg?raw";
import sparkle from "@phosphor-icons/core/assets/regular/sparkle.svg?raw";
import storefront from "@phosphor-icons/core/assets/regular/storefront.svg?raw";
import squaresFour from "@phosphor-icons/core/assets/regular/squares-four.svg?raw";
import caretDown from "@phosphor-icons/core/assets/regular/caret-down.svg?raw";
import plus from "@phosphor-icons/core/assets/regular/plus.svg?raw";
import table from "@phosphor-icons/core/assets/regular/table.svg?raw";
import bellSimple from "@phosphor-icons/core/assets/regular/bell-simple.svg?raw";
import paperPlaneTilt from "@phosphor-icons/core/assets/regular/paper-plane-tilt.svg?raw";
import checkCircle from "@phosphor-icons/core/assets/regular/check-circle.svg?raw";
import globeSimple from "@phosphor-icons/core/assets/regular/globe-simple.svg?raw";
import arrowUpRight from "@phosphor-icons/core/assets/regular/arrow-up-right.svg?raw";
import arrowUp from "@phosphor-icons/core/assets/regular/arrow-up.svg?raw";
import question from "@phosphor-icons/core/assets/regular/question.svg?raw";
import clock from "@phosphor-icons/core/assets/regular/clock.svg?raw";
import sealCheck from "@phosphor-icons/core/assets/regular/seal-check.svg?raw";

import x from "@phosphor-icons/core/assets/regular/x.svg?raw";
import arrowCounterClockwise from "@phosphor-icons/core/assets/regular/arrow-counter-clockwise.svg?raw";
import play from "@phosphor-icons/core/assets/regular/play.svg?raw";
import user from "@phosphor-icons/core/assets/regular/user.svg?raw";
import deviceMobile from "@phosphor-icons/core/assets/regular/device-mobile.svg?raw";
import funnel from "@phosphor-icons/core/assets/regular/funnel.svg?raw";
import lockSimple from "@phosphor-icons/core/assets/regular/lock-simple.svg?raw";
import pencilSimple from "@phosphor-icons/core/assets/regular/pencil-simple.svg?raw";
import rocketLaunch from "@phosphor-icons/core/assets/regular/rocket-launch.svg?raw";
import users from "@phosphor-icons/core/assets/regular/users.svg?raw";
import listChecks from "@phosphor-icons/core/assets/regular/list-checks.svg?raw";
import browser from "@phosphor-icons/core/assets/regular/browser.svg?raw";
import paintBrush from "@phosphor-icons/core/assets/regular/paint-brush.svg?raw";
import arrowsClockwise from "@phosphor-icons/core/assets/regular/arrows-clockwise.svg?raw";
import phone from "@phosphor-icons/core/assets/regular/phone.svg?raw";
import caretRight from "@phosphor-icons/core/assets/regular/caret-right.svg?raw";
import caretLeft from "@phosphor-icons/core/assets/regular/caret-left.svg?raw";
import warningCircle from "@phosphor-icons/core/assets/regular/warning-circle.svg?raw";
import info from "@phosphor-icons/core/assets/regular/info.svg?raw";
import kanban from "@phosphor-icons/core/assets/regular/kanban.svg?raw";
import circleNotch from "@phosphor-icons/core/assets/regular/circle-notch.svg?raw";
import scissors from "@phosphor-icons/core/assets/regular/scissors.svg?raw";
import leaf from "@phosphor-icons/core/assets/regular/leaf.svg?raw";
import house from "@phosphor-icons/core/assets/regular/house.svg?raw";
import chatsCircle from "@phosphor-icons/core/assets/regular/chats-circle.svg?raw";
import bellRinging from "@phosphor-icons/core/assets/regular/bell-ringing.svg?raw";
import tray from "@phosphor-icons/core/assets/regular/tray.svg?raw";
import userCircle from "@phosphor-icons/core/assets/regular/user-circle.svg?raw";
import eye from "@phosphor-icons/core/assets/regular/eye.svg?raw";
import monitor from "@phosphor-icons/core/assets/regular/monitor.svg?raw";
import gauge from "@phosphor-icons/core/assets/regular/gauge.svg?raw";
import flowArrow from "@phosphor-icons/core/assets/regular/flow-arrow.svg?raw";
import sun from "@phosphor-icons/core/assets/regular/sun.svg?raw";
import drop from "@phosphor-icons/core/assets/regular/drop.svg?raw";
import tree from "@phosphor-icons/core/assets/regular/tree.svg?raw";
import headset from "@phosphor-icons/core/assets/regular/headset.svg?raw";
import userPlus from "@phosphor-icons/core/assets/regular/user-plus.svg?raw";
import addressBook from "@phosphor-icons/core/assets/regular/address-book.svg?raw";
import megaphone from "@phosphor-icons/core/assets/regular/megaphone.svg?raw";
import clockCounterClockwise from "@phosphor-icons/core/assets/regular/clock-counter-clockwise.svg?raw";

const icons = { arrowRight, arrowUp, calendarCheck, chatCircleText, check, copy, creditCard, desktop, envelopeSimple, gift, githubLogo, list, magnifyingGlass, mapPin, phoneX, star, wrench, briefcase, broom, chartLineUp, clipboardText, coffee, envelopeOpen, forkKnife, hammer, handshake, lightning, mapTrifold, plugsConnected, receipt, robot, shieldCheck, shoppingBag, sparkle, storefront, squaresFour, caretDown, plus, table, bellSimple, paperPlaneTilt, checkCircle, globeSimple, arrowUpRight, question, clock, sealCheck, x, arrowCounterClockwise, play, user, deviceMobile, funnel, lockSimple, pencilSimple, rocketLaunch, users, listChecks, browser, paintBrush, arrowsClockwise, phone, caretRight, caretLeft, warningCircle, info, kanban, circleNotch, scissors, leaf, house, chatsCircle, bellRinging, tray, userCircle, eye, monitor, gauge, flowArrow, sun, drop, tree, headset, userPlus, addressBook, megaphone, clockCounterClockwise };
export type IconName = keyof typeof icons;
interface Props {
  name: IconName;
  class?: string;
}
const { name, class: className = "icon" } = Astro.props;
const raw = icons[name];
const open = raw.match(/^<svg([^>]*)>/)![1].replace(/\s*xmlns="[^"]*"/, "");
const body = raw.slice(raw.indexOf(">") + 1, raw.lastIndexOf("</svg>"));
// Astro.locals is fresh for every page, so each page carries its own drawings.
const locals = Astro.locals as { iconsDrawn?: Set<string> };
const drawn = (locals.iconsDrawn ??= new Set<string>());
const inner = drawn.has(name) ? `<use href="#i-${name}"/>` : `<g id="i-${name}">${body}</g>`;
drawn.add(name);
const svg = `<svg class="${className}"${open} aria-hidden="true" focusable="false">${inner}</svg>`;
---
<Fragment set:html={svg} />
