---
import { Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import Icon, { type IconName } from "../components/Icon.astro";
import hero from "../assets/photos/hero.jpg";
import booking from "../assets/photos/booking.jpg";
import followUp from "../assets/photos/follow-up.jpg";
import reviews from "../assets/photos/reviews.jpg";
import newWebsite from "../assets/photos/new-website.jpg";
import siteFixes from "../assets/photos/site-fixes.jpg";
import care from "../assets/photos/care.jpg";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// The request form is an email: no server to run, and the answer lands in the inbox the work runs from.
// (a chosen package's own request names it at the top; Gmail and Outlook links for computers with no email app,
// where a mailto: link does nothing at all)
const inbox = "nuxy@nuxyautomation.com";
type Item = { name: string; price: string };
const subject = (p?: Item) => (p ? `Setup request: ${p.name}` : "Setup request");
const body = (p?: Item) => `${p ? `Package: ${p.name} (${p.price})\n` : ""}Business name:\nWebsite:\nWhat you use for booking now (or "phone only"):\nWhat you'd like fixed or set up:\nAnything else:\n`;
const query = (fields: Record<string, string>) => new URLSearchParams(fields).toString().replace(/\+/g, "%20");
const ask = (p?: Item) => `mailto:${inbox}?` + query({ subject: subject(p), body: body(p) });
const gmail = (p?: Item) => "https://mail.google.com/mail/?" + query({ view: "cm", fs: "1", to: inbox, su: subject(p), body: body(p) });
const outlook = (p?: Item) => "https://outlook.live.com/mail/0/deeplink/compose?" + query({ to: inbox, subject: subject(p), body: body(p) });

// (ids are linked from outreach emails: keep them stable)
const packages = [
  { id: "booking", photo: booking, alt: "A hand holding a phone with a booking page at a spa’s front desk.", name: "Online booking & reminders", price: "$400", fixes: "calls you miss while you’re with a client", text: "A Book now button on your website, Google profile and Instagram, connected to the booking tool you already use (or a free one), plus automatic text and email reminders that cut no-shows." },
  { id: "follow-up", photo: followUp, alt: "A nail technician at work while a new message lights up her phone.", name: "Lead follow-up", price: "$450", fixes: "messages that wait hours for an answer", text: "Every website form, Facebook or Instagram inquiry gets an instant reply, 2 friendly follow-ups and an alert to you, so nobody waits until you’re free." },
  { id: "reviews", photo: reviews, alt: "A barbershop client smiling at his new haircut in the mirror.", name: "Review requests", price: "$250", fixes: "happy clients who never leave a review", text: "After each visit, every client gets a short thank-you with a link to leave you a Google review. More reviews, no awkward asking." },
  { id: "new-website", photo: newWebsite, alt: "A dance studio owner sitting on the studio floor with a laptop.", name: "New website", price: "$600", fixes: "no website, or one too old to fix", text: "Up to 4 pages, built for phones: your services and prices, hours, map and a Book now button, on your own domain. Built in your own Squarespace or Wix account, so you can edit it and it stays yours." },
  { id: "site-fixes", photo: siteFixes, alt: "A phone showing a website in a tattoo studio, the artist setting up behind.", name: "Website quick fixes", price: "from $150", fixes: "a site that looks broken on a phone", text: "Secure https, a phone-friendly page setup, a booking button and a contact form that works: on the site you already have." },
  { id: "care", photo: care, alt: "A groomer drying a fluffy dog on a grooming table.", name: "Care plan", price: "$100/month", fixes: "a site or automation that quietly stops working", text: "Your website and automations watched 24/7, checked every 5 minutes. Anything that breaks fixed within one business day, and small changes when you ask. Cancel any time." },
];
const oneOff = packages.filter((p) => p.id !== "care");
const carePlan = packages.find((p) => p.id === "care")!;

// (ids are linked from outreach emails too)
const addons: (Item & { id: string; icon: IconName; fixes: string; text: string })[] = [
  { id: "missed-calls", icon: "phoneX", name: "Missed-call text-back", price: "$250", fixes: "callers who hang up and book elsewhere", text: "When you can’t pick up, the caller gets a text right away with your booking link, set up in the booking or phone tool you already use." },
  { id: "deposits", icon: "creditCard", name: "Deposits & no-show protection", price: "$150", fixes: "empty chairs from no-shows", text: "A card on file or a small deposit when clients book, plus a clear cancellation policy, switched on in your booking tool." },
  { id: "gift-cards", icon: "gift", name: "Online gift cards", price: "$150", fixes: "gift shoppers with nowhere to buy", text: "A Buy a gift card button on your website, Google profile and Instagram, using your booking tool’s own gift cards." },
];

// The finder under the hero: start from the problem, land on the package that fixes it.
const problems = [
  { label: "Missed calls", text: "Clients book online", href: "#booking" },
  { label: "Slow replies", text: "Instant answers", href: "#follow-up" },
  { label: "Few reviews", text: "Ask every client", href: "#reviews" },
  { label: "Old website", text: "Fix it or start fresh", href: "#site-fixes" },
];

const steps = [
  ["Tell me in writing", "Send the request below: your business, your website, what you’d like fixed. No call to schedule."],
  ["Get the plan and price", "Within one business day: a written plan and a fixed price. No surprises later."],
  ["I build it in your accounts", "50% to start, paid by a secure Stripe invoice. I work as an invited user, never with your passwords, and test with real examples."],
  ["Handover", "A short video guide showing it working, then the other 50% by the same kind of invoice. Add the care plan if you want it looked after."],
];

// What search engines read about the business (schema.org): only what the page itself says.
const site = "https://nuxyautomation.com/";
const priceOf = (price: string) => {
  const n = Number(price.replace(/\D/g, ""));
  if (price.startsWith("from")) return { "@type": "PriceSpecification", minPrice: n, priceCurrency: "USD" };
  if (price.includes("/month")) return { "@type": "UnitPriceSpecification", price: n, priceCurrency: "USD", unitText: "MONTH" };
  return { "@type": "PriceSpecification", price: n, priceCurrency: "USD" };
};
const business = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "Nuxy Automation",
  url: site,
  logo: `${site}logo.png`,
  image: `${site}og.jpg`,
  email: inbox,
  description: "Online booking, instant replies, reminders and review requests for salons, spas, studios and groomers. Fixed prices, no calls needed.",
  address: { "@type": "PostalAddress", addressLocality: "Faribault", addressRegion: "MN", addressCountry: "US" },
  areaServed: ["Minneapolis", "Saint Paul", "Faribault", "Northfield", "Owatonna"].map((name) => ({ "@type": "City", name })),
  priceRange: "$100-$600",
  sameAs: ["https://github.com/Nuxy1"],
  // (each package is an offer, so a search result can show what it costs)
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Packages",
    itemListElement: [...packages, ...addons].map((p) => ({
      "@type": "Offer",
      url: `${site}#${p.id}`,
      priceSpecification: priceOf(p.price),
      itemOffered: { "@type": "Service", name: p.name, description: p.text },
    })),
  },
};

const work = [
  { name: "Shopify order webhook relay", repo: "shopify-webhook-relay", doc: "webhook-relay", text: "Every order to Google Sheets and Slack or Discord: checked, never written twice, retried, failures replayable." },
  { name: "Code steps for Zapier & n8n", repo: "automation-code-steps", doc: "code-steps", text: "Paste-ready steps that clean phone numbers, names, dates and time zones inside an automation." },
  { name: "CSV contact cleaner", repo: "csv-contact-cleaner", doc: "csv-cleaner", text: "Cleans and dedupes a contact list before an import, with every change counted." },
  { name: "Stream community bot", repo: "stream-community-bot", doc: "community-bot", text: "A Discord bot for a creator’s community: welcome cards, role buttons, live alerts." },
];
const photoSizes = "(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw";
---
<Base title="Nuxy Automation · Booking and follow-up for small businesses" wide>
  <script type="application/ld+json" set:html={JSON.stringify(business)} />

  <section class="wrap hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <h1 id="hero-title">Never lose a booking while you’re with a client.</h1>
      <p class="sub">Online booking, instant replies, reminders and review requests for salons, spas, studios and groomers. Fixed prices, no calls.</p>
      <p class="hero-actions">
        <a class="button" href="#request">Request a setup</a>
        <a class="button secondary" href={`${base}/demo/`}>See it working</a>
      </p>
    </div>
    <Picture class="hero-photo" src={hero} formats={["avif", "webp"]} widths={[640, 960, 1400]} sizes="(min-width: 900px) 46vw, 100vw" alt="A hairdresser laughing with her client mid-haircut, a phone lying on the counter." loading="eager" fetchpriority="high" />
  </section>

  <section class="wrap finder" aria-labelledby="finder-title">
    <h2 id="finder-title">What’s costing you bookings?</h2>
    <nav class="finder-bar" aria-labelledby="finder-title">
      {problems.map((p) => (
        <a class="seg" href={p.href}><span class="seg-label">{p.label}</span><span class="seg-text">{p.text}</span></a>
      ))}
      <a class="orb" href="#packages"><Icon name="magnifyingGlass" /><span class="orb-text">See all packages</span></a>
    </nav>
  </section>

  <section id="packages" class="wrap section" aria-labelledby="packages-title">
    <h2 id="packages-title" class="section-title">Packages</h2>
    <p class="section-lead">Fixed prices, agreed in writing before I start. Everything is built in your own accounts, so it stays yours. <a href={`${base}/demo/`}>See them working on a demo salon</a>.</p>
    <ul class="listings">
      {oneOff.map((p, i) => (
        <li class="reveal">
          <article class="listing" id={p.id} aria-labelledby={`${p.id}-name`}>
            <div class="photo"><Picture src={p.photo} formats={["avif", "webp"]} widths={[480, 760, 1100]} sizes={i < 3 ? photoSizes : "(min-width: 1024px) 580px, (min-width: 640px) 50vw, 100vw"} alt={p.alt} loading="lazy" /></div>
            <div class="title-row">
              <h3 id={`${p.id}-name`}>{p.name}</h3>
              <p class="price">{p.price}</p>
            </div>
            <p class="fixes">Fixes: {p.fixes}</p>
            <p class="desc">{p.text}</p>
            <p class="actions">
              <a class="request-link" href={ask(p)} aria-label={`Request a setup: ${p.name}`}>Request a setup<Icon name="arrowRight" /></a>
              <span class="alt">or in <a href={gmail(p)} target="_blank" rel="noopener">Gmail</a> or <a href={outlook(p)} target="_blank" rel="noopener">Outlook</a></span>
            </p>
          </article>
        </li>
      ))}
    </ul>

    <article class="care reveal" id={carePlan.id} aria-labelledby="care-name">
      <div class="photo"><Picture src={carePlan.photo} formats={["avif", "webp"]} widths={[560, 900, 1260]} sizes="(min-width: 900px) 600px, 100vw" alt={carePlan.alt} loading="lazy" /></div>
      <div class="care-body">
        <h3 id="care-name">{carePlan.name}</h3>
        <p class="care-price"><strong>$100</strong> a month</p>
        <p class="fixes">Fixes: {carePlan.fixes}</p>
        <p class="desc">{carePlan.text}</p>
        <p class="actions">
          <a class="request-link" href={ask(carePlan)} aria-label={`Request a setup: ${carePlan.name}`}>Request a setup<Icon name="arrowRight" /></a>
          <span class="alt">or in <a href={gmail(carePlan)} target="_blank" rel="noopener">Gmail</a> or <a href={outlook(carePlan)} target="_blank" rel="noopener">Outlook</a></span>
        </p>
      </div>
    </article>
  </section>

  <section id="add-ons" class="wrap section addons" aria-labelledby="add-ons-title">
    <div class="addons-head">
      <h2 id="add-ons-title" class="section-title">Add-ons</h2>
      <p class="section-lead">Small extras, on their own or with any package.</p>
    </div>
    <ul class="extras">
      {addons.map((a) => (
        <li class="extra reveal" id={a.id}>
          <span class="extra-icon"><Icon name={a.icon} /></span>
          <div class="extra-body">
            <div class="title-row">
              <h3>{a.name}</h3>
              <p class="price">{a.price}</p>
            </div>
            <p class="fixes">Fixes: {a.fixes}</p>
            <p class="desc">{a.text}</p>
            <p class="actions">
              <a class="request-link" href={ask(a)} aria-label={`Request a setup: ${a.name}`}>Request a setup<Icon name="arrowRight" /></a>
              <span class="alt">or in <a href={gmail(a)} target="_blank" rel="noopener">Gmail</a> or <a href={outlook(a)} target="_blank" rel="noopener">Outlook</a></span>
            </p>
          </div>
        </li>
      ))}
    </ul>
    <p class="something-else">Something else? Custom integrations, data clean-up and bots are quoted in writing after one question.</p>
  </section>

  <section id="how" class="band" aria-labelledby="how-title">
    <div class="wrap">
      <h2 id="how-title" class="section-title">How it works</h2>
      <ol class="steps">
        {steps.map(([head, text], i) => (
          <li class="reveal">
            <span class="step-n" aria-hidden="true">{i + 1}</span>
            <h3>{head}</h3>
            <p>{text}</p>
          </li>
        ))}
      </ol>
      <p class="policy">No calls needed. Questions, plans and updates come in writing, with short screen recordings of each piece working.</p>
    </div>
  </section>

  <section id="work" class="wrap section" aria-labelledby="work-title">
    <h2 id="work-title" class="section-title">Projects I built</h2>
    <p class="section-lead">Nuxy Automation is new, so instead of testimonials, here is working code you can open and check.</p>
    <div class="work">
      <figure class="demo reveal">
        <video src={`${base}/relay-demo.mp4`} poster={`${base}/relay-demo-poster.jpg`} width="800" height="450" autoplay muted loop playsinline controls preload="metadata" aria-describedby="demo-caption"></video>
        <figcaption id="demo-caption">The order relay at work: a new order arriving, the clean spreadsheet row it writes, and a forged request refused.</figcaption>
      </figure>
      <ul class="projects">
        {work.map((w) => (
          <li class="reveal">
            <h3>{w.name}</h3>
            <p>{w.text}</p>
            <p class="links"><a href={`${base}/docs/${w.doc}/`}>How it works</a><a href={`https://github.com/Nuxy1/${w.repo}`}>Code</a></p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="request" class="wrap section request" aria-labelledby="request-title">
    <div class="request-copy">
      <h2 id="request-title" class="section-title">Request a setup</h2>
      <p class="section-lead">Email me your business name, website, what you use for booking now and what you’d like fixed. You’ll have a written plan and a fixed price within one business day.</p>
      <ul class="facts">
        <li><Icon name="envelopeSimple" /><p><strong>Everything in writing.</strong> No calls needed: questions, plans and updates come by email.</p></li>
        <li><Icon name="creditCard" /><p><strong>Paying:</strong> a secure Stripe invoice by email, by card, Apple Pay, Google Pay or bank transfer. 50% to start, 50% at handover; the care plan is billed monthly.</p></li>
        <li><Icon name="mapPin" /><p><strong>Based in Faribault, Minnesota.</strong> Twin Cities and southern Minnesota businesses first, and anywhere remotely.</p></li>
      </ul>
    </div>
    <aside class="ticket" aria-label="Send your request">
      <p class="ticket-head"><strong>Written plan and price</strong><span>within one business day</span></p>
      <ul class="include">
        <li><Icon name="check" />Your business name</li>
        <li><Icon name="check" />Your website, if you have one</li>
        <li><Icon name="check" />What you use for booking now</li>
        <li><Icon name="check" />What you’d like fixed</li>
      </ul>
      <a class="button wide" href={ask()}>Request a setup</a>
      <p class="ticket-note">Nothing is charged until you agree to the written plan.</p>
      <p class="other-ways">
        No email app? Open it in <a href={gmail()} target="_blank" rel="noopener">Gmail</a> or <a href={outlook()} target="_blank" rel="noopener">Outlook</a>, or write to <span class="address">{inbox}</span>
        <button class="copy" type="button" data-copy={inbox} hidden><Icon name="copy" /><span aria-live="polite">Copy address</span></button>
      </p>
    </aside>
  </section>

  <script is:inline>
    // Less motion: the demo video waits for its play button instead of starting by itself.
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) document.querySelectorAll("video[autoplay]").forEach((v) => { v.autoplay = false; v.pause(); });
    // Copy the address. (navigator.clipboard can be refused; then select the address and copy it the old way.)
    document.querySelectorAll("button.copy").forEach((button) => {
      const label = button.querySelector("span");
      button.hidden = false;
      button.addEventListener("click", async () => {
        const address = button.previousElementSibling;
        try {
          await navigator.clipboard.writeText(button.dataset.copy);
        } catch {
          const range = document.createRange();
          range.selectNodeContents(address);
          getSelection().removeAllRanges();
          getSelection().addRange(range);
          if (!document.execCommand("copy")) return; // (left selected: Ctrl+C still works)
        }
        label.textContent = "Copied";
        setTimeout(() => (label.textContent = "Copy address"), 2000);
      });
    });
  </script>
</Base>

<style>
  .section { padding-block: clamp(56px, 7vw, 88px) 0; }
  .section-title { font-size: clamp(1.75rem, 3vw, 2.25rem); line-height: 1.15; letter-spacing: -0.02em; margin: 0 0 10px; }
  .section-lead { font-size: 1.0625rem; max-width: 60ch; margin: 0 0 32px; }
  .price { margin: 0; color: var(--ink); font-weight: 700; font-size: 1.0625rem; font-variant-numeric: tabular-nums lining-nums; white-space: nowrap; }
  .fixes { margin: 6px 0 0; color: var(--muted); font-size: 0.9375rem; }
  .desc { margin: 10px 0 0; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 16px; margin: 0; padding-top: 14px; }
  /* Each package's request is a quiet link; it becomes the coral button only on the package an email linked to. */
  .request-link {
    display: inline-flex; align-items: center; gap: 6px; min-height: 44px; color: var(--ink); font-weight: 600;
    text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.25em;
    transition: background-color 160ms ease-out, color 160ms ease-out;
  }
  .request-link :global(.icon) { width: 1.1em; height: 1.1em; transition: transform 200ms var(--ease); }
  .request-link:hover :global(.icon) { transform: translateX(3px); }
  .alt { color: var(--muted); font-size: 0.875rem; }
  .alt a { color: var(--muted); }
  .alt a:hover { color: var(--accent-text); }
  .photo { overflow: hidden; border-radius: var(--r-md); background: var(--surface-strong); }
  .photo :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 500ms var(--ease); }
  :is(.listing, .care, .extra):target { outline: 2px solid var(--ink); outline-offset: 12px; border-radius: var(--r-lg); }
  :is(.listing, .care, .extra):target .request-link { padding: 0 22px; border-radius: var(--r-sm); background: var(--accent); color: var(--on-accent); text-decoration: none; }
  :is(.listing, .care, .extra):target .request-link:hover { background: var(--accent-press); }

  /* Hero: the promise on the left, a working salon on the right. */
  .hero { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: clamp(32px, 5vw, 64px); align-items: center; padding-block: clamp(28px, 4vw, 48px) 8px; }
  .hero h1 { font-size: clamp(2.25rem, 3.3vw, 2.875rem); line-height: 1.08; letter-spacing: -0.03em; margin: 0; }
  .sub { font-size: clamp(1.0625rem, 1.4vw, 1.25rem); line-height: 1.5; max-width: 40ch; margin: 20px 0 0; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin: 32px 0 0; }
  .hero-photo { width: 100%; height: clamp(420px, calc(100dvh - var(--nav-h) - 110px), 660px); object-fit: cover; object-position: 50% 40%; border-radius: var(--r-lg); background: var(--surface-strong); }
  @media (prefers-reduced-motion: no-preference) {
    .hero-copy > * { animation: enter 700ms var(--ease) backwards; }
    .hero-copy > :nth-child(2) { animation-delay: 80ms; }
    .hero-copy > :nth-child(3) { animation-delay: 160ms; }
    .hero-photo { animation: settle 900ms var(--ease) backwards; }
  }
  @keyframes enter { from { opacity: 0; transform: translateY(16px); } }
  @keyframes settle { from { opacity: 0; transform: scale(1.03); } }

  /* The finder: Airbnb's search pill, here split by problem; the coral orb opens every package. */
  .finder { padding-top: clamp(40px, 5vw, 56px); }
  .finder h2 { font-size: 1.125rem; margin: 0 0 14px; text-align: center; }
  .finder-bar {
    display: flex; align-items: stretch; max-width: 920px; margin: 0 auto; padding: 8px; gap: 0;
    border: 1px solid var(--hairline); border-radius: var(--r-full); background: var(--bg); box-shadow: var(--shadow);
  }
  .seg { position: relative; flex: 1 1 0; display: grid; gap: 2px; padding: 10px 22px; border-radius: var(--r-full); text-decoration: none; transition: background-color 160ms ease-out; }
  .seg + .seg::before { content: ""; position: absolute; left: 0; top: 22%; bottom: 22%; border-left: 1px solid var(--hairline); }
  .seg:hover { background: var(--surface-strong); }
  .seg:hover::before, .seg:hover + .seg::before { opacity: 0; }
  .seg-label { color: var(--ink); font-size: 0.8125rem; font-weight: 700; }
  .seg-text { color: var(--muted); font-size: 0.875rem; }
  .orb {
    flex: none; display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-width: 56px; padding: 0 16px; margin-left: 4px;
    border-radius: var(--r-full); background: var(--accent); color: var(--on-accent); text-decoration: none; font-weight: 600;
    transition: background-color 160ms ease-out;
  }
  .orb:hover { background: var(--accent-press); color: var(--on-accent); }
  .orb :global(.icon) { width: 1.35rem; height: 1.35rem; }
  .orb-text { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (max-width: 760px) {
    .finder h2 { text-align: left; }
    .finder-bar { display: grid; grid-template-columns: 1fr 1fr; border-radius: var(--r-lg); padding: 8px; }
    .seg { border-radius: var(--r-md); padding: 12px 14px; }
    .seg + .seg::before { display: none; }
    .orb { grid-column: 1 / -1; min-height: 48px; margin: 6px 0 0; border-radius: var(--r-sm); }
    .orb-text { position: static; width: auto; height: auto; clip-path: none; }
  }

  /* Packages: photo-first listings, three across then two wider. */
  .listings { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 40px 24px; }
  .listings > li { grid-column: span 2; }
  .listings > li:nth-child(n + 4) { grid-column: span 3; }
  /* (each card fills its grid cell, so the requests in a row line up at the bottom) */
  .listings > li { display: flex; }
  .listing { flex: 1; display: flex; flex-direction: column; }
  .listing .actions { margin-top: auto; }
  .listing .photo { aspect-ratio: 4 / 3; }
  .listings > li:nth-child(n + 4) .photo { aspect-ratio: 16 / 9; }
  .title-row { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; margin-top: 16px; }
  .title-row h3 { font-size: 1.1875rem; line-height: 1.3; margin: 0; }
  @media (hover: hover) and (pointer: fine) {
    .listing:hover .photo :global(img), .care:hover .photo :global(img) { transform: scale(1.03); }
