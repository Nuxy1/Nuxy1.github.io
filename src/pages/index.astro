---
// Homepage (conversion brief, 2026-11), in the order a visitor decides: what Nuxy does, the four services most
// businesses start with, the automations working, a goal picker, a price estimate, example work, three ways to start,
// the five steps, one trust band and one next step. Services and prices come from data/services.ts; nothing on this
// page is a client result. Section ids avoid the old one-page anchors that Base.astro forwards (any service, plan or
// bundle id, "services", "plans", "work", ...), or the forwarding script would send the visitor away.
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import AutomationCore from "../components/AutomationCore.astro";
import CinematicLoop from "../components/CinematicLoop.astro";
import AutopilotDemos from "../components/AutopilotDemos.astro";
import AutomateSelector from "../components/AutomateSelector.astro";
import PackageEstimator from "../components/PackageEstimator.astro";
import DemoSites from "../components/DemoSites.astro";
import CaseStudy from "../components/CaseStudy.astro";
import VideoTeasers from "../components/VideoTeasers.astro";
import { demos as videoDemos } from "../data/creative";
import { demosReady } from "../data/cinematic";
import { levels } from "../data/tiers";

// the home page links to the video portfolio only when all three demo videos have real, checked files
const hasVideos = demosReady(videoDemos.map((d) => d.id));
import { featured, tiers, steps, services, areas, automationFrom, dollars, money, variantById } from "../data/services";
import { inbox, caseStudies } from "../data/site";
import type { IconName } from "../components/Icon.astro";

// The cheapest and dearest one-time prices, for search engines' price range: read from the price list so it can't drift.
const oneTime = services.flatMap((s) => [s, ...(s.variants ?? [])]).map((s) => dollars(s.price)).filter(Boolean);
// The hero's price line: the smallest website and the smallest automation setup, from the price list. (Monthly plans
// are optional on every one-time service, which is what "no required monthly contract" says.)
const startPrices = [`Websites from ${variantById["starter-website"].price}`, `Automations from ${automationFrom}`, "No required monthly contract"];

// The one trust band: each line is a published term (/policies/, /websites/#ownership), said once on this page.
const trust: { icon: IconName; title: string; text: string }[] = [
  { icon: "receipt", title: "Clear Pricing", text: "You see the price before work starts." },
  { icon: "lockSimple", title: "Your Accounts", text: "Your website, domain and tools remain yours." },
  { icon: "checkCircle", title: "Tested Before Launch", text: "Everything is tested before handover." },
  { icon: "handshake", title: "No Long Contracts", text: "Monthly management is optional." },
  { icon: "userCircle", title: "Direct Support", text: "You work directly with the person building your system." },
];

const site = "https://nuxyautomation.com";
const business = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": `${site}/#business`,
  name: "Nuxy Automation",
  url: `${site}/`,
  logo: `${site}/logo.png`,
  image: `${site}/og.jpg`,
  email: inbox,
  description: "Websites, online stores and business automation for small businesses: business websites, Shopify and Square Online stores, lead response and follow-up, missed-call text-back, online booking and reminders, estimate follow-up, and invoice and admin automations, built in the client’s own accounts at published prices agreed in writing.",
  address: { "@type": "PostalAddress", addressLocality: "Faribault", addressRegion: "MN", addressCountry: "US" },
  areaServed: [
    ...["Faribault", "Northfield", "Owatonna", "Lakeville"].map((name) => ({ "@type": "City", name: `${name}, Minnesota` })),
    { "@type": "AdministrativeArea", name: "Southern Minnesota" },
    { "@type": "AdministrativeArea", name: "Minneapolis–Saint Paul metropolitan area" },
    { "@type": "Country", name: "United States" },
  ],
  priceRange: `${money(Math.min(...oneTime))}-${money(Math.max(...oneTime))}`,
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Website, online store and automation services",
    itemListElement: services.map((s) => ({
      "@type": "Offer",
      url: `${site}/solutions/#${s.id}`,
      itemOffered: { "@type": "Service", name: s.name, description: s.text },
      ...(s.priceType === "fixed"
        ? { price: String(dollars(s.price)), priceCurrency: "USD" }
        : { priceSpecification: { "@type": "PriceSpecification", minPrice: String(dollars(s.price)), priceCurrency: "USD" } }),
    })),
  },
};
// the early levels strip (website levels brief, 2026-11): three website levels with a page each, then automation
const strip = [
  ...levels.filter((l) => l.page).map((l) => ({ name: `${l.name} website`, promise: l.promise, href: l.page as string })),
  { name: "Automation", promise: "Built to save time", href: "/automation/" },
];
---
<Base title="Nuxy Automation · Websites, Online Stores & Automation · Faribault, MN" wide>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(business)} />

  <section class="hero cine-host" data-hero>
    <CinematicLoop id="hero" backdrop eager />
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Websites, online stores & automation · Faribault, MN</p>
        <h1><span>Stop Missing Leads.</span> <span>Save Time.</span> <span>Grow Your Business.</span></h1>
        <p class="hero-lead">Nuxy builds websites, AI-powered automations, lead follow-up and customer messaging for small businesses. We set it up, connect the tools you already use, and keep it simple.</p>
        <div class="hero-actions">
          <a class="button" href="/contact/" data-track="cta_hero">Get My Free Automation Plan<Icon name="arrowRight" /></a>
          <a class="button secondary" href="#autopilot" data-track="cta_see_working"><Icon name="play" />See It Working</a>
        </div>
        <div class="hero-price-clip"><ul class="hero-price" aria-label="Starting prices">{startPrices.map((p) => <li>{p}</li>)}</ul></div>
      </div>
      <AutomationCore />
    </div>
  </section>

  <section class="levels-strip" aria-labelledby="ls-h">
    <div class="wrap">
      <h2 id="ls-h">Four ways we can help</h2>
      <ul>
        {strip.map((s) => (
          <li><a href={s.href}><span class="ls-name">{s.name}</span><span class="ls-promise">{s.promise}</span><Icon name="arrowRight" /></a></li>
        ))}
      </ul>
      <p><a class="text-link" href="/web-design/">Compare website levels and prices<Icon name="arrowRight" /></a></p>
    </div>
  </section>

  <section class="section" id="what-we-do" aria-labelledby="do-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">What we do</p>
        <h2 id="do-h">What Can Nuxy Do for Your Business?</h2>
        <p>Four places most small businesses start, each with its starting price.</p>
      </div>
      <div class="grid-4">
        {featured.map((p) => (
          <article class="prim reveal">
            <span class="prim-icon"><Icon name={p.icon} /></span>
            <p class="prim-outcome">{p.outcome}</p>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
            <p class="prim-price">{p.price}{p.note && <span class="prim-note">{p.note}</span>}</p>
            <a class="text-link" href={p.href}>{p.cta}<Icon name="arrowRight" /></a>
          </article>
        ))}
      </div>
      <p class="more"><a class="text-link" href="/solutions/" data-track="cta_services">See all {services.length} services<Icon name="arrowRight" /></a></p>
      <p class="note also-note"><Icon name="shieldCheck" /><span>Already have a website that’s broken, slow or showing a security warning? We also do <a href="/website-security/" data-track="cta_home_security">website health checks, repairs and authorized security assessments</a>, starting with a free look.</span></p>
      {!hasVideos && (
        <p class="note also-note"><Icon name="filmSlate" /><span>Need a video for your business? We also make <a href="/creative-studio/" data-track="cta_home_creative">short video ads, moving menus and product showcases</a>, made with AI video tools and finished by a person.</span></p>
      )}
      {hasVideos && (
        <div class="home-video">
          <VideoTeasers level={3} headingId="home-video-h" title="We Also Make Video: Three Concept Demonstrations">
            <p slot="intro">Need a video for your business? We also make <a href="/creative-studio/" data-track="cta_home_creative">short video ads, moving menus and product showcases</a>, made with AI video tools and finished by a person. These three are for made-up brands: open one to watch it.</p>
          </VideoTeasers>
        </div>
      )}
    </div>
  </section>

  <AutopilotDemos />

  <AutomateSelector />

  <PackageEstimator />

  <section class="section" id="portfolio" aria-labelledby="portfolio-h">
    <div class="wrap">
      <div class="web-head">
        <div class="section-head">
          <p class="eyebrow">Our work</p>
          <h2 id="portfolio-h">See What We Build, on a Computer and a Phone</h2>
          <p>Example websites and an online store for made-up businesses, each labeled as a demonstration. Open one to try it at full size.</p>
        </div>
        <div class="web-actions">
          <a class="button secondary" href="/portfolio/" data-track="cta_portfolio">See the full portfolio<Icon name="arrowRight" /></a>
        </div>
      </div>
      <DemoSites />
      {caseStudies.length > 0 && <div class="cases">{caseStudies.map((c) => <CaseStudy study={c} />)}</div>}
    </div>
  </section>

  <section class="section band" id="start-small" aria-labelledby="tiers-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Pricing</p>
        <h2 id="tiers-h">Start Small. Upgrade When It Makes Sense.</h2>
        <p>Three ways in, with today’s starting prices. Every price is one-time unless it says monthly.</p>
      </div>
      <div class="grid-3">
        {tiers.map((t) => (
          <article class="prim tier reveal">
            <span class="prim-icon"><Icon name={t.icon} /></span>
            <h3>{t.name}</h3>
            <p>{t.who}</p>
            <p class="tier-price">{t.price}<span class="prim-note">{t.priceNote}</span></p>
            <ul class="ticks">{t.points.map((pt) => <li><Icon name="check" />{pt}</li>)}</ul>
          </article>
        ))}
      </div>
      <p class="more">
        <a class="button" href="/pricing/" data-track="cta_pricing_preview">See All Pricing<Icon name="arrowRight" /></a>
        <a class="button secondary" href="/contact/" data-track="cta_tiers_quote">Get a Free Quote</a>
      </p>
    </div>
  </section>

  <section class="section" id="how" aria-labelledby="how-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">How it works</p>
        <h2 id="how-h">Five Steps, All in Writing</h2>
        <p>No sales call and no long contract. Nothing is charged until you agree to the written plan.</p>
      </div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li class="step reveal">
            <span class="step-num" aria-hidden="true">{i + 1}</span>
            <h3><span class="sr-only">Step {i + 1}: </span>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section band" id="why-nuxy" aria-labelledby="why-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Why Nuxy</p>
        <h2 id="why-h">Fair Prices, Work You Own, One Person to Talk To</h2>
      </div>
      <ul class="trust">
        {trust.map((t) => (
          <li class="reveal">
            <Icon name={t.icon} />
            <h3>{t.title}</h3>
            <p>{t.text}</p>
          </li>
        ))}
      </ul>
      <p class="trust-foot"><Icon name="mapPin" /><span>Based in Faribault, Minnesota. We work with businesses in {areas.slice(0, -2).join(", ")}, {areas.at(-2)} and {areas.at(-1)}, and remotely anywhere in the US. <a href="/about/">About Nuxy</a> · <a href="/websites/#ownership">How ownership and handover work</a></span></p>
    </div>
  </section>

  <section class="final" aria-labelledby="final-h" data-final>
    <div class="wrap"><div class="final-box">
      <h2 id="final-h">Ready to Improve Your Business Online?</h2>
      <p>Tell us about your business and what you need. You’ll get a written recommendation and a fixed price within one business day. No sales call is required.</p>
      <div class="final-actions">
        <a class="button" href="/contact/" data-track="cta_final">Get My Free Automation Plan<Icon name="arrowRight" /></a>
        <a class="final-mail" href={`mailto:${inbox}`}><Icon name="envelopeSimple" />{inbox}</a>
      </div>
    </div></div>
  </section>

  {/* Phones only, and only with the script: one quote button that comes in after the hero and steps aside wherever
      the page already offers the next step (the estimator, the final box, the footer). Closing it lasts the visit. */}
  <div class="sticky-cta" data-sticky hidden>
    <a class="button" href="/contact/" data-track="cta_sticky">Get a Free Quote<Icon name="arrowRight" /></a>
    <button type="button" class="sticky-x" data-sticky-close aria-label="Hide the quote button"><Icon name="x" /></button>
  </div>
</Base>

<script>
  // The phone quote button. No scroll listener: an observer says when the hero, the estimator, the final box or the
  // footer is on screen, and the button shows only when none of them is.
  const bar = document.querySelector<HTMLElement>("[data-sticky]");
  const KEY = "nuxy-quote-bar";
  let closed = false;
  try { closed = sessionStorage.getItem(KEY) === "off"; } catch {}
  if (bar && !closed && "IntersectionObserver" in window) {
    const quiet = [...document.querySelectorAll("[data-hero], #package, [data-final], footer")];
    const seen = new Set<Element>();
    const set = (on: boolean) => { bar.classList.toggle("is-on", on); bar.inert = !on; };
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) e.isIntersecting ? seen.add(e.target) : seen.delete(e.target);
      set(seen.size === 0);
    });
    bar.hidden = false;
    bar.inert = true;
    quiet.forEach((el) => io.observe(el));
    bar.querySelector("[data-sticky-close]")?.addEventListener("click", () => {
      io.disconnect();
      set(false);
      try { sessionStorage.setItem(KEY, "off"); } catch {}
    });
  }
</script>


<style>
  .hero { position: relative; padding: clamp(48px, 8vw, 104px) 0 clamp(56px, 8vw, 96px); overflow: hidden; }
  .hero::before {
    content: ""; position: absolute; inset: -20% -10% auto; height: 80%; pointer-events: none;
    background: radial-gradient(60% 60% at 70% 30%, rgba(59, 130, 246, 0.16), transparent 70%);
  }
  .hero-grid { position: relative; display: grid; gap: clamp(40px, 6vw, 64px); align-items: center; }
  /* (each sentence on its own line on wide screens; the headline is a little smaller than other pages' so both fit) */
  .hero h1 { font-size: clamp(2.25rem, 1.2rem + 3vw, 3.125rem); }
  .hero h1 span { display: inline-block; }
  .hero-lead { max-width: 54ch; margin-top: 22px; font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.25rem); color: var(--body); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  /* three short facts with a rule between them; the list is pulled left by one item's padding and clipped, so a
     line never starts with a rule */
  .hero-price-clip { margin-top: 20px; overflow: hidden; }
  .hero-price { display: flex; flex-wrap: wrap; gap: 6px 0; margin: 0 0 0 -15px; list-style: none; color: var(--body); font-size: 0.875rem; font-weight: 500; }
  .hero-price li { padding: 0 12px 0 14px; border-left: 1px solid var(--hairline-strong); line-height: 1.3; }
  @media (min-width: 1024px) { .hero-grid { grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); } }
  @media (max-width: 479px) { .hero-actions .button { width: 100%; } }
  @media (max-width: 359px) { .hero-actions .button { padding-inline: 12px; font-size: 0.9375rem; } } /* (the long label stays on one line at 320) */

  /* the levels strip: text only, one hairline row under the hero (2x2 on tablets, a list on phones) */
  .levels-strip { padding: 0 0 clamp(32px, 5vw, 56px); }
  .levels-strip h2 { margin-bottom: 14px; color: var(--muted); font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; }
  .levels-strip ul { display: grid; margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--hairline); }
  .levels-strip li { border-bottom: 1px solid var(--hairline); }
  .levels-strip li a { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 2px 12px; min-height: 64px; padding: 12px 4px; color: var(--ink); text-decoration: none; }
  .ls-name { font-weight: 650; }
  .ls-promise { grid-row: 2; color: var(--body); font-size: 0.9375rem; }
  .levels-strip li a :global(.icon) { grid-row: 1 / 3; grid-column: 2; width: 18px; height: 18px; color: var(--link); }
  .levels-strip p { margin-top: 12px; }
  @media (min-width: 640px) {
    .levels-strip ul { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 24px; }
  }
  @media (min-width: 1024px) {
    .levels-strip ul { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  @media (hover: hover) and (pointer: fine) {
    .levels-strip li a :global(.icon) { transition: transform var(--dur-1) var(--ease-out); }
    .levels-strip li a:hover .ls-name { color: var(--link); }
    .levels-strip li a:hover :global(.icon) { transform: translateX(3px); }
  }


  .prim { display: flex; flex-direction: column; gap: 12px; padding: 24px; border: 1px solid var(--hairline); border-radius: var(--r-lg); background: var(--panel); }
  .prim-icon { display: grid; place-items: center; width: 46px; height: 46px; border-radius: 12px; background: var(--accent-soft); color: var(--link); }
  .prim-icon :global(.icon) { width: 24px; height: 24px; }
  .prim p { font-size: 0.9375rem; }
  .prim .ticks { font-size: 0.9375rem; gap: 8px; }
  .prim .prim-outcome { margin-bottom: -6px; color: var(--cyan); font-size: 0.875rem; font-weight: 600; }
  .prim-price { margin-top: auto; padding-top: 14px; border-top: 1px solid var(--hairline-soft); color: var(--ink); font-weight: 650; }
  .prim-note { display: block; margin-top: 2px; color: var(--muted); font-size: 0.875rem; font-weight: 500; }
  .prim .text-link { min-height: 44px; }
  /* a thin accent line along the top of each card, brighter under a mouse */
  .prim { position: relative; overflow: hidden; }
  .prim::before { content: ""; position: absolute; inset: 0 0 auto; height: 2px; background: linear-gradient(90deg, var(--blue), var(--cyan)); opacity: 0.45; transition: opacity var(--dur-2) ease; }
  @media (hover: hover) and (pointer: fine) {
    .prim:hover::before { opacity: 1; }
    .prim .text-link :global(.icon) { transition: transform var(--dur-1) var(--ease-out); }
    .prim:hover .text-link :global(.icon) { transform: translateX(3px); }
  }
  .tier { gap: 10px; }
  .prim .tier-price { padding-block: 12px; border-block: 1px solid var(--hairline-soft); color: var(--ink); font-size: 1.5rem; font-weight: 700; letter-spacing: -0.02em; }
  .tier-price .prim-note { letter-spacing: 0; }
  .more { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; margin-top: 32px; }
  .more .text-link { display: inline-flex; align-items: center; min-height: 44px; }
  @media (max-width: 479px) { .more .button { flex: 1 1 100%; } }

  .web-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 0 24px; }
  .web-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: clamp(32px, 4vw, 48px); }
  @media (max-width: 479px) { .web-actions .button { flex: 1 1 100%; } }
  .also-note { display: flex; align-items: flex-start; gap: 8px; margin-top: 12px; max-width: 80ch; }
  .also-note :global(.icon) { flex: none; margin-top: 0.2em; width: 1.05em; height: 1.05em; }
  .cases { display: grid; gap: 20px; margin-top: 24px; }
  .home-video { margin-top: clamp(32px, 4vw, 48px); }

  /* the five steps as numbered rows: number, title, then the text in its own column on wide screens */
  .steps { list-style: none; border-top: 1px solid var(--hairline); }
  .step { display: grid; grid-template-columns: 40px minmax(0, 1fr); gap: 10px 20px; align-items: center; padding: 22px 0; border-bottom: 1px solid var(--hairline); }
  .step-num { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--button); color: #fff; font-weight: 700; font-variant-numeric: tabular-nums; }
  .step h3 { font-size: 1.1875rem; }
  .step p { grid-column: 2; color: var(--body); }
  @media (min-width: 880px) {
    .step { grid-template-columns: 40px minmax(0, 17rem) minmax(0, 1fr); gap: 0 28px; align-items: start; padding: 26px 0; }
    .step h3 { line-height: 40px; }
    .step p { grid-column: 3; padding-top: 8px; }
  }

  /* one trust band: five short promises. One column on a phone, three then two from 720px, five across from 1100px */
  .trust { display: grid; gap: 14px; list-style: none; }
  .trust li { display: grid; grid-template-columns: 40px minmax(0, 1fr); gap: 2px 14px; align-content: start; padding: 18px; border: 1px solid var(--hairline); border-radius: var(--r-lg); background: var(--panel); }
  .trust li > :global(.icon) { grid-row: span 2; width: 40px; height: 40px; padding: 9px; border-radius: 10px; background: rgba(34, 211, 238, 0.1); color: var(--cyan); }
  .trust h3 { font-size: 1.0625rem; }
  .trust p { grid-column: 2; color: var(--body); font-size: 0.9375rem; }
  @media (min-width: 720px) {
    .trust { grid-template-columns: repeat(6, minmax(0, 1fr)); }
    .trust li { grid-column: span 2; }
    .trust li:nth-child(n + 4) { grid-column: span 3; }
  }
  @media (min-width: 1100px) {
    .trust { grid-template-columns: repeat(5, minmax(0, 1fr)); }
    .trust li, .trust li:nth-child(n + 4) { grid-column: auto; grid-template-columns: minmax(0, 1fr); gap: 8px; }
    .trust li > :global(.icon) { grid-row: auto; margin-bottom: 4px; }
    .trust p { grid-column: 1; }
  }
  .trust-foot { display: flex; align-items: flex-start; gap: 8px; max-width: 110ch; text-wrap: pretty; margin-top: 24px; color: var(--muted); font-size: 0.9375rem; }
  .trust-foot :global(.icon) { flex: none; margin-top: 0.2em; width: 1.05em; height: 1.05em; }

  .final { padding: clamp(64px, 9vw, 112px) 0; }
  .final-box {
    padding: clamp(40px, 6vw, 72px) clamp(20px, 5vw, 64px); text-align: center;
    border: 1px solid var(--hairline); border-radius: 24px;
    background: radial-gradient(80% 120% at 50% 0%, rgba(59, 130, 246, 0.18), transparent 70%), var(--bg-2);
  }
  .final-box h2 { max-width: 22ch; margin-inline: auto; }
  .final-box > p { max-width: 60ch; margin: 18px auto 0; font-size: 1.0625rem; text-wrap: balance; }
  .final-actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 12px 24px; margin-top: 32px; }
  .final-mail { display: inline-flex; align-items: center; gap: 8px; min-height: 48px; font-weight: 600; text-decoration: none; overflow-wrap: anywhere; }
  @media (max-width: 559px) { .final-actions .button { width: 100%; } }

  .sticky-cta, .sticky-cta[hidden] { display: none; }
