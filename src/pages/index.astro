    position: relative; z-index: 1; display: grid; place-items: center; width: 44px; height: 44px; border-radius: var(--r-full);
    background: var(--ink); color: var(--bg); box-shadow: inset 0 0 0 1.5px var(--ink); font-weight: 700; font-variant-numeric: tabular-nums;
  }
