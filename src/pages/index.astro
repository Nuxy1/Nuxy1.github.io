---
import { Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import Icon, { type IconName } from "../components/Icon.astro";
import hero from "../assets/photos/hero.jpg";
import booking from "../assets/photos/booking.jpg";
import followUp from "../assets/photos/follow-up.jpg";
import reviews from "../assets/photos/reviews.jpg";
import newWebsite from "../assets/photos/new-website.jpg";
import siteFixes from "../assets/photos/site-fixes.jpg";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// The request form is an email: no server to run, and the answer lands in the inbox the work runs from.
// (a chosen package's own request names it at the top; Gmail and Outlook links for computers with no email app,
// where a mailto: link does nothing at all)
const inbox = "nuxy@nuxyautomation.com";
type Item = { name: string; price: string };
const subject = (p?: Item) => (p ? `Setup request: ${p.name}` : "Setup request");
const body = (p?: Item) => `${p ? `Service: ${p.name} (${p.price})\n` : ""}Business name:\nWebsite:\nWhat kind of business:\nTools you use now (booking, ordering, accounting, email, CRM...):\nWhat you'd like fixed or set up:\nAnything else:\n`;
const query = (fields: Record<string, string>) => new URLSearchParams(fields).toString().replace(/\+/g, "%20");
const ask = (p?: Item) => `mailto:${inbox}?` + query({ subject: subject(p), body: body(p) });
const gmail = (p?: Item) => "https://mail.google.com/mail/?" + query({ view: "cm", fs: "1", to: inbox, su: subject(p), body: body(p) });
const outlook = (p?: Item) => "https://outlook.live.com/mail/0/deeplink/compose?" + query({ to: inbox, subject: subject(p), body: body(p) });

// (ids are linked from outreach emails: keep them stable)
const packages = [
  { id: "booking", photo: booking, alt: "A hand holding a phone with a booking page at a spa’s front desk.", name: "Online booking & reminders", price: "$400", fixes: "calls you miss while you’re with a customer", text: "A Book now button on your website, Google profile and Instagram, connected to the booking tool you already use (or a free one), plus automatic text and email reminders that cut no-shows." },
  { id: "follow-up", photo: followUp, alt: "A nail technician at work while a new message lights up her phone.", name: "Lead follow-up", price: "$450", fixes: "messages that wait hours for an answer", text: "Every website form, email, Facebook or Instagram inquiry gets an instant reply, 2 friendly follow-ups and an alert to you, so nobody waits until you’re free. A contact form added if your site has none." },
  { id: "reviews", photo: reviews, alt: "A barbershop client smiling at his new haircut in the mirror.", name: "Review requests", price: "$250", fixes: "happy customers who never leave a review", text: "After each visit, job or order, every customer gets a short thank-you with a link to leave you a Google review. More reviews, no awkward asking." },
  { id: "new-website", photo: newWebsite, alt: "A dance studio owner sitting on the studio floor with a laptop.", name: "New website", price: "$900", fixes: "no website, or one too old to fix", text: "Up to 4 pages, built for phones: your services and prices, hours, map and a Book, Quote or Order button, on your own domain. Built in your own Squarespace or Wix account, so you can edit it and it stays yours." },
  { id: "site-fixes", photo: siteFixes, alt: "A phone showing a website in a tattoo studio, the artist setting up behind.", name: "Website quick fixes", price: "from $150", fixes: "a site that looks broken on a phone", text: "Secure https, a phone-friendly page setup, a booking or quote button and a contact form that works: on the site you already have." },
];
const oneOff = packages;

// Every other service, in three groups (ids are linked from outreach emails: keep them stable)
type Service = Item & { id: string; icon: IconName; fixes: string; text: string };
const groups: { id: string; title: string; lead: string; items: Service[] }[] = [
  { id: "customers", title: "Win and keep customers", lead: "For the inquiries, orders and regulars that slip away while you’re busy.", items: [
    { id: "quotes", icon: "clipboardText", name: "Quote requests", price: "$450", fixes: "calls you can’t take on a job", text: "A Get a quote form on your site (photos welcome), an instant reply to the customer, a reminder to you to send the estimate, and a follow-up if they go quiet." },
    { id: "email-list", icon: "envelopeOpen", name: "Email list & welcome emails", price: "$300", fixes: "customers who never hear from you again", text: "A sign-up form on your site and at checkout, 3 welcome emails in your voice, and your existing customers imported (only people who agreed), in Mailchimp, Brevo or Klaviyo." },
    { id: "ordering", icon: "forkKnife", name: "Online ordering & reservations", price: "$400", fixes: "a phone ringing at your busiest hour", text: "Online ordering and table reservations switched on in the system you already use (Toast, Square, Clover) or a free one, with Order and Reserve buttons on your site and Google profile." },
    { id: "ai-replies", icon: "robot", name: "AI inquiry assistant", price: "$750", fixes: "an inbox that eats your evenings", text: "New emails and form messages sorted by AI, with a drafted answer waiting in your inbox for you to approve and an alert for anything urgent. Nothing is sent without you." },
  ] },
  { id: "admin", title: "Less admin", lead: "For the copy-and-paste hours between your tools.", items: [
    { id: "invoices", icon: "receipt", name: "Invoices & payment reminders", price: "$350", fixes: "invoices sent late and paid later", text: "Invoices sent automatically when a job is done or an order ships, from QuickBooks, Stripe, Square or Wave, friendly reminders when one is overdue, and an alert when it’s paid." },
    { id: "store", icon: "storefront", name: "Online store automations", price: "$500", fixes: "orders typed into spreadsheets by hand", text: "For Shopify, WooCommerce or Square stores: every order into your spreadsheet or accounting, low-stock alerts, abandoned-cart and thank-you emails." },
    { id: "reports", icon: "chartLineUp", name: "Weekly report", price: "$300", fixes: "numbers scattered across five apps", text: "One email or live dashboard every Monday with the numbers you care about: sales, leads, bookings, reviews, pulled from the tools you already use." },
    { id: "data", icon: "broom", name: "Data clean-up & import", price: "from $200", fixes: "messy, duplicated customer lists", text: "Customer and contact lists cleaned, duplicates merged and moved into your new CRM or email tool, with every change counted." },
    { id: "integrations", icon: "plugsConnected", name: "Custom integrations", price: "from $750", fixes: "apps that don’t talk to each other", text: "Your CRM, email marketing, inventory sheet, accounting and website connected with custom connectors and webhooks: every record checked, never written twice, retried when a service is down, and an alert if anything fails." },
  ] },
  { id: "web", title: "Websites and Google", lead: "For being easy to find and easy to buy from.", items: [
    { id: "online-shop", icon: "shoppingBag", name: "Online shop", price: "$1,200", fixes: "customers who can’t buy unless they come in", text: "A store on Square Online or Shopify in your own account: up to 25 products from photos you send, payments, pickup or shipping, and a Shop button on your site." },
    { id: "google-profile", icon: "mapTrifold", name: "Google profile setup", price: "$250", fixes: "a business Google barely shows", text: "Your Google Business Profile claimed or created, with categories, hours, services, your photos and your website and booking links. I walk you through Google’s own verification." },
  ] },
];

// The monthly plans (billed monthly by Stripe, cancel any time)
const plans = [
  { id: "care", name: "Care plan", price: "$100/month", amount: "$100", who: "A website and a few simple automations", points: ["Website checked every 5 minutes, 24/7", "Anything that breaks fixed within one business day", "Domain and security renewals watched", "Small changes when you ask"] },
  { id: "automation-care", name: "Automation care", price: "$500/month", amount: "$500", who: "Businesses running several automations", points: ["Up to 10 automations or integrations monitored", "Failed runs alert me, fixed the same business day", "A monthly report of what ran and what was fixed", "Up to 3 hours of small changes a month"] },
  { id: "automation-partner", name: "Automation partner", price: "$1,000/month", amount: "$1,000", who: "Your automation team, on call", points: ["Everything in Automation care", "One new automation or integration every month", "Fixes started within 4 business hours", "A quarterly look at your tools for more time to save"] },
];

// Who it's for: each kind of business and the services that fit it first
const kinds: { icon: IconName; name: string; who: string; links: [string, string][] }[] = [
  { icon: "calendarCheck", name: "Appointments", who: "Salons, spas, studios, clinics, groomers", links: [["Online booking", "#booking"], ["Deposits", "#deposits"], ["Review requests", "#reviews"]] },
  { icon: "hammer", name: "Trades & home services", who: "Plumbers, electricians, cleaners, contractors, auto shops", links: [["Quote requests", "#quotes"], ["Invoices & reminders", "#invoices"], ["Missed-call text-back", "#missed-calls"]] },
  { icon: "forkKnife", name: "Restaurants & cafés", who: "Restaurants, cafés, bakeries, breweries", links: [["Online ordering", "#ordering"], ["Email list", "#email-list"], ["Gift cards", "#gift-cards"]] },
  { icon: "storefront", name: "Shops & online stores", who: "Boutiques, gift shops, garden centers, online stores", links: [["Online shop", "#online-shop"], ["Store automations", "#store"], ["Email list", "#email-list"]] },
  { icon: "briefcase", name: "Offices & professional services", who: "Law, accounting, real estate, insurance, consultants", links: [["Lead follow-up", "#follow-up"], ["AI inquiry assistant", "#ai-replies"], ["Invoices & reminders", "#invoices"]] },
  { icon: "plugsConnected", name: "Any business", who: "Tools that don’t talk to each other", links: [["Custom integrations", "#integrations"], ["Weekly report", "#reports"], ["Data clean-up", "#data"]] },
];

// (ids are linked from outreach emails too)
const addons: (Item & { id: string; icon: IconName; fixes: string; text: string })[] = [
  { id: "missed-calls", icon: "phoneX", name: "Missed-call text-back", price: "$250", fixes: "callers who hang up and call someone else", text: "When you can’t pick up, the caller gets a text right away with your booking or quote link, set up in the booking or phone tool you already use." },
  { id: "deposits", icon: "creditCard", name: "Deposits & no-show protection", price: "$150", fixes: "empty chairs from no-shows", text: "A card on file or a small deposit when clients book, plus a clear cancellation policy, switched on in your booking tool." },
  { id: "gift-cards", icon: "gift", name: "Online gift cards", price: "$150", fixes: "gift shoppers with nowhere to buy", text: "A Buy a gift card button on your website, Google profile and Instagram, using your booking or point-of-sale tool’s own gift cards." },
];

// The finder under the hero: start from the problem, land on the package that fixes it.
const problems = [
  { label: "Missed inquiries", text: "Instant replies", href: "#follow-up" },
  { label: "Busy phone", text: "Book, quote, order online", href: "#kinds" },
  { label: "Admin hours", text: "Invoices that send themselves", href: "#invoices" },
  { label: "Apps that don’t talk", text: "Connect them", href: "#integrations" },
];

const steps = [
  ["Tell me in writing", "Send the request below: your business, your website, the tools you use and what you’d like fixed. No call to schedule."],
  ["Get the plan and price", "Within one business day: a written plan and a fixed price. No surprises later."],
  ["I build it in your accounts", "50% to start, paid by a secure Stripe invoice. I work as an invited user, never with your passwords, and test with real examples."],
  ["Handover", "A short video guide showing it working, then the other 50% by the same kind of invoice. Add a monthly plan if you want it looked after."],
];

// What search engines read about the business (schema.org): only what the page itself says.
const site = "https://nuxyautomation.com/";
const priceOf = (price: string) => {
  const n = Number(price.replace(/\D/g, ""));
  if (price.startsWith("from")) return { "@type": "PriceSpecification", minPrice: n, priceCurrency: "USD" };
  if (price.includes("/month")) return { "@type": "UnitPriceSpecification", price: n, priceCurrency: "USD", unitText: "MONTH" };
  return { "@type": "PriceSpecification", price: n, priceCurrency: "USD" };
};
const business = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "Nuxy Automation",
  url: site,
  logo: `${site}logo.png`,
  image: `${site}og.jpg`,
  email: inbox,
  description: "Automations, integrations and websites for small businesses of every kind: instant replies, online booking, quotes and ordering, invoices, store automations, reports and custom connectors. Fixed prices, no calls needed.",
  address: { "@type": "PostalAddress", addressLocality: "Faribault", addressRegion: "MN", addressCountry: "US" },
  areaServed: ["Minneapolis", "Saint Paul", "Faribault", "Northfield", "Owatonna"].map((name) => ({ "@type": "City", name })),
  priceRange: "$150-$1200",
  sameAs: ["https://github.com/Nuxy1"],
  // (each package is an offer, so a search result can show what it costs)
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Services",
    itemListElement: [...packages, ...groups.flatMap((g) => g.items), ...addons, ...plans].map((p) => ({
      "@type": "Offer",
      url: `${site}#${p.id}`,
      priceSpecification: priceOf(p.price),
      itemOffered: { "@type": "Service", name: p.name, description: "text" in p ? p.text : `${p.who}: ${p.points.join("; ")}.` },
    })),
  },
};

const work = [
  { name: "Shopify order webhook relay", repo: "shopify-webhook-relay", doc: "webhook-relay", text: "Every order to Google Sheets and Slack or Discord: checked, never written twice, retried, failures replayable." },
  { name: "Code steps for Zapier & n8n", repo: "automation-code-steps", doc: "code-steps", text: "Paste-ready steps that clean phone numbers, names, dates and time zones inside an automation." },
  { name: "CSV contact cleaner", repo: "csv-contact-cleaner", doc: "csv-cleaner", text: "Cleans and dedupes a contact list before an import, with every change counted." },
  { name: "Stream community bot", repo: "stream-community-bot", doc: "community-bot", text: "A Discord bot for a creator’s community: welcome cards, role buttons, live alerts." },
];
const photoSizes = "(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw";
---
<Base title="Nuxy Automation · Automations and integrations for small businesses" description="Your tools connected and your busywork automated: instant replies, online booking, quotes and ordering, invoices, store automations, reports and custom integrations for any small business. Fixed prices, no calls. Faribault, Minnesota." wide>
  <script type="application/ld+json" set:html={JSON.stringify(business)} />

  <section class="wrap hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <h1 id="hero-title">Your tools connected. Your busywork automated.</h1>
      <p class="sub">Instant replies to every inquiry, online booking and ordering, invoices that send themselves, orders that land in your spreadsheet, apps that finally talk. For any small business. Fixed prices, no calls.</p>
      <p class="hero-actions">
        <a class="button" href="#request">Request a setup</a>
        <a class="button secondary" href={`${base}/demo/`}>See it working</a>
      </p>
    </div>
    <Picture class="hero-photo" src={hero} formats={["avif", "webp"]} widths={[640, 960, 1400]} sizes="(min-width: 900px) 46vw, 100vw" alt="A shop owner in a work apron smiling at her laptop behind a wooden counter stacked with orders." loading="eager" fetchpriority="high" />
  </section>

  <section class="wrap finder" aria-labelledby="finder-title">
    <h2 id="finder-title">What’s costing you customers or time?</h2>
    <nav class="finder-bar" aria-labelledby="finder-title">
      {problems.map((p) => (
        <a class="seg" href={p.href}><span class="seg-label">{p.label}</span><span class="seg-text">{p.text}</span></a>
      ))}
      <a class="orb" href="#services"><Icon name="magnifyingGlass" /><span class="orb-text">See all services</span></a>
    </nav>
  </section>

  <section id="kinds" class="wrap section" aria-labelledby="kinds-title">
    <h2 id="kinds-title" class="section-title">Built for your kind of business</h2>
    <p class="section-lead">Start from what you do. Each kind of business has the services that usually save it the most, and everything else on this page works for it too.</p>
    <ul class="kinds">
      {kinds.map((k) => (
        <li class="kind reveal">
          <span class="kind-icon"><Icon name={k.icon} /></span>
          <h3>{k.name}</h3>
          <p class="who">{k.who}</p>
          <p class="kind-links">{k.links.map(([label, href]) => <a href={href}>{label}</a>)}</p>
        </li>
      ))}
    </ul>
  </section>

  <section id="services" class="wrap section" aria-labelledby="packages-title">
    <h2 id="packages-title" class="section-title">Most requested</h2>
    <p class="section-lead">Fixed prices, agreed in writing before I start. Everything is built in your own accounts, so it stays yours. <a href={`${base}/demo/`}>See them working on a demo salon</a>.</p>
    <ul class="listings">
      {oneOff.map((p, i) => (
        <li class="reveal">
          <article class="listing" id={p.id} aria-labelledby={`${p.id}-name`}>
            <div class="photo"><Picture src={p.photo} formats={["avif", "webp"]} widths={[480, 760, 1100]} sizes={i < 3 ? photoSizes : "(min-width: 1024px) 580px, (min-width: 640px) 50vw, 100vw"} alt={p.alt} loading="lazy" /></div>
            <div class="title-row">
              <h3 id={`${p.id}-name`}>{p.name}</h3>
              <p class="price">{p.price}</p>
            </div>
            <p class="fixes">Fixes: {p.fixes}</p>
            <p class="desc">{p.text}</p>
            <p class="actions">
              <a class="request-link" href={ask(p)} aria-label={`Request a setup: ${p.name}`}>Request a setup<Icon name="arrowRight" /></a>
              <span class="alt">or in <a href={gmail(p)} target="_blank" rel="noopener">Gmail</a> or <a href={outlook(p)} target="_blank" rel="noopener">Outlook</a></span>
            </p>
          </article>
        </li>
      ))}
    </ul>

  </section>

  {groups.map((g) => (
    <section id={g.id} class="wrap section addons" aria-labelledby={`${g.id}-title`}>
      <div class="addons-head">
        <h2 id={`${g.id}-title`} class="section-title">{g.title}</h2>
        <p class="section-lead">{g.lead}</p>
      </div>
      <ul class="extras">
        {g.items.map((a) => (
          <li class="extra reveal" id={a.id}>
            <span class="extra-icon"><Icon name={a.icon} /></span>
            <div class="extra-body">
              <div class="title-row">
                <h3>{a.name}</h3>
                <p class="price">{a.price}</p>
              </div>
              <p class="fixes">Fixes: {a.fixes}</p>
              <p class="desc">{a.text}</p>
              <p class="actions">
                <a class="request-link" href={ask(a)} aria-label={`Request a setup: ${a.name}`}>Request a setup<Icon name="arrowRight" /></a>
                <span class="alt">or in <a href={gmail(a)} target="_blank" rel="noopener">Gmail</a> or <a href={outlook(a)} target="_blank" rel="noopener">Outlook</a></span>
              </p>
            </div>
          </li>
        ))}
      </ul>
    </section>
  ))}


  <section id="add-ons" class="wrap section addons" aria-labelledby="add-ons-title">
    <div class="addons-head">
      <h2 id="add-ons-title" class="section-title">Add-ons</h2>
      <p class="section-lead">Small extras, on their own or with any service.</p>
    </div>
    <ul class="extras">
      {addons.map((a) => (
        <li class="extra reveal" id={a.id}>
          <span class="extra-icon"><Icon name={a.icon} /></span>
          <div class="extra-body">
            <div class="title-row">
              <h3>{a.name}</h3>
              <p class="price">{a.price}</p>
            </div>
            <p class="fixes">Fixes: {a.fixes}</p>
            <p class="desc">{a.text}</p>
            <p class="actions">
              <a class="request-link" href={ask(a)} aria-label={`Request a setup: ${a.name}`}>Request a setup<Icon name="arrowRight" /></a>
              <span class="alt">or in <a href={gmail(a)} target="_blank" rel="noopener">Gmail</a> or <a href={outlook(a)} target="_blank" rel="noopener">Outlook</a></span>
            </p>
          </div>
        </li>
      ))}
    </ul>
    <p class="something-else">Something else? Bots, scrapers of public data and custom dashboards are quoted in writing after one question.</p>
  </section>

  <section id="plans" class="wrap section" aria-labelledby="plans-title">
    <h2 id="plans-title" class="section-title">Monthly plans</h2>
    <p class="section-lead">Keep everything watched and growing after handover. Billed monthly by Stripe; cancel any time and it ends with the month already paid.</p>
    <ul class="plans">
      {plans.map((p, i) => (
        <li class={`plan reveal${i === plans.length - 1 ? " featured" : ""}`} id={p.id}>
          {i === plans.length - 1 && <p class="badge">Most complete</p>}
          <h3>{p.name}</h3>
          <p class="who">{p.who}</p>
          <p class="plan-price"><strong>{p.amount}</strong> a month</p>
          <ul class="points">{p.points.map((point) => <li><Icon name="check" />{point}</li>)}</ul>
          <a class={`button wide${i === plans.length - 1 ? "" : " secondary"}`} href={ask(p)}>Start {p.name}</a>
          <p class="alt plan-alt">or in <a href={gmail(p)} target="_blank" rel="noopener">Gmail</a> or <a href={outlook(p)} target="_blank" rel="noopener">Outlook</a></p>
        </li>
      ))}
    </ul>
    <p class="plan-note">Monitoring runs 24/7: websites are checked every 5 minutes, and automations alert me when a run fails. Fixes come within each plan’s stated time, not instantly.</p>
  </section>

  <section id="how" class="band" aria-labelledby="how-title">
    <div class="wrap">
      <h2 id="how-title" class="section-title">How it works</h2>
      <ol class="steps">
        {steps.map(([head, text], i) => (
          <li class="reveal">
            <span class="step-n" aria-hidden="true">{i + 1}</span>
            <h3>{head}</h3>
            <p>{text}</p>
          </li>
        ))}
      </ol>
      <p class="policy">No calls needed. Questions, plans and updates come in writing, with short screen recordings of each piece working.</p>
    </div>
  </section>

  <section id="work" class="wrap section" aria-labelledby="work-title">
    <h2 id="work-title" class="section-title">Projects I built</h2>
    <p class="section-lead">Nuxy Automation is new, so instead of testimonials, here is working code you can open and check.</p>
    <div class="work">
      <figure class="demo reveal">
        <video src={`${base}/relay-demo.mp4`} poster={`${base}/relay-demo-poster.jpg`} width="800" height="450" autoplay muted loop playsinline controls preload="metadata" aria-describedby="demo-caption"></video>
        <figcaption id="demo-caption">The order relay at work: a new order arriving, the clean spreadsheet row it writes, and a forged request refused.</figcaption>
      </figure>
      <ul class="projects">
        {work.map((w) => (
          <li class="reveal">
            <h3>{w.name}</h3>
            <p>{w.text}</p>
            <p class="links"><a href={`${base}/docs/${w.doc}/`}>How it works</a><a href={`https://github.com/Nuxy1/${w.repo}`}>Code</a></p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="request" class="wrap section request" aria-labelledby="request-title">
    <div class="request-copy">
      <h2 id="request-title" class="section-title">Request a setup</h2>
      <p class="section-lead">Email me your business name, website, the tools you use now and what you’d like fixed. You’ll have a written plan and a fixed price within one business day.</p>
      <ul class="facts">
        <li><Icon name="envelopeSimple" /><p><strong>Everything in writing.</strong> No calls needed: questions, plans and updates come by email.</p></li>
        <li><Icon name="creditCard" /><p><strong>Paying:</strong> a secure Stripe invoice by email, by card, Apple Pay, Google Pay or bank transfer. 50% to start, 50% at handover; monthly plans are billed monthly.</p></li>
        <li><Icon name="mapPin" /><p><strong>Based in Faribault, Minnesota.</strong> Twin Cities and southern Minnesota businesses first, and anywhere remotely.</p></li>
      </ul>
    </div>
    <aside class="ticket" aria-label="Send your request">
      <p class="ticket-head"><strong>Written plan and price</strong><span>within one business day</span></p>
      <ul class="include">
        <li><Icon name="check" />Your business name</li>
        <li><Icon name="check" />Your website, if you have one</li>
        <li><Icon name="check" />The tools you use now</li>
        <li><Icon name="check" />What you’d like fixed</li>
      </ul>
      <a class="button wide" href={ask()}>Request a setup</a>
      <p class="ticket-note">Nothing is charged until you agree to the written plan.</p>
      <p class="other-ways">
        No email app? Open it in <a href={gmail()} target="_blank" rel="noopener">Gmail</a> or <a href={outlook()} target="_blank" rel="noopener">Outlook</a>, or write to <span class="address">{inbox}</span>
        <button class="copy" type="button" data-copy={inbox} hidden><Icon name="copy" /><span aria-live="polite">Copy address</span></button>
      </p>
    </aside>
  </section>

  <script is:inline>
    // Less motion: the demo video waits for its play button instead of starting by itself.
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) document.querySelectorAll("video[autoplay]").forEach((v) => { v.autoplay = false; v.pause(); });
    // Copy the address. (navigator.clipboard can be refused; then select the address and copy it the old way.)
    document.querySelectorAll("button.copy").forEach((button) => {
      const label = button.querySelector("span");
      button.hidden = false;
      button.addEventListener("click", async () => {
        const address = button.previousElementSibling;
        try {
          await navigator.clipboard.writeText(button.dataset.copy);
        } catch {
          const range = document.createRange();
          range.selectNodeContents(address);
          getSelection().removeAllRanges();
          getSelection().addRange(range);
          if (!document.execCommand("copy")) return; // (left selected: Ctrl+C still works)
        }
        label.textContent = "Copied";
        setTimeout(() => (label.textContent = "Copy address"), 2000);
      });
    });
  </script>
