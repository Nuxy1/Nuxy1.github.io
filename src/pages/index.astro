---
import { Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import Icon, { type IconName } from "../components/Icon.astro";
import hero from "../assets/photos/hero.jpg";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

import { ask, gmail, outlook, inbox } from "../lib/request";
import { caseFor, examples } from "../data/examples";
import { reviews } from "../data/reviews";

// Kinds of business: the strip that filters the services, and what each kind usually starts with.
const kinds: { id: string; icon: IconName; name: string; full: string; who: string; start: string[] }[] = [
  { id: "all", icon: "squaresFour", name: "All", full: "every business", who: "", start: [] },
  { id: "appointments", icon: "calendarCheck", name: "Appointments", full: "Appointment businesses", who: "salons, spas, studios, clinics, groomers", start: ["booking", "deposits", "reviews"] },
  { id: "trades", icon: "hammer", name: "Trades", full: "Trades and home services", who: "plumbers, electricians, cleaners, contractors, auto shops", start: ["quotes", "invoices", "missed-calls"] },
  { id: "food", icon: "forkKnife", name: "Restaurants", full: "Restaurants and cafés", who: "restaurants, cafés, bakeries, breweries", start: ["ordering", "email-list", "gift-cards"] },
  { id: "retail", icon: "storefront", name: "Shops", full: "Shops and online stores", who: "boutiques, gift shops, garden centers, online stores", start: ["online-shop", "store", "email-list"] },
  { id: "office", icon: "briefcase", name: "Offices", full: "Offices and professional services", who: "law, accounting, real estate, insurance, consultants", start: ["follow-up", "ai-replies", "invoices"] },
];

// Every one-time service. ids are linked from outreach emails: keep them stable. fits: the kinds it suits ("all": every kind).
type Service = { name: string; price: string } & { id: string; icon: IconName; fixes: string; text: string; fits: string; popular?: boolean };
// (cols: cards per row on wide screens, so each group fills its rows)
const groups: { id: string; title: string; lead: string; cols?: number; items: Service[] }[] = [
  { id: "customers", title: "Win and keep customers", lead: "For the inquiries, bookings and regulars that slip away while you’re busy.", items: [
    { id: "booking", icon: "calendarCheck", name: "Online booking & reminders", price: "$400", fits: "appointments office", popular: true, fixes: "Calls you miss while you’re with a customer", text: "A Book now button on your website, Google profile and Instagram, connected to the booking tool you already use (or a free one), plus automatic text and email reminders that cut no-shows." },
    { id: "follow-up", icon: "chatCircleText", name: "Lead follow-up", price: "$450", fits: "all", popular: true, fixes: "Messages that wait hours for an answer", text: "Every website form, email, Facebook or Instagram inquiry gets an instant reply, 2 friendly follow-ups and an alert to you, so nobody waits until you’re free. A contact form added if your site has none." },
    { id: "reviews", icon: "star", name: "Review requests", price: "$250", fits: "all", popular: true, fixes: "Happy customers who never leave a review", text: "After each visit, job or order, every customer gets a short thank-you with a link to leave you a Google review. More reviews, no awkward asking." },
    { id: "quotes", icon: "clipboardText", name: "Quote requests", price: "$450", fits: "trades", fixes: "Calls you can’t take on a job", text: "A Get a quote form on your site (photos welcome), an instant reply to the customer, a reminder to you to send the estimate, and a follow-up if they go quiet." },
    { id: "email-list", icon: "envelopeOpen", name: "Email list & welcome emails", price: "$300", fits: "appointments food retail", fixes: "Customers who never hear from you again", text: "A sign-up form on your site and at checkout, 3 welcome emails in your voice, and your existing customers imported (only people who agreed), in Mailchimp, Brevo or Klaviyo." },
    { id: "ordering", icon: "forkKnife", name: "Online ordering & reservations", price: "$400", fits: "food", fixes: "A phone ringing at your busiest hour", text: "Online ordering and table reservations switched on in the system you already use (Toast, Square, Clover) or a free one, with Order and Reserve buttons on your site and Google profile." },
  ] },
  { id: "admin", title: "Less admin", lead: "For the inbox and copy-and-paste hours between your tools.", items: [
    { id: "ai-replies", icon: "robot", name: "AI inquiry assistant", price: "$750", fits: "all", fixes: "An inbox that eats your evenings", text: "New emails and form messages sorted by AI, with a drafted answer waiting in your inbox for you to approve and an alert for anything urgent. Nothing is sent without you." },
    { id: "invoices", icon: "receipt", name: "Invoices & payment reminders", price: "$350", fits: "trades office", fixes: "Invoices sent late and paid later", text: "Invoices sent automatically when a job is done or an order ships, from QuickBooks, Stripe, Square or Wave, friendly reminders when one is overdue, and an alert when it’s paid." },
    { id: "store", icon: "storefront", name: "Online store automations", price: "$500", fits: "retail", fixes: "Orders typed into spreadsheets by hand", text: "For Shopify, WooCommerce or Square stores: every order into your spreadsheet or accounting, low-stock alerts, abandoned-cart and thank-you emails." },
    { id: "reports", icon: "chartLineUp", name: "Weekly report", price: "$300", fits: "all", fixes: "Numbers scattered across five apps", text: "One email or live dashboard every Monday with the numbers you care about: sales, leads, bookings, reviews, pulled from the tools you already use." },
    { id: "data", icon: "broom", name: "Data clean-up & import", price: "from $200", fits: "all", fixes: "Messy, duplicated customer lists", text: "Customer and contact lists cleaned, duplicates merged and moved into your new CRM or email tool, with every change counted." },
    { id: "integrations", icon: "plugsConnected", name: "Custom integrations", price: "from $750", fits: "all", fixes: "Apps that don’t talk to each other", text: "Your CRM, email marketing, inventory sheet, accounting and website connected with custom connectors and webhooks: every record checked, never written twice, retried when a service is down, and an alert if anything fails." },
  ] },
  { id: "web", title: "Websites and Google", lead: "For being easy to find and easy to buy from.", cols: 4, items: [
    { id: "new-website", icon: "globeSimple", name: "New website", price: "$900", fits: "all", popular: true, fixes: "No website, or one too old to fix", text: "Up to 4 pages, built for phones: your services and prices, hours, map and a Book, Quote or Order button, on your own domain. Built in your own Squarespace or Wix account, so you can edit it and it stays yours." },
    { id: "site-fixes", icon: "wrench", name: "Website quick fixes", price: "from $150", fits: "all", popular: true, fixes: "A site that looks broken on a phone", text: "Secure https, a phone-friendly page setup, a booking or quote button and a contact form that works: on the site you already have." },
    { id: "online-shop", icon: "shoppingBag", name: "Online shop", price: "$1,200", fits: "retail", fixes: "Customers who can’t buy unless they come in", text: "A store on Square Online or Shopify in your own account: up to 25 products from photos you send, payments, pickup or shipping, and a Shop button on your site." },
    { id: "google-profile", icon: "mapTrifold", name: "Google profile setup", price: "$250", fits: "all", fixes: "A business Google barely shows", text: "Your Google Business Profile claimed or created, with categories, hours, services, your photos and your website and booking links. I walk you through Google’s own verification." },
  ] },
  { id: "add-ons", title: "Add-ons", lead: "Small extras, on their own or with any service.", items: [
    { id: "missed-calls", icon: "phoneX", name: "Missed-call text-back", price: "$250", fits: "trades appointments", fixes: "Callers who hang up and call someone else", text: "When you can’t pick up, the caller gets a text right away with your booking or quote link, set up in the booking or phone tool you already use." },
    { id: "deposits", icon: "creditCard", name: "Deposits & no-show protection", price: "$150", fits: "appointments", fixes: "Empty chairs from no-shows", text: "A card on file or a small deposit when clients book, plus a clear cancellation policy, switched on in your booking tool." },
    { id: "gift-cards", icon: "gift", name: "Online gift cards", price: "$150", fits: "appointments food retail", fixes: "Gift shoppers with nowhere to buy", text: "A Buy a gift card button on your website, Google profile and Instagram, using your booking or point-of-sale tool’s own gift cards." },
  ] },
];
const services = groups.flatMap((g) => g.items);
const kindData = Object.fromEntries(kinds.map(({ id, full, who, start }) => [id, { full, who, start }]));

// The monthly plans (billed monthly by Stripe, cancel any time)
const plans = [
  { id: "care", name: "Care plan", price: "$100/month", amount: "$100", who: "A website and a few simple automations", points: ["Website checked every 5 minutes, 24/7", "Anything that breaks fixed within one business day", "Domain and security renewals watched", "Small changes when you ask"] },
  { id: "automation-care", name: "Automation care", price: "$500/month", amount: "$500", who: "Businesses running several automations", points: ["Up to 10 automations or integrations monitored", "Failed runs alert me, fixed the same business day", "A monthly report of what ran and what was fixed", "Up to 3 hours of small changes a month"] },
  { id: "automation-partner", name: "Automation partner", price: "$1,000/month", amount: "$1,000", who: "Your automation team, on call", points: ["Everything in Automation care", "One new automation or integration every month", "Fixes started within 4 business hours", "A quarterly look at your tools for more time to save"] },
];

// The hero's moving notifications: examples of what the services do on their own (marked as examples on the page).
const feed: { icon: IconName; title: string; meta: string }[] = [
  { icon: "chatCircleText", title: "Website inquiry answered", meta: "Instant reply sent, you’re alerted" },
  { icon: "calendarCheck", title: "Booking confirmed", meta: "Saturday 10:00 · reminder set" },
  { icon: "receipt", title: "Invoice paid", meta: "$350 · thank-you email sent" },
  { icon: "star", title: "Review request sent", meta: "After today’s job" },
  { icon: "table", title: "Order added to your sheet", meta: "Stock count updated" },
  { icon: "phoneX", title: "Missed call texted back", meta: "Booking link sent" },
];

// Tools the services are built in (named in the services themselves): the client's own accounts.
const tools = ["Square", "Shopify", "QuickBooks", "Stripe", "Google Business Profile", "Gmail", "Outlook", "Mailchimp", "Toast", "Clover", "WooCommerce", "Squarespace", "Wix", "Acuity", "Wave", "Klaviyo", "Zapier", "Make", "n8n", "Slack"];

const steps = [
  ["Tell me in writing", "Send the request below: your business, your website, the tools you use and what you’d like fixed. No call to schedule."],
  ["Get the plan and price", "Within one business day: a written plan and a fixed price. No surprises later."],
  ["I build it in your accounts", "50% to start, paid by a secure Stripe invoice. I work as an invited user, never with your passwords, and test with real examples."],
  ["Handover", "A short video guide showing it working, then the other 50% by the same kind of invoice. Add a monthly plan if you want it looked after."],
];

// Answers only from the written policies (/policies/) and the contract.
const faqs = [
  ["Do we need to get on a call?", "No. Your request, the written plan and price, questions and updates all happen by email, with short screen recordings of each piece working."],
  ["Who owns what you build?", "You do. Everything is built in your own accounts (your booking tool, your Google, your Stripe), and once it’s paid in full everything I build is yours."],
  ["Do you need my passwords?", "No. I work as an invited user in your accounts and never ask for passwords. You can remove my access at any time."],
  ["What if something breaks after launch?", "Every job includes a 30-day launch watch: every failure alerts me, I check in with you on day 3 and day 14, and anything my work breaks is fixed at no charge. After that, anything that doesn’t do what the written plan says is still fixed at no charge, and a monthly plan keeps it watched."],
  ["How do I pay?", "By a secure Stripe invoice: card, Apple Pay, Google Pay or bank transfer. 50% to start and 50% at handover; monthly plans are billed monthly. Nothing is charged until you agree to the written plan."],
  ["Is there a discount for more than one service?", "Yes. Order 2 one-time services together and the total is 10% off; 3 or more, 15% off. Add-ons count, monthly plans aren’t discounted, and the discount is written into the plan and price before you pay anything."],
  ["What if I change my mind?", "Cancel before work starts and the whole deposit is refunded. After that, I refund the part that covers work not yet done. Monthly plans end with the month already paid."],
  ["Do you work outside Minnesota?", "Yes. I’m based in Faribault and start with Twin Cities and southern Minnesota businesses, and everything works remotely anywhere in the US."],
];

// What search engines read about the business (schema.org): only what the page itself says.
const site = "https://nuxyautomation.com/";
const priceOf = (price: string) => {
  const n = Number(price.replace(/\D/g, ""));
  if (price.startsWith("from")) return { "@type": "PriceSpecification", minPrice: n, priceCurrency: "USD" };
  if (price.includes("/month")) return { "@type": "UnitPriceSpecification", price: n, priceCurrency: "USD", unitText: "MONTH" };
  return { "@type": "PriceSpecification", price: n, priceCurrency: "USD" };
};
const business = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "Nuxy Automation",
  url: site,
  logo: `${site}logo.png`,
  image: `${site}og.jpg`,
  email: inbox,
  description: "Automations, integrations and websites for small businesses of every kind: instant replies, online booking, quotes and ordering, invoices, store automations, reports and custom connectors. Fixed prices, no calls needed.",
  address: { "@type": "PostalAddress", addressLocality: "Faribault", addressRegion: "MN", addressCountry: "US" },
  areaServed: ["Minneapolis", "Saint Paul", "Faribault", "Northfield", "Owatonna"].map((name) => ({ "@type": "City", name })),
  priceRange: "$150-$1200",
  sameAs: ["https://github.com/Nuxy1"],
  // (each service is an offer, so a search result can show what it costs)
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Services",
    itemListElement: [...services, ...plans].map((p) => ({
      "@type": "Offer",
      url: `${site}#${p.id}`,
      priceSpecification: priceOf(p.price),
      itemOffered: { "@type": "Service", name: p.name, description: "text" in p ? p.text : `${p.who}: ${p.points.join("; ")}.` },
    })),
  },
};
const faqData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })),
};

// How a job keeps working (business/delivery-playbook.md, in short).
const keep: { icon: IconName; title: string; text: string }[] = [
  { icon: "sealCheck", title: "Your tools’ own features first", text: "If your booking tool or accounting app can already do it, I set that up properly. Custom code only where your tools can’t, and then only on tested code." },
  { icon: "clipboardText", title: "Tested on your real, messy data", text: "A dry run on a copy of your records: names in capitals, typos, duplicates, odd dates. Every message is read by a person before anything goes live." },
  { icon: "bellSimple", title: "30-day launch watch, included", text: "For the first 30 days every failure alerts me, with check-ins on day 3 and day 14. Anything my work breaks is fixed at no charge." },
  { icon: "shieldCheck", title: "An off switch, and a plan", text: "You can pause it yourself in one step. If something goes wrong, I pause it first, tell you within 4 business hours, and fix it with a test so it can’t come back." },
];

// The working examples' demo week (src/data/examples.ts).
const week = examples.map(({ slug, tab, who, lines }) => ({ id: slug, tab, who, lines }));

const work = [
  { name: "Shopify order webhook relay", repo: "shopify-webhook-relay", doc: "webhook-relay", text: "Every order to Google Sheets and Slack or Discord: checked, never written twice, retried, failures replayable." },
  { name: "Code steps for Zapier & n8n", repo: "automation-code-steps", doc: "code-steps", text: "Paste-ready steps that clean phone numbers, names, dates and time zones inside an automation." },
  { name: "CSV contact cleaner", repo: "csv-contact-cleaner", doc: "csv-cleaner", text: "Cleans and dedupes a contact list before an import, with every change counted." },
];
---
<Base title="Nuxy Automation · Automations and integrations for small businesses" description="Your tools connected and your busywork automated: instant replies, online booking, quotes and ordering, invoices, store automations, reports and custom integrations for any small business. Fixed prices, no calls. Faribault, Minnesota." wide>
  <script type="application/ld+json" set:html={JSON.stringify(business)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqData)} />

  <section class="wrap hero" aria-labelledby="hero-title" data-hero>
    <div class="hero-copy">
      <h1 id="hero-title">Your tools connected. Your busywork automated.</h1>
      <p class="sub">Instant replies to every inquiry, online booking and ordering, invoices that send themselves, orders that land in your spreadsheet, apps that finally talk. For any small business.</p>
      <p class="hero-actions">
        <a class="button" href="#request">Request a setup</a>
        <a class="button secondary" href="#services">Browse services</a>
      </p>
      <ul class="promises">
        <li><Icon name="checkCircle" />Fixed prices in writing</li>
        <li><Icon name="checkCircle" />Built in your accounts</li>
        <li><Icon name="checkCircle" />No calls needed</li>
      </ul>
    </div>
    <div class="hero-media">
      <Picture class="hero-photo" src={hero} formats={["avif", "webp"]} widths={[640, 960, 1400]} sizes="(min-width: 900px) 46vw, 100vw" alt="A shop owner in a work apron smiling at her laptop behind a wooden counter stacked with orders." loading="eager" fetchpriority="high" />
      <div class="feed-box" aria-hidden="true">
        <p class="feed-label"><span class="live"></span>Examples of what runs while you work</p>
        <ul class="feed" data-feed>
          {feed.map((f, i) => (
            <li class={i < 3 ? "on" : undefined}>
              <span class="feed-icon"><Icon name={f.icon} /></span>
              <span class="feed-text"><strong>{f.title}</strong><span>{f.meta}</span></span>
              <span class="feed-time">now</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="tools" aria-labelledby="tools-title">
    <h2 id="tools-title" class="tools-label">Built in the tools you already use</h2>
    <div class="marquee">
      <div class="marquee-track">
        <ul>{tools.map((t) => <li>{t}</li>)}</ul>
        <ul aria-hidden="true">{tools.map((t) => <li>{t}</li>)}</ul>
      </div>
    </div>
  </section>

  <section id="services" class="wrap section" aria-labelledby="services-title" data-catalog data-kinds={JSON.stringify(kindData)}>
    <div class="section-head">
      <h2 id="services-title" class="section-title">Services</h2>
      <p class="section-lead">Fixed prices, agreed in writing before I start. Everything is built in your own accounts, so it stays yours. <a href={`${base}/demo/`}>See online booking working on a demo</a>.</p>
    </div>
    <div id="kinds" class="strip-wrap">
      <div class="strip" role="toolbar" aria-label="Show services for your kind of business" hidden>
        {kinds.map((k, i) => (
          <button type="button" data-kind={k.id} aria-pressed={i === 0 ? "true" : "false"}><Icon name={k.icon} /><span>{k.name}</span></button>
        ))}
      </div>
    </div>
    <p class="kind-note" aria-live="polite">All {services.length} services. Pick your kind of business to see what usually helps first.</p>
    <p class="bundle-note"><Icon name="sparkle" /><span><strong>Bundle and save.</strong> Order 2 services together and the total is 10% off; 3 or more, 15% off.<span data-js-only hidden> Tap <span class="mini" aria-hidden="true">+</span> on any service to build yours.</span></span></p>

    {groups.map((g) => (
      <div class="group" id={g.id}>
        <div class="group-head">
          <h3>{g.title}</h3>
          <p>{g.lead}</p>
        </div>
        <ul class={g.cols === 4 ? "svcs four" : "svcs"}>
          {g.items.map((s) => (
            <li class="svc reveal" id={s.id} data-fits={s.fits} data-name={s.name} data-price={s.price} style={`view-transition-name: svc-${s.id}`}>
              <div class="svc-top">
                <span class="svc-icon"><Icon name={s.icon} /></span>
                <span class="tags">
                  <span class="tag start-tag">Start here</span>
                  {s.popular && <span class="tag popular-tag">Most requested</span>}
                  <button class="pick" type="button" aria-pressed="false" aria-label={`Add ${s.name} to your bundle`} title="Add to your bundle" data-pick hidden><Icon name="plus" /><Icon name="check" /></button>
                </span>
              </div>
              <div class="svc-title">
                <h4>{s.name}</h4>
                <p class="price">{s.price}</p>
              </div>
              <p class="svc-fixes">Fixes: {s.fixes.charAt(0).toLowerCase() + s.fixes.slice(1)}</p>
              <details class="svc-more">
                <summary>What’s included<Icon name="caretDown" /></summary>
                <div class="svc-body">
                  <p>{s.text}</p>
                  {caseFor[s.id] && <p class="see"><a href={`${base}/work/${caseFor[s.id]}/`}>See it working on a made-up {examples.find((e) => e.slug === caseFor[s.id])?.kind}<Icon name="arrowRight" /></a></p>}
                  <p class="svc-actions">
                    <a class="request-link" href={ask(s)} aria-label={`Request a setup: ${s.name}`}>Request this<Icon name="arrowRight" /></a>
                    <span class="alt">or in <a href={gmail(s)} target="_blank" rel="noopener">Gmail</a> or <a href={outlook(s)} target="_blank" rel="noopener">Outlook</a></span>
                  </p>
                </div>
              </details>
            </li>
          ))}
        </ul>
      </div>
    ))}
    <p class="something-else"><Icon name="question" /><span>Something else? Bots, scrapers of public data and custom dashboards are quoted in writing after one question. <a href="#request">Ask about it</a>.</span></p>
  </section>

  <section id="plans" class="wrap section" aria-labelledby="plans-title">
    <div class="section-head">
      <h2 id="plans-title" class="section-title">Monthly plans</h2>
      <p class="section-lead">Keep everything watched and growing after handover. Billed monthly by Stripe; cancel any time and it ends with the month already paid.</p>
    </div>
    <ul class="plans">
      {plans.map((p, i) => (
        <li class={`plan reveal${i === plans.length - 1 ? " featured" : ""}`} id={p.id}>
          {i === plans.length - 1 && <p class="badge">Most complete</p>}
          <h3>{p.name}</h3>
          <p class="who">{p.who}</p>
          <p class="plan-price"><strong>{p.amount}</strong> a month</p>
          <ul class="points">{p.points.map((point) => <li><Icon name="check" />{point}</li>)}</ul>
          <a class={`button wide${i === plans.length - 1 ? "" : " secondary"}`} href={ask(p)}>Start {p.name}</a>
          <p class="alt plan-alt">or in <a href={gmail(p)} target="_blank" rel="noopener">Gmail</a> or <a href={outlook(p)} target="_blank" rel="noopener">Outlook</a></p>
        </li>
      ))}
    </ul>
    <p class="plan-note">Monitoring runs 24/7: websites are checked every 5 minutes, and automations alert me when a run fails. Fixes come within each plan’s stated time, not instantly.</p>
  </section>

  <section id="how" class="band" aria-labelledby="how-title">
    <div class="wrap">
      <h2 id="how-title" class="section-title">How it works</h2>
      <ol class="steps">
        {steps.map(([head, text], i) => (
          <li>
            <span class="step-n" aria-hidden="true">{i + 1}</span>
            <h3>{head}</h3>
            <p>{text}</p>
          </li>
        ))}
      </ol>
      <p class="policy"><Icon name="envelopeSimple" />No calls needed. Questions, plans and updates come in writing, with short screen recordings of each piece working.</p>
    </div>
  </section>

  <section id="keep" class="wrap section" aria-labelledby="keep-title">
    <div class="section-head">
      <h2 id="keep-title" class="section-title">Built to keep working</h2>
      <p class="section-lead">The job isn’t done when it works once. It’s done when it still works on day 300, with your real customers and their typos.</p>
    </div>
    <ul class="keep">
      {keep.map((k) => (
        <li class="reveal">
          <span class="keep-icon"><Icon name={k.icon} /></span>
          <h3>{k.title}</h3>
          <p>{k.text}</p>
        </li>
      ))}
    </ul>
  </section>

  {reviews.length > 0 && (
    <section id="reviews-from-clients" class="wrap section" aria-labelledby="said-title">
      <div class="section-head">
        <h2 id="said-title" class="section-title">What clients say</h2>
        <p class="section-lead">Word for word, from where each review was left.</p>
      </div>
      <ul class="said">
        {reviews.map((r) => (
          <li class="reveal">
            {r.stars && <p class="stars" aria-label={`${r.stars} out of 5 stars`}>{"★".repeat(r.stars)}</p>}
            <blockquote>{r.quote}</blockquote>
            <p class="said-who"><strong>{r.name}</strong>{r.business && <span>, {r.business}</span>}<span class="said-src">{r.link ? <a href={r.link}>{r.source}</a> : r.source} · {r.date}</span></p>
          </li>
        ))}
      </ul>
    </section>
  )}

