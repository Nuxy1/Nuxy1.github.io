---
// Homepage (brief 4): what Nuxy builds, the four primary services, the portfolio of labeled examples, the five steps,
// customer ownership, why Nuxy, and one clear next step. Services and prices come from data/services.ts; nothing on
// this page is a client result. Section ids avoid the old one-page anchors that Base.astro forwards (any service or
// plan id, "services", "plans", "work", ...), or the forwarding script would send the visitor away.
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import DeviceShot from "../components/DeviceShot.astro";
import DemoSites from "../components/DemoSites.astro";
import CaseStudy from "../components/CaseStudy.astro";
import { primary, steps, services, tools, areas } from "../data/services";
import { inbox, caseStudies } from "../data/site";
import type { IconName } from "../components/Icon.astro";

// The cheapest and dearest one-time prices, for search engines' price range: read from the price list so it can't drift.
const oneTime = services.map((s) => Number(s.price.replace(/[^0-9]/g, ""))).filter(Boolean);

// Customer ownership: the same terms as /websites/#ownership and contract items 4 and 7.
const owned: { icon: IconName; title: string; text: string }[] = [
  { icon: "globeSimple", title: "Your domain, in your name", text: "Registered to you and paid by you, never held in our account." },
  { icon: "creditCard", title: "Your accounts, your billing", text: "The website or store plan is in your name, paid by you directly to Squarespace, Wix, Shopify or Square." },
  { icon: "lockSimple", title: "No passwords handed over", text: "We work as an invited user that you can remove at any time. You never share your password." },
  { icon: "shieldCheck", title: "Management is optional", text: "Stop the monthly plan whenever you like. Your website, domain and content stay yours, and nothing is switched off." },
];

const why: { icon: IconName; title: string; text: string }[] = [
  { icon: "receipt", title: "Transparent pricing", text: "Every price is published on this site, and your fixed price is in writing before anything starts. No hourly meter, no surprise invoice." },
  { icon: "listChecks", title: "Clear scopes", text: "The written plan says what’s included. One round of changes is included; anything new is quoted in writing first." },
  { icon: "browser", title: "Professional development", text: "Modern sites built for phones first, with clear pages, readable text and a quote or contact form that works." },
  { icon: "lockSimple", title: "Customer-owned accounts", text: "Built in your own accounts as an invited user, never with your passwords. Once it’s paid, everything built for you is yours." },
  { icon: "checkCircle", title: "Tested websites", text: "Pages, forms and buttons are tried on a phone and a computer before launch, and you get a short video showing it working." },
  { icon: "bellSimple", title: "Optional support", text: "Every job includes a 30-day launch watch. After that, monthly care is there if you want it, never a condition." },
];

const site = "https://nuxyautomation.com";
const business = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": `${site}/#business`,
  name: "Nuxy Automation",
  url: `${site}/`,
  logo: `${site}/logo.png`,
  image: `${site}/og.jpg`,
  email: inbox,
  description: "Websites, online stores and business automation for small businesses: business websites, Shopify and Square Online stores, lead response and follow-up, online booking and reminders, and invoice and admin automations, built in the client’s own accounts at fixed, published prices.",
  address: { "@type": "PostalAddress", addressLocality: "Faribault", addressRegion: "MN", addressCountry: "US" },
  areaServed: [
    ...["Faribault", "Northfield", "Owatonna", "Lakeville"].map((name) => ({ "@type": "City", name: `${name}, Minnesota` })),
    { "@type": "AdministrativeArea", name: "Southern Minnesota" },
    { "@type": "AdministrativeArea", name: "Minneapolis–Saint Paul metropolitan area" },
    { "@type": "Country", name: "United States" },
  ],
  priceRange: `$${Math.min(...oneTime)}-$${Math.max(...oneTime)}`,
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Website, online store and automation services",
    itemListElement: services.map((s) => ({
      "@type": "Offer",
      url: `${site}/solutions/#${s.id}`,
      itemOffered: { "@type": "Service", name: s.name, description: s.text },
      ...(s.price.startsWith("$") ? { price: s.price.replace(/[$,]/g, ""), priceCurrency: "USD" } : {}),
    })),
  },
};
---
<Base title="Nuxy Automation · Websites, Online Stores & Automation · Faribault, MN" wide>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(business)} />

  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Websites, online stores & automation · Faribault, MN</p>
        <h1><span>Professional Websites.</span> <span>Smarter Business.</span></h1>
        <p class="hero-lead">We build modern websites, online stores, and automations that help small businesses get found, attract customers, and save time.</p>
        <div class="hero-actions">
          <a class="button" href="/contact/" data-track="cta_hero">Get a Free Quote<Icon name="arrowRight" /></a>
          <a class="button secondary" href="/portfolio/" data-track="cta_work">See Our Work</a>
        </div>
        <ul class="trust" aria-label="How we work">
          <li><Icon name="check" />Fixed, published prices</li>
          <li><Icon name="check" />Your accounts, your website</li>
          <li><Icon name="check" />Tested before launch</li>
        </ul>
      </div>
      <DeviceShot slug="mossgate-cleaning" />
    </div>
  </section>

  <section class="section tight tools-band" aria-labelledby="tools-h">
    <div class="wrap">
      <h2 id="tools-h" class="tools-h">Works with the tools you already use</h2>
      <ul class="tools">{tools.map((t) => <li>{t}</li>)}</ul>
    </div>
  </section>

  <section class="section" id="what-we-build" aria-labelledby="build-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">What we build</p>
        <h2 id="build-h">Websites, online stores and automations, at fixed prices</h2>
        <p>Every build is a fixed, written price, in your own accounts. Management after launch is optional, never a condition.</p>
      </div>
      <div class="grid-4 primary">
        {primary.map((p) => (
          <article class="prim reveal">
            <span class="prim-icon"><Icon name={p.icon} /></span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
            <ul class="ticks">{p.points.map((pt) => <li><Icon name="check" />{pt}</li>)}</ul>
            <p class="prim-price">{p.price}</p>
            <a class="text-link" href={p.href}>{p.cta}<Icon name="arrowRight" /></a>
          </article>
        ))}
      </div>
      <p class="more"><a class="button secondary" href="/solutions/" data-track="cta_services">See all {services.length} services<Icon name="arrowRight" /></a><a class="text-link" href="/pricing/">Pricing and monthly plans<Icon name="arrowRight" /></a></p>
    </div>
  </section>

  <section class="section band" id="portfolio" aria-labelledby="portfolio-h">
    <div class="wrap">
      <div class="web-head">
        <div class="section-head">
          <p class="eyebrow">Portfolio</p>
          <h2 id="portfolio-h">See what we build, on a computer and a phone</h2>
          <p>Example websites and an online store for made-up businesses, each labeled as a demonstration. Open one to try it at full size.</p>
        </div>
        <div class="web-actions">
          <a class="button" href="/portfolio/" data-track="cta_portfolio">See the full portfolio</a>
          <a class="button secondary" href="/demos/">Try the interactive demos</a>
        </div>
      </div>
      <DemoSites />
      <p class="note tech-note"><Icon name="githubLogo" /><span>Looking for the technical side? Automations we’ve published as open source, each with its tests and docs, are under <a href="/demos/#technical">Technical projects</a>, kept apart from the website examples.</span></p>
      {caseStudies.length > 0 && <div class="cases">{caseStudies.map((c) => <CaseStudy study={c} />)}</div>}
    </div>
  </section>

  <section class="section" id="how" aria-labelledby="how-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">How it works</p>
        <h2 id="how-h">Five steps, all in writing</h2>
        <p>No sales call and no long contract. Nothing is charged until you agree to the written plan.</p>
      </div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li class="step reveal">
            <span class="step-num" aria-hidden="true">{i + 1}</span>
            <h3><span class="sr-only">Step {i + 1}: </span>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section band" id="ownership" aria-labelledby="ownership-h">
    <div class="wrap own">
      <div class="own-head">
        <p class="eyebrow">Customer ownership</p>
        <h2 id="ownership-h">Your website belongs to you. Always.</h2>
        <p>Buy it once and it’s yours. You pay your website builder and domain directly, never a fee to us to keep it online, and you don’t need to know anything about code or hosting to own it. If you choose our monthly management, you can stop it at any time and keep everything.</p>
        <a class="text-link" href="/websites/#ownership">How ownership and handover work<Icon name="arrowRight" /></a>
      </div>
      <ul class="own-list">
        {owned.map((o) => (
          <li class="reveal">
            <Icon name={o.icon} />
            <div><h3>{o.title}</h3><p>{o.text}</p></div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" id="why" aria-labelledby="why-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Why Nuxy</p>
        <h2 id="why-h">Straight answers, fair prices, work you own</h2>
      </div>
      <ul class="why">
        {why.map((w) => (
          <li class="reveal">
            <Icon name={w.icon} />
            <div><h3>{w.title}</h3><p>{w.text}</p></div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section band" aria-labelledby="about-h">
    <div class="wrap about">
      <div>
        <p class="eyebrow"><Icon name="mapPin" />Faribault, Minnesota</p>
        <h2 id="about-h">Local, independent and easy to reach</h2>
      </div>
      <div class="about-text">
        <p>Nuxy Automation is a small business based in Faribault. You deal directly with the person who builds your project, from your first question to handover, and you get answers in writing.</p>
        <p>We work with businesses in {areas.slice(0, -2).join(", ")}, {areas.at(-2)} and {areas.at(-1)}, and remotely anywhere in the US.</p>
        <a class="text-link" href="/about/">About Nuxy<Icon name="arrowRight" /></a>
      </div>
    </div>
  </section>

  <section class="final" aria-labelledby="final-h">
    <div class="wrap"><div class="final-box">
      <h2 id="final-h">Ready to Improve Your Business Online?</h2>
      <p>Tell us about your business and what you need: a new website, a redesign, an online store or an automation. You’ll get a written plan and a fixed price within one business day. No call required.</p>
      <div class="final-actions">
        <a class="button" href="/contact/" data-track="cta_final">Request a Free Quote<Icon name="arrowRight" /></a>
        <a class="final-mail" href={`mailto:${inbox}`}><Icon name="envelopeSimple" />{inbox}</a>
      </div>
    </div></div>
  </section>
</Base>

<style>
  .hero { position: relative; padding: clamp(48px, 8vw, 104px) 0 clamp(56px, 8vw, 96px); overflow: hidden; }
  .hero::before {
    content: ""; position: absolute; inset: -20% -10% auto; height: 80%; pointer-events: none;
    background: radial-gradient(60% 60% at 70% 30%, rgba(59, 130, 246, 0.16), transparent 70%);
  }
  .hero-grid { position: relative; display: grid; gap: clamp(40px, 6vw, 64px); align-items: center; }
  /* (each sentence on its own line on wide screens; the headline is a little smaller than other pages' so both fit) */
  .hero h1 { font-size: clamp(2.25rem, 1.2rem + 3vw, 3.125rem); }
  .hero h1 span { display: inline-block; }
  .hero-lead { max-width: 54ch; margin-top: 22px; font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.25rem); color: var(--body); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .trust { display: flex; flex-wrap: wrap; gap: 8px 20px; margin-top: 28px; list-style: none; color: var(--muted); font-size: 0.9375rem; }
  .trust li { display: inline-flex; align-items: center; gap: 6px; }
  .trust :global(.icon) { color: var(--cyan); width: 1.05em; height: 1.05em; }
  @media (min-width: 1024px) { .hero-grid { grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); } }
  @media (max-width: 479px) { .hero-actions .button { width: 100%; } }

  .tools-band { border-block: 1px solid var(--hairline-soft); padding-block: 28px; }
  .tools-h { margin-bottom: 14px; color: var(--muted); font-size: 0.875rem; font-weight: 600; letter-spacing: 0.02em; text-align: center; }
  .tools { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; list-style: none; }
  .tools li { padding: 6px 12px; border: 1px solid var(--hairline); border-radius: var(--r-full); color: var(--body); font-size: 0.875rem; white-space: nowrap; }

  .prim { display: flex; flex-direction: column; gap: 12px; padding: 24px; border: 1px solid var(--hairline); border-radius: var(--r-lg); background: var(--panel); }
  .prim-icon { display: grid; place-items: center; width: 46px; height: 46px; border-radius: 12px; background: var(--accent-soft); color: var(--link); }
  .prim-icon :global(.icon) { width: 24px; height: 24px; }
  .prim p { font-size: 0.9375rem; }
  .prim .ticks { font-size: 0.9375rem; gap: 8px; }
  .prim-price { margin-top: auto; padding-top: 14px; border-top: 1px solid var(--hairline-soft); color: var(--ink); font-weight: 650; }
  .prim .text-link { min-height: 44px; }
  .more { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; margin-top: 32px; }

  .web-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 0 24px; }
  .web-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: clamp(32px, 4vw, 48px); }
  @media (max-width: 479px) { .web-actions .button { flex: 1 1 100%; } }
  .tech-note { display: flex; align-items: flex-start; gap: 8px; margin-top: 12px; max-width: 80ch; }
  .tech-note :global(.icon) { flex: none; margin-top: 0.2em; width: 1.05em; height: 1.05em; }
  .cases { display: grid; gap: 20px; margin-top: 24px; }

  /* the five steps as numbered rows: number, title, then the text in its own column on wide screens */
  .steps { list-style: none; border-top: 1px solid var(--hairline); }
  .step { display: grid; grid-template-columns: 40px minmax(0, 1fr); gap: 10px 20px; align-items: center; padding: 22px 0; border-bottom: 1px solid var(--hairline); }
  .step-num { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--button); color: #fff; font-weight: 700; font-variant-numeric: tabular-nums; }
  .step h3 { font-size: 1.1875rem; }
  .step p { grid-column: 2; color: var(--body); }
  @media (min-width: 880px) {
    .step { grid-template-columns: 40px minmax(0, 17rem) minmax(0, 1fr); gap: 0 28px; align-items: start; padding: 26px 0; }
    .step h3 { line-height: 40px; }
    .step p { grid-column: 3; padding-top: 8px; }
  }

  .own { display: grid; gap: 32px 64px; }
  .own-head { display: grid; gap: 16px; justify-items: start; align-content: start; }
  .own-head p:not(.eyebrow) { font-size: 1.0625rem; }
  .own-head .eyebrow { margin-bottom: -4px; }
  .own-list { display: grid; gap: 16px; list-style: none; }
  .own-list li { display: grid; grid-template-columns: 44px minmax(0, 1fr); gap: 14px; padding: 20px; border: 1px solid var(--hairline); border-radius: var(--r-lg); background: var(--panel); }
  .own-list li > :global(.icon) { width: 44px; height: 44px; padding: 10px; border-radius: 12px; background: rgba(34, 211, 238, 0.1); color: var(--cyan); }
  .own-list h3 { font-size: 1.0625rem; margin-bottom: 6px; }
  .own-list p { font-size: 0.9375rem; }
  @media (min-width: 640px) { .own-list { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .own { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); align-items: start; } }

  .why { display: grid; gap: 28px 32px; list-style: none; }
  .why li { display: grid; grid-template-columns: 44px minmax(0, 1fr); gap: 14px; }
  .why li > :global(.icon) { width: 44px; height: 44px; padding: 10px; border-radius: 12px; background: var(--accent-soft); color: var(--link); }
  .why h3 { font-size: 1.0625rem; margin-bottom: 6px; }
  .why p { font-size: 0.9375rem; }
  @media (min-width: 720px) { .why { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .why { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  .about { display: grid; gap: 20px 64px; }
  .about-text { display: grid; gap: 14px; justify-items: start; font-size: 1.0625rem; }
  @media (min-width: 900px) { .about { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); align-items: start; } }

  .final { padding: clamp(64px, 9vw, 112px) 0; }
  .final-box {
    padding: clamp(40px, 6vw, 72px) clamp(20px, 5vw, 64px); text-align: center;
    border: 1px solid var(--hairline); border-radius: 24px;
    background: radial-gradient(80% 120% at 50% 0%, rgba(59, 130, 246, 0.18), transparent 70%), var(--bg-2);
  }
  .final-box h2 { max-width: 22ch; margin-inline: auto; }
  .final-box > p { max-width: 60ch; margin: 18px auto 0; font-size: 1.0625rem; }
  .final-actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 12px 24px; margin-top: 32px; }
  .final-mail { display: inline-flex; align-items: center; gap: 8px; min-height: 48px; font-weight: 600; text-decoration: none; overflow-wrap: anywhere; }
  @media (max-width: 559px) { .final-actions .button { width: 100%; } }
</style>
