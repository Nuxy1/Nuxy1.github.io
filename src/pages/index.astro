  <script is:inline>
    const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
    // Less motion: the demo video waits for its play button instead of starting by itself.
    if (calm) document.querySelectorAll("video[autoplay]").forEach((v) => { v.autoplay = false; v.pause(); });

    // The hero's notifications: a new one arrives every few seconds and the oldest leaves (still with less motion).
    const feed = document.querySelector("[data-feed]");
    if (feed && !calm) {
      const items = [...feed.children];
      let next = 3;
      setInterval(() => {
        if (document.hidden) return;
        const oldest = feed.querySelector("li.on");
        oldest.classList.add("out");
        setTimeout(() => {
          oldest.classList.remove("on", "out");
          const item = items[next++ % items.length];
          feed.append(item);
          item.classList.add("on");
        }, 420);
      }, 2800);
    }

    // The services: the strip shows what fits a kind of business, its usual first steps first.
    const catalog = document.querySelector("[data-catalog]");
    if (catalog) {
      const strip = catalog.querySelector(".strip");
      const note = catalog.querySelector(".kind-note");
      const cards = [...catalog.querySelectorAll(".svc")];
      const groups = [...catalog.querySelectorAll(".group")];
      const kinds = JSON.parse(catalog.dataset.kinds);
      const show = (kind) => {
        const k = kinds[kind];
        let shown = 0;
        for (const b of strip.querySelectorAll("button")) b.setAttribute("aria-pressed", String(b.dataset.kind === kind));
        for (const card of cards) {
          const fits = kind === "all" || card.dataset.fits === "all" || card.dataset.fits.split(" ").includes(kind);
          const first = k.start.indexOf(card.id);
          card.hidden = !fits;
          card.classList.toggle("start", first >= 0);
          card.style.order = first >= 0 ? String(first - 10) : "";
          if (fits) shown++;
        }
        for (const g of groups) g.hidden = !g.querySelector(".svc:not([hidden])");
        note.textContent = kind === "all"
          ? `All ${cards.length} services. Pick your kind of business to see what usually helps first.`
          : `${shown} services for ${k.who}. The ones marked Start here usually help first.`;
      };
      strip.hidden = false;
      strip.addEventListener("click", (e) => {
        const button = e.target.closest("button[data-kind]");
        if (!button || button.getAttribute("aria-pressed") === "true") return;
        // (scrolled into the list: after the change, back to its top, so a shorter list doesn't leave you below it)
        const deep = groups[0].getBoundingClientRect().top < strip.getBoundingClientRect().bottom;
        const change = () => {
          show(button.dataset.kind);
          if (deep) groups.find((g) => !g.hidden).scrollIntoView({ block: "start" });
        };
        if (document.startViewTransition && !calm) document.startViewTransition(change);
        else change();
      });
      // A link straight to a service (outreach emails link #quotes and the like): everything shown, that one opened.
      const reach = () => {
        const target = location.hash.length > 1 && document.getElementById(decodeURIComponent(location.hash.slice(1)));
        if (!target || !catalog.contains(target)) return;
        if (target.closest("[hidden]")) show("all");
        const more = target.matches(".svc") && target.querySelector("details");
        if (more) more.open = true;
        target.scrollIntoView({ block: target.matches(".svc") ? "center" : "start" });
      };
      addEventListener("hashchange", reach);
      if (location.hash) requestAnimationFrame(reach);
    }

    // The bundle: + on a card adds it; the bar shows the discounted total (2 services 10% off, 3 or more 15%) and one
    // request email listing them all.
    const bundle = document.querySelector("[data-bundle]");
    if (catalog && bundle) {
      const picks = new Map();
      const $ = (name) => bundle.querySelector(`[data-${name}]`);
      const money = (n) => "$" + Math.round(n).toLocaleString("en-US");
      const enc = (fields) => new URLSearchParams(fields).toString().replace(/\+/g, "%20");
      const inbox = bundle.dataset.inbox;
      const draw = () => {
        const list = [...picks.values()];
        bundle.hidden = !list.length;
        document.body.classList.toggle("has-bundle", list.length > 0);
        if (!list.length) return;
        const from = list.some((s) => s.price.startsWith("from")) ? "from " : "";
        const sub = list.reduce((t, s) => t + Number(s.price.replace(/\D/g, "")), 0);
        const off = list.length >= 3 ? 15 : list.length === 2 ? 10 : 0;
        const total = sub * (1 - off / 100);
        $("count").textContent = `${list.length} service${list.length > 1 ? "s" : ""}`;
        $("names").textContent = list.map((s) => s.name).join(", ");
        $("was").textContent = off ? money(sub) : "";
        $("total").textContent = from + money(total);
        $("off").textContent = off ? `${off}% off` : "";
        $("hint").textContent = list.length === 1 ? "Add 1 more service for 10% off the total" : list.length === 2 ? "Add 1 more for 15% off" : "Your best bundle price: 15% off";
        if (!calm) $("total").animate([{ transform: "scale(1.12)" }, { transform: "none" }], { duration: 360, easing: "cubic-bezier(0.16, 1, 0.3, 1)" });
        const subject = list.length > 1 ? `Setup request: bundle of ${list.length} services` : `Setup request: ${list[0].name}`;
        const body = `Services:\n${list.map((s) => `- ${s.name} (${s.price})`).join("\n")}\n${off ? `Bundle discount: ${off}% (${from}${money(total)} instead of ${from}${money(sub)})\n` : ""}\nBusiness name:\nWebsite:\nWhat kind of business:\nTools you use now (booking, ordering, accounting, email, CRM...):\nAnything else:\n`;
        $("ask").href = `mailto:${inbox}?` + enc({ subject, body });
        $("gmail").href = "https://mail.google.com/mail/?" + enc({ view: "cm", fs: "1", to: inbox, su: subject, body });
        $("outlook").href = "https://outlook.live.com/mail/0/deeplink/compose?" + enc({ to: inbox, subject, body });
      };
      const set = (card, on) => {
        const pick = card.querySelector("[data-pick]");
        pick.setAttribute("aria-pressed", String(on));
        pick.setAttribute("aria-label", on ? `Remove ${card.dataset.name} from your bundle` : `Add ${card.dataset.name} to your bundle`);
        card.classList.toggle("picked", on);
        if (on) picks.set(card.id, { name: card.dataset.name, price: card.dataset.price });
        else picks.delete(card.id);
      };
      for (const card of catalog.querySelectorAll(".svc")) {
        const pick = card.querySelector("[data-pick]");
        pick.hidden = false;
        pick.addEventListener("click", () => { set(card, pick.getAttribute("aria-pressed") !== "true"); draw(); });
      }
      $("clear").addEventListener("click", () => { for (const card of catalog.querySelectorAll(".svc.picked")) set(card, false); draw(); });
      document.querySelectorAll("[data-js-only]").forEach((el) => (el.hidden = false));
    }

    // The demo week: tabs switch the tool; its lines play in one by one when it comes into view (all at once with less motion).
    const term = document.querySelector("[data-term]");
    if (term) {
      const tabs = [...term.querySelectorAll('[role="tab"]')];
      const panels = [...term.querySelectorAll('[role="tabpanel"]')];
      let seen = false;
      const play = (panel) => {
        const lines = [...panel.querySelectorAll("li")];
        lines.forEach((li, i) => { li.classList.toggle("on", calm); if (!calm) setTimeout(() => li.classList.add("on"), 120 + i * 320); });
      };
      const open = (tab) => {
        for (const t of tabs) { const on = t === tab; t.setAttribute("aria-selected", String(on)); t.tabIndex = on ? 0 : -1; }
        for (const p of panels) p.hidden = p.id !== tab.getAttribute("aria-controls");
        const panel = panels.find((p) => !p.hidden);
        if (seen) play(panel);
      };
      term.querySelector(".term-tabs").hidden = false;
      term.classList.add("playing");
      term.addEventListener("click", (e) => { const tab = e.target.closest('[role="tab"]'); if (tab) open(tab); });
      term.addEventListener("keydown", (e) => {
        const i = tabs.indexOf(document.activeElement);
        if (i < 0 || !["ArrowLeft", "ArrowRight"].includes(e.key)) return;
        const next = tabs[(i + (e.key === "ArrowRight" ? 1 : tabs.length - 1)) % tabs.length];
        next.focus();
        open(next);
      });
      open(tabs[0]);
      if ("IntersectionObserver" in window) {
        const watcher = new IntersectionObserver((entries) => {
          if (!entries.some((e) => e.isIntersecting)) return;
          seen = true;
          play(panels.find((p) => !p.hidden));
          watcher.disconnect();
        }, { threshold: 0.35 });
        watcher.observe(term);
      } else { seen = true; play(panels[0]); }
    }

    // Phones: a request bar at the bottom once the hero is gone, out of the way of the request card and the footer.
    const dock = document.querySelector("[data-dock]");
    if (dock && "IntersectionObserver" in window) {
      const seen = new Map();
      const watch = [document.querySelector("[data-hero]"), document.querySelector("#request"), document.querySelector(".site-foot")].filter(Boolean);
      const watcher = new IntersectionObserver((entries) => {
        for (const e of entries) seen.set(e.target, e.isIntersecting);
        const up = ![...seen.values()].some(Boolean);
        dock.classList.toggle("up", up);
        dock.setAttribute("aria-hidden", String(!up));
        dock.querySelector("a").tabIndex = up ? 0 : -1;
      });
      watch.forEach((el) => watcher.observe(el));
    }

    // Copy the address. (navigator.clipboard can be refused; then select the address and copy it the old way.)
    document.querySelectorAll("button.copy").forEach((button) => {
      const label = button.querySelector("span");
      button.hidden = false;
      button.addEventListener("click", async () => {
        const address = button.previousElementSibling;
        try {
          await navigator.clipboard.writeText(button.dataset.copy);
        } catch {
          const range = document.createRange();
          range.selectNodeContents(address);
          getSelection().removeAllRanges();
          getSelection().addRange(range);
          if (!document.execCommand("copy")) return; // (left selected: Ctrl+C still works)
        }
        label.textContent = "Copied";
        setTimeout(() => (label.textContent = "Copy address"), 2000);
      });
    });
  </script>
</Base>

<style>
  .section { padding-block: clamp(64px, 8vw, 104px) 0; }
  .section-head { max-width: 680px; margin-bottom: 32px; }
  .section-title { font-size: clamp(1.875rem, 3.2vw, 2.5rem); line-height: 1.1; letter-spacing: -0.025em; margin: 0 0 12px; }
  .section-lead { font-size: 1.0625rem; margin: 0; }
  .price { margin: 0; color: var(--ink); font-weight: 700; font-size: 1.0625rem; font-variant-numeric: tabular-nums lining-nums; white-space: nowrap; }
  .alt { color: var(--muted); font-size: 0.875rem; }
  .alt a { color: var(--muted); }
  .alt a:hover { color: var(--accent-text); }

  /* Hero: the promise on the left; on the right a shop owner at work while her notifications arrive by themselves. */
  .hero { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: clamp(32px, 5vw, 72px); align-items: center; padding-block: clamp(32px, 4vw, 56px) 0; }
  .hero h1 { font-size: clamp(2.375rem, 4.2vw, 3.5rem); line-height: 1.04; letter-spacing: -0.035em; margin: 0; }
  .sub { font-size: clamp(1.0625rem, 1.4vw, 1.25rem); line-height: 1.55; max-width: 42ch; margin: 22px 0 0; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin: 32px 0 0; }
  .promises { list-style: none; display: flex; flex-wrap: wrap; gap: 10px 22px; margin: 28px 0 0; padding: 0; color: var(--body); font-size: 0.9375rem; }
  .promises li { display: inline-flex; align-items: center; gap: 8px; }
  .promises :global(.icon) { width: 20px; height: 20px; color: var(--ink); }
  .hero-media { position: relative; }
  .hero-photo { width: 100%; height: clamp(440px, calc(100dvh - var(--nav-h) - 120px), 640px); object-fit: cover; object-position: 50% 40%; border-radius: var(--r-lg); background: var(--surface-strong); }
  .feed-box { position: absolute; left: clamp(12px, 2vw, 20px); bottom: clamp(12px, 2vw, 20px); width: min(330px, calc(100% - 24px)); }
  .feed-label { display: inline-flex; align-items: center; gap: 8px; margin: 0 0 8px; padding: 5px 12px; border-radius: var(--r-full); background: rgb(0 0 0 / 0.55); color: #fff; font-size: 0.75rem; font-weight: 600; backdrop-filter: blur(6px); }
  .live { width: 7px; height: 7px; border-radius: 50%; background: #3ccf6e; box-shadow: 0 0 0 3px rgb(60 207 110 / 0.3); }
  .feed { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .feed li { display: none; grid-template-columns: 36px minmax(0, 1fr) auto; align-items: center; gap: 12px; max-height: 80px; padding: 10px 14px; border-radius: var(--r-md); background: var(--bg); box-shadow: var(--shadow-lift); overflow: hidden; }
  .feed li.on { display: grid; }
  .feed-icon { display: grid; place-items: center; width: 36px; height: 36px; border-radius: var(--r-full); background: var(--surface-strong); color: var(--ink); }
  .feed-icon :global(.icon) { width: 19px; height: 19px; }
  .feed-text { display: grid; min-width: 0; line-height: 1.3; }
  .feed-text strong { color: var(--ink); font-size: 0.875rem; }
  .feed-text span { color: var(--muted); font-size: 0.8125rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .feed-time { align-self: start; color: var(--muted); font-size: 0.75rem; }
  @media (prefers-reduced-motion: no-preference) {
    .hero-copy > * { animation: enter 800ms var(--ease) backwards; }
    .hero-copy > :nth-child(2) { animation-delay: 90ms; }
    .hero-copy > :nth-child(3) { animation-delay: 180ms; }
    .hero-copy > :nth-child(4) { animation-delay: 270ms; }
    .hero-photo { animation: settle 1000ms var(--ease) backwards; }
    .feed-label { animation: enter 600ms var(--ease) 500ms backwards; }
    .feed li.on { animation: feed-in 560ms var(--ease) backwards; }
    .feed li.on:nth-child(1) { animation-delay: 650ms; }
    .feed li.on:nth-child(2) { animation-delay: 800ms; }
    .feed li.on:nth-child(3) { animation-delay: 950ms; }
    .feed li.on.out { animation: feed-out 420ms cubic-bezier(0.4, 0, 1, 1) forwards; }
    .live { animation: pulse 2s ease-in-out infinite; }
  }
  @keyframes enter { from { opacity: 0; transform: translateY(18px); } }
  @keyframes settle { from { opacity: 0; transform: scale(1.04); } }
  @keyframes feed-in { from { opacity: 0; transform: translateY(16px) scale(0.97); } }
  @keyframes feed-out { to { opacity: 0; transform: translateY(-6px) scale(0.97); max-height: 0; padding-block: 0; margin-bottom: -8px; } }
  @keyframes pulse { 50% { box-shadow: 0 0 0 6px rgb(60 207 110 / 0); } }

  /* Tools: the names drift past; hover holds them still. */
  .tools { padding-top: clamp(48px, 6vw, 72px); }
  .tools-label { margin: 0 0 18px; text-align: center; color: var(--muted); font-size: 0.9375rem; font-weight: 500; letter-spacing: 0; }
  .marquee { overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); }
  .marquee-track { display: flex; gap: 10px; width: max-content; }
  .marquee ul { display: flex; gap: 10px; margin: 0; padding: 0; list-style: none; }
  .marquee li { padding: 9px 18px; border: 1px solid var(--hairline); border-radius: var(--r-full); color: var(--ink); font-size: 0.9375rem; font-weight: 600; white-space: nowrap; }
  @media (prefers-reduced-motion: no-preference) {
    .marquee-track { animation: drift 48s linear infinite; }
    .marquee:hover .marquee-track { animation-play-state: paused; }
  }
  @keyframes drift { to { transform: translateX(calc(-50% - 5px)); } }
  @media (prefers-reduced-motion: reduce) {
    .marquee { mask-image: none; padding-inline: 16px; }
    .marquee-track, .marquee ul:first-child { flex-wrap: wrap; justify-content: center; width: auto; }
    .marquee ul[aria-hidden] { display: none; }
  }

  /* Services: Airbnb's category strip filters one catalog of cards. */
  .strip-wrap { position: sticky; top: var(--nav-h); z-index: 5; margin: 0 calc(-1 * clamp(16px, 4vw, 40px)); padding: 0 clamp(16px, 4vw, 40px); background: var(--bg); }
  .strip { display: flex; gap: 4px; overflow-x: auto; scrollbar-width: none; border-bottom: 1px solid var(--hairline-soft); }
  .strip::-webkit-scrollbar { display: none; }
  .strip button {
    flex: none; display: grid; justify-items: center; gap: 6px; min-width: 92px; padding: 14px 14px 12px; margin-bottom: -1px; cursor: pointer;
    background: none; border: 0; border-bottom: 2px solid transparent; color: var(--muted); font: 600 0.875rem/1.2 var(--font);
    transition: color 160ms ease-out, border-color 160ms ease-out;
  }
  .strip button :global(.icon) { width: 26px; height: 26px; transition: transform 200ms var(--ease); }
  .strip button:hover { color: var(--ink); border-bottom-color: var(--hairline); }
