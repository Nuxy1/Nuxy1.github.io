---
import { titleCase } from "../lib/title-case";
// Homepage (website improvement brief, 2026-11), in the order a visitor decides: what Nuxy does in three categories,
// the four website levels with their prices, the concept demonstrations, the automations working, the five steps,
// handover in short, one trust band, the first questions and one next step. The goal picker and the price estimator
// have their own pages (/automation/ and /pricing/) and are linked from under the demos; the full handover account is
// on /handover/ (approvals 87, owner's yes 2026-11-13).
// Services and prices come from data/services.ts and data/tiers.ts; nothing on this page is a client result. Section
// ids avoid the old one-page anchors that Base.astro forwards (any service, plan or bundle id, "services", "plans",
// "faq", "work", ...), or the forwarding script would send the visitor away.
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import AutomationCore from "../components/AutomationCore.astro";
import CinematicLoop from "../components/CinematicLoop.astro";
import AutopilotDemos from "../components/AutopilotDemos.astro";
import DemoSites from "../components/DemoSites.astro";
import CaseStudy from "../components/CaseStudy.astro";
import VideoTeasers from "../components/VideoTeasers.astro";
import LevelRail from "../components/levels/LevelRail.astro";
import { demos as videoDemos } from "../data/creative";
import { demosReady } from "../data/cinematic";
import { steps, services, plans, health, faqs, areas, automationFrom, dollars, money, variantById } from "../data/services";
import { callbackForm, inbox, shownCases, isStaged, replacedDemos } from "../data/site";
import { arrangements, handoverSteps } from "../data/handover";
import type { IconName } from "../components/Icon.astro";

// the home page links to the video portfolio only when all three demo videos have real, checked files
const hasVideos = demosReady(videoDemos.map((d) => d.id));
// a client project reaches the page only with written consent and its checks (data/case-studies.ts): Chrysfadezzz since 13 Nov 2026. The
// stage build also shows a project still waiting on that consent, marked "Staged preview" (shownCases, isStaged).
const clients = shownCases;
const hasClients = clients.length > 0;
const anyStaged = clients.some((c) => isStaged(c));
// the video demos shown: one that a client project replaces is left out (VideoTeasers does the same)
const videoCount = videoDemos.filter((d) => !replacedDemos.has(d.id)).length;
const videoWord = ["no", "one", "two", "three", "four", "five", "six"][videoCount] ?? String(videoCount);

// The cheapest and dearest one-time prices, for search engines' price range: read from the price list so it can't drift.
const oneTime = services.flatMap((s) => [s, ...(s.variants ?? [])]).map((s) => dollars(s.price)).filter(Boolean);
const websiteFrom = variantById["starter-website"].price;
const care = plans[0];
// The hero's price line: the smallest website and the smallest automation setup, from the price list, each a link to
// where that price is explained. (Monthly plans are optional on every one-time service, which is what "no required
// monthly contract" says.)
const startPrices: { text: string; href?: string }[] = [
  { text: `Websites from ${websiteFrom}`, href: "#website-levels" },
  { text: `Automations from ${automationFrom}`, href: "/pricing/" },
  { text: "No required monthly contract" },
];

// The three kinds of work. Every service in the catalogue sits under one of them, and each card's price is the
// smallest published price in that kind. The security page is linked once on this page, from the third card.
type Category = { icon: IconName; title: string; text: string; price: string; href: string; cta: string; track: string; more: [string, string][] };
const categories: Category[] = [
  { icon: "browser", title: "Websites & Digital Experiences",
    text: "A website sized to your business, from a clear one-page site to a custom interactive experience. Also online stores, and redesigns of the site you already have.",
    price: `Websites from ${websiteFrom}, one-time`, href: "/web-design/", cta: "Compare website levels", track: "cta_cat_websites",
    more: [["Business websites", "/websites/"], ["Online stores", "/ecommerce/"], ["Website redesigns", "/websites/#redesign"]] },
  { icon: "lightning", title: "AI & Business Automation",
    text: "Every inquiry answered and followed up, calls picked up by an AI receptionist, bookings and reminders sent for you, and the tools you already use connected.",
    price: `One-time setups from ${automationFrom}`, href: "/automation/", cta: "See automation services", track: "cta_cat_automation",
    more: [["AI Voice Receptionist", "/automation/#voice"], ["Lead response and follow-up", "/automation/#lead-response"], ["Monthly automation plans", "/pricing/#plans"]] },
  { icon: "shieldCheck", title: "Website Care & Security",
    text: `A ${health[0].price.toLowerCase()} website health consultation, monthly care that keeps a website working, repairs when it doesn’t, and security assessments done only with the owner’s written authorization.`,
    price: `${care.name} ${care.price}, optional`, href: "/website-security/", cta: "See care, repairs and security", track: "cta_home_security",
    more: [["Website Care plan", `/pricing/#${care.id}`], ["How handover works", "/handover/"]] },
];

// Easy handover: three steps, each said only in words the published terms already use (data/services.ts `steps`,
// /websites/#ownership and /policies/). Nothing here describes the client portal, which is not open to customers.
// The first questions an owner asks, taken word for word from the price list's questions (/pricing/#faq has them all).
const firstQuestions = ["Who owns what you build?", "Do I have to sign up for a monthly plan?", "What if something breaks after launch?", "How do I pay?", "Do we need to get on a call?", "Can you promise more customers or a top Google ranking?"];
const homeFaqs = firstQuestions.map((q) => {
  const found = faqs.find(([question]) => question === q);
  if (!found) throw new Error(`home page: no published answer for “${q}” in data/services.ts`);
  return found;
});

// The one trust band: each line is a published term (/policies/, /websites/#ownership), said once on this page.
const trust: { icon: IconName; title: string; text: string }[] = [
  { icon: "receipt", title: "Clear Pricing", text: "You see the price before work starts." },
  { icon: "lockSimple", title: "Your Accounts", text: "Your website, domain and tools remain yours." },
  { icon: "checkCircle", title: "Tested Before Launch", text: "Everything is tested before handover." },
  { icon: "handshake", title: "No Long Contracts", text: "Monthly management is optional." },
  { icon: "userCircle", title: "Direct Support", text: "You work directly with the person building your system." },
];

const site = "https://nuxyautomation.com";
const business = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": `${site}/#business`,
  name: "Nuxy Automation",
  url: `${site}/`,
  logo: `${site}/logo.png`,
  image: `${site}/og.jpg`,
  email: inbox,
  description: "Websites, online stores and business automation for small businesses: business websites, Shopify and Square Online stores, lead response and follow-up, missed-call text-back, online booking and reminders, estimate follow-up, and invoice and admin automations, built in the client’s own accounts at published prices agreed in writing.",
  address: { "@type": "PostalAddress", addressLocality: "Faribault", addressRegion: "MN", addressCountry: "US" },
  areaServed: [
    ...["Faribault", "Northfield", "Owatonna", "Lakeville"].map((name) => ({ "@type": "City", name: `${name}, Minnesota` })),
    { "@type": "AdministrativeArea", name: "Southern Minnesota" },
    { "@type": "AdministrativeArea", name: "Minneapolis–Saint Paul metropolitan area" },
    { "@type": "Country", name: "United States" },
  ],
  priceRange: `${money(Math.min(...oneTime))}-${money(Math.max(...oneTime))}`,
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Website, online store and automation services",
    itemListElement: services.map((s) => ({
      "@type": "Offer",
      url: `${site}/solutions/#${s.id}`,
      itemOffered: { "@type": "Service", name: s.name, description: s.text },
      ...(s.priceType === "fixed"
        ? { price: String(dollars(s.price)), priceCurrency: "USD" }
        : { priceSpecification: { "@type": "PriceSpecification", minPrice: String(dollars(s.price)), priceCurrency: "USD" } }),
    })),
  },
};
---
<Base title="Nuxy Automation · Websites, Automation & Website Care" wide>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(business)} />

  <section class="hero cine-host" data-hero>
    <CinematicLoop id="hero" backdrop eager />
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Websites, automation & website care · Faribault, MN</p>
        <h1><span>Build Smarter.</span> <span>Grow Faster.</span></h1>
        <p class="hero-lead">Premium websites, intelligent automation and dependable digital systems, built around your business. Clear prices in writing, and everything set up in your own accounts.</p>
        <div class="hero-actions">
          <a class="button" href="/contact/" data-track="cta_hero">Get a Free Quote<Icon name="arrowRight" /></a>
          <a class="button secondary" href="#portfolio" data-track="cta_explore_work">Explore Our Work</a>
        </div>
        <div class="hero-price-clip"><ul class="hero-price" aria-label="Starting prices">{startPrices.map((p) => <li>{p.href ? <a href={p.href}>{p.text}</a> : p.text}</li>)}</ul></div>
      </div>
      <AutomationCore />
    </div>
  </section>

  <section class="section" id="what-we-do" aria-labelledby="do-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">What we do</p>
        <h2 id="do-h">What Can Nuxy Do for Your Business?</h2>
        <p>Three kinds of work, each with its starting price.</p>
      </div>
      <div class="grid-3">
        {categories.map((c) => (
          <article class="prim cat reveal">
            <span class="prim-icon"><Icon name={c.icon} /></span>
            <h3>{titleCase(c.title)}</h3>
            <p>{c.text}</p>
            <ul class="cat-more" role="list">
              {c.more.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
            </ul>
            <p class="prim-price">{c.price}</p>
            <a class="text-link" href={c.href} data-track={c.track}>{c.cta}<Icon name="arrowRight" /></a>
          </article>
        ))}
      </div>
      <p class="more"><a class="text-link" href="/solutions/" data-track="cta_services">See all {services.length} services<Icon name="arrowRight" /></a></p>
      {!hasVideos && (
        <p class="note also-note"><Icon name="filmSlate" /><span>Need a video for your business? We also make <a href="/creative-studio/" data-track="cta_home_creative">short video ads, moving menus and product showcases</a>, made with AI video tools and finished by a person.</span></p>
      )}
      {hasVideos && (
        <div class="home-video">
          <VideoTeasers level={3} headingId="home-video-h" title={`We Also Make Video: ${titleCase(videoWord)} Concept Demonstration${videoCount === 1 ? "" : "s"}`}>
            <p slot="intro">Need a video for your business? We also make <a href="/creative-studio/" data-track="cta_home_creative">short video ads, moving menus and product showcases</a>, made with AI video tools and finished by a person. {videoCount === 1 ? "This one is for a made-up brand: open it to watch it." : `These ${videoWord} are for made-up brands: open one to watch it.`}</p>
          </VideoTeasers>
        </div>
      )}
    </div>
  </section>

  <section class="section band" id="website-levels" aria-labelledby="levels-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Website levels and prices</p>
        <h2 id="levels-h">Four Website Levels, From Simple to Bespoke</h2>
        <p>Each level adds design, motion and engineering, and the price follows the work. Interactive 3D and scroll storytelling start at Immersive: they are not part of Business or Signature.</p>
      </div>
      <LevelRail compact />
      <p class="more">
        <a class="button" href="/web-design/" data-track="cta_levels_compare">Compare Website Levels<Icon name="arrowRight" /></a>
        <a class="button secondary" href="/contact/" data-track="cta_tiers_quote">Get a Free Quote</a>
        <a class="text-link" href="/pricing/" data-track="cta_pricing_preview">See all pricing<Icon name="arrowRight" /></a>
      </p>
    </div>
  </section>

  <section class="section" id="portfolio" aria-labelledby="portfolio-h">
    <div class="wrap">
      <div class="web-head">
        <div class="section-head">
          <p class="eyebrow">{hasClients ? "Our work · real clients and concept demonstrations" : "Our work · concept demonstrations"}</p>
          <h2 id="portfolio-h">{hasClients ? "Client Projects and Concept Demonstrations" : "Concept Demonstrations: Real Websites for Made-Up Businesses"}</h2>
          <p>{hasClients
            ? `The client projects come first: real businesses, ${anyStaged ? "published only once each client approves in writing" : "shown with their permission"}. The concept demonstrations after them are websites and an online store for made-up businesses, built to show what Nuxy can build. Open one to try it at full size, on a computer or a phone.`
            : "None of them is a client project. They are websites and an online store built to show what Nuxy can build. Open one to try it at full size, on a computer or a phone."}</p>
        </div>
        <div class="web-actions">
          <a class="button secondary" href="/portfolio/" data-track="cta_portfolio">See the full portfolio<Icon name="arrowRight" /></a>
        </div>
      </div>
      {hasClients && <div class="cases">{clients.map((c) => <CaseStudy study={c} />)}</div>}
      {hasClients && <p class="kind-label"><Icon name="info" /><span><strong>Concept demonstrations</strong> · made-up businesses, built to show what Nuxy can build</span></p>}
      <DemoSites />
    </div>
  </section>

  <AutopilotDemos>
    <ul class="tools" slot="after" role="list">
      <li><a class="tool" href="/automation/#what-to-automate" data-track="cta_home_picker"><span class="tool-name">What Do You Want to Automate?</span><span class="tool-text">Pick a goal to see the best fits and their starting prices.</span><Icon name="arrowRight" /></a></li>
      <li><a class="tool" href="/pricing/#package" data-track="cta_home_estimator"><span class="tool-name">Build Your Automation Package</span><span class="tool-text">Choose what your business needs and see an estimated starting price.</span><Icon name="arrowRight" /></a></li>
    </ul>
  </AutopilotDemos>

  <section class="section" id="how" aria-labelledby="how-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">How it works</p>
        <h2 id="how-h">Five Steps, All in Writing</h2>
        <p>No sales call and no long contract. Nothing is charged until you agree to the written plan.</p>
      </div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li class="step reveal">
            <span class="step-num" aria-hidden="true">{i + 1}</span>
            <h3><span class="sr-only">Step {i + 1}: </span>{titleCase(s.title)}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section band" id="handover" aria-labelledby="handover-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Easy handover</p>
        <h2 id="handover-h">Your Website. Your Control. None of the Technical Headaches.</h2>
        <p>From getting your website online to connecting your business tools, Nuxy helps make the complicated parts simple. We guide you through the decisions that matter and handle the technical work covered by your project.</p>
      </div>
      <ol class="ho-steps">
        {handoverSteps.map((s, i) => <li class="ho-step"><span class="ho-num" aria-hidden="true">{i + 1}</span>{s.title}</li>)}
      </ol>
      <dl class="ho-ways">
        {arrangements.map((a) => (
          <div class="ho-way">
            <dt>{a.title}</dt>
            <dd><span class="ho-tag">{a.tag}</span>{a.text}</dd>
          </div>
        ))}
      </dl>
      <p class="more"><a class="button secondary" href="/handover/" data-track="cta_handover">How Handover Works<Icon name="arrowRight" /></a></p>
    </div>
  </section>

  <section class="section" id="why-nuxy" aria-labelledby="why-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Why Nuxy</p>
        <h2 id="why-h">Fair Prices, Work You Own, One Person to Talk To</h2>
      </div>
      <ul class="trust">
        {trust.map((t) => (
          <li class="reveal">
            <Icon name={t.icon} />
            <h3>{titleCase(t.title)}</h3>
            <p>{t.text}</p>
          </li>
        ))}
      </ul>
      <p class="trust-foot"><Icon name="mapPin" /><span>Based in Faribault, Minnesota. We work with businesses in {areas.slice(0, -2).join(", ")}, {areas.at(-2)} and {areas.at(-1)}, and remotely anywhere in the US. <a href="/about/">About Nuxy</a> · <a href="/policies/">Our written policies</a></span></p>
    </div>
  </section>

  <section class="section band" id="home-faq" aria-labelledby="home-faq-h">
    <div class="wrap faq-wrap">
      <div class="section-head">
        <p class="eyebrow">Questions</p>
        <h2 id="home-faq-h">What Owners Ask First</h2>
      </div>
      <div class="faq">
        {homeFaqs.map(([q, a]) => (
          <details>
            <summary><span>{q}</span><Icon name="plus" /></summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
      <p class="more"><a class="text-link" href="/pricing/#faq">All questions about prices and paying<Icon name="arrowRight" /></a></p>
    </div>
  </section>

  <section class="final" aria-labelledby="final-h" data-final>
    <div class="wrap"><div class="final-box">
      <h2 id="final-h">A Fixed Price in Writing Within One Business Day</h2>
      <p>Tell us about your business and what you need. The price comes with a written recommendation, and no sales call is required.</p>
      <div class="final-actions">
        <a class="button" href="/contact/" data-track="cta_final">Get a Free Quote<Icon name="arrowRight" /></a>
        {callbackForm && <a class="final-mail" href="/contact/#callback" data-track="cta_final_callback"><Icon name="phone" />Request a callback</a>}
        <a class="final-mail" href={`mailto:${inbox}`}><Icon name="envelopeSimple" />{inbox}</a>
      </div>
    </div></div>
  </section>

  {/* Phones only, and only with the script: one quote button that comes in after the hero and steps aside wherever
      the page already offers the next step (the final box, the footer). Closing it lasts the visit. */}
  <div class="sticky-cta" data-sticky hidden>
    <a class="button" href="/contact/" data-track="cta_sticky">Get a Free Quote<Icon name="arrowRight" /></a>
    <button type="button" class="sticky-x" data-sticky-close aria-label="Hide the quote button"><Icon name="x" /></button>
  </div>
</Base>

<script>
  // The phone quote button. No scroll listener: an observer says when the hero, the final box or the footer is on
  // screen, and the button shows only when none of them is.
  const bar = document.querySelector<HTMLElement>("[data-sticky]");
  const KEY = "nuxy-quote-bar";
  let closed = false;
  try { closed = sessionStorage.getItem(KEY) === "off"; } catch {}
  if (bar && !closed && "IntersectionObserver" in window) {
    const quiet = [...document.querySelectorAll("[data-hero], [data-final], footer")];
    const seen = new Set<Element>();
    const set = (on: boolean) => { bar.classList.toggle("is-on", on); bar.inert = !on; };
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) e.isIntersecting ? seen.add(e.target) : seen.delete(e.target);
      set(seen.size === 0);
    });
    bar.hidden = false;
    bar.inert = true;
    quiet.forEach((el) => io.observe(el));
    bar.querySelector("[data-sticky-close]")?.addEventListener("click", () => {
      io.disconnect();
      set(false);
      try { sessionStorage.setItem(KEY, "off"); } catch {}
    });
  }
</script>


<style>
  .hero { position: relative; padding: clamp(48px, 8vw, 104px) 0 clamp(56px, 8vw, 96px); overflow: hidden; }
  .hero::before {
    content: ""; position: absolute; inset: -20% -10% auto; height: 80%; pointer-events: none;
    background: radial-gradient(60% 60% at 70% 30%, rgb(var(--blue-rgb) / 0.16), transparent 70%);
  }
  .hero-grid { position: relative; display: grid; gap: clamp(40px, 6vw, 64px); align-items: center; }
  /* (two short sentences, each kept whole: side by side where they fit, one per line where they don't) */
  /* the hero type token from DESIGN.md, to the letter */
  .hero h1 { font-size: clamp(2.25rem, 1.3rem + 3.6vw, 3.75rem); line-height: 1.06; letter-spacing: -0.035em; }
  .hero h1 span { display: inline-block; }
  .hero-lead { max-width: 54ch; margin-top: 22px; font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.25rem); color: var(--body); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  /* three short facts with a rule between them; the list is pulled left by one item's padding and clipped, so a
     line never starts with a rule */
  .hero-price-clip { margin-top: 20px; overflow: hidden; }
  .hero-price { display: flex; flex-wrap: wrap; gap: 6px 0; margin: 0 0 0 -15px; list-style: none; color: var(--body); font-size: 0.875rem; font-weight: 500; }
  .hero-price li { padding: 0 12px 0 14px; border-left: 1px solid var(--hairline-strong); line-height: 1.3; }
  .hero-price a { display: inline-block; padding-block: 6px; margin-block: -6px; color: inherit; text-decoration: underline; text-decoration-color: var(--hairline-strong); text-underline-offset: 3px; }
  .hero-price a:hover { color: var(--ink); text-decoration-color: currentColor; }
  @media (min-width: 1024px) { .hero-grid { grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); } }
  @media (max-width: 479px) { .hero-actions .button { width: 100%; } }

  .prim { display: flex; flex-direction: column; gap: 12px; padding: 24px; border: 1px solid var(--hairline); border-radius: var(--r-lg); background: var(--panel); }
  .prim-icon { display: grid; place-items: center; width: 46px; height: 46px; border-radius: 12px; background: var(--accent-soft); color: var(--link); }
  .prim-icon :global(.icon) { width: 24px; height: 24px; }
  .prim p { font-size: 0.9375rem; }
  .prim .ticks { font-size: 0.9375rem; gap: 8px; }
  .prim .prim-outcome { margin-bottom: -6px; color: var(--cyan); font-size: 0.875rem; font-weight: 600; }
  .prim-price { margin-top: auto; padding-top: 14px; border-top: 1px solid var(--hairline-soft); color: var(--ink); font-weight: 650; }
  .prim-note { display: block; margin-top: 2px; color: var(--muted); font-size: 0.875rem; font-weight: 500; }
  .prim .text-link { min-height: 44px; }
  /* a thin accent line along the top of each card, brighter under a mouse */
  .prim { position: relative; overflow: hidden; }
  .prim::before { content: ""; position: absolute; inset: 0 0 auto; height: 2px; background: linear-gradient(90deg, var(--blue), var(--cyan)); opacity: 0.45; transition: opacity var(--dur-2) ease; }
  @media (hover: hover) and (pointer: fine) {
    .prim:hover::before { opacity: 1; }
    .prim .text-link :global(.icon) { transition: transform var(--dur-1) var(--ease-out); }
    .prim:hover .text-link :global(.icon) { transform: translateX(3px); }
  }
  /* a category card's smaller links: the pages inside that kind of work */
  .cat h3 { font-size: 1.3125rem; }
  .cat-more { display: flex; flex-wrap: wrap; gap: 6px 8px; margin: 2px 0 0; padding: 0; list-style: none; }
  .cat-more a { display: inline-flex; align-items: center; min-height: 36px; padding: 0 12px; border: 1px solid var(--hairline); border-radius: 999px; color: var(--body); font-size: 0.875rem; font-weight: 500; text-decoration: none; }
  .cat-more a:hover { border-color: var(--hairline-strong); color: var(--ink); }
  .more { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; margin-top: 32px; }
  .more .text-link { display: inline-flex; align-items: center; min-height: 44px; }
  @media (max-width: 479px) { .more .button { flex: 1 1 100%; } }

  .web-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 0 24px; }
  .web-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: clamp(32px, 4vw, 48px); }
  @media (max-width: 479px) { .web-actions .button { flex: 1 1 100%; } }
