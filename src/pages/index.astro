  .qa { border-bottom: 1px solid var(--hairline); interpolate-size: allow-keywords; }
  .qa summary { display: flex; justify-content: space-between; align-items: center; gap: 16px; min-height: 64px; padding: 14px 0; cursor: pointer; list-style: none; color: var(--ink); font-weight: 600; font-size: 1.0625rem; }
