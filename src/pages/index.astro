    position: relative; display: flex; flex-direction: column; padding: 28px 24px 24px; border: 1px solid var(--hairline); border-radius: var(--r-lg); background: var(--bg);
    transition: box-shadow 220ms ease-out, transform 220ms var(--ease);
  }
