  /* What clients say: real reviews only (src/data/reviews.ts); hidden while there are none. */
  .said { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; }
