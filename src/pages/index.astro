    }
  }
  @keyframes fill-in { from { background: var(--bg); color: var(--ink); } }
  @keyframes draw { from { transform: scaleX(0); } }
  @media (max-width: 900px) {
    .steps { grid-template-columns: 1fr; gap: 0; }
    .steps li { display: grid; grid-template-columns: 44px minmax(0, 1fr); column-gap: 18px; padding-bottom: 28px; }
    .steps li:not(:last-child)::after, .steps li:not(:last-child)::before { left: 21px; right: auto; top: 48px; bottom: 4px; border-top: 0; }
    .steps li:not(:last-child)::after { border-left: 1.5px dashed var(--hairline); }
