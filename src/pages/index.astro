---
import { titleCase } from "../lib/title-case";
import { noWidow } from "../lib/no-widow";
// Homepage, in the order of the owner's site audit brief (2026-11-21, which replaces the 11-17 "real work straight after
// the hero"): hero, the three kinds of work with their starting prices, real work (the client project, then a strip of
// concept demonstrations), the four website levels, one automation demo, why Nuxy, the handover steps and one next
// step. To keep the page short on a phone (audit finding 2), the video teasers, the first questions and the two ways to
// own the site left home: the Creative Studio, /pricing/#faq and /handover/ carry them, each linked from here.
// (2026-11-17: the five steps of a job left home too; /about/#how-we-work has them, linked from the handover.) The goal
// picker and the price estimator have their own pages (/automation/ and /pricing/) and are linked from under the demo
// (approvals 87, owner's yes 2026-11-13).
// Services and prices come from data/services.ts and data/tiers.ts; nothing on this page is a client result. Section
// ids avoid the old one-page anchors that Base.astro forwards (any service, plan or bundle id, "services", "plans",
// "faq", "work", ...), or the forwarding script would send the visitor away.
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import CinematicLoop from "../components/CinematicLoop.astro";
import AutopilotDemos from "../components/AutopilotDemos.astro";
import DemoStrip from "../components/DemoStrip.astro";
import CaseStudy from "../components/CaseStudy.astro";
import LevelRail from "../components/levels/LevelRail.astro";
import { services, plans, health, areas, automationFrom, dollars, money, variantById } from "../data/services";
import { callbackForm, inbox, shownCases, isStaged } from "../data/site";
import { handoverSteps } from "../data/handover";
import type { IconName } from "../components/Icon.astro";

// a client project reaches the page only with written consent and its checks (data/case-studies.ts): Chrysfadezzz since 13 Nov 2026. The
// stage build also shows a project still waiting on that consent, marked "Staged preview" (shownCases, isStaged).
const clients = shownCases;
const hasClients = clients.length > 0;
const anyStaged = clients.some((c) => isStaged(c));
// The concept demonstrations in the strip: one per kind of build (two Business sites, the Signature store, the Immersive
// concept). The made-up barber stays off the home page beside the real one (critique 11-17: both in black and gold, a
// skimming visitor merged them); /portfolio/ shows all five.
const concepts = hasClients
  ? ["fernway-lawn", "mossgate-cleaning", "quillfern-candles", "halvane-audio"]
  : ["fernway-lawn", "lantern-row-barbers", "quillfern-candles", "halvane-audio"];

// The cheapest and dearest one-time prices, for search engines' price range: read from the price list so it can't drift.
const oneTime = services.flatMap((s) => [s, ...(s.variants ?? [])]).map((s) => dollars(s.price)).filter(Boolean);
const websiteFrom = variantById["starter-website"].price;
const care = plans[0];
// The hero's price line: the smallest website and the smallest automation setup, from the price list, each a link to
// where that price is explained. (Monthly plans are optional on every one-time service, which is what "no required
// monthly contract" says.)
const startPrices: { text: string; href?: string }[] = [
  { text: `Websites from ${websiteFrom}`, href: "#website-levels" },
  { text: `Automations from ${automationFrom}`, href: "/pricing/" },
  { text: "No required monthly contract" },
];

// The three kinds of work. Every service in the catalogue sits under one of them, and each card's price is the
// smallest published price in that kind. The security page is linked once on this page, from the third card.
// (critique 11-17: the cards lost their chip rows; one link each, and the menu and the pages carry the rest)
type Category = { icon: IconName; title: string; text: string; price: string; href: string; cta: string; track: string };
const categories: Category[] = [
  { icon: "browser", title: "Websites & Digital Experiences",
    text: "A website sized to your business, from a clear one-page site to a custom interactive experience. Also online stores, and redesigns of the site you already have.",
    price: `Websites from ${websiteFrom}, one-time`, href: "/web-design/", cta: "Compare website levels", track: "cta_cat_websites" },
  { icon: "lightning", title: "AI & Business Automation",
    text: "Every inquiry answered and followed up, calls picked up by an AI receptionist, bookings and reminders sent for you, and the tools you already use connected.",
    price: `One-time setups from ${automationFrom}`, href: "/automation/", cta: "See automation services", track: "cta_cat_automation" },
  { icon: "shieldCheck", title: "Website Care & Security",
    text: `A ${health[0].price.toLowerCase()} website health consultation, monthly care that keeps a website working, repairs when it doesn’t, and security assessments done only with the owner’s written authorization.`,
    price: `${care.name} ${care.price}, optional`, href: "/website-security/", cta: "See care, repairs and security", track: "cta_home_security" },
];

// Easy handover: three steps, each said only in words the published terms already use (data/services.ts `steps`,
// /websites/#ownership and /policies/). Nothing here describes the client portal, which is not open to customers.

// The one trust band: each line is a published term (/policies/, /websites/#ownership), said once on this page.
const trust: { icon: IconName; title: string; text: string }[] = [
  { icon: "receipt", title: "Clear Pricing", text: "You see the price before work starts." },
  { icon: "lockSimple", title: "Your Accounts", text: "Your website, domain and tools stay yours." },
  { icon: "checkCircle", title: "Tested Before Launch", text: "Everything is tested before handover." },
  { icon: "handshake", title: "No Long Contracts", text: "Monthly management is optional." },
  { icon: "userCircle", title: "Direct Support", text: "You work directly with the person building your system." },
];

const site = "https://nuxyautomation.com";
const business = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": `${site}/#business`,
  name: "Nuxy Automation",
  url: `${site}/`,
  logo: `${site}/logo.png`,
  image: `${site}/og.jpg`,
  email: inbox,
  description: "Websites, online stores and business automation for small businesses: business websites, Shopify and Square Online stores, lead response and follow-up, missed-call text-back, online booking and reminders, estimate follow-up, and invoice and admin automations, built in the client’s own accounts at published prices agreed in writing.",
  address: { "@type": "PostalAddress", addressLocality: "Faribault", addressRegion: "MN", addressCountry: "US" },
  areaServed: [
    ...["Faribault", "Northfield", "Owatonna", "Lakeville"].map((name) => ({ "@type": "City", name: `${name}, Minnesota` })),
    { "@type": "AdministrativeArea", name: "Southern Minnesota" },
    { "@type": "AdministrativeArea", name: "Minneapolis–Saint Paul metropolitan area" },
    { "@type": "Country", name: "United States" },
  ],
  priceRange: `${money(Math.min(...oneTime))}-${money(Math.max(...oneTime))}`,
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Website, online store and automation services",
    itemListElement: services.map((s) => ({
      "@type": "Offer",
      url: `${site}/solutions/#${s.id}`,
      itemOffered: { "@type": "Service", name: s.name, description: s.text },
      ...(s.priceType === "fixed"
        ? { price: String(dollars(s.price)), priceCurrency: "USD" }
        : { priceSpecification: { "@type": "PriceSpecification", minPrice: String(dollars(s.price)), priceCurrency: "USD" } }),
    })),
  },
};
---
<Base title="Nuxy Automation · Websites, Automation & Website Care" wide>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(business)} />

  <section class="hero cine-host" data-hero>
    <CinematicLoop id="hero" backdrop eager />
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Websites, automation & website care<span class="ey-sep"> · </span><span class="ey-place">Faribault, MN</span></p>
        <h1><span>Websites That Stand Out.</span> <span>Systems That Save You Time.</span></h1>
        <p class="hero-lead">Custom websites and practical automation built around your business. Clear prices in writing, and everything set up in your own accounts.</p>
        <div class="hero-actions">
          <a class="button" href="/contact/" data-track="cta_hero">Get a Free Quote<Icon name="arrowRight" /></a>
          <a class="button secondary" href="#portfolio" data-track="cta_explore_work">Explore Our Work</a>
        </div>
        <div class="hero-price-clip"><ul class="hero-price" aria-label="Starting prices">{startPrices.map((p) => <li>{p.href ? <a href={p.href}>{p.text}</a> : p.text}</li>)}</ul></div>
      </div>
    </div>
  </section>

  <section class="section" id="what-we-do" aria-labelledby="do-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">What we do</p>
        <h2 id="do-h">What Can Nuxy Do for Your Business?</h2>
        <p>Three kinds of work, each with its starting price.</p>
      </div>
      <div class="grid-3">
        {categories.map((c) => (
          <article class="prim cat reveal">
            <div class="prim-head"><span class="prim-icon"><Icon name={c.icon} /></span><h3>{titleCase(c.title)}</h3></div>
            <p>{c.text}</p>
            <p class="prim-price">{c.price}</p>
            <a class="text-link" href={c.href} data-track={c.track}>{c.cta}<Icon name="arrowRight" /></a>
          </article>
        ))}
      </div>
      <p class="more"><a class="text-link" href="/solutions/" data-track="cta_services">See all {services.length} services<Icon name="arrowRight" /></a></p>
      <p class="note also-note"><Icon name="filmSlate" /><span>Need a video for your business? We also make <a href="/creative-studio/" data-track="cta_home_creative">short video ads, moving menus and product showcases</a>, made with AI video tools and finished by a person.</span></p>
    </div>
  </section>

  <section class="section band" id="portfolio" aria-labelledby="portfolio-h">
    <div class="wrap">
      <div class="web-head">
        <div class="section-head">
          <p class="eyebrow">Our work</p>
          <h2 id="portfolio-h">{hasClients ? "Client Projects and Concept Demonstrations" : "Concept Demonstrations: Real Websites for Made-Up Businesses"}</h2>
          <p>{hasClients
            ? `Real client work first, ${anyStaged ? "published only once the client approves in writing" : "shown with permission"}. After it, concept demonstrations: websites for made-up businesses that you can open and try.`
            : "None of them is a client project. They are websites and an online store built to show what Nuxy can build. Open one to try it at full size, on a computer or a phone."}</p>
        </div>
        <div class="web-actions">
          <a class="button secondary" href="/portfolio/" data-track="cta_portfolio">See All Our Work<Icon name="arrowRight" /></a>
        </div>
      </div>
      {hasClients && <div class="cases">{clients.map((c) => <CaseStudy study={c} />)}</div>}
      <p class="kind-label"><Icon name="info" /><span><strong>Concept demonstrations</strong> · made-up businesses, built to show what Nuxy can build. Open one to see it on a computer and a phone.</span></p>
      <DemoStrip only={concepts} />
    </div>
  </section>

  <section class="section" id="website-levels" aria-labelledby="levels-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Website levels and prices</p>
        <h2 id="levels-h">Four Website Levels, From Simple to Bespoke</h2>
        <p>Each level adds design, motion and engineering, and the price follows the work. Interactive 3D and scroll storytelling start at Immersive: they are not part of Business or Signature.</p>
      </div>
      <LevelRail compact />
      <p class="more">
        {/* (site audit 2026-11-21, critique round 3) the quote is this section's one filled button, as in the others.
            (critique round 5) two ways on, not three: "See all pricing" went, Pricing is in the menu on every page */}
        <a class="button" href="/contact/" data-track="cta_tiers_quote">Get a Free Quote</a>
        <a class="button secondary" href="/web-design/" data-track="cta_levels_compare">Compare Website Levels<Icon name="arrowRight" /></a>
      </p>
    </div>
  </section>

  <AutopilotDemos>
    <ul class="tools" slot="after" role="list">
      <li><a class="tool" href="/automation/#what-to-automate" data-track="cta_home_picker"><span class="tool-name">What Do You Want to Automate?</span><span class="tool-text">Pick a goal to see the best fits and their starting prices.</span><Icon name="arrowRight" /></a></li>
      <li><a class="tool" href="/pricing/#package" data-track="cta_home_estimator"><span class="tool-name">Build Your Automation Package</span><span class="tool-text">Choose what your business needs and see an estimated starting price.</span><Icon name="arrowRight" /></a></li>
    </ul>
  </AutopilotDemos>

  <section class="section" id="why-nuxy" aria-labelledby="why-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Why Nuxy</p>
        <h2 id="why-h">Fair Prices, Work You Own, One Person to Talk To</h2>
      </div>
      <ul class="trust">
        {trust.map((t) => (
          <li class="reveal">
            <Icon name={t.icon} />
            <h3>{titleCase(t.title)}</h3>
            <p>{noWidow(t.text)}</p>
          </li>
        ))}
      </ul>
      <p class="trust-foot"><Icon name="mapPin" /><span>Based in Faribault, Minnesota. We work with businesses in {areas.slice(0, -2).join(", ")}, {areas.at(-2)} and {areas.at(-1)}, and remotely anywhere in the US. <a href="/about/">About Nuxy</a> · <a href="/policies/">Our written policies</a> · <a href="/pricing/#faq">Questions about prices and paying</a></span></p>
    </div>
  </section>

  <section class="section band" id="handover" aria-labelledby="handover-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Easy handover</p>
        <h2 id="handover-h">Your Website. Your Control. <span class="nw-line">None of the Technical Headaches.</span></h2>
        <p>From getting your website online to connecting your business tools, Nuxy helps make the complicated parts simple. We guide you through the decisions that matter and handle the technical work covered by your project. No sales call and no long contract: nothing is charged until you agree to the written plan (<a href="/about/#how-we-work">how a job runs</a>).</p>
      </div>
      <ol class="ho-steps" role="list">
        {handoverSteps.map((s, i) => <li class="ho-step"><span class="ho-num" aria-hidden="true">{i + 1}</span><span class="ho-body"><span class="ho-title">{s.title}</span><span class="ho-line">{s.text.split(/(?<=\.)\s/)[0]}</span></span></li>)}
      </ol>
      <p class="more"><a class="button secondary" href="/handover/" data-track="cta_handover">How Handover Works<Icon name="arrowRight" /></a></p>
    </div>
  </section>

  <section class="final" aria-labelledby="final-h" data-final>
    <div class="wrap"><div class="final-box">
      <h2 id="final-h">A Fixed Price in Writing Within One Business Day</h2>
      <p>Tell us about your business and what you need. The price comes with a written recommendation, and no sales call is required.</p>
      <div class="final-actions">
        <a class="button" href="/contact/" data-track="cta_final">Get a Free Quote<Icon name="arrowRight" /></a>
        {callbackForm && <a class="final-mail" href="/contact/#callback" data-track="cta_final_callback"><Icon name="phone" />Request a callback</a>}
        <a class="final-mail" href={`mailto:${inbox}`}><Icon name="envelopeSimple" />{inbox}</a>
        {/* (critique round 5) the only way to the answers was a link at the end of the location line; a visitor with a
            question before asking now finds it where they decide */}
        <a class="final-mail" href="/pricing/#faq"><Icon name="question" />Questions about prices and paying</a>
      </div>
    </div></div>
  </section>

  {/* Phones only, and only with the script: one quote button that comes in after the hero and steps aside wherever
      the page already offers the next step (the final box, the footer). Closing it lasts the visit. */}
  <div class="sticky-cta" data-sticky hidden>
    <a class="button" href="/contact/" data-track="cta_sticky">Get a Free Quote<Icon name="arrowRight" /></a>
    <button type="button" class="sticky-x" data-sticky-close aria-label="Hide the quote button"><Icon name="x" /></button>
  </div>
</Base>

<script>
  // The phone quote button. No scroll listener: an observer says when the hero, the final box or the footer is on
  // screen, and the button shows only when none of them is.
  const bar = document.querySelector<HTMLElement>("[data-sticky]");
  const KEY = "nuxy-quote-bar";
  let closed = false;
  try { closed = sessionStorage.getItem(KEY) === "off"; } catch {}
  if (bar && !closed && "IntersectionObserver" in window) {
    const quiet = [...document.querySelectorAll("[data-hero], [data-final], footer")];
    const seen = new Set<Element>();
    const set = (on: boolean) => { bar.classList.toggle("is-on", on); bar.inert = !on; };
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) e.isIntersecting ? seen.add(e.target) : seen.delete(e.target);
      set(seen.size === 0);
    });
    bar.hidden = false;
    bar.inert = true;
    quiet.forEach((el) => io.observe(el));
    bar.querySelector("[data-sticky-close]")?.addEventListener("click", () => {
      io.disconnect();
      set(false);
      try { sessionStorage.setItem(KEY, "off"); } catch {}
    });
  }
</script>


<style>
  /* (2026-11-17) The studio hero: the copy in one column on the page colour, the graphite object (H1/H3, a 16:9 loop)
     at full brightness to its right. No part of the picture sits under a word: from 1200px a page-colour band
     (::before) covers the copy column and fades out past it, so the text contrast is the page's own. */
  .hero { position: relative; padding: clamp(40px, 7vw, 72px) 0 clamp(48px, 7vw, 72px); overflow: hidden; }
  .hero-grid { position: relative; display: grid; }
  .hero-copy { max-width: 36rem; }
  .hero :global(.cine.backdrop)::after { background: none; }
  /* (critique round 5) the two mask gradients must intersect: by default mask layers add up, so wherever one gradient was
     solid the other's fade did nothing, and the picture kept a hard top edge under the menu (1440) and a hard right and
     bottom edge on a phone. Intersected, every edge fades into the page. */
  .hero :global(.cine.backdrop) { -webkit-mask-composite: source-in; mask-composite: intersect; }
  @media (min-width: 1200px) {
    /* the hero is at most one 16:9 frame tall; the frame is pinned right and runs a little off the edge (its right strip
       is empty studio), so the object starts after the copy column at every width from 1200 up */
    .hero { --hh: clamp(600px, calc(100svh - 72px), 660px); --copy-end: calc(max(40px, 50% - 560px) + 36rem); display: grid; align-items: center; min-height: var(--hh); }
    .hero::before { content: ""; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(90deg, var(--bg) 0, var(--bg) var(--copy-end), transparent calc(var(--copy-end) + 96px)); }
    .hero :global(.cine.backdrop) {
      inset: 0 calc(var(--hh) * 16 / 9 * -0.07) auto auto; width: calc(var(--hh) * 16 / 9); height: var(--hh);
      -webkit-mask-image: linear-gradient(to bottom, transparent, #000 14%, #000 72%, transparent), linear-gradient(90deg, transparent, #000 20%);
      mask-image: linear-gradient(to bottom, transparent, #000 14%, #000 72%, transparent), linear-gradient(90deg, transparent, #000 20%);
    }
  }
  /* Under 1200px the 16:9 frame no longer clears the copy: the object is a still made for a narrower shape (H2,
     cinematic-manifest stillBelow), never behind a word. 900-1199: beside the copy, a narrower copy column. */
  @media (max-width: 1199px) {
    /* (the box sits on whole pixels: on a half pixel the picture's top row showed through the mask as a faint line) */
    .hero :global(.cine.backdrop) {
      inset: round(down, calc(var(--top)), 1px) 0 auto auto; width: var(--sw); height: var(--sh);
      -webkit-mask-image: linear-gradient(to bottom, transparent, #000 18%, #000 80%, transparent), linear-gradient(90deg, transparent, #000 14%, #000 88%, transparent);
      mask-image: linear-gradient(to bottom, transparent, #000 18%, #000 80%, transparent), linear-gradient(90deg, transparent, #000 14%, #000 88%, transparent);
    }
  }
  /* (critique round 6: on a phone the picture's lit right side met the screen edge after a fade only about 37px wide,
     so it read as cut off) under 900px the right side fades over the last quarter of the picture */
  @media (max-width: 899px) {
    .hero :global(.cine.backdrop) {
      -webkit-mask-image: linear-gradient(to bottom, transparent, #000 18%, #000 80%, transparent), linear-gradient(90deg, transparent, #000 14%, #000 74%, transparent);
      mask-image: linear-gradient(to bottom, transparent, #000 18%, #000 80%, transparent), linear-gradient(90deg, transparent, #000 14%, #000 74%, transparent);
    }
  }
  @media (min-width: 900px) and (max-width: 1199px) {
    .hero-copy { max-width: 30rem; }
    .hero { --sw: round(down, 100vw - 30rem - max(40px, 4vw) - 24px, 2px); --sh: round(down, var(--sw) / 1.1636, 2px); --top: 50% - var(--sh) / 2; }
  }
  /* Under 900px: the copy, then the object below it. The work follows. (site audit 2026-11-21: the bottom padding was the
     still's height less 8-16px, so the still's fading top edge ran under the last line of prices: 4.14:1 on a white
     frame at 390px. The padding is now the still's full height, so no word sits over it.) */
  @media (max-width: 899px) {
    .hero { --sw: round(down, min(100vw, 560px), 2px); --sh: round(down, var(--sw) / 1.1636, 2px); --top: 100% - var(--sh); padding-bottom: var(--sh); }
  }
  /* (critique 11-17, round 7) on a phone the full-width object took most of a screen between the offer and the work:
     a smaller one, set to the right, leaves the work starting about 60px sooner */
  @media (max-width: 599px) {
    .hero { --sw: round(down, 80vw, 2px); }
    /* (critique 11-17, round 8) the eyebrow wrapped mid-line and left the "·" dangling: the place gets its own line */
    /* (round 9) the eyebrow is a flex row, so a block span became a second column: wrap, and give the place the full row */
    .ey-sep { display: none; }
    .hero .eyebrow { flex-wrap: wrap; }
    .ey-place { flex-basis: 100%; }
  }
  /* the hero already ends in its own space (the copy is centred in a frame-tall box, or the still fades out under it):
     the work after it takes a shorter top margin, or the two added up to ~190px of nothing on a desktop */
  .hero + .section { padding-top: clamp(32px, 4.5vw, 64px); }
  /* the hero type token from DESIGN.md, to the letter */
  /* Two statements, one per offer: the second line steps back in tone so four wrapped lines still read as two. */
  .hero h1 { font-size: clamp(2.25rem, 1.3rem + 3.6vw, 3.75rem); line-height: 1.06; letter-spacing: -0.035em; text-wrap: balance; }
  .hero h1 span + span { color: var(--muted); }
  .hero h1 span { display: block; }
  .hero-lead { max-width: 54ch; margin-top: 22px; font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.25rem); color: var(--body); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  /* three short facts with a rule between them; the list is pulled left by one item's padding and clipped, so a
     line never starts with a rule */
  .hero-price-clip { margin-top: 20px; overflow: hidden; }
  .hero-price { display: flex; flex-wrap: wrap; gap: 6px 0; margin: 0 0 0 -15px; list-style: none; color: var(--body); font-size: 0.875rem; font-weight: 500; }
  .hero-price li { padding: 0 12px 0 14px; border-left: 1px solid var(--hairline-strong); line-height: 1.3; }
  .hero-price a { display: inline-block; padding-block: 6px; margin-block: -6px; color: inherit; text-decoration: underline; text-decoration-color: var(--hairline-strong); text-underline-offset: 3px; }
  .hero-price a:hover { color: var(--ink); text-decoration-color: currentColor; }
  /* (critique 11-17, round 9: each price link was a 30px target) on a touch screen each is 44px tall without moving the
     line; the clip box gets room above and below so its edges don't cut the taller targets */
  @media (pointer: coarse) {
    .hero-price-clip { margin-top: 12px; padding-block: 8px; }
    .hero-price a { padding-block: 13px; margin-block: -13px; }
  }
  @media (max-width: 479px) { .hero-actions .button { width: 100%; } }

  .prim { display: flex; flex-direction: column; gap: 12px; padding: 24px; border: 1px solid var(--hairline); border-radius: var(--r-lg); background: var(--panel); }
  /* (critique 11-17) the icon sits beside the heading, not in a tile stacked over it (the stock feature-card shape) */
  .prim-head { display: flex; align-items: center; gap: 14px; }
