---
import { titleCase } from "../../lib/title-case";
// Portfolio: the example websites and the example store (data/demo-sites.ts), each with its industry, project type,
// features, the services it shows, a computer-and-phone picture, the viewer (/examples/<slug>/) and the demo itself.
// The automation code examples sit in their own section further down, so design work and technical work never mix.
// Every business here is made up and the page says so at the top and on every example; there are no reviews, no client
// logos and no results on this page, because there are none to show yet. A real client project (data/case-studies.ts,
// only with the client's written consent) gets its own section above the examples, and the note at the top then says
// which is which instead of "every business on this page is made up".
// Each example carries its website level (data/tiers.ts) as a badge, and with JavaScript a row of buttons filters
// the examples by level (`portfolio_tier_filter`, name and page only). Without JavaScript every example shows.
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import DeviceShot from "../../components/DeviceShot.astro";
import CaseStudy from "../../components/CaseStudy.astro";
import VideoTeasers from "../../components/VideoTeasers.astro";
import { demos } from "../../data/creative";
import { demosReady } from "../../data/cinematic";
import { isStaged, replacedDemos, shownCases } from "../../data/case-studies";
import { demoSites } from "../../data/demo-sites";
import { examples } from "../../data/examples";
import { serviceById } from "../../data/services";
import { levelById } from "../../data/tiers";

const repo = "https://github.com/Nuxy1/small-business-automations";
// real client projects: the ones that pass every check in data/case-studies.ts, plus, in the stage build only, the ones
// still waiting on the client's written approval (shownCases; CaseStudy marks those "Staged preview")
const clients = shownCases;
const anyStaged = clients.some((c) => isStaged(c));
// the video demos listed: a demo that a client project replaces is left out (VideoTeasers does the same)
const videos = demos.filter((d) => !replacedDemos.has(d.id)).length;
// the video demos are listed here only when all three have real, checked files (the same rule as the gallery)
const hasVideo = demosReady(demos.map((d) => d.id));
const isStore = (project: string) => project === "E-commerce store";
const where = (id: string) => (id === "new-website" ? "/websites/#new-website" : id === "online-shop" ? "/ecommerce/" : `/solutions/#${id}`);
const sites = demoSites.filter((d) => !isStore(d.project)).length;
const stores = demoSites.length - sites;
const shown = ["business", "signature", "immersive"] as const;
const steps = { Lower: 1, Moderate: 2, High: 3, Bespoke: 4 } as const;
const version = (d: (typeof demoSites)[number]) => isStore(d.project)
  ? d.tier === "business" ? "Built in your own Shopify or Square Online account" : "A custom-designed theme on your own Shopify store"
  : d.tier === "business" ? "Built in your own Squarespace or Wix account" : "Custom-coded and published to hosting in your name";
// Structured data for search: the page as a collection of concept projects. Each one is named a concept by Nuxy
// Automation for a made-up business, never a client (the brief: fictional work is never presented as paid work).
const site = "https://nuxyautomation.com";
const ld = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "@id": `${site}/portfolio/#page`,
    url: `${site}/portfolio/`,
    name: "Portfolio: concept websites by Nuxy Automation",
    publisher: { "@id": `${site}/#business` },
    mainEntity: {
      "@type": "ItemList",
      itemListElement: demoSites.map((d, i) => ({
        "@type": "ListItem",
        position: i + 1,
        item: {
          "@type": "CreativeWork",
          name: `${d.name} (concept project)`,
          url: `${site}/portfolio/#${d.slug}`,
          description: `Concept project created by Nuxy Automation; ${d.name} is a made-up business, not a client. ${d.summary}`,
          creator: { "@id": `${site}/#business` },
        },
      })),
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${site}/` },
      { "@type": "ListItem", position: 2, name: "Portfolio", item: `${site}/portfolio/` },
    ],
  },
];
const count = (n: number, one: string, many: string) => `${["no", "one", "two", "three", "four", "five", "six"][n] ?? n} ${n === 1 ? one : many}`;
---
<Base title={clients.length === 0 ? "Portfolio: Concept Websites and a Store · Nuxy Automation" : "Portfolio: Client Work, Concept Websites and a Store · Nuxy Automation"} description={`${clients.length === 0 ? "" : `Real client work (${clients.map((c) => c.business).join(", ")}), plus `}${clients.length === 0 ? "Concept" : "concept"} websites and a store for made-up businesses${clients.length === 0 ? ", by website level" : ""}: a landscaper, a barber, a cleaner, a candle shop and a speaker brand.`} wide>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ld)} />
  <section class="pf-hero">
    <div class="wrap pf-grid">
      <div>
        <p class="eyebrow">Portfolio</p>
        <h1>{clients.length === 0 ? "Concept Demonstrations You Can Click Through" : "Client Projects and Concept Demonstrations You Can Click Through"}</h1>
        <p class="lead">{count(sites, "business website", "business websites").replace(/^\w/, (c) => c.toUpperCase())} and {count(stores, "online store", "online stores")}, each built for a made-up business so you can see the layout, features and finish we aim for. Open any of them on a computer or a phone, and try the forms.</p>
        {clients.length === 0 ? (
          <p class="made-up"><Icon name="info" /><span><strong>These are concept demonstrations, not client projects.</strong> Every business on this page is made up and labeled that way. There are no reviews or results here, because examples have none to show.</span></p>
        ) : (
          <p class="made-up"><Icon name="info" /><span><strong>Client projects and examples are kept apart.</strong> {anyStaged ? "The client projects are real businesses. This preview is published only once each client approves it in writing." : "The client projects are real and shown with each client's permission."} Every example business below them is made up and labeled that way.</span></p>
        )}
      </div>
      <nav class="jump" aria-labelledby="jump-h">
        <h2 id="jump-h" class="jump-h">On This Page</h2>
        <ul role="list">
          {clients.length > 0 && <li><a href="#clients"><Icon name="briefcase" /><span><strong>Client projects</strong><span>{anyStaged ? "Real work, staged for the client's approval" : "Real work, shown with permission"}</span></span></a></li>}
          {demoSites.map((d) => (
            <li data-tier={d.tier}><a href={`#${d.slug}`}><Icon name={d.icon} /><span><strong>{d.name}</strong><span>{d.project}</span></span></a></li>
          ))}
          {hasVideo && <li><a href="#video"><Icon name="filmSlate" /><span><strong>Video concept demonstrations</strong><span>{count(videos, "short video", "short videos").replace(/^\w/,(c) => c.toUpperCase())} for made-up brands</span></span></a></li>}
          <li><a href="#technical"><Icon name="githubLogo" /><span><strong>Interactive experiments</strong><span>{count(examples.length, "working automation", "working automations").replace(/^\w/, (c) => c.toUpperCase())}</span></span></a></li>
        </ul>
      </nav>
    </div>
  </section>

  {clients.length > 0 && (
    <section class="section" id="clients" aria-labelledby="clients-h">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Real client projects</p>
          <h2 id="clients-h">Work for Real Businesses</h2>
          <p>{anyStaged ? "Real websites for real businesses. This is a staged preview: a project goes live here only once its client approves it in writing." : "Each one is shown with the client's permission."}</p>
        </div>
        <div class="clients">{clients.map((c) => <CaseStudy study={c} />)}</div>
      </div>
    </section>
  )}

  <section class="section cases" id="concepts" aria-labelledby="concepts-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Concept demonstrations</p>
        <h2 id="concepts-h">Made-Up Businesses, Real Websites</h2>
        <p>Fictional projects built to show what each website level can do. Each one is a working site you can open and try, and none of them is a client.</p>
      </div>
      <div class="pf-filter" role="group" aria-label="Show examples by website level" data-pf-filter hidden>
        <button type="button" data-tier="all" aria-pressed="true">All levels</button>
        {shown.map((t) => <button type="button" data-tier={t} aria-pressed="false">{levelById[t].name}</button>)}
        <p class="pf-flag">Flagship work is planned one project at a time: <a href="/contact/?level=flagship" data-track="tier_selected">discuss a custom project</a>.</p>
      </div>
      {demoSites.map((d, i) => {
        const store = isStore(d.project);
        return (
          <article class:list={["case", { flip: i % 2 === 1 }]} id={d.slug} data-tier={d.tier} aria-labelledby={`${d.slug}-h`}>
            <div class="case-shot"><DeviceShot slug={d.slug} lazy={i > 0} /></div>
            <div class="case-copy">
              <p class="case-kind"><Icon name={d.icon} />{d.kind} · concept demonstration<a class="case-tier" href={levelById[d.tier].page}><span class="case-steps" aria-hidden="true">{[1, 2, 3, 4].map((n) => <i class:list={{ on: n <= steps[levelById[d.tier].complexity] }}></i>)}</span>{levelById[d.tier].name}</a></p>
              <h3 id={`${d.slug}-h`}>{d.name}</h3>
              <p class="case-sum">{d.summary}</p>
              <dl class="case-facts">
                <div><dt>Industry</dt><dd>{d.kind}</dd></div>
                <div><dt>Project</dt><dd>{d.project}</dd></div>
                <div><dt>Level</dt><dd><a href={levelById[d.tier].page}>{levelById[d.tier].name}</a> · {levelById[d.tier].complexity.toLowerCase()} complexity</dd></div>
                <div><dt>Your version</dt><dd>{version(d)}</dd></div>
              </dl>
              <h4 class="case-h3">Features</h4>
              <ul class="ticks case-ticks">{d.shows.map((s) => <li><Icon name="check" />{s}</li>)}</ul>
              <p class="case-svc">Services it shows: {d.services.map((id, j) => (
                <>{j > 0 && ", "}<a href={where(id)}>{serviceById[id].name}</a> ({serviceById[id].price})</>
              ))}</p>
              {store && <p class="case-note"><Icon name="lockSimple" /><span>Its cart and checkout work as a demo, but no card is ever asked for: nothing can be bought.</span></p>}
              <div class="case-actions">
                <a class="button" href={`/examples/${d.slug}/`} data-track="example_open">View Project</a>
                <a class="button secondary" href={`/example-sites/${d.slug}/`} data-track="example_full">Open the full {store ? "store" : "site"}</a>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  {hasVideo && (
    <section class="section" id="video" aria-labelledby="video-h">
      <div class="wrap">
        <VideoTeasers level={2} headingId="video-h" title="Video concept demonstrations" />
      </div>
    </section>
  )}

  <section class="section band" id="technical" aria-labelledby="technical-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Interactive experiments</p>
        <h2 id="technical-h">Automations, with the Code</h2>
        <p>Technical work, kept apart from the website concepts: {count(examples.length, "working automation", "working automations")}, published as open source with automated tests and plain-English docs. Each example page walks through a made-up business’s week.</p>
      </div>
      <ul class="tech grid-2" role="list">
        {examples.map((e) => (
          <li class="tech-item">
            <h3><a href={`/work/${e.slug}/`}>{titleCase(e.title)}</a></h3>
            <p>{e.problem}</p>
            <p class="tech-svc">Service: <a href={`/solutions/#${e.service.id}`}>{serviceById[e.service.id].name}</a>, {serviceById[e.service.id].price}</p>
          </li>
        ))}
      </ul>
      <div class="tech-links">
        <a class="button secondary" href={repo} rel="noopener" data-track="github_open"><Icon name="githubLogo" />The code on GitHub<Icon name="arrowUpRight" /></a>
        <a class="button secondary" href="/demos/" data-track="portfolio_demos"><Icon name="play" />Interactive demos</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="cta-band">
        <div>
          <h2>Want Something Like This for Your Business?</h2>
          <p>Tell us what you need. Within one business day you’ll get a written plan and a fixed price, with nothing charged until you agree.</p>
        </div>
        <div class="cta-actions">
          <a class="button" href="/contact/" data-track="cta_portfolio_quote">Get a Free Quote</a>
          <a class="button secondary" href="/pricing/">See pricing</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .pf-hero { padding-block: clamp(40px, 6vw, 80px) clamp(8px, 2vw, 24px); }
  .pf-hero h1 { max-width: 20ch; font-size: clamp(2.125rem, 1.5rem + 2.6vw, 3.25rem); }
  .pf-hero .lead { margin-top: 18px; max-width: 62ch; }
  .made-up { display: flex; gap: 10px; align-items: flex-start; max-width: 72ch; margin-top: 24px; padding: 14px 16px; border: 1px solid var(--hairline); border-radius: var(--r-md, 12px); background: var(--panel); color: var(--body); font-size: 0.9375rem; }
  .made-up :global(.icon) { flex: none; margin-top: 0.2em; color: var(--cyan); }
  .made-up strong { color: var(--ink); }
  .pf-grid { display: grid; gap: 32px; }
  @media (min-width: 960px) { .pf-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 20rem); gap: 56px; align-items: end; } }
  .jump-h { color: var(--muted); font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; }
  .jump ul { display: grid; gap: 2px; margin: 10px 0 0; padding: 0; list-style: none; border-top: 1px solid var(--hairline); }
  .jump li { border-bottom: 1px solid var(--hairline); }
  .clients { display: grid; gap: 20px; }
  .jump a { display: flex; gap: 12px; align-items: center; min-height: 52px; padding: 8px 4px; color: var(--ink); text-decoration: none; }
  .jump a:hover strong { color: var(--link); text-decoration: underline; text-underline-offset: 3px; }
  .jump a :global(.icon) { flex: none; color: var(--cyan); }
  .jump a > span { display: grid; }
  .jump strong { font-size: 0.9375rem; font-weight: 600; }
  .jump strong + span { color: var(--muted); font-size: 0.8125rem; }

  .cases .wrap { display: grid; gap: clamp(56px, 8vw, 104px); }
  .case { display: grid; gap: 28px; align-items: center; scroll-margin-top: 16px; }
  @media (min-width: 960px) {
    .case { grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: 56px; }
    .case.flip .case-shot { order: 2; }
  }
  .case-kind { display: inline-flex; align-items: center; gap: 8px; color: var(--cyan); font-size: 0.875rem; font-weight: 600; }
  .case h3 { margin-top: 8px; font-size: clamp(1.625rem, 1.3rem + 1.2vw, 2.125rem); }
  .case-sum { margin-top: 12px; color: var(--body); max-width: 56ch; }
  .case-facts { display: grid; gap: 10px; margin-top: 20px; padding-block: 14px; border-block: 1px solid var(--hairline); }
  .case-facts div { display: grid; grid-template-columns: 7.5rem minmax(0, 1fr); gap: 12px; }
  .case-facts dt { color: var(--muted); font-size: 0.875rem; font-weight: 600; }
  .case-facts dd { margin: 0; color: var(--ink); font-size: 0.9375rem; }
  .case-h3 { margin-top: 20px; font-size: 1rem; }
  .case-ticks { margin-top: 10px; color: var(--body); }
  .case-svc { margin-top: 16px; color: var(--muted); font-size: 0.9375rem; }
  .case-note { display: flex; gap: 8px; align-items: flex-start; margin-top: 12px; color: var(--body); font-size: 0.9375rem; }
  .case-note :global(.icon) { flex: none; margin-top: 0.2em; color: var(--cyan); }
  .case-tier { display: inline-flex; align-items: center; gap: 8px; margin-left: 4px; padding: 2px 10px; border: 1px solid var(--hairline-strong); border-radius: var(--r-full); color: var(--ink); font-size: 0.8125rem; text-decoration: none; }
  .case-tier:hover { border-color: var(--link); }
  .case-steps { display: inline-grid; grid-template-columns: repeat(4, 10px); gap: 2px; }
  .case-steps i { height: 4px; border-radius: 2px; background: var(--hairline-strong); }
  .case-steps i.on { background: var(--link); }
  .case-facts a { color: var(--link); }
  .pf-filter:not([hidden]) { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .pf-filter button { min-height: 44px; padding: 0 16px; border: 1px solid var(--hairline); border-radius: var(--r-full); background: var(--panel); color: var(--body); font-weight: 600; font-size: 0.9375rem; cursor: pointer; transition: border-color 150ms var(--ease), background-color 150ms var(--ease); }
  .pf-filter button:hover { border-color: var(--hairline-strong); color: var(--ink); }
  .pf-filter button[aria-pressed="true"] { border-color: var(--button); background: var(--button); color: #fff; }
  .pf-flag { flex-basis: 100%; margin-top: 4px; color: var(--muted); font-size: 0.9375rem; }
  .pf-flag a { color: var(--link); }
  .case-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
  @media (max-width: 479px) { .case-actions .button { width: 100%; } }

  .tech { margin: 0; padding: 0; list-style: none; }
  .tech-item { display: flex; flex-direction: column; gap: 10px; padding: 24px; border: 1px solid var(--hairline); border-radius: var(--r-lg); background: var(--panel); }
  .tech-item h3 { font-size: 1.125rem; }
  /* a one-line heading link: the invisible layer makes its tap area taller without moving anything */
  .tech-item h3 a { position: relative; color: var(--ink); text-decoration: none; }
  .tech-item h3 a::after { content: ""; position: absolute; inset: -10px 0; }
  .tech-item h3 a:hover { color: var(--link); text-decoration: underline; text-underline-offset: 3px; }
  .tech-item p { color: var(--body); font-size: 0.9375rem; }
  .tech-item .tech-svc { margin-top: auto; padding-top: 10px; border-top: 1px solid var(--hairline-soft); color: var(--muted); }
  .tech-links { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  @media (max-width: 479px) { .tech-links .button { width: 100%; } }
</style>

<script>
  // Filter the examples by website level. Hidden examples (and their "On this page" links) are hidden outright, and
  // the picture side alternates again over the ones still showing.
  const bar = document.querySelector<HTMLElement>("[data-pf-filter]");
  if (bar) {
    const cases = [...document.querySelectorAll<HTMLElement>("article.case[data-tier]")];
    const links = [...document.querySelectorAll<HTMLElement>(".jump li[data-tier]")];
    const set = (tier: string) => {
      bar.querySelectorAll<HTMLButtonElement>("button").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.tier === tier)));
      let n = 0;
      for (const c of cases) {
        const on = tier === "all" || c.dataset.tier === tier;
        c.hidden = !on;
        if (on) c.classList.toggle("flip", n++ % 2 === 1);
      }
      for (const l of links) l.hidden = !(tier === "all" || l.dataset.tier === tier);
    };
    bar.addEventListener("click", (e) => {
      const b = (e.target as Element).closest<HTMLButtonElement>("button[data-tier]");
      if (!b || b.getAttribute("aria-pressed") === "true") return;
      set(b.dataset.tier!);
      (window as unknown as { nuxyTrack?: (e: string) => void }).nuxyTrack?.("portfolio_tier_filter");
    });
    bar.hidden = false;
  }
</script>
