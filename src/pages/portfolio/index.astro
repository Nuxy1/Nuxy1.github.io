---
import { titleCase } from "../../lib/title-case";
// Portfolio: the example websites and the example store (data/demo-sites.ts), each with its industry, project type,
// features, the services it shows, a computer-and-phone picture, the viewer (/examples/<slug>/) and the demo itself.
// The automation code examples sit in their own section further down, so design work and technical work never mix.
// Every business here is made up and the page says so at the top and on every example; there are no reviews, no client
// logos and no results on this page, because there are none to show yet. A real client project (data/case-studies.ts,
// only with the client's written consent) gets its own section above the examples, and the note at the top then says
// which is which instead of "every business on this page is made up".
// Each example carries its website level (data/tiers.ts) as a badge, and with JavaScript a row of buttons filters
// the examples by level (`portfolio_tier_filter`, name and page only). Without JavaScript every example shows.
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import DeviceShot from "../../components/DeviceShot.astro";
import CaseStudy from "../../components/CaseStudy.astro";
import VideoTeasers from "../../components/VideoTeasers.astro";
import { demos } from "../../data/creative";
import { demosReady } from "../../data/cinematic";
import { isStaged, replacedDemos, shownCases } from "../../data/case-studies";
import { demoSites as allDemoSites, listedServices } from "../../data/demo-sites";
import { examples } from "../../data/examples";
import { serviceById, variantById } from "../../data/services";
import { levelById } from "../../data/tiers";

const repo = "https://github.com/Nuxy1/small-business-automations";
// real client projects: the ones that pass every check in data/case-studies.ts, plus, in the stage build only, the ones
// still waiting on the client's written approval (shownCases; CaseStudy marks those "Staged preview")
const clients = shownCases;
const anyStaged = clients.some((c) => isStaged(c));
// the video demos listed: a demo that a client project replaces is left out (VideoTeasers does the same)
const videos = demos.filter((d) => !replacedDemos.has(d.id)).length;
// the video demos are listed here only when all three have real, checked files (the same rule as the gallery)
const hasVideo = demosReady(demos.map((d) => d.id));
const isStore = (project: string) => project === "E-commerce store";
// (critique round 7) a Business card's service line said only "New website ($900)": it now gives both website prices,
// as the Business level's "$499 – $900" does, so the two never seem to disagree
const svcPrice = (id: string) => id === "new-website"
  ? `${serviceById["new-website"].price} up to 4 pages, ${variantById["starter-website"].price} for one page` : serviceById[id].price; // its own price first (tests/pricing.test.mjs §5)
const where = (id: string) => (id === "new-website" ? "/websites/#new-website" : id === "online-shop" ? "/ecommerce/" : `/solutions/#${id}`);
const shown = ["business", "signature", "immersive"] as const;
// (critique 11-17) in level order, like the filter: the made-up barber is no longer right under the real one
const demoSites = [...allDemoSites].sort((a, b) => shown.indexOf(a.tier as (typeof shown)[number]) - shown.indexOf(b.tier as (typeof shown)[number]));
const sites = demoSites.filter((d) => !isStore(d.project)).length;
const stores = demoSites.length - sites;
const steps = { Lower: 1, Moderate: 2, High: 3, Bespoke: 4 } as const;
const version = (d: (typeof demoSites)[number]) => isStore(d.project)
  ? d.tier === "business" ? "Built in your own Shopify or Square Online account" : "A custom-designed theme on your own Shopify store"
  : d.tier === "business" ? "Built in your own Squarespace or Wix account" : "Custom-coded and published to hosting in your name";
// Structured data for search: the page as a collection of concept projects. Each one is named a concept by Nuxy
// Automation for a made-up business, never a client (the brief: fictional work is never presented as paid work).
const site = "https://nuxyautomation.com";
const ld = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "@id": `${site}/portfolio/#page`,
    url: `${site}/portfolio/`,
    name: "Portfolio: concept websites by Nuxy Automation",
    publisher: { "@id": `${site}/#business` },
    mainEntity: {
      "@type": "ItemList",
      itemListElement: demoSites.map((d, i) => ({
        "@type": "ListItem",
        position: i + 1,
        item: {
          "@type": "CreativeWork",
          name: `${d.name} (concept project)`,
          url: `${site}/portfolio/#${d.slug}`,
          description: `Concept project created by Nuxy Automation; ${d.name} is a made-up business, not a client. ${d.summary}`,
          creator: { "@id": `${site}/#business` },
        },
      })),
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${site}/` },
      { "@type": "ListItem", position: 2, name: "Our Work", item: `${site}/portfolio/` },
    ],
  },
];
const count = (n: number, one: string, many: string) => `${["no", "one", "two", "three", "four", "five", "six"][n] ?? n} ${n === 1 ? one : many}`;
---
<Base title={clients.length === 0 ? "Portfolio: Concept Websites and a Store · Nuxy Automation" : "Portfolio: Client Work and Concept Websites · Nuxy Automation"} description={`${clients.length === 0 ? "" : `Real client work (${clients.map((c) => c.business).join(", ")}), plus `}${clients.length === 0 ? "Concept" : "concept"} websites and a store for made-up businesses${clients.length === 0 ? ", by website level" : ""}: a landscaper, a barber, a cleaner, a candle shop and a speaker brand.`} wide>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ld)} />
  <section class="pf-hero">
    <div class="wrap pf-grid">
      <div>
        <p class="eyebrow">Our work</p>
        <h1>{clients.length === 0 ? "Concept Demonstrations You Can Click Through" : "Client Projects and Concept Demonstrations You Can Click Through"}</h1>
        {/* (critique 11-17: two sentences, so "each built for a made-up business" can't be read as covering the client) */}
        <p class="lead">{clients.length > 0 && `${count(clients.length, "real client website", "real client websites").replace(/^\w/, (c) => c.toUpperCase())} ${clients.length === 1 ? "comes" : "come"} first. Then `}{clients.length > 0 ? count(sites, "business website", "business websites") : count(sites, "business website", "business websites").replace(/^\w/, (c) => c.toUpperCase())} and {count(stores, "online store", "online stores")}, each built for a made-up business so you can see the layout, features and finish we aim for. Open any of them on a computer or a phone, and try the forms.</p>
        {clients.length === 0 ? (
          <p class="made-up"><Icon name="info" /><span><strong>These are concept demonstrations, not client projects.</strong> Every business on this page is made up and labeled that way. There are no reviews or results here, because examples have none to show.</span></p>
        ) : (
          <p class="made-up"><Icon name="info" /><span><strong>{clients.length === 1 ? "The client project and the examples are kept apart." : "Client projects and examples are kept apart."}</strong> {clients.length === 1
            ? (anyStaged ? "The client project is a real business. This preview is published only once the client approves it in writing." : "The client project is real and shown with the client's permission.")
            : (anyStaged ? "The client projects are real businesses. This preview is published only once each client approves it in writing." : "The client projects are real and shown with each client's permission.")} Every example business below {clients.length === 1 ? "it" : "them"} is made up and labeled that way.</span></p>
        )}
      </div>
      <nav class="jump" aria-labelledby="jump-h">
        <h2 id="jump-h" class="jump-h">On This Page</h2>
        <ul role="list">
          {clients.length > 0 && <li><a href="#clients"><Icon name="briefcase" /><span><strong>Client Projects</strong><span>{anyStaged ? "Real work, staged for the client's approval" : "Real work, shown with permission"}</span></span></a></li>}
          {demoSites.map((d) => (
            <li data-tier={d.tier}><a href={`#${d.slug}`}><Icon name={d.icon} /><span><strong>{d.name}</strong><span>{d.project}</span></span></a></li>
          ))}
          {hasVideo && <li><a href="#video"><Icon name="filmSlate" /><span><strong>Concept Films</strong><span>{count(videos, "concept film", "concept films").replace(/^\w/,(c) => c.toUpperCase())}</span></span></a></li>}
          <li><a href="#technical"><Icon name="githubLogo" /><span><strong>Open-Source Automations</strong><span>{count(examples.length, "working automation", "working automations").replace(/^\w/, (c) => c.toUpperCase())}</span></span></a></li>
        </ul>
      </nav>
    </div>
  </section>

  {clients.length > 0 && (
    <section class="section" id="clients" aria-labelledby="clients-h">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">{clients.length === 1 ? "Real client project" : "Real client projects"}</p>
          <h2 id="clients-h">{clients.length === 1 ? "Work for a Real Business" : "Work for Real Businesses"}</h2>
          <p>{anyStaged ? "Real websites for real businesses. This is a staged preview: a project goes live here only once its client approves it in writing." : clients.length === 1 ? "Shown with the client's permission." : "Each one is shown with the client's permission."}</p>
        </div>
        <div class="clients">{clients.map((c) => <CaseStudy study={c} />)}</div>
      </div>
    </section>
  )}

  <section class="section cases" id="concepts" aria-labelledby="concepts-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Concept demonstrations</p>
        <h2 id="concepts-h">Made-Up Businesses, Real Websites</h2>
        <p>Each one shows what a website level can do, and each is a working site you can open and try.</p>
      </div>
      <div class="pf-tools" data-pf-tools hidden>
        <div class="pf-filter" role="group" aria-label="Show examples by website level" data-pf-filter>
          <button type="button" data-tier="all" aria-pressed="true">All levels</button>
          {shown.map((t) => <button type="button" data-tier={t} aria-pressed="false">{levelById[t].name}</button>)}
        </div>
        <p class="pf-flag"><span data-pf-count></span> There is no Flagship example here: Flagship work is planned one project at a time, so <a href="/contact/?level=flagship" data-track="tier_selected">discuss a custom project</a>.</p>
      </div>
      {demoSites.map((d, i) => {
        const store = isStore(d.project);
        return (
          <article class:list={["case", { flip: i % 2 === 1 }]} id={d.slug} data-tier={d.tier} aria-labelledby={`${d.slug}-h`}>
            <div class="case-shot"><DeviceShot slug={d.slug} lazy={i > 0} /></div>
            <div class="case-copy">
              {/* (site audit 2026-11-21, critique round 3) the level chip carries the level's price, so it is read before the
                  features; the facts below drop "Industry", which repeated this line word for word */}
              <p class="case-kind"><Icon name={d.icon} />{d.kind} · concept demonstration<a class="case-tier tap" href={levelById[d.tier].page}><span class="case-steps" aria-hidden="true">{[1, 2, 3, 4].map((n) => <i class:list={{ on: n <= steps[levelById[d.tier].complexity] }}></i>)}</span>{levelById[d.tier].name}<span class="case-price">{d.tier === "business" && store ? serviceById["online-shop"].price : levelById[d.tier].price}</span></a></p>
              <h3 id={`${d.slug}-h`}>{d.name}</h3>
              <p class="case-sum">{d.summary}</p>
              <details class="case-more"><summary>Project details<Icon name="caretDown" /></summary><dl class="case-facts">
                <div><dt>Project</dt><dd>{d.project}</dd></div>
                <div><dt>Level</dt><dd><a class="tap" href={levelById[d.tier].page}>{levelById[d.tier].name}</a> · {levelById[d.tier].complexity.toLowerCase()}{"\u00a0"}complexity</dd></div>
                <div><dt>Your version</dt><dd>{version(d)}</dd></div>
              </dl></details>
              <h4 class="case-h3">Features</h4>
              <ul class="ticks case-ticks">{d.shows.map((s) => <li><Icon name="check" />{s}</li>)}</ul>
              <p class="case-svc">Optional services it shows, each priced on its own: {listedServices(d).map((id, j) => (
                <>{j > 0 && ", "}<a href={where(id)}>{serviceById[id].name}</a> ({svcPrice(id)})</>
              ))}</p>
              {store && d.tier !== "business" && <p class="case-svc">Need something simpler? An <a href={where("online-shop")}>online shop</a> in your own Square Online or Shopify account is {serviceById["online-shop"].price}.</p>}
              {store && <p class="case-note"><Icon name="lockSimple" /><span>Its cart and checkout work as a demo, but no card is ever asked for: nothing can be bought.</span></p>}
              <div class="case-actions">
                <a class="button secondary" href={`/example-sites/${d.slug}/`} data-track="example_full">Open the Demo {store ? "Store" : "Site"}</a>
                <a class="button secondary" href={`/examples/${d.slug}/`} data-track="example_open">Computer &amp; Phone View</a>
              </div>
              <p class="case-back"><a href="#jump-h">Back to the list<Icon name="arrowUp" /></a></p>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  {hasVideo && (
    <section class="section" id="video" aria-labelledby="video-h">
      <div class="wrap">
        <VideoTeasers level={2} headingId="video-h" title="Concept Films" />
      </div>
    </section>
  )}

  <section class="section band" id="technical" aria-labelledby="technical-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Technical work</p>
        <h2 id="technical-h">Automations, with the Code</h2>
        <p>Technical work, kept apart from the website concepts: {count(examples.length, "working automation", "working automations")}, published as open source with automated tests and plain-English docs. Each example page walks through a sample business’s week, start to finish.</p>
      </div>
      <ul class="tech grid-2" role="list">
        {examples.map((e) => (
          <li class="tech-item">
            <h3><a href={`/work/${e.slug}/`}>{titleCase(e.title)}</a></h3>
            <p>{e.problem}</p>
            <p class="tech-svc">Service: <a href={`/solutions/#${e.service.id}`}>{serviceById[e.service.id].name}</a>, {serviceById[e.service.id].price}</p>
          </li>
        ))}
      </ul>
      <div class="tech-links">
        <a class="button secondary" href={repo} rel="noopener" data-track="github_open"><Icon name="githubLogo" />The code on GitHub<Icon name="arrowUpRight" /></a>
        <a class="button secondary" href="/demos/" data-track="portfolio_demos"><Icon name="play" />Interactive demos</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="cta-band">
        <div>
          <h2>Want Something Like This for Your Business?</h2>
          <p>Tell us what you need. Within one business day you’ll get a written plan and a fixed price, with nothing charged until you agree.</p>
        </div>
        <div class="cta-actions">
          <a class="button" href="/contact/" data-track="cta_portfolio_quote">Get a Free Quote</a>
          <a class="button secondary" href="/pricing/">See pricing</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .pf-hero { padding-block: clamp(40px, 6vw, 80px) clamp(8px, 2vw, 24px); }
  .pf-hero h1 { max-width: 20ch; font-size: clamp(2rem, 1.4rem + 2.6vw, 3.25rem); }
  .pf-hero .lead { margin-top: 18px; max-width: 62ch; }
  .made-up { display: flex; gap: 10px; align-items: flex-start; max-width: 72ch; margin-top: 24px; padding: 14px 16px; border: 1px solid var(--hairline); border-radius: var(--r-md, 12px); background: var(--panel); color: var(--body); font-size: 0.9375rem; }
  .made-up :global(.icon) { flex: none; margin-top: 0.2em; color: var(--cyan); }
  .made-up strong { color: var(--ink); }
  .pf-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 32px; }
  @media (min-width: 960px) { .pf-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 20rem); gap: 56px; align-items: start; } }
  .jump-h { color: var(--muted); font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; }
  .jump ul { display: grid; gap: 2px; margin: 10px 0 0; padding: 0; list-style: none; border-top: 1px solid var(--hairline); }
  .jump li { border-bottom: 1px solid var(--hairline); }
  .clients { display: grid; gap: 20px; }
  /* (2026-11-17 critique) the client work follows the intro closely, so a 1440x900 screen shows the start of it */
  .pf-hero + #clients { padding-top: clamp(24px, 3vw, 40px); }
  /* on a computer the index is the names alone in a tighter list; each section repeats its own description */
  @media (min-width: 960px) {
    .jump strong + span { display: none; }
    .jump a { min-height: 40px; padding-block: 6px; }
  }
  .jump a { display: flex; gap: 12px; align-items: center; min-height: 52px; padding: 8px 4px; color: var(--ink); text-decoration: none; }
  .jump a:hover strong { color: var(--link); text-decoration: underline; text-underline-offset: 3px; }
  .jump a :global(.icon) { flex: none; color: var(--cyan); }
  .jump a > span { display: grid; }
  .jump strong { font-size: 0.9375rem; font-weight: 600; }
  .jump strong + span { color: var(--muted); font-size: 0.8125rem; }
  /* On a phone the index is the names alone: each section repeats its own description, and the list stays one screen. */
  /* (2026-11-17) on a phone the index is one row of chips that scrolls sideways, so the work starts about a screen
     sooner; the page itself never scrolls sideways */
  @media (max-width: 639px) {
    .jump strong + span { display: none; }
    .jump ul { display: flex; gap: 8px; overflow-x: auto; overscroll-behavior-x: contain; scrollbar-width: thin; margin-inline: -16px; padding: 2px 48px 4px 16px; border-top: 0; }
    /* (critique 11-17) the row ran off the screen's edge with nothing to say it scrolls: the right edge fades, and the
       end padding lets the last chip scroll clear of the fade */
    .jump ul { mask-image: linear-gradient(to right, #000 calc(100% - 48px), transparent); scroll-snap-type: x proximity; scroll-padding-inline: 16px; }
    .jump li { flex: none; border-bottom: 0; scroll-snap-align: start; }
    .jump a { min-height: 44px; padding: 0 14px; border: 1px solid var(--hairline-strong); border-radius: var(--r-full); white-space: nowrap; }
    .jump a :global(.icon) { width: 18px; height: 18px; }
  }

  /* (critique 11-17, round 9) two sections' padding stacked into a 227px gap between the client card and the concepts:
     the client section hands the space to the next one, so the gap is one section's padding */
  #clients { padding-bottom: 0; }
  .cases .wrap { --case-gap: clamp(48px, 6vw, 80px); display: grid; gap: var(--case-gap); }
  .case { display: grid; gap: 28px; align-items: center; scroll-margin-top: 16px; }
  /* (critique 11-17: a centred picture beside a taller column left a dead band above and below it, so the entries
     read far apart) on a computer the picture starts level with the name and stays in view while its column is read */
  @media (min-width: 960px) {
    .case { grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: 56px; align-items: start; }
    .case.flip .case-shot { order: 2; }
    .case-shot { position: sticky; top: 96px; }
  }
  /* (critique round 5: on a phone the phone frame covered the right end of Halvane's headline) under 480px the phone
     overlaps the computer by 20px instead of a quarter of its width, so the pair sits side by side and neither page's
     headline is hidden */
  @media (max-width: 479px) {
    .case-shot :global(.desk) { margin-right: calc(clamp(96px, 27%, 180px) - 20px); }
  }
  /* (critique round 6: the level pill sat beside the kind on the wider text column and dropped under it on the
     narrower one, so the names of neighbouring concepts started at different heights) the icon and kind share the
     first row and the pill always takes the row under them, on every concept and at every width */
  .case-kind { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: 10px 8px; color: var(--cyan); font-size: 0.875rem; font-weight: 600; }
  .case-kind .case-tier { grid-column: 1 / -1; justify-self: start; margin-left: 0; }
  .case h3 { margin-top: 8px; font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2rem); }
  .case-sum { margin-top: 12px; color: var(--body); max-width: 56ch; }
  .case-facts { display: grid; gap: 10px; padding-block: 14px; border-block: 1px solid var(--hairline); }
  /* (site audit 2026-11-21, critique round 4) on a phone each concept's facts fold under one "Project details" line, so
     the concepts read as a picture and its features instead of a spec table each. A computer shows the facts open with
     no toggle; a browser without ::details-content shows the toggle there too, so the facts are always reachable. */
  .case-more { margin-top: 20px; }
  .case-more > summary { display: flex; align-items: center; gap: 8px; min-height: 48px; border-top: 1px solid var(--hairline); color: var(--ink); font-size: 0.9375rem; font-weight: 600; cursor: pointer; list-style: none; }
  .case-more:not([open]) > summary { border-bottom: 1px solid var(--hairline); }
  .case-more > summary::-webkit-details-marker { display: none; }
  .case-more > summary:hover { color: var(--link); }
  .case-more > summary :global(.icon) { margin-left: auto; width: 16px; height: 16px; color: var(--muted); transition: transform 200ms var(--ease); }
  .case-more[open] > summary :global(.icon) { transform: rotate(180deg); }
  @media (prefers-reduced-motion: reduce) { .case-more > summary :global(.icon) { transition: none; } }
  @supports selector(::details-content) {
    @media (min-width: 640px) {
      .case-more > summary { display: none; }
      .case-more::details-content { content-visibility: visible; }
    }
  }
  /* a way back to the index from deep in the list, on a phone only (a computer keeps the index beside the intro) */
  .case-back { display: none; }
  @media (max-width: 639px) {
    .case-back { display: flex; margin-top: 8px; }
    .case-back a { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; color: var(--link); font-size: 0.9375rem; font-weight: 600; }
    .case-back :global(.icon) { width: 1em; height: 1em; }
    /* the chips above index the page, so a phone skips the level filter and keeps the Flagship line */
    .pf-tools .pf-filter, .pf-tools [data-pf-count] { display: none; }
    /* (critique round 5) with the filter gone the Flagship line is all that is left, and it sat 80px under the intro
       (the head's margin plus the list's gap): it now follows the intro as its last line, 40px down */
    .pf-tools:not([hidden]) { margin-top: calc(var(--case-gap) * -1 + 8px); }
  }
  .case-facts div { display: grid; grid-template-columns: 7.5rem minmax(0, 1fr); gap: 12px; }
  .case-facts dt { color: var(--muted); font-size: 0.875rem; font-weight: 600; }
  .case-facts dd { margin: 0; color: var(--ink); font-size: 0.9375rem; }
  .case-h3 { margin-top: 20px; font-size: 1rem; }
  .case-ticks { margin-top: 10px; color: var(--body); }
  .case-svc { margin-top: 16px; color: var(--muted); font-size: 0.9375rem; }
  /* a service name never breaks inside itself ("follow- / up" at 390, audit 11-21); the list still wraps between them */
  .case-svc a { white-space: nowrap; }
  .case-note { display: flex; gap: 8px; align-items: flex-start; margin-top: 12px; color: var(--body); font-size: 0.9375rem; }
  .case-note :global(.icon) { flex: none; margin-top: 0.2em; color: var(--cyan); }
  .case-tier { display: inline-flex; align-items: center; gap: 8px; margin-left: 4px; padding: 2px 10px; border: 1px solid var(--hairline-strong); border-radius: var(--r-full); color: var(--ink); font-size: 0.8125rem; text-decoration: none; }
  .case-tier:hover { border-color: var(--link); }
  .case-price { color: var(--body); font-weight: 600; }
  .case-price::before { content: "·" / ""; margin-right: 8px; color: var(--muted); font-weight: 400; }
  .case-steps { display: inline-grid; grid-template-columns: repeat(4, 10px); gap: 2px; }
  .case-steps i { height: 4px; border-radius: 2px; background: var(--hairline-strong); }
  .case-steps i.on { background: var(--link); }
  .case-facts a { color: var(--link); }
  .pf-tools:not([hidden]) { display: grid; gap: 12px; }
  .pf-filter { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  /* (critique 11-17) four chips don't fit one phone row; wrapping left "Immersive" alone on the second line, so a
     narrow screen gets an even two-by-two grid */
  @media (max-width: 519px) { .pf-filter { display: grid; grid-template-columns: 1fr 1fr; } }
  .pf-filter button { min-height: 44px; padding: 0 16px; border: 1px solid var(--hairline); border-radius: var(--r-full); background: var(--panel); color: var(--body); font-weight: 600; font-size: 0.9375rem; cursor: pointer; transition: border-color 150ms var(--ease), background-color 150ms var(--ease); }
  .pf-filter button:hover { border-color: var(--hairline-strong); color: var(--ink); }
  /* (site audit 2026-11-21, critique round 4) the chosen level is a lighter chip with a doubled blue edge, not the
     filled blue that marks the next step everywhere else */
  .pf-filter button[aria-pressed="true"] { border-color: var(--blue-line); background: var(--surface-strong); color: var(--ink); box-shadow: inset 0 0 0 1px var(--blue-line); }
  /* (critique 11-17) the filter belongs to the list under it: half the section gap, not the full one */
  .pf-tools:not([hidden]) + .case { margin-top: calc(var(--case-gap) / -2); }
  .pf-flag { margin: 0; color: var(--muted); font-size: 0.9375rem; }
  .pf-flag a { color: var(--link); }
  .case-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
  @media (max-width: 479px) { .case-actions .button { width: 100%; } }

  .tech { margin: 0; padding: 0; list-style: none; }
  .tech-item { display: flex; flex-direction: column; gap: 10px; padding: 24px; border: 1px solid var(--hairline); border-radius: var(--r-lg); background: var(--panel); }
  .tech-item h3 { font-size: 1.125rem; }
  /* a one-line heading link: the invisible layer makes its tap area taller without moving anything */
  .tech-item h3 a { position: relative; color: var(--ink); text-decoration: none; }
  .tech-item h3 a::after { content: ""; position: absolute; inset: -10px 0; }
  .tech-item h3 a:hover { color: var(--link); text-decoration: underline; text-underline-offset: 3px; }
  .tech-item p { color: var(--body); font-size: 0.9375rem; }
  .tech-item .tech-svc { margin-top: auto; padding-top: 10px; border-top: 1px solid var(--hairline-soft); color: var(--muted); }
  .tech-links { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  @media (max-width: 479px) { .tech-links .button { width: 100%; } }
</style>

<script>
  // Filter the examples by website level. Hidden examples (and their "On this page" links) are hidden outright, and
  // the picture side alternates again over the ones still showing. A count after the buttons says what is showing; it
  // becomes a live region only after its first text, so a screen reader hears each change but not the page load.
  const tools = document.querySelector<HTMLElement>("[data-pf-tools]");
  const bar = tools?.querySelector<HTMLElement>("[data-pf-filter]");
  const count = tools?.querySelector<HTMLElement>("[data-pf-count]");
  if (tools && bar) {
    const cases = [...document.querySelectorAll<HTMLElement>("article.case[data-tier]")];
    const links = [...document.querySelectorAll<HTMLElement>(".jump li[data-tier]")];
    const say = (tier: string, n: number) => {
      if (!count) return;
      const name = bar.querySelector<HTMLButtonElement>(`button[data-tier="${tier}"]`)?.textContent?.trim();
      count.textContent = tier === "all" ? `Showing all ${n} examples.` : `Showing ${n} ${name} example${n === 1 ? "" : "s"}.`;
    };
    const set = (tier: string) => {
      bar.querySelectorAll<HTMLButtonElement>("button").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.tier === tier)));
      let n = 0;
      for (const c of cases) {
        const on = tier === "all" || c.dataset.tier === tier;
        c.hidden = !on;
        if (on) c.classList.toggle("flip", n++ % 2 === 1);
      }
      for (const l of links) l.hidden = !(tier === "all" || l.dataset.tier === tier);
      say(tier, n);
    };
    bar.addEventListener("click", (e) => {
      const b = (e.target as Element).closest<HTMLButtonElement>("button[data-tier]");
      if (!b || b.getAttribute("aria-pressed") === "true") return;
      set(b.dataset.tier!);
      (window as unknown as { nuxyTrack?: (e: string) => void }).nuxyTrack?.("portfolio_tier_filter");
    });
    // (site audit 2026-11-21) a phone hides the filter, so turning a phone upright never leaves examples hidden with no
    // button to bring them back
    const phone = matchMedia("(max-width: 639px)");
    phone.addEventListener("change", () => {
      if (phone.matches && bar.querySelector<HTMLButtonElement>('button[aria-pressed="true"]')?.dataset.tier !== "all") set("all");
    });
    say("all", cases.length);
    tools.hidden = false;
    count?.setAttribute("role", "status");
  }
</script>
