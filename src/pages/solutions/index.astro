---
// Every service, grouped, with search and a "kind of business" filter (brief 1, phase 6). All words, prices and ids
// come from data/services.ts, so a change there shows up here, on the homepage and in the contact form.
// - Each card keeps its service id as its anchor: outreach emails and old homepage links (/#follow-up, redirected
//   by Base.astro) land on /solutions/#<id>.
// - The finder is extra: without JavaScript it stays hidden and every service is listed.
// - Analytics get only "solutions_search" (once per visit, never the words typed) and "filter_<kind>".
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import ServiceCard from "../../components/ServiceCard.astro";
import { groups, services, serviceById, kinds, bundle } from "../../data/services";

const site = "https://nuxyautomation.com";

// "$1,200" -> 1200 as a string, "from $200" -> a minimum price (schema.org wants plain numbers)
const offerPrice = (price: string) => {
  const n = price.replace(/[^0-9.]/g, "");
  return price.startsWith("from")
    ? { priceSpecification: { "@type": "PriceSpecification", minPrice: n, priceCurrency: "USD" } }
    : { price: n, priceCurrency: "USD" };
};

const catalog = {
  "@context": "https://schema.org",
  "@type": "OfferCatalog",
  "@id": `${site}/solutions/#catalog`,
  name: "Nuxy Automation services",
  url: `${site}/solutions/`,
  itemListElement: groups.map((g) => ({
    "@type": "OfferCatalog",
    name: g.title,
    url: `${site}/solutions/#${g.id}`,
    itemListElement: g.items.map((s) => ({
      "@type": "Offer",
      url: `${site}/solutions/#${s.id}`,
      ...offerPrice(s.price),
      itemOffered: { "@type": "Service", name: s.name, description: s.text, provider: { "@id": `${site}/#business` } },
    })),
  })),
};

const filterKinds = kinds.filter((k) => k.id !== "all");
---
<Base title="Services & Fixed Prices · Nuxy Automation" description={`All ${services.length} services with fixed one-time prices: lead follow-up, online booking, quotes, reviews, invoices, websites and more, and what each one needs from you.`} wide>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(catalog)} />

  <section class="sol-hero">
    <div class="wrap">
      <p class="eyebrow">Services and prices</p>
      <h1>Every service, with its price written down.</h1>
      <p class="lead">{services.length} one-time services for small businesses. Each shows what it fixes, what you get, what it needs from you and what other companies charge, if anything. Pick what fits, or tell us the problem and we’ll suggest the smallest fix.</p>
      <ul class="sol-facts" role="list">
        <li><Icon name="sealCheck" />Fixed price, agreed before you pay</li>
        <li><Icon name="lockSimple" />Built in your own accounts</li>
        <li><Icon name="listChecks" />2 services: {bundle.two}% off. 3 or more: {bundle.three}% off</li>
      </ul>
    </div>
  </section>

  <section class="catalog" aria-label="All services">
    <div class="wrap">
      <div class="finder panel" data-finder hidden>
        <div class="finder-search">
          <label for="svc-q">Search services</label>
          <div class="search">
            <Icon name="magnifyingGlass" />
            <input id="svc-q" type="search" placeholder="Try “invoices” or “reviews”" autocomplete="off" enterkeyhint="search" />
          </div>
        </div>
        <fieldset class="finder-kinds">
          <legend>Your kind of business</legend>
          <div class="kinds">
            {kinds.map((k) => (
              <label class="kind">
                <input type="radio" name="for" value={k.id} checked={k.id === "all"} />
                <span><Icon name={k.icon} />{k.name}</span>
              </label>
            ))}
          </div>
        </fieldset>
        <div class="finder-foot">
          {filterKinds.map((k) => (
            <p class="kind-note" data-kind-note={k.id} hidden>
              <strong>{k.name}</strong> ({k.who}) usually start with{" "}
              {k.start.map((id, i) => (
                <>{i > 0 && (i === k.start.length - 1 ? " and " : ", ")}<a href={`#${id}`}>{serviceById[id].name}</a></>
              ))}.
            </p>
          ))}
          <p class="count" role="status" data-count>{services.length} services</p>
        </div>
      </div>

      {groups.map((g) => (
        <section class="group" id={g.id} aria-labelledby={`${g.id}-h`} data-group>
          {/* old category anchors (/solutions/#save-time and the like, from before brief 4) land on the new category */}
          {g.legacy.filter((old) => !serviceById[old]).map((old) => <span id={old} class="old-anchor" />)}
          <div class="group-head">
            <h2 id={`${g.id}-h`}>{g.title}</h2>
            <p>{g.lead}</p>
          </div>
          <div class="grid-3 cards">
            {g.items.map((s) => <ServiceCard service={s} />)}
          </div>
        </section>
      ))}

      <div class="empty panel" data-empty hidden>
        <Icon name="magnifyingGlass" />
        <h2>Nothing matches that yet</h2>
        <p>Try another word, or <button type="button" class="link-button" data-reset>show every service</button>. Or describe the problem in your own words and we’ll tell you what would fix it, with a price.</p>
        <a class="button small" href="/contact/" data-track="cta_solutions_empty">Describe the problem</a>
      </div>
    </div>
  </section>

  <section class="section tight band" aria-labelledby="more-h">
    <div class="wrap more-grid">
      <div>
        <h2 id="more-h">Two or more? It costs less.</h2>
        <p>{bundle.text}</p>
      </div>
      <div>
        <h2>Want it looked after?</h2>
        <p>Every service is a one-time price, and monthly plans are optional. They watch your website or automations after the 30-day launch watch and fix what breaks. {" "}<a class="text-link" href="/pricing/">Pricing and plans<Icon name="arrowRight" /></a></p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="cta-band">
        <div>
          <h2>Not sure which one you need?</h2>
          <p>Tell us what slows you down. Within one business day you’ll get a written plan with what we’d build and the price. No call needed, and nothing is charged until you agree.</p>
        </div>
        <div class="cta-actions">
          <a class="button" href="/contact/" data-track="cta_solutions">Get a Free Quote</a>
          <a class="button secondary" href="/demo/">Try the demo</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .sol-hero { padding-block: clamp(40px, 6vw, 80px) clamp(24px, 3vw, 40px); }
  .sol-hero h1 { max-width: 18ch; font-size: clamp(2.125rem, 1.5rem + 2.6vw, 3.25rem); }
  .sol-hero .lead { margin-top: 18px; max-width: 62ch; }
  .sol-facts { display: flex; flex-wrap: wrap; gap: 10px 28px; margin-top: 24px; padding: 0; list-style: none; color: var(--body); font-size: 0.9375rem; }
  .sol-facts li { display: inline-flex; align-items: center; gap: 8px; }
  .sol-facts :global(.icon) { flex: none; color: var(--cyan); }

  .catalog { padding-bottom: clamp(48px, 7vw, 88px); }

  .finder { display: grid; gap: 20px 32px; padding: clamp(18px, 2.5vw, 26px); margin-bottom: clamp(16px, 2vw, 24px); }
  /* (search above the kinds at every width: the six kinds need ~875px in one row, which a side-by-side layout never leaves them) */
  .finder-search { display: grid; gap: 8px; align-content: start; max-width: 520px; }
  .finder-search > label, .finder-kinds legend { color: var(--ink); font-size: 0.9375rem; font-weight: 600; }
  .finder-kinds { margin: 0; padding: 0; border: 0; min-width: 0; }
  .finder-kinds legend { padding: 0; margin-bottom: 8px; }
  .search { position: relative; }
  .search :global(.icon) { position: absolute; left: 14px; top: 50%; width: 20px; height: 20px; transform: translateY(-50%); color: var(--muted); pointer-events: none; }
  .search input {
    width: 100%; min-height: 48px; padding: 11px 14px 11px 44px; border: 1px solid var(--hairline-strong); border-radius: 10px;
    background: #0e1a30; color: var(--ink); font-size: 1rem; line-height: 1.4; transition: border-color 160ms ease-out;
  }
  .search input::placeholder { color: var(--muted); }
  .search input:hover { border-color: #46608f; }
  .search input:focus { border-color: var(--blue); }

  .kinds { display: flex; flex-wrap: wrap; gap: 8px; }
  .kind { position: relative; }
  .kind input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: pointer; }
  .kind span {
    display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 16px;
    border: 1px solid var(--hairline-strong); border-radius: var(--r-full); color: var(--body); font-size: 0.9375rem; font-weight: 500;
    transition: border-color 160ms ease-out, background-color 160ms ease-out, color 160ms ease-out;
  }
  .kind span :global(.icon) { flex: none; width: 18px; height: 18px; color: var(--muted); }
  .kind:hover span { border-color: #46608f; color: var(--ink); }
  .kind input:checked + span { border-color: var(--blue); background: var(--accent-soft); color: var(--ink); }
  .kind input:checked + span :global(.icon) { color: var(--link); }
  .kind input:focus-visible + span { outline: 2px solid var(--focus); outline-offset: 2px; }

  .finder-foot { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px 24px; padding-top: 16px; border-top: 1px solid var(--hairline-soft); }
  .kind-note { flex: 1 1 420px; color: var(--body); font-size: 0.9375rem; }
  .kind-note strong { color: var(--ink); }
  .count { margin-left: auto; color: var(--muted); font-size: 0.9375rem; white-space: nowrap; }

  .group { padding-top: clamp(40px, 5vw, 64px); scroll-margin-top: calc(var(--nav-h) + 8px); }
  .old-anchor { display: block; scroll-margin-top: calc(var(--nav-h) + 8px); }
  .group-head { display: grid; gap: 8px; max-width: 720px; margin-bottom: 24px; }
  .group-head h2 { font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2rem); }
  .group-head p { color: var(--muted); font-size: 1.0625rem; }

  .empty { display: grid; justify-items: start; gap: 12px; max-width: 640px; margin-top: 24px; padding: clamp(22px, 3vw, 32px); }
  .empty > :global(.icon) { width: 28px; height: 28px; color: var(--muted); }
  .empty h2 { font-size: 1.375rem; }
  .empty p { color: var(--body); }
  .link-button { padding: 0; border: 0; background: none; color: var(--link); font: inherit; font-weight: 600; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
  .link-button:hover { color: var(--ink); }

  .more-grid { display: grid; gap: 32px 56px; }
  @media (min-width: 900px) { .more-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .more-grid h2 { font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem); }
  .more-grid p { margin-top: 10px; max-width: 60ch; color: var(--body); }
  .more-grid .text-link { white-space: nowrap; }
</style>

<script>
  // Search and kind filter. A card shows when it suits the chosen kind (or every kind) and contains every word typed.
  // The chosen kind goes in the address (?for=trades) so a link can open the list already filtered.
  const finder = document.querySelector<HTMLElement>("[data-finder]");
  if (finder) {
    const q = finder.querySelector<HTMLInputElement>("#svc-q")!;
    const radios = [...finder.querySelectorAll<HTMLInputElement>("input[name='for']")];
    const notes = [...finder.querySelectorAll<HTMLElement>("[data-kind-note]")];
    const count = finder.querySelector<HTMLElement>("[data-count]")!;
    const cards = [...document.querySelectorAll<HTMLElement>(".svc[data-fits]")];
    const groups = [...document.querySelectorAll<HTMLElement>("[data-group]")];
    const empty = document.querySelector<HTMLElement>("[data-empty]")!;
    const track = (e: string) => (window as unknown as { nuxyTrack?: (e: string) => void }).nuxyTrack?.(e);
    const kindNow = () => radios.find((r) => r.checked)?.value ?? "all";
    let searched = false;

    const apply = () => {
      const kind = kindNow();
      const words = q.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
      let shown = 0;
      for (const card of cards) {
        const fits = card.dataset.fits!.split(" ");
        const ok = (kind === "all" || fits.includes("all") || fits.includes(kind)) && words.every((w) => card.dataset.search!.includes(w));
        card.hidden = !ok;
        if (ok) shown++;
      }
      for (const g of groups) g.hidden = !g.querySelector(".svc:not([hidden])");
      for (const n of notes) n.hidden = n.dataset.kindNote !== kind || words.length > 0;
      empty.hidden = shown > 0;
      count.textContent = shown === cards.length ? `${shown} services` : `${shown} of ${cards.length} services`;
      const url = new URL(location.href);
      if (kind === "all") url.searchParams.delete("for");
      else url.searchParams.set("for", kind);
      history.replaceState(history.state, "", url);
    };

    const choose = (kind: string) => {
      const r = radios.find((x) => x.value === kind) ?? radios[0];
      r.checked = true;
    };

    // A link to one service (#invoices) must never land on a hidden card: show everything instead.
    const reveal = () => {
      const id = decodeURIComponent(location.hash.slice(1));
      const el = id ? document.getElementById(id) : null;
      if (el?.closest("[hidden]")) {
        q.value = "";
        choose("all");
        apply();
        el.scrollIntoView();
      }
    };

    choose(new URLSearchParams(location.search).get("for") ?? "all");
    finder.hidden = false;
    apply();
    reveal();

    for (const r of radios) r.addEventListener("change", () => { apply(); track(`filter_${r.value}`); });
    q.addEventListener("input", () => {
      apply();
      if (!searched && q.value.trim()) { searched = true; track("solutions_search"); }
    });
    q.addEventListener("keydown", (e) => { if (e.key === "Enter") e.preventDefault(); });
    window.addEventListener("hashchange", reveal);
    empty.querySelector("[data-reset]")!.addEventListener("click", () => {
      q.value = "";
      choose("all");
      apply();
      q.focus();
    });
  }
</script>
