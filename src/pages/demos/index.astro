---
import { titleCase } from "../../lib/title-case";
// Demos: the interactive lead demo (#try), the demo salon (/demo/), the example websites (#websites) and the
// open-source automations behind the examples (#technical, where the old /#work link lands). Every business on this
// page is made up and said to be; nothing here is a client result, and nothing is sent anywhere.
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import LeadDemo from "../../components/LeadDemo.astro";
import DemoSites from "../../components/DemoSites.astro";
import { examples } from "../../data/examples";
import { serviceById } from "../../data/services";

const repo = "https://github.com/Nuxy1/small-business-automations";

// Structured data for search: what this page is, tied to the business entry in Base.astro.
const pageData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": "https://nuxyautomation.com/demos/",
  url: "https://nuxyautomation.com/demos/",
  name: "Demos and example work",
  about: { "@id": "https://nuxyautomation.com/#business" },
};
---
<Base title="Demos & Example Work · Nuxy Automation" description="Try the lead follow-up demo, a demo salon with booking and reminders, example websites and the open-source code behind them. Every business shown is made up." wide>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(pageData)} />
  <section class="dm-hero">
    <div class="wrap">
      <p class="eyebrow">Demos</p>
      <h1>See It Working Before You Spend a Dollar</h1>
      <p class="lead">Every demo here uses a made-up business and sends nothing to anyone. They show how the services work; none of them is a client result.</p>
      <nav class="jump" aria-label="On this page">
        <a class="chip" href="#try"><Icon name="play" />Lead follow-up demo</a>
        <a class="chip" href="#salon"><Icon name="calendarCheck" />Demo salon</a>
        <a class="chip" href="#websites"><Icon name="browser" />Example websites</a>
        <a class="chip" href="#technical"><Icon name="githubLogo" />The code</a>
      </nav>
    </div>
  </section>

  <section class="section band" id="try" aria-labelledby="try-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Interactive demo</p>
        <h2 id="try-h">One Quote Request, from First Message to Booked Visit</h2>
        <p>Step through what the customer sees and what the owner sees. Press Start, or pick any step.</p>
      </div>
      <LeadDemo />
      <p class="after-demo">This is <a href="/solutions/#follow-up">lead response &amp; follow-up</a>, {serviceById["follow-up"].price} one time, built in the email and form tools you already have.</p>
    </div>
  </section>

  <section class="section" id="salon" aria-labelledby="salon-h">
    <div class="wrap">
      <a class="salon" href="/demo/" data-track="demo_salon_open">
        <span class="salon-icon"><Icon name="calendarCheck" /></span>
        <span class="salon-text">
          <span class="eyebrow">Demo salon</span>
          <h2 id="salon-h">Booking, Reminders and Missed-Call Text-Back on a Made-Up Salon</h2>
          <span>See what a client sees when they book online, the reminder they get the day before, the text that goes out when a call is missed, and the review request after the visit.</span>
        </span>
        <span class="text-link" aria-hidden="true">Open the demo salon<Icon name="arrowRight" /></span>
      </a>
    </div>
  </section>

  <section class="section band" id="websites" aria-labelledby="websites-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Example websites</p>
        <h2 id="websites-h">What a Nuxy Website Looks Like</h2>
        <p>Open any of them to switch between the desktop and phone view.</p>
      </div>
      <DemoSites />
      <p class="more-line"><a class="text-link" href="/websites/">Website development and prices<Icon name="arrowRight" /></a></p>
    </div>
  </section>

  <section class="section" id="technical" aria-labelledby="technical-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">For the technical details</p>
        <h2 id="technical-h">Working Automations, with the Code</h2>
        <p>Four automations, published as open source with their own automated tests and plain-English docs. Each example page shows a made-up business’s week: what came in, what went out and how messy data was handled.</p>
      </div>
      <ul class="examples grid-2" role="list">
        {examples.map((e) => (
          <li class="example">
            <h3><a href={`/work/${e.slug}/`}>{titleCase(e.title)}</a></h3>
            <p>{e.problem}</p>
            <p class="example-meta"><Icon name="lightning" />{e.speed}, measured on a desktop PC</p>
            <p class="example-svc">Service: <a href={`/solutions/#${e.service.id}`}>{serviceById[e.service.id].name}</a>, {serviceById[e.service.id].price}</p>
          </li>
        ))}
      </ul>
      <div class="code-links">
        <a class="button secondary" href={repo} rel="noopener" data-track="github_open"><Icon name="githubLogo" />The code on GitHub<Icon name="arrowUpRight" /></a>
        <a class="button secondary" href="/docs/"><Icon name="clipboardText" />Docs and setup guides</a>
      </div>
      <p class="note"><Icon name="info" /><span>The businesses in these examples are made up. The speeds come from each project’s <code>npm run bench</code>: thousands of records take seconds, not hours.</span></p>
    </div>
  </section>

  <section class="section band">
    <div class="wrap">
      <div class="cta-band">
        <div>
          <h2>Want This for Your Business?</h2>
          <p>Tell us what you’d like to fix. Within one business day you’ll get a written plan with the exact price. No call needed.</p>
        </div>
        <div class="cta-actions">
          <a class="button" href="/contact/" data-track="cta_demos">Get a Free Quote</a>
          <a class="button secondary" href="/solutions/">See all services</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .dm-hero { padding-block: clamp(40px, 6vw, 80px) clamp(40px, 6vw, 72px); }
  .dm-hero h1 { max-width: 20ch; font-size: clamp(2.125rem, 1.5rem + 2.6vw, 3.25rem); }
  .dm-hero .lead { margin-top: 18px; max-width: 60ch; }
  .jump { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }
  .jump .chip { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 8px 16px; color: var(--ink); text-decoration: none; }
  .jump .chip:hover { border-color: var(--hairline-strong); }
  .after-demo { margin-top: 20px; color: var(--body); }

  .salon { display: grid; gap: 16px 24px; padding: clamp(22px, 3vw, 32px); border: 1px solid var(--hairline); border-radius: var(--r-lg); background: var(--panel); color: inherit; text-decoration: none; transition: border-color 160ms ease-out; }
  .salon:hover { color: inherit; border-color: var(--hairline-strong); }
  @media (min-width: 900px) { .salon { grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; } }
  .salon-icon { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 14px; background: rgb(var(--cyan-rgb) / 0.1); color: var(--cyan); }
  .salon-icon :global(.icon) { width: 26px; height: 26px; }
  .salon-text { display: grid; gap: 8px; color: var(--body); }
  .salon-text .eyebrow { margin: 0; }
  .salon h2 { color: var(--ink); font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem); }
  .salon .text-link { color: var(--link); white-space: nowrap; }
  @media (prefers-reduced-motion: reduce) { .salon { transition: none; } }

  .more-line { margin-top: 28px; }
  .examples { margin: 0; padding: 0; list-style: none; }
  .example { display: flex; flex-direction: column; gap: 10px; padding: 24px; border: 1px solid var(--hairline); border-radius: var(--r-lg); background: var(--panel); }
  .example h3 { font-size: 1.125rem; }
  .example h3 a { color: var(--ink); text-decoration: none; }
  .example h3 a:hover { color: var(--link); text-decoration: underline; text-underline-offset: 3px; }
  .example p { color: var(--body); font-size: 0.9375rem; }
  .example-meta { display: flex; gap: 8px; align-items: flex-start; margin-top: auto; }
  .example-meta :global(.icon) { flex: none; margin-top: 0.2em; color: var(--cyan); }
  .example .example-svc { padding-top: 10px; border-top: 1px solid var(--hairline-soft); color: var(--muted); }
  .code-links { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  @media (max-width: 479px) { .code-links .button { width: 100%; } }
  .code-links + .note { display: flex; gap: 10px; align-items: flex-start; max-width: 80ch; margin-top: 20px; }
  .code-links + .note :global(.icon) { flex: none; margin-top: 0.2em; color: var(--cyan); }
</style>
