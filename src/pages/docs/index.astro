---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
const pages = Object.values(import.meta.glob("./*.md", { eager: true })) as { frontmatter: { title: string; description: string }; url: string }[];
---
<Base title="Docs · Nuxy Automation">
  <h1>Docs</h1>
  <p class="lead">Setup guides for each project, written for the person who has to run it.</p>
  <ul class="guides">
    {pages.map((p) => (
      <li>
        <a href={p.url}>
          <span class="guide-title">{p.frontmatter.title}</span>
          <span class="guide-text">{p.frontmatter.description}</span>
          <Icon name="arrowRight" class="guide-arrow" />
        </a>
      </li>
    ))}
  </ul>
</Base>

<style>
  .guides { list-style: none; margin: 32px 0 0; padding: 0; display: grid; gap: 12px; }
  .page .guides li + li { margin-top: 0; }
  .guides a {
    display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 4px 16px; align-items: center; padding: 20px 22px;
    border: 1px solid var(--hairline); border-radius: var(--r-md); text-decoration: none; transition: box-shadow 160ms ease-out;
  }
  .guides a:hover { box-shadow: var(--shadow-lift); color: inherit; }
  .guide-title { color: var(--ink); font-weight: 600; font-size: 1.0625rem; }
  /* (descriptions are cut at 200 characters by scripts/sync-docs.mjs, so show two lines and an ellipsis) */
  .guide-text { grid-column: 1; color: var(--muted); font-size: 0.9375rem; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; line-clamp: 2; overflow: hidden; }
  .guides :global(.guide-arrow) { grid-row: 1 / span 2; grid-column: 2; width: 22px; height: 22px; color: var(--ink); }
</style>
