---
// A case study for each working example: the problem, what was built, the messy cases it handles, the demo week as it
// ran, and the numbers. The business is made up (said at the top); the code and the numbers are real.
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import { examples, type Example } from "../../data/examples";
import { ask, gmail, outlook } from "../../lib/request";

export function getStaticPaths() {
  return examples.map((example) => ({ params: { slug: example.slug }, props: { example } }));
}
const { example: e } = Astro.props as { example: Example };
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const others = examples.filter((x) => x.slug !== e.slug);
---
<Base title={`${e.title} · Case study · Nuxy Automation`} description={`${e.problem} How a ${e.service.name.toLowerCase()} setup handles it, shown on a made-up ${e.kind} with working, open-source code.`}>
  <p class="crumbs"><a href={`${base}/#work`}>Working examples</a><span aria-hidden="true">/</span>{e.tab}</p>
  <h1>{e.title}</h1>
  <p class="made-up"><Icon name="sealCheck" /><span><strong>{e.who}</strong> is made up for this example. The code is real and open: <a href="https://github.com/Nuxy1/small-business-automations">read it or run it</a>.</span></p>

  <figure id="video" class="video">
    <video src={`${base}/videos/${e.slug}.mp4`} poster={`${base}/videos/${e.slug}-poster.jpg`} width="1920" height="1080" controls playsinline preload="metadata" aria-describedby="video-note"></video>
    <figcaption id="video-note">The week below, in under a minute: every line and every email is the code’s real output. No sound needed.</figcaption>
  </figure>

  <h2>The problem</h2>
  <p class="lead">{e.problem}</p>

  <h2>What it does</h2>
  <ul class="ticks">{e.built.map((b) => <li><Icon name="check" />{b}</li>)}</ul>

  <h2>The messy parts it handles</h2>
  <ul class="ticks">{e.messy.map((m) => <li><Icon name="check" />{m}</li>)}</ul>

  <h2>The week, line by line</h2>
  <figure class="term">
    <p class="term-who">{e.who}</p>
    <ol class="term-lines">
      {e.lines.map(([time, kind, text]) => <li class={`k-${kind}`}><span class="t">{time}</span><span class="k">{kind}</span><span class="x">{text}</span></li>)}
    </ol>
    <figcaption>The demo’s simulated week (<code>npm run demo</code>), word for word.</figcaption>
  </figure>
  <ul class="stats">{e.numbers.map(([n, what]) => <li><strong>{n}</strong><span>{what}</span></li>)}</ul>
  <p class="speed"><Icon name="lightning" /><span><strong>Speed:</strong> {e.speed} on a desktop PC (<code>npm run bench</code>). A small business’s whole year fits in under a second.</span></p>

  <h2>For your business</h2>
  <p>{e.fit}</p>
  <aside class="offer" aria-label={`Request ${e.service.name}`}>
    <div><p class="offer-name">{e.service.name}</p><p class="offer-price">{e.service.price}, fixed · 30-day launch watch included</p></div>
    <a class="button" href={ask(e.service)}>Request this</a>
    <p class="alt">or in <a href={gmail(e.service)} target="_blank" rel="noopener">Gmail</a> or <a href={outlook(e.service)} target="_blank" rel="noopener">Outlook</a> · <a href={`${base}/#${e.service.id}`}>What’s included</a></p>
  </aside>

  <h2>More examples</h2>
  <ul class="more">{others.map((o) => <li><a href={`${base}/work/${o.slug}/`}><strong>{o.title}</strong><span>{o.problem}</span></a></li>)}</ul>
</Base>

<style>
  .crumbs { display: flex; gap: 8px; margin: 0; color: var(--muted); font-size: 0.875rem; }
  .crumbs a { color: var(--muted); }
  .made-up { display: flex; gap: 10px; align-items: flex-start; margin: 0 0 8px; padding: 12px 16px; border-radius: var(--r-md); background: var(--surface); font-size: 0.9375rem; }
  .made-up :global(.icon) { width: 20px; height: 20px; margin-top: 2px; color: var(--ink); }
  .video { margin: 20px 0 8px; }
  .video video { width: 100%; height: auto; border-radius: var(--r-md); background: #0f1115; box-shadow: var(--shadow-lift); }
  .video figcaption { margin-top: 10px; color: var(--muted); font-size: 0.875rem; }
  .ticks { list-style: none; padding: 0 !important; display: grid; gap: 10px; }
  .ticks li { display: grid; grid-template-columns: 22px minmax(0, 1fr); gap: 10px; margin: 0 !important; }
  .ticks :global(.icon) { width: 18px; height: 18px; margin-top: 4px; color: var(--accent-text); }
  .term { margin: 0; border-radius: var(--r-md); background: #101114; color: #d9dde3; box-shadow: var(--shadow); overflow: hidden; font: 0.8125rem/1.5 ui-monospace, "Cascadia Code", Consolas, monospace; }
  .term-who { margin: 0; padding: 14px 18px 8px; color: #9aa1ab; }
  .term-lines { list-style: none; margin: 0; padding: 0 18px 8px !important; display: grid; gap: 4px; }
  .term-lines li { display: grid; grid-template-columns: 76px 72px minmax(0, 1fr); gap: 10px; margin: 0 !important; }
  .term-lines .t, .term-lines .k { color: #7d8590; }
  .k-customer .k { color: #7ee2a8; }
  .k-owner .k { color: #9ecbff; }
  .k-form .k { color: #f0c674; }
  .k-stopped .k, .k-skipped .k, .k-quiet .k { color: #b4b9c1; }
  .k-skipped .x, .k-quiet .x { color: #9aa1ab; }
  .term figcaption { padding: 10px 18px 14px; color: #7d8590; }
  .term code { color: #d9dde3; background: #1d2026; }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .term-lines li { animation: line-in linear both; animation-timeline: view(); animation-range: entry 0% entry 60%; }
    }
  }
  @keyframes line-in { from { opacity: 0; transform: translateY(6px); } }
  @media (max-width: 560px) {
    .term-lines li { display: block; padding: 6px 0; border-bottom: 1px solid #1d2026; }
    .term-lines .t::after { content: " · "; }
    .term-lines .x { display: block; }
  }
  .stats { list-style: none; padding: 0 !important; margin: 20px 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(110px, 1fr)); gap: 10px; }
  .stats li { margin: 0 !important; padding: 14px; border-radius: var(--r-md); background: var(--surface); display: grid; gap: 2px; }
  .stats strong { color: var(--ink); font-size: 1.75rem; line-height: 1; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
  .stats span { color: var(--muted); font-size: 0.875rem; line-height: 1.3; }
  .speed { display: flex; gap: 10px; align-items: flex-start; margin: 16px 0 0; font-size: 0.9375rem; }
  .speed :global(.icon) { width: 20px; height: 20px; margin-top: 2px; color: var(--ink); }
  .offer { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 10px 20px; margin: 20px 0 0; padding: 20px 22px; border: 1px solid var(--hairline); border-radius: var(--r-md); box-shadow: var(--shadow-lift); }
  .offer p { margin: 0; }
  .offer-name { color: var(--ink); font-weight: 700; font-size: 1.125rem; }
  .offer-price { color: var(--muted); font-size: 0.9375rem; }
  .offer .alt { grid-column: 1 / -1; color: var(--muted); font-size: 0.875rem; }
  .offer .alt a { color: var(--muted); }
  @media (max-width: 520px) { .offer { grid-template-columns: 1fr; } .offer .button { width: 100%; } }
  .more { list-style: none; padding: 0 !important; display: grid; gap: 10px; }
  .more li { margin: 0 !important; }
  .more a { display: grid; gap: 4px; padding: 16px 18px; border: 1px solid var(--hairline); border-radius: var(--r-md); text-decoration: none; transition: box-shadow 200ms ease-out, border-color 200ms ease-out; }
  .more a:hover { border-color: transparent; box-shadow: var(--shadow-lift); }
  .more strong { color: var(--ink); }
  .more span { color: var(--muted); font-size: 0.9375rem; }
</style>
