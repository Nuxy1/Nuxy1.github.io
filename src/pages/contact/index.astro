---
import { titleCase } from "../../lib/title-case";
// The contact page: the quote form (components/InquiryForm.astro) and plain email as the alternative.
// The booking link appears only when data/site.ts calUrl is set; the callback request form
// (components/CallbackForm.astro) only when data/site.ts callbackForm is on.
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import InquiryForm from "../../components/InquiryForm.astro";
import CallbackForm from "../../components/CallbackForm.astro";
import { calMinutes, calUrl, callbackForm, inbox } from "../../data/site";
import { ask, gmail, outlook } from "../../lib/request";
import { faqs, variantById, automationFrom } from "../../data/services";

// (critique round 6: at 1440 the side column ended a screen above the form, and the page never said what things cost
// or how paying works) the starting prices and three answers from the pricing page's questions, word for word
const websiteFrom = variantById["starter-website"].price;
const quick = ["How do I pay?", "Are there costs from other companies?", "What if I change my mind?"].map((q) => {
  const found = faqs.find(([x]) => x === q);
  if (!found) throw new Error(`contact: the question "${q}" is no longer in data/services.ts faqs`);
  return found;
});

const next = [
  ["We read it", "A person reads every request. There is no sales sequence to sit through."],
  // (critique round 12: on a phone the starting prices sat in the side column, after the Send button) the step before
  // the first field names them, from the same data as the side column
  ["You get a written plan and price", `Within one business day: what we’d build, what it costs (websites from ${websiteFrom}, automations from ${automationFrom}), what we’d need from you and how long it takes.`],
  ["You decide", "Nothing is charged and no work starts until you agree to the plan. If it isn’t a fit, we’ll say so."],
];

// Structured data for search: what this page is, tied to the business entry in Base.astro.
const pageData = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "@id": "https://nuxyautomation.com/contact/",
  url: "https://nuxyautomation.com/contact/",
  name: "Contact Nuxy Automation",
  about: { "@id": "https://nuxyautomation.com/#business" },
};
---
<Base title="Get a Free Quote · Nuxy Automation" description="Tell us what you need and get a written plan and fixed price within one business day. No call needed, and nothing is charged until you agree." wide>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(pageData)} />
  <section class="section contact">
    <div class="wrap contact-grid">
      <div class="contact-main">
        <p class="eyebrow" data-way-eyebrow>Free quote</p>
        <h1 id="contact-title">Tell Us What You Need</h1>
        <p class="lead">A new website, an online store, an automation or care for the site you have. Tell us about it, and <span data-way-reply>we’ll reply in writing</span>.</p>
        <!-- (site audit 2026-11-21, critique: on a phone the callback came after the whole quote form, and the aside
        offered it a second time; now both ways are named here, before the first field)
        (owner decision 2026-11-21: one form at a time) With JavaScript the two links become tabs and only the chosen
        form shows; the quote form is chosen first, /contact/#callback opens the callback form, and a form keeps what was
        typed in it when the visitor switches. Without JavaScript both forms show, one below the other, and the links jump. -->
        {callbackForm && (
          <ul class="ways" aria-label="Two ways to start" data-ways>
            <li><a href="#quote-form" id="way-quote" data-way="quote"><Icon name="pencilSimple" /><span><strong>Write it down</strong> A short form; we reply in writing</span></a></li>
            <li><a href="#callback" id="way-callback" data-way="callback"><Icon name="phone" /><span><strong>Request a callback</strong> Leave your number; we call you back</span></a></li>
          </ul>
        )}
        <div class="way-panel" id="quote-panel" data-way-panel="quote">
          <!-- (site audit 2026-11-21, critique round 3) what happens next sat in the side column, so on a phone it came
          after both forms: it now sits in the main column at every width, right above the form it explains, and the lead
          no longer says the same thing first. The two ways stay above it so a phone still shows them in the first screen. -->
          <section class="steps" aria-labelledby="steps-h">
            <h2 id="steps-h">What Happens Next</h2>
            <ol class="next">
              {next.map(([title, text], i) => (
                <li><span class="num" aria-hidden="true">{i + 1}</span><div><h3>{titleCase(title)}</h3><p>{text}</p></div></li>
              ))}
            </ol>
            <!-- (critique round 13: below 1024px the questions about paying come after the form and its Send button; this
            points to them first. From 1024px they sit beside the form.) -->
            <p class="steps-more">Questions about paying or other costs? <a class="glue" href="#prices-h">See the answers below the form</a></p>
          </section>
          <div class="panel form-panel" id="quote-form">
            <InquiryForm />
          </div>
        </div>

        {callbackForm && (
          <section class="callback way-panel" id="callback" data-way-panel="callback" aria-labelledby="callback-title">
            <h2 id="callback-title">Rather Talk on the Phone?</h2>
            <p class="lead">Leave your number and the time of day that suits you, and we’ll call you back about it. Texts only if you tick the optional box. This asks for a call; it doesn’t set a time.</p>
            <div class="panel form-panel">
              <CallbackForm />
            </div>
          </section>
        )}
      </div>

      <aside class="contact-aside" aria-label="About your request">
        <div class="aside-block aside-email">
          <h2>Prefer Email?</h2>
          <p>Write to <a href={ask()}>{inbox}</a>. If nothing opens when you click, use <a href={gmail()} target="_blank" rel="noopener">Gmail</a> or <a href={outlook()} target="_blank" rel="noopener">Outlook</a> in your browser.</p>
        </div>

        {calUrl && (
          <div class="aside-block">
            <h2>Rather Talk It Through?</h2>
            <p>Pick a time for a free {calMinutes}-minute call. It’s optional: the form or an email gets the same written plan.</p>
            <a class="button secondary small" href={calUrl} target="_blank" rel="noopener" data-track="cal_open"><Icon name="calendarCheck" />Book a call</a>
          </div>
        )}

        <div class="aside-block">
          <h2>Your Information</h2>
          <ul class="ticks small">
            <li><Icon name="check" />Used only to reply about your project</li>
            <li><Icon name="check" />Never sold, shared or added to a mailing list</li>
            <li><Icon name="check" />We never ask for passwords or card numbers here</li>
          </ul>
          <p class="fine"><a href="/policies/#privacy">Privacy policy</a></p>
        </div>

        <!-- (critique round 7) last, so on a computer it can stay beside the long form (see .aside-follow); the answers
             share a name, so opening one closes the other and the block always fits the screen -->
        <div class="aside-block aside-follow">
          <h2 id="prices-h">Prices and Paying</h2>
          <p>Websites from {websiteFrom}, one-time. Automations from {automationFrom}. The exact price is in your written plan.</p>
          <div class="faq aside-faq">
            {quick.map(([q, a]) => (
              <details name="contact-prices">
                <summary><span>{q}</span><Icon name="plus" /></summary>
                <p>{a}</p>
              </details>
            ))}
          </div>
          <p class="fine"><a href="/pricing/#faq">More questions about prices and paying</a></p>
        </div>
      </aside>
    </div>
  </section>
</Base>

<script>
  // One form at a time (owner decision 2026-11-21): the two links above the forms become tabs (WAI-ARIA tabs pattern,
  // selection follows focus). Hidden forms stay in the page, so nothing typed is lost. No imports, so Astro writes this
  // into the page and /contact/ still loads one script file (tests/cinematic.test.mjs counts them).
  const list = document.querySelector<HTMLElement>("[data-ways]");
  if (list) {
    const tabs = [...list.querySelectorAll<HTMLAnchorElement>("[data-way]")];
    const panelOf = (t: HTMLElement) => document.querySelector<HTMLElement>(`[data-way-panel="${t.dataset.way}"]`)!;
    const eyebrow = document.querySelector<HTMLElement>("[data-way-eyebrow]");
    const reply = document.querySelector<HTMLElement>("[data-way-reply]");
    list.setAttribute("role", "tablist");
    list.dataset.tabs = "";
    for (const li of list.children) li.setAttribute("role", "presentation");
    for (const t of tabs) {
      const p = panelOf(t);
      t.setAttribute("role", "tab");
      t.setAttribute("aria-controls", p.id);
      p.setAttribute("role", "tabpanel");
      p.setAttribute("aria-labelledby", t.id);
    }
    const show = (t: HTMLAnchorElement, focus = false) => {
      for (const x of tabs) {
        const on = x === t;
        x.setAttribute("aria-selected", String(on));
        x.tabIndex = on ? 0 : -1;
        panelOf(x).hidden = !on;
      }
      if (focus) t.focus();
      // (critique round 16) the label above the heading and the intro's promise named the quote while the callback
      // form was open; both now follow the chosen form
      const call = t.dataset.way === "callback";
      if (eyebrow) eyebrow.textContent = call ? "Free callback" : "Free quote";
      if (reply) reply.textContent = call ? "we’ll call you back" : "we’ll reply in writing";
      // the address says which form is open, so a reload or a shared link opens the same one; no jump
      history.replaceState(history.state, "", t.dataset.way === "callback" ? "#callback" : location.pathname + location.search);
    };
    const byHash = () => tabs.find((t) => t.getAttribute("href") === location.hash);
    const first = byHash() ?? tabs[0];
    show(first);
    if (first !== tabs[0]) {
      // a link to /contact/#callback lands with the two choices in view, not just under them: they stop where every
      // anchor on the site stops (Base.astro's scroll-padding-top), and the intro's last line stays under the header
      const p = panelOf(first);
      p.style.scrollMarginTop = `${p.getBoundingClientRect().top - list.getBoundingClientRect().top}px`;
      p.scrollIntoView({ block: "start", behavior: "instant" });
    }
    list.addEventListener("click", (e) => {
      const t = (e.target as Element).closest<HTMLAnchorElement>("[data-way]");
      if (!t) return;
      e.preventDefault();
      show(t);
    });
    list.addEventListener("keydown", (e) => {
      const i = tabs.indexOf(document.activeElement as HTMLAnchorElement);
      if (i < 0) return;
      const n = { ArrowRight: i + 1, ArrowDown: i + 1, ArrowLeft: i - 1, ArrowUp: i - 1, Home: 0, End: tabs.length - 1, " ": i }[e.key];
      if (n === undefined) return;
      e.preventDefault();
      show(tabs[(n + tabs.length) % tabs.length], true);
    });
    addEventListener("hashchange", () => { const t = byHash(); if (t) show(t); });
  }
</script>

<style>
  .contact { padding-top: clamp(40px, 6vw, 72px); }
  .contact-grid { display: grid; gap: clamp(40px, 5vw, 64px); align-items: start; }
  @media (min-width: 1024px) { .contact-grid { grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr); } }
  .contact .lead { margin-top: 16px; max-width: 60ch; color: var(--muted); }
  .form-panel { margin-top: clamp(28px, 4vw, 40px); padding: clamp(20px, 4vw, 36px); scroll-margin-top: 16px; }
  .ways { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 10px; margin: 24px 0 0; padding: 0; list-style: none; }
  /* the two choices stay the same height side by side when one line wraps (round 12 check) */
  .ways li { display: flex; }
  .ways a { flex: 1; display: grid; grid-template-columns: 22px minmax(0, 1fr); gap: 12px; align-items: start; min-height: 44px; padding: 14px 16px; border: 1px solid var(--hairline); border-radius: var(--r-md); color: var(--muted); text-decoration: none; font-size: 0.875rem; line-height: 1.45; transition: border-color 160ms ease-out, background-color 160ms ease-out; }
  .ways a:hover { border-color: var(--accent); background: var(--accent-soft); }
  .ways strong { display: block; color: var(--ink); font-size: 1rem; font-weight: 600; }
  .ways :global(.icon) { width: 22px; height: 22px; margin-top: 1px; color: var(--link); }
  /* as tabs (the script above): the open form's card is tinted with a doubled blue edge, the same "chosen" mark as the
     portfolio's level filter; hovering the other one only colors its edge */
  .ways a[aria-selected="true"] { border-color: var(--accent); background: var(--accent-soft); box-shadow: inset 0 0 0 1px var(--accent); }
  .ways a[aria-selected="false"]:hover { background: transparent; }
  .callback { margin-top: clamp(48px, 7vw, 80px); scroll-margin-top: 16px; }
  .ways[data-tabs] ~ .callback { margin-top: clamp(28px, 3vw, 36px); }
  .callback h2 { font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2rem); }
  .callback .form-panel { margin-top: clamp(20px, 3vw, 28px); }
  .contact-aside { display: flex; flex-direction: column; gap: 32px; }
  @media (min-width: 1024px) { .contact-aside { padding-top: 8px; } }
  /* (critique round 7) the whole column (650-750px) only fit tall screens, so a 1280x800 or 1536x730 laptop got a short
     column beside a long form. Now the column runs the form's full height and only its last block, prices and paying
     (about 310-520px with one answer open), stays in view, which fits any screen 640px tall or more. A flex column,
     not a grid: a grid would hold the block inside its own row. */
  @media (min-width: 1024px) { .contact-aside { align-self: stretch; } }
  @media (min-width: 1024px) and (min-height: 640px) { .aside-follow { position: sticky; top: 96px; } }
  .aside-block { display: grid; gap: 12px; padding-bottom: 32px; border-bottom: 1px solid var(--hairline); }
  .aside-block:last-child { padding-bottom: 0; border-bottom: 0; }
  .aside-block h2 { font-size: 1.125rem; letter-spacing: -0.01em; }
  .aside-block p { color: var(--body); font-size: 0.9375rem; line-height: 1.6; overflow-wrap: anywhere; }
  .aside-block .button { justify-self: start; }
  .aside-faq { margin-top: 0; }
  /* (critique round 13) once a request is sent, its confirmation names the email address for anything to add, so the
     side column no longer offers it a second time. Whole rule global: the panels are in the form components. */
  :global(.contact-grid:has([data-done]:not([hidden]), [data-cb-done]:not([hidden])) .aside-email) { display: none; }
  .steps-more { margin-top: 16px; color: var(--muted); font-size: 0.875rem; }
  .steps-more a { color: var(--link); }
  @media (min-width: 1024px) { .steps-more { display: none; } }
  .aside-faq summary { padding: 12px 0; font-size: 0.9375rem; }
  .aside-faq details p { padding-bottom: 14px; }
  /* the three steps, one under the other. (critique round 7: three columns left each step about 190px wide, five or six
     lines tall) (critique round 14: from 640px the titles sat in a 152px column beside their text, wrapping to two
     lines, and read as a table; flagged in rounds 11, 13 and 14) Each title now sits above its text at every width, as
     on the home page and /get-a-website/. */
  .steps { margin-top: clamp(28px, 3vw, 36px); padding-top: 18px; border-top: 1px solid var(--hairline); }
  .steps h2 { color: var(--muted); font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; }
  .next { display: grid; gap: 14px; margin: 14px 0 0; padding: 0; list-style: none; }
  @media (min-width: 640px) { .next { gap: 16px; } .next p { max-width: 64ch; } }
  .next li { display: grid; grid-template-columns: 28px minmax(0, 1fr); gap: 12px; align-items: start; }
  /* (critique round 14) the site's numbered circle (home handover, /get-a-website/), a size smaller for these short steps */
  .num { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: var(--button); color: #fff; font-size: 0.8125rem; font-weight: 700; font-variant-numeric: tabular-nums; }
  .next h3 { font-size: 0.9375rem; font-weight: 600; line-height: 1.35; }
  .next p { margin-top: 4px; color: var(--muted); font-size: 0.875rem; line-height: 1.5; }
  .ticks.small { font-size: 0.9375rem; }
  .fine { font-size: 0.875rem; }
</style>
