---
// Not found. Kept out of search (noindex) and the sitemap. GitHub Pages serves dist/404.html for any missing path.
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";

const links: [string, string, string][] = [
  ["/", "Home", "What Nuxy Automation does, in one page"],
  ["/solutions/", "All services", "Every service with its fixed price"],
  ["/websites/", "Website development", "New websites, redesigns and fixes"],
  ["/automation/", "Automation", "Lead follow-up, booking, invoices and more"],
  ["/pricing/", "Pricing", "One-time prices and optional monthly plans"],
  ["/demos/", "Demos", "Try it before you spend a dollar"],
  ["/contact/", "Contact", "Get a free quote, in writing"],
];
---
<Base title="Page not found · Nuxy Automation" description="This page doesn’t exist or has moved." noindex>
  <p class="eyebrow">Error 404</p>
  <h1>That Page Isn’t Here</h1>
  <p class="lead">It may have moved when the site was reorganized, or the link has a typo. One of these should get you where you were going.</p>
  <ul class="nf-links" role="list">
    {links.map(([href, name, text]) => (
      <li><a href={href}><span><strong>{name}</strong><span>{text}</span></span><Icon name="arrowRight" /></a></li>
    ))}
  </ul>
</Base>

<style>
  .nf-links { display: grid; gap: 10px; max-width: 640px; margin: 32px 0 0; padding: 0; list-style: none; }
  .nf-links a { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 56px; padding: 12px 18px; border: 1px solid var(--hairline); border-radius: var(--r-md); background: var(--panel); color: var(--ink); text-decoration: none; }
  .nf-links a:hover { border-color: var(--hairline-strong); color: var(--ink); }
  .nf-links a > span { display: grid; gap: 2px; }
  .nf-links a > span > span { color: var(--muted); font-size: 0.875rem; }
  .nf-links :global(.icon) { flex: none; color: var(--link); }
</style>
