---
// Pricing, in the brief's order: the three bundles (#bundles), every service (#services), the optional monthly plans
// (#plans, with #care, #automation-starter, #automation-growth, #automation-partner and the retired #automation-care),
// custom projects (#custom) and the questions (#faq). Old homepage links (/#plans, /#faq, /#care...) land here
// (Base.astro). Every price and term comes from data/services.ts and is the PUBLISHED one.
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import { groups, services, plans, planNote, planTerms, bundle, bundles, bundleMath, money, dollars, faqs, keep, retired, priceWords, statusWords, manageWords } from "../../data/services";
import type { IconName } from "../../components/Icon.astro";
import type { Service, Variant } from "../../data/services";
// (the lowest monthly plan and one-time price, from the data, so a price change follows into the description)
const cheapest = [...plans].sort((x, y) => dollars(x.amount) - dollars(y.amount))[0];
const lowest = money(Math.min(...services.flatMap((s) => [s, ...(s.variants ?? [])]).map((s) => dollars(s.price))));

const site = "https://nuxyautomation.com";
const watch = keep.find((k) => k.icon === "bellSimple")!;

const paying: { icon: IconName; title: string; text: string }[] = [
  { icon: "sealCheck", title: "A written plan and price first", text: "Within one business day of your request: what we’ll build, what it costs and what it needs from you. Nothing is charged until you agree." },
  { icon: "creditCard", title: "50% to start, 50% at handover", text: "By a secure Stripe invoice: card, Apple Pay, Google Pay or bank transfer. Monthly plans are billed monthly." },
  { icon: "listChecks", title: "Two or more cost less", text: `Order 2 one-time services together and the total is ${bundle.two}% off; 3 or more, ${bundle.three}% off. The bundles below are already discounted.` },
  { icon: watch.icon, title: watch.title, text: watch.text },
];

// Custom projects: everything priced "from" a starting point that depends on your tools, plus the consultation-only
// services. Their final price is always in writing first.
const custom = services.filter((s) => s.priceType === "custom" || s.status === "consult" || s.id === "integrations");
const priceOf = (s: Service | Variant) => (s.monthly ? `${s.price} + ${s.monthly}` : s.price);

const offerOf = (s: Service | Variant, url: string) => {
  const n = String(dollars(s.price));
  const fixed = s.priceType === "fixed";
  return {
    "@type": "Offer", name: s.name, url, priceCurrency: "USD",
    ...(fixed ? { price: n } : { priceSpecification: { "@type": "PriceSpecification", minPrice: n, priceCurrency: "USD" } }),
    ...(s.monthly ? { description: `Setup ${s.price}; optional monthly management ${s.monthly}, plus provider usage` } : {}),
    seller: { "@id": `${site}/#business` },
  };
};

const data = [
  {
    "@context": "https://schema.org",
    "@type": "OfferCatalog",
    "@id": `${site}/pricing/#bundles`,
    name: "Business solution bundles",
    url: `${site}/pricing/#bundles`,
    itemListElement: bundles.map((b) => ({
      "@type": "Offer", name: b.name, description: b.includes.join(". "), url: `${site}/pricing/#${b.id}`,
      price: String(dollars(b.price)), priceCurrency: "USD", seller: { "@id": `${site}/#business` },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "OfferCatalog",
    "@id": `${site}/pricing/#plans`,
    name: "Optional monthly management plans",
    url: `${site}/pricing/#plans`,
    itemListElement: plans.map((p) => ({
      "@type": "Offer",
      name: p.name,
      description: p.points.join(". "),
      url: `${site}/pricing/#${p.id}`,
      price: p.amount.replace(/[^0-9.]/g, ""),
      priceCurrency: "USD",
      priceSpecification: { "@type": "UnitPriceSpecification", price: p.amount.replace(/[^0-9.]/g, ""), priceCurrency: "USD", unitCode: "MON", unitText: "month" },
      seller: { "@id": `${site}/#business` },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "OfferCatalog",
    "@id": `${site}/pricing/#custom`,
    name: "Custom projects",
    url: `${site}/pricing/#custom`,
    itemListElement: custom.flatMap((s) => [offerOf(s, `${site}/solutions/#${s.id}`), ...(s.variants ?? []).map((v) => offerOf(v, `${site}/solutions/#${v.id}`))]),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${site}/pricing/#faq`,
    mainEntity: faqs.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })),
  },
];

// One-time setup vs. a monthly plan, side by side (the brief's "easy comparison").
const compare: [string, string, string][] = [
  ["What it is", "Building it: set up, tested and handed over in your accounts", "Looking after it: watched, fixed when it breaks, small changes"],
  ["How you pay", "Once: 50% to start, 50% at handover", "Monthly, by Stripe, month to month"],
  ["Required?", "It’s what you’re buying", "Never. Everything works and stays yours without one"],
  ["When it ends", "At handover, plus the 30-day launch watch", "Whenever you cancel: it ends with the month already paid"],
  ["Other companies’ fees", "Named in your written plan, paid by you to them", "Same: never included, never marked up"],
];
---
<Base title="Pricing: Setups, Bundles & Monthly Plans · Nuxy Automation" description={`One-time prices from ${lowest}, agreed in writing before you pay: three money-saving bundles, every service, and optional monthly plans from ${cheapest.price}.`} wide>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(data)} />

  <section class="pr-hero">
    <div class="wrap">
      <p class="eyebrow">Pricing</p>
      <h1>Clear prices, agreed before you pay.</h1>
      <p class="lead">Every setup has a one-time price, written into your plan before any work starts. Monthly plans are optional, for when you’d like your website or automations watched and fixed after launch.</p>
      <ul class="paying" role="list">
        {paying.map((p) => (
          <li>
            <Icon name={p.icon} />
            <div><h2>{p.title}</h2><p>{p.text}</p></div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section band" id="bundles" aria-labelledby="bundles-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Business solutions</p>
        <h2 id="bundles-h">Three bundles that solve one problem each</h2>
        <p>Whole services from the price list below, set up together for less. One-time prices; a monthly plan is optional.</p>
      </div>
      <ul class="bundles" role="list">
        {bundles.map((b) => {
          const m = bundleMath(b);
          return (
            <li class="bundle" id={b.id}>
              <span class="bundle-icon"><Icon name={b.icon} /></span>
              <h3>{b.name}</h3>
              <p class="plan-who">{b.who}</p>
              <p class="plan-price"><strong>{b.price}</strong> one-time</p>
              <p class="bundle-save">{money(m.separately)} separately: you save {money(m.save)}</p>
              <ul class="ticks" role="list">{b.includes.map((point) => <li><Icon name="check" />{point}</li>)}</ul>
              <a class="button wide" href={`/contact/?service=${b.id}`} data-track="bundle_ask">Ask about this bundle</a>
            </li>
          );
        })}
      </ul>
      <p class="plan-note"><Icon name="info" />Bundle prices already include their discount, so the {bundle.two}% / {bundle.three}% multi-service discount doesn’t apply on top. Texting, booking-tool and other companies’ fees are separate and named in your written plan.</p>
    </div>
  </section>

  <section class="section" id="services" aria-labelledby="prices-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">One-time prices</p>
        <h2 id="prices-h">Every service and its price</h2>
        <p>A plain price is fixed. A “from” price is where it starts; the exact price is in your written plan before you pay. What other companies charge, like a website builder’s plan, is paid to them directly. The services page shows what each one fixes and needs.</p>
      </div>
      <div class="price-lists">
        {groups.map((g) => (
          <table class="price-list">
            <caption><a href={`/solutions/#${g.id}`}>{g.title}</a></caption>
            <thead class="sr-only"><tr><th scope="col">Service</th><th scope="col">Price</th></tr></thead>
            <tbody>
              {g.items.flatMap((s) => [
                <tr>
                  <th scope="row"><a href={`/solutions/#${s.id}`}>{s.name}</a>{s.addon && <span class="chip plain">Add-on</span>}{s.status !== "active" && <span class="chip plain">{statusWords[s.status]}</span>}</th>
                  <td>{s.price}{s.monthly && <span class="per">+ {s.monthly}</span>}</td>
                </tr>,
                ...(s.variants ?? []).map((v) => (
                  <tr class="variant">
                    <th scope="row"><a href={`/solutions/#${s.id}`}>{v.name}</a></th>
                    <td>{v.price}{v.monthly && <span class="per">+ {v.monthly}</span>}</td>
                  </tr>
                )),
              ])}
            </tbody>
          </table>
        ))}
      </div>
      <p class="more-line"><a class="text-link" href="/solutions/">Compare every service in detail<Icon name="arrowRight" /></a></p>
    </div>
  </section>

  <section class="section band" id="plans" aria-labelledby="plans-h">
    <div class="wrap">
      {Object.keys(retired).map((old) => <span id={old} class="old-anchor" />)}
      <div class="section-head">
        <p class="eyebrow">Optional monthly plans</p>
        <h2 id="plans-h">Want it looked after after launch?</h2>
        <p>Not required: everything we build is yours, with or without a plan. Plans are billed monthly by Stripe; cancel any time and the plan ends with the month already paid.</p>
      </div>
      <ul class="plans" role="list">
        {plans.map((p) => (
          <li class={`plan${p.recommended ? " featured" : ""}`} id={p.id}>
            {p.recommended && <span class="chip blue badge">Recommended for several automations</span>}
            <p class="plan-kind">{p.kind === "website" ? "Website" : "Automations"}</p>
            <h3>{p.name}</h3>
            <p class="plan-who">{p.who}</p>
            <p class="plan-price"><strong>{p.amount}</strong> a month</p>
            <ul class="ticks" role="list">{p.points.map((point) => <li><Icon name="check" />{point}</li>)}</ul>
            <a class={`button wide${p.recommended ? "" : " secondary"}`} href={`/contact/?service=${p.id}`} data-track="plan_ask">Ask about {p.name}</a>
          </li>
        ))}
      </ul>
      <p class="plan-note"><Icon name="info" />{planNote}</p>

      <div class="plan-more">
        <div>
          <h3 id="compare-h">One-time setup or monthly plan?</h3>
          <div class="table-scroll" role="region" aria-labelledby="compare-h" tabindex="0">
            <table class="compare">
              <thead><tr><td></td><th scope="col">One-time setup</th><th scope="col">Monthly plan</th></tr></thead>
              <tbody>{compare.map(([row, a, b]) => <tr><th scope="row">{row}</th><td>{a}</td><td>{b}</td></tr>)}</tbody>
            </table>
          </div>
        </div>
        <div>
          <h3>What every plan includes and excludes</h3>
          <ul class="terms" role="list">{planTerms.map((t) => <li><Icon name="check" />{t}</li>)}</ul>
          <p class="terms-link">Full terms: <a href="/policies/#cancel">Monthly plan cancellations</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="custom" aria-labelledby="custom-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Custom projects</p>
        <h2 id="custom-h">Bigger systems, quoted in writing</h2>
        <p>These depend on your phone system, your tools and how many locations you have, so the price shown is where they start. You get a written scope and a fixed price before you pay anything; work outside it is quoted separately, never added to the bill.</p>
      </div>
      <ul class="custom-list" role="list">
        {custom.map((s) => (
          <li>
            <Icon name={s.icon} />
            <div>
              <h3><a href={`/solutions/#${s.id}`}>{s.name}</a></h3>
              <p class="custom-price"><strong>{priceOf(s)}</strong> <span>{priceWords[s.priceType]}</span>{s.status !== "active" && <span class="chip plain">{statusWords[s.status]}</span>}</p>
              {(s.variants ?? []).map((v) => <p class="custom-price"><strong>{priceOf(v)}</strong> <span>{v.name}</span></p>)}
              <p>{manageWords(s)}.</p>
              <a class="text-link" href={`/contact/?service=${s.id}`} data-track="service_ask">Request a proposal<Icon name="arrowRight" /></a>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section band" id="faq" aria-labelledby="faq-h">
    <div class="wrap faq-wrap">
      <div class="section-head">
        <p class="eyebrow">Questions</p>
        <h2 id="faq-h">Questions about prices and paying</h2>
      </div>
      <div class="faq">
        {faqs.map(([q, a]) => (
          <details>
            <summary><span>{q}</span><Icon name="plus" /></summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="cta-band">
        <div>
          <h2>Get your free automation plan</h2>
          <p>Tell us what slows you down or what you’d like built. Within one business day you’ll get a written plan with the exact price. No call needed.</p>
        </div>
        <div class="cta-actions">
          <a class="button" href="/contact/" data-track="cta_pricing">Get My Free Automation Plan</a>
          <a class="button secondary" href="/solutions/">See all services</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .old-anchor { display: block; scroll-margin-top: calc(var(--nav-h) + 8px); }
  .pr-hero { padding-block: clamp(40px, 6vw, 80px) clamp(48px, 7vw, 88px); }
  .pr-hero h1 { max-width: 20ch; font-size: clamp(2.125rem, 1.5rem + 2.6vw, 3.25rem); }
  .pr-hero .lead { margin-top: 18px; max-width: 62ch; }
  .paying { display: grid; gap: 24px 32px; margin: clamp(32px, 4vw, 48px) 0 0; padding: 0; list-style: none; }
  @media (min-width: 640px) { .paying { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1120px) { .paying { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .paying li { display: grid; grid-template-columns: 40px minmax(0, 1fr); gap: 14px; align-items: start; }
  .paying li > :global(.icon) { width: 40px; height: 40px; padding: 9px; border-radius: 10px; background: var(--accent-soft); color: var(--link); }
  .paying h2 { font-size: 1.0625rem; }
  .paying p { margin-top: 4px; color: var(--body); font-size: 0.9375rem; }

  .bundles { display: grid; gap: 20px; margin: 0; padding: 0; list-style: none; }
  @media (min-width: 960px) { .bundles { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .bundle { display: flex; flex-direction: column; gap: 12px; padding: clamp(22px, 3vw, 30px); border: 1px solid var(--hairline); border-radius: var(--r-lg); background: var(--panel); scroll-margin-top: calc(var(--nav-h) + 20px); }
  .bundle:target { border-color: var(--blue); box-shadow: 0 0 0 1px var(--blue); }
  .bundle-icon :global(.icon) { width: 40px; height: 40px; padding: 9px; border-radius: 10px; background: var(--accent-soft); color: var(--link); }
  .bundle h3 { font-size: 1.25rem; }
  /* (side by side, the prices line up: each "who" line takes two lines of room) */
  @media (min-width: 960px) { .bundle .plan-who { min-height: 3.2em; min-height: 2lh; } }
  .bundle-save { color: var(--ink); font-size: 0.9375rem; font-weight: 600; }
  .bundle .ticks { margin: 0 0 8px; padding: 14px 0 0; border-top: 1px solid var(--hairline-soft); color: var(--body); font-size: 0.9375rem; }
  .bundle .button { margin-top: auto; }

  .price-lists { display: grid; gap: 28px 40px; align-items: start; }
  @media (min-width: 900px) { .price-lists { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .price-list { width: 100%; border-collapse: collapse; font-size: 0.9375rem; }
  .price-list caption { padding-bottom: 10px; text-align: left; font-size: 1.125rem; font-weight: 650; }
  .price-list caption a { color: var(--ink); text-decoration: none; }
  .price-list caption a:hover { color: var(--link); }
  .price-list tr { border-top: 1px solid var(--hairline); }
  .price-list tr.variant { border-top-style: dashed; }
  .price-list tr.variant th { padding-left: 16px; }
  .price-list tr:last-child { border-bottom: 1px solid var(--hairline); }
  .price-list th, .price-list td { padding: 11px 0; vertical-align: baseline; }
  .price-list th { padding-right: 16px; font-weight: 500; text-align: left; }
  /* Underlined at rest so a service name reads as a link without relying on colour (Lighthouse link-in-text-block). */
  .price-list th a { color: var(--body); text-decoration: underline; text-decoration-color: var(--hairline-strong); text-decoration-thickness: 1px; text-underline-offset: 3px; }
  .price-list th a:hover { color: var(--ink); text-decoration-color: currentColor; }
  .price-list th .chip { margin-left: 8px; padding: 2px 8px; font-size: 0.75rem; vertical-align: 1px; }
  .price-list td { color: var(--ink); font-weight: 650; text-align: right; font-variant-numeric: tabular-nums; }
  .price-list .per { display: block; color: var(--muted); font-size: 0.8125rem; font-weight: 500; white-space: nowrap; }
  .more-line { margin-top: 28px; }

  .plans { display: grid; gap: 20px; margin: 0; padding: 0; list-style: none; }
  @media (min-width: 720px) { .plans { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1200px) { .plans { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .plan { position: relative; display: flex; flex-direction: column; gap: 12px; padding: clamp(22px, 3vw, 28px); border: 1px solid var(--hairline); border-radius: var(--r-lg); background: var(--panel); scroll-margin-top: calc(var(--nav-h) + 20px); }
  .plan.featured { border-color: rgba(59, 130, 246, 0.55); }
  .plan:target { border-color: var(--blue); box-shadow: 0 0 0 1px var(--blue); }
  .plan .badge { position: absolute; top: 0; left: clamp(22px, 3vw, 28px); transform: translateY(-50%); border: 1px solid rgba(59, 130, 246, 0.55); background: var(--panel); }
  .plan-kind { color: var(--muted); font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; }
  .plan h3 { font-size: 1.25rem; }
  .plan-who { color: var(--muted); font-size: 0.9375rem; }
  .plan-price { color: var(--muted); }
  .plan-price strong { margin-right: 4px; color: var(--ink); font-size: 2.25rem; font-weight: 700; letter-spacing: -0.02em; line-height: 1; }
  .plan .ticks { margin: 0 0 8px; padding: 14px 0 0; border-top: 1px solid var(--hairline-soft); color: var(--body); font-size: 0.9375rem; }
  .plan .button { margin-top: auto; }
  .plan-note { display: flex; gap: 10px; align-items: flex-start; max-width: 80ch; margin-top: 24px; color: var(--muted); font-size: 0.9375rem; }
  .plan-note :global(.icon) { flex: none; margin-top: 0.2em; color: var(--cyan); }

  .plan-more { display: grid; grid-template-columns: minmax(0, 1fr); gap: 36px 48px; margin-top: clamp(36px, 5vw, 56px); }
  @media (min-width: 1024px) { .plan-more { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); } }
  .plan-more h3 { margin-bottom: 14px; font-size: 1.125rem; }
  .table-scroll { overflow-x: auto; }
  .compare { width: 100%; min-width: 520px; border-collapse: collapse; font-size: 0.9375rem; }
  .compare th, .compare td { padding: 11px 12px 11px 0; border-top: 1px solid var(--hairline); text-align: left; vertical-align: top; }
  .compare tbody tr:last-child > * { border-bottom: 1px solid var(--hairline); }
  .compare thead th { color: var(--ink); font-weight: 650; }
  .compare tbody th { width: 9.5em; color: var(--muted); font-weight: 600; }
  .compare td { color: var(--body); }
  .terms { display: grid; gap: 10px; margin: 0; padding: 0; list-style: none; color: var(--body); font-size: 0.9375rem; }
  .terms li { display: grid; grid-template-columns: 18px minmax(0, 1fr); gap: 10px; }
  .terms :global(.icon) { margin-top: 0.2em; color: var(--cyan); }
  .terms-link { margin-top: 14px; color: var(--muted); font-size: 0.9375rem; }

  .custom-list { display: grid; gap: 28px 40px; margin: 0; padding: 0; list-style: none; }
  @media (min-width: 900px) { .custom-list { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .custom-list li { display: grid; grid-template-columns: 40px minmax(0, 1fr); gap: 14px; align-items: start; }
  .custom-list li > :global(.icon) { width: 40px; height: 40px; padding: 9px; border-radius: 10px; background: var(--accent-soft); color: var(--link); }
  .custom-list h3 { font-size: 1.0625rem; }
  .custom-list h3 a { color: var(--ink); text-decoration: none; }
  .custom-list h3 a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .custom-list p { margin-top: 4px; color: var(--body); font-size: 0.9375rem; }
  .custom-price strong { color: var(--ink); font-variant-numeric: tabular-nums; }
  .custom-price span { color: var(--muted); }
  .custom-price .chip { margin-left: 8px; padding: 2px 8px; font-size: 0.75rem; }
  .custom-list .text-link { display: inline-flex; margin-top: 8px; }
</style>
