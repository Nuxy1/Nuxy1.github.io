---
import Base from "../layouts/Base.astro";

// A made-up salon showing each package working. Nothing here is a real business, person or phone number
// (555 numbers and the .example domain are reserved for exactly this).
const salon = "Juniper & Rose";
const services = [["Women’s cut", "$55"], ["Men’s cut", "$35"], ["Color", "from $95"], ["Blowout", "$40"]];
const times = ["10:30", "1:00", "2:15", "4:45"];
---
<Base title="Demo salon · Nuxy Automation" description="See online booking, reminders, missed-call text-back, instant replies and review requests working on a made-up salon.">
  <h1>See it working</h1>
  <p class="lead">{salon} is a made-up salon: no real business, people or phone numbers. This is what the packages look like once they’re set up. The highlighted parts are filled in automatically for each client.</p>

  <section class="exhibit" aria-labelledby="ex-booking">
    <h2 id="ex-booking">Online booking</h2>
    <p class="note">Before, clients had to call. After, they book themselves from the website, Google and Instagram. <a href="/#booking">The package: $400</a></p>
    <div class="switch">
      <input class="sr" type="radio" name="booking-view" id="view-before" checked />
      <input class="sr" type="radio" name="booking-view" id="view-after" />
      <p class="views">
        <label for="view-before">Before</label>
        <label for="view-after">After</label>
      </p>
      <div class="browser">
        <p class="bar"><span class="url">juniperandrose.example</span></p>
        <div class="site">
          <p class="site-name">{salon}</p>
          <p class="site-line">Cuts, color and curls. Open Tuesday to Saturday, 9 to 6.</p>
          <div class="before">
            <p class="site-call">Call to book: (507) 555-0142</p>
            <p class="site-small">Leave a message and we’ll call you back when we’re free.</p>
          </div>
          <details class="after">
            <summary class="site-book">Book now</summary>
            <div class="booking">
              <p class="booking-head">Choose a service</p>
              <ul class="services">{services.map(([name, price]) => <li><span>{name}</span><span>{price}</span></li>)}</ul>
              <p class="booking-head">Tuesday, November 4</p>
              <ul class="times">{times.map((t) => <li>{t}</li>)}</ul>
              <p class="site-small">A $20 deposit holds your spot. Free cancellation up to 24 hours before.</p>
              <p class="site-small"><span class="gift">Buy a gift card</span></p>
            </div>
          </details>
        </div>
      </div>
    </div>
    <p class="note after-note">Choose After, then Book now. The booking page also takes a deposit to cut no-shows (<a href="/#deposits">add-on: $150</a>) and sells gift cards (<a href="/#gift-cards">add-on: $150</a>).</p>
  </section>

  <section class="exhibit phones" aria-label="Messages clients receive">
    <figure class="phone">
      <h2 class="phone-title">Reminders</h2>
      <ol class="thread">
        <li class="in">Hi <b class="fill">Maya</b>, a reminder of your <b class="fill">women’s cut with Jess</b> tomorrow at <b class="fill">2:15 PM</b> at {salon}. Need to change it? <span class="link">juniperandrose.example/book</span></li>
        <li class="out">See you then!</li>
      </ol>
      <figcaption>Sent the day before, by the booking tool you already use. <a href="/#booking">Part of online booking</a></figcaption>
    </figure>

    <figure class="phone">
      <h2 class="phone-title">Missed-call text-back</h2>
      <ol class="thread">
        <li class="event">Missed call: <b class="fill">(507) 555-0188</b>, 11:42 AM</li>
        <li class="in">Sorry we missed your call! We’re with a client. Book online any time: <span class="link">juniperandrose.example/book</span></li>
        <li class="out">Perfect, just booked Saturday</li>
      </ol>
      <figcaption>Goes out within a minute when nobody can pick up. <a href="/#missed-calls">Add-on: $250</a></figcaption>
    </figure>

    <figure class="phone">
      <h2 class="phone-title">Instant replies</h2>
      <ol class="thread">
        <li class="out">Do you have anything this Saturday?</li>
        <li class="in">Hi <b class="fill">Sam</b>, thanks for messaging {salon}! You can see every open time and book here: <span class="link">juniperandrose.example/book</span>. Jess will reply personally soon.</li>
        <li class="event">Next day, if they haven’t booked</li>
        <li class="in">Hi <b class="fill">Sam</b>, just checking you found a time. Saturday still has <b class="fill">1:00</b> open.</li>
      </ol>
      <figcaption>Every website, Facebook and Instagram message answered at once, with an alert to the salon. <a href="/#follow-up">Lead follow-up: $450</a></figcaption>
    </figure>

    <figure class="phone">
      <h2 class="phone-title">Review requests</h2>
      <ol class="thread">
        <li class="in">Thanks for coming in today, <b class="fill">Maya</b>! If you have a minute, a Google review helps a small salon a lot: <span class="link">g.page/juniper-and-rose/review</span></li>
        <li class="out">Done! Love the cut</li>
      </ol>
      <figcaption>Sent to every client after their visit, not only the happy ones (Google’s rules). <a href="/#reviews">Review requests: $250</a></figcaption>
    </figure>
  </section>

  <section class="close" aria-labelledby="ex-yours">
    <h2 id="ex-yours">Want this for your business?</h2>
    <p>Everything above is built inside your own accounts, with the booking tool you already use where possible. Fixed prices, in writing, no calls needed.</p>
    <p class="actions"><a class="button" href="/#request">Request a setup</a> <a href="/#packages">See the packages and prices</a></p>
  </section>

  <script is:inline>
    // Messages arrive one by one as each phone comes into view. Without this script they're simply all there.
    if (matchMedia("(prefers-reduced-motion: no-preference)").matches && "IntersectionObserver" in window) {
      document.documentElement.classList.add("deal");
      const seen = new IntersectionObserver((entries) => entries.forEach((e) => {
        if (!e.isIntersecting) return;
        e.target.classList.add("dealt");
        seen.unobserve(e.target);
      }), { rootMargin: "0px 0px -15% 0px" });
      document.querySelectorAll(".phone").forEach((el) => seen.observe(el));
    }
  </script>
</Base>

<style>
  .lead { margin-bottom: 8px; }
  .exhibit { margin: 48px 0 0; }
  .exhibit h2 { margin-top: 0; }
  .note { margin: 0 0 18px; max-width: 62ch; }
  .after-note { margin: 16px 0 0; font-size: 0.9375rem; color: var(--muted); }

  /* Before / After: a segmented pill; the radio buttons stay in the page for keyboards and screen readers. */
  .sr { position: absolute; opacity: 0; width: 1px; height: 1px; pointer-events: none; }
  .views { display: inline-flex; gap: 4px; margin: 0 0 16px; padding: 4px; border-radius: var(--r-full); background: var(--surface-strong); }
  .views label { display: inline-flex; align-items: center; min-height: 40px; padding: 0 22px; border-radius: var(--r-full); cursor: pointer; font-weight: 600; color: var(--muted); transition: background-color 160ms ease-out, color 160ms ease-out, box-shadow 160ms ease-out; }
  .views label:hover { color: var(--ink); }
  #view-before:checked ~ .views label[for="view-before"],
  #view-after:checked ~ .views label[for="view-after"] { background: var(--bg); color: var(--ink); box-shadow: var(--shadow); }
  #view-before:focus-visible ~ .views label[for="view-before"],
  #view-after:focus-visible ~ .views label[for="view-after"] { outline: 2px solid var(--ink); outline-offset: 2px; }
  #view-before:checked ~ .browser .after,
  #view-after:checked ~ .browser .before { display: none; }

  /* The salon's own website, shown working inside a browser frame. */
  .browser { overflow: hidden; border: 1px solid var(--hairline); border-radius: var(--r-md); background: var(--bg); box-shadow: var(--shadow); }
  .bar { margin: 0; padding: 10px 14px; background: var(--surface); border-bottom: 1px solid var(--hairline-soft); }
  .url { display: inline-block; padding: 3px 14px; border-radius: var(--r-full); background: var(--bg); color: var(--muted); font-size: 0.8125rem; box-shadow: inset 0 0 0 1px var(--hairline); }
  .site { padding: clamp(20px, 5vw, 40px); min-height: 18rem; }
  .site-name { color: var(--ink); font-size: clamp(1.75rem, 5vw, 2.25rem); font-weight: 700; letter-spacing: -0.025em; line-height: 1.1; margin: 0; }
  .site-line { margin: 8px 0 22px; }
  .site-call { color: var(--ink); font-weight: 700; font-size: 1.25rem; margin: 0; }
  .site-small { font-size: 0.9375rem; color: var(--muted); margin: 8px 0 0; }
  .site-book {
    display: inline-flex; align-items: center; min-height: 48px; padding: 0 24px; list-style: none; cursor: pointer;
    background: var(--ink); color: var(--bg); border-radius: var(--r-sm); font-weight: 600;
  }
  .site-book::-webkit-details-marker { display: none; }
  details[open] .site-book { opacity: 0.85; }
  .booking { margin-top: 20px; padding-top: 4px; border-top: 1px solid var(--hairline); }
  .booking-head { color: var(--ink); font-weight: 600; margin: 16px 0 8px; }
  .services, .times { list-style: none; margin: 0; padding: 0; }
  .services { max-width: 26rem; border: 1px solid var(--hairline); border-radius: var(--r-sm); }
  .services li { display: flex; justify-content: space-between; gap: 12px; padding: 10px 14px; font-variant-numeric: tabular-nums; }
  .services li + li { border-top: 1px solid var(--hairline); }
  .times { display: flex; flex-wrap: wrap; gap: 8px; }
  .times li { padding: 8px 16px; border-radius: var(--r-full); box-shadow: inset 0 0 0 1px var(--hairline); color: var(--ink); font-variant-numeric: tabular-nums; }
  .times li:nth-child(3) { background: var(--ink); color: var(--bg); box-shadow: none; }
  .gift { color: var(--ink); text-decoration: underline; text-underline-offset: 0.2em; }
  @media (prefers-reduced-motion: no-preference) {
    .booking { animation: unfold 320ms var(--ease); }
  }

  /* The client's phone: the salon's automatic messages in grey, the client's own replies in ink. */
  .phones { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 40px 28px; }
  .phone { margin: 0; }
  .phone-title { margin: 0 0 12px !important; font-size: 1.125rem !important; }
  .thread {
    list-style: none; margin: 0; padding: 22px 14px 26px; display: grid; gap: 8px; align-content: start; min-height: 16rem;
    border: 1px solid var(--hairline); border-radius: 28px; background: var(--bg); box-shadow: var(--shadow);
  }
  .thread li { max-width: 86%; padding: 9px 14px; border-radius: 18px; font-size: 0.9375rem; line-height: 1.4; }
  .page .thread li + li { margin-top: 0; }
  .in { justify-self: start; background: var(--surface-strong); color: var(--ink); border-bottom-left-radius: 6px; }
  .out { justify-self: end; background: var(--ink); color: var(--bg); border-bottom-right-radius: 6px; }
  .event { justify-self: center; max-width: 100% !important; padding: 2px 0 !important; color: var(--muted); font-size: 0.8125rem !important; }
  .fill { font-weight: 600; background: var(--accent-soft); color: var(--ink); padding: 0 2px; margin: 0 -2px; border-radius: 4px; box-decoration-break: clone; -webkit-box-decoration-break: clone; }
  .link { text-decoration: underline; text-underline-offset: 0.18em; overflow-wrap: anywhere; }
  figcaption { margin-top: 12px; font-size: 0.9375rem; color: var(--muted); max-width: 40ch; }

  :global(html.deal) .phone:not(.dealt) .thread li { opacity: 0; }
  .phone.dealt .thread li { animation: arrive 380ms var(--ease) backwards; }
  .phone.dealt .thread li:nth-child(2) { animation-delay: 700ms; }
  .phone.dealt .thread li:nth-child(3) { animation-delay: 1400ms; }
  .phone.dealt .thread li:nth-child(4) { animation-delay: 2100ms; }

  .close { margin-top: 64px; padding: 28px; border-radius: var(--r-lg); background: var(--surface); }
  .close h2 { margin-top: 0; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 24px; margin: 20px 0 0; }

  @keyframes arrive { from { opacity: 0; transform: translateY(10px); } }
  @keyframes unfold { from { opacity: 0; transform: translateY(-6px); } }
</style>
