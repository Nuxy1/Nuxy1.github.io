---
// About: who Nuxy is (one independent business in Faribault, no names or photos until the owner approves them:
// data/site.ts `team`), what it stands for, how a job runs (#how-we-work, where the old /#keep link lands), where it
// works (one page for every area, no near-identical city pages), the tools it builds in, and what it won't do.
// Every commitment here is already published in data/services.ts or /policies/.
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import { steps, keep, areas, tools } from "../../data/services";
import { inbox, team } from "../../data/site";
import type { IconName } from "../../components/Icon.astro";

const site = "https://nuxyautomation.com";
const areaText = `${areas.slice(0, -2).join(", ")}, ${areas.at(-2)} and ${areas.at(-1)}`;

const values: { icon: IconName; title: string; text: string }[] = [
  { icon: "receipt", title: "Written, fixed prices", text: "You see the plan and the price in writing before anything starts. No hourly meter, no surprise invoice." },
  { icon: "lockSimple", title: "Your accounts, your property", text: "Built in your own accounts as an invited user, never with your passwords. Once it’s paid, everything built for you is yours." },
  { icon: "checkCircle", title: "Tested before handover", text: "Every piece is tried with realistic examples first, and you get a short video showing it working." },
  { icon: "chatsCircle", title: "Plain English, in writing", text: "No jargon and no call you have to schedule. Questions and updates come in writing, with screen recordings." },
];

const glance: [IconName, string, string][] = [
  ["mapPin", "Based in", "Faribault, Minnesota"],
  ["mapTrifold", "Works with", "Businesses in southern Minnesota, the Twin Cities and remotely across the US"],
  ["clock", "First answer", "A written plan and price within one business day"],
  ["user", "Who you deal with", "The person who builds your project, start to finish"],
];

const wont: string[] = [
  "Promise a top Google ranking or a number of new customers. Results depend on your market and your business.",
  "Ask for your passwords. We work as an invited user, and you can remove our access at any time.",
  "Make a monthly plan a condition. Every service is a one-time price.",
  "Keep your website, domain or automations from you. Once they’re paid for, they’re yours, in your own accounts.",
  "Send anything to your customers that you haven’t approved. You set the wording and the rules first.",
  "Show made-up businesses as clients. Every demo on this site is labeled as one.",
];

const data = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "@id": `${site}/about/`,
  url: `${site}/about/`,
  name: "About Nuxy Automation",
  about: { "@id": `${site}/#business` },
};
---
<Base title="About Nuxy Automation · Faribault, Minnesota" description="A small business in Faribault, Minnesota, building websites and automations for service businesses in southern Minnesota, the Twin Cities and across the US." wide>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(data)} />

  <section class="ab-hero">
    <div class="wrap ab-grid">
      <div>
      <p class="eyebrow"><Icon name="mapPin" />Faribault, Minnesota</p>
      <h1>A small, local business that builds websites and automations.</h1>
      <p class="lead">Nuxy Automation helps small service businesses answer every inquiry, book jobs without phone tag and stop typing the same details twice. You deal directly with the person who builds your project, from your first question to handover, and every answer comes in writing.</p>
      {team.length > 0 && (
        <ul class="team" role="list">
          {team.map((p) => (
            <li>
              {p.photo && <img src={p.photo} alt="" width="72" height="72" loading="lazy" decoding="async" />}
              <div><h2>{p.name}</h2><p class="role">{p.role}</p><p>{p.bio}</p></div>
            </li>
          ))}
        </ul>
      )}
      </div>
      <dl class="glance panel">
        {glance.map(([icon, term, text]) => (
          <div><Icon name={icon} /><dt>{term}</dt><dd>{text}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section band" aria-labelledby="values-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">What you can count on</p>
        <h2 id="values-h">Straight answers, fair prices, work you own</h2>
      </div>
      <ul class="values" role="list">
        {values.map((v) => (
          <li>
            <Icon name={v.icon} />
            <div><h3>{v.title}</h3><p>{v.text}</p></div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" id="how-we-work" aria-labelledby="how-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">How we work</p>
        <h2 id="how-h">Four steps, all in writing</h2>
        <p>No sales call and no long contract. You can stop after any step.</p>
      </div>
      <ol class="steps" role="list">
        {steps.map((s, i) => (
          <li class="step">
            <span class="step-num" aria-hidden="true">{i + 1}</span>
            <h3><span class="sr-only">Step {i + 1}: </span>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
      <h3 class="sub-h">After launch</h3>
      <ul class="keep" role="list">
        {keep.map((k) => (
          <li>
            <Icon name={k.icon} />
            <div><h4>{k.title}</h4><p>{k.text}</p></div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section band" id="areas" aria-labelledby="areas-h">
    <div class="wrap split">
      <div>
        <p class="eyebrow">Where we work</p>
        <h2 id="areas-h">Southern Minnesota, the Twin Cities and anywhere in the US</h2>
      </div>
      <div class="split-text">
        <p>Nuxy Automation is based in Faribault and works with businesses in {areaText}, and remotely anywhere in the US.</p>
        <p>Everything happens in writing, with short screen recordings of each piece working, so where you are doesn’t change how we work. If you’d rather talk, say so in the form.</p>
        <p class="contact-line"><Icon name="envelopeSimple" /><a href={`mailto:${inbox}`}>{inbox}</a></p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="tools-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">The tools</p>
        <h2 id="tools-h">Built in the tools you already use</h2>
        <p>We set things up inside your own accounts with these and similar tools. Nuxy Automation isn’t a partner of, or endorsed by, any of these companies.</p>
      </div>
      <ul class="tools" role="list">{tools.map((t) => <li>{t}</li>)}</ul>
    </div>
  </section>

  <section class="section band" aria-labelledby="wont-h">
    <div class="wrap split">
      <div>
        <p class="eyebrow">Plainly</p>
        <h2 id="wont-h">What we won’t do</h2>
        <p class="split-sub">The full terms, refunds and privacy policy are on the <a href="/policies/">policies page</a>.</p>
      </div>
      <ul class="wont" role="list">
        {wont.map((w) => <li><Icon name="x" />{w}</li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="cta-band">
        <div>
          <h2>Tell us what slows you down</h2>
          <p>A short form, then a written plan and a fixed price within one business day, or an honest “this isn’t worth automating”.</p>
        </div>
        <div class="cta-actions">
          <a class="button" href="/contact/" data-track="cta_about">Get a Free Assessment</a>
          <a class="button secondary" href="/demos/">See the demos</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .ab-hero { padding-block: clamp(40px, 6vw, 80px) clamp(48px, 7vw, 88px); }
  .ab-grid { display: grid; gap: 32px 64px; }
  @media (min-width: 1024px) { .ab-grid { grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr); align-items: center; } }
  .glance { display: grid; gap: 18px; margin: 0; padding: clamp(22px, 3vw, 28px); }
  .glance div { display: grid; grid-template-columns: 24px minmax(0, 1fr); gap: 2px 12px; }
  .glance :global(.icon) { grid-row: span 2; width: 22px; height: 22px; margin-top: 2px; color: var(--cyan); }
  .glance dt { color: var(--muted); font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.02em; }
  .glance dd { margin: 0; color: var(--ink); font-size: 0.9375rem; }
  .ab-hero .eyebrow { display: inline-flex; align-items: center; gap: 6px; }
  .ab-hero h1 { max-width: 22ch; font-size: clamp(2.125rem, 1.5rem + 2.6vw, 3.25rem); }
  .ab-hero .lead { margin-top: 18px; max-width: 64ch; }
  .team { display: grid; gap: 20px; margin: 32px 0 0; padding: 0; list-style: none; }
  .team li { display: grid; grid-template-columns: 72px minmax(0, 1fr); gap: 16px; max-width: 640px; }
  .team img { border-radius: 50%; object-fit: cover; }
  .team h2 { font-size: 1.125rem; }
  .team .role { color: var(--muted); font-size: 0.9375rem; }

  .values { display: grid; gap: 28px 32px; margin: 0; padding: 0; list-style: none; }
  .values li, .keep li { display: grid; grid-template-columns: 44px minmax(0, 1fr); gap: 14px; align-items: start; }
  .values li > :global(.icon), .keep li > :global(.icon) { width: 44px; height: 44px; padding: 10px; border-radius: 12px; background: var(--accent-soft); color: var(--link); }
  .values h3, .keep h4 { margin-bottom: 6px; font-size: 1.0625rem; }
  .values p, .keep p { color: var(--body); font-size: 0.9375rem; }
  @media (min-width: 720px) { .values, .keep { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1120px) { .values { grid-template-columns: repeat(4, minmax(0, 1fr)); } }

  .steps { display: grid; gap: 16px; margin: 0; padding: 0; list-style: none; }
  .step { padding: 24px; border: 1px solid var(--hairline); border-radius: var(--r-lg); background: var(--panel); }
  .step-num { display: grid; place-items: center; width: 40px; height: 40px; margin-bottom: 16px; border-radius: 50%; background: var(--button); color: #fff; font-weight: 700; font-variant-numeric: tabular-nums; }
  .step h3 { margin-bottom: 8px; }
  .step p { font-size: 0.9375rem; }
  @media (min-width: 720px) { .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .steps { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .sub-h { margin: clamp(40px, 5vw, 56px) 0 20px; font-size: 1.25rem; }
  .keep { display: grid; gap: 24px 32px; margin: 0; padding: 0; list-style: none; }

  .split { display: grid; gap: 20px 64px; }
  @media (min-width: 900px) { .split { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); align-items: start; } }
  .split-text { display: grid; gap: 14px; font-size: 1.0625rem; color: var(--body); }
  .split-sub { margin-top: 12px; color: var(--body); }
  .contact-line { display: inline-flex; align-items: center; gap: 8px; }
  .contact-line :global(.icon) { color: var(--cyan); }
  .contact-line a { display: inline-flex; align-items: center; min-height: 44px; overflow-wrap: anywhere; }

  .tools { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; list-style: none; }
  .tools li { padding: 6px 12px; border: 1px solid var(--hairline); border-radius: var(--r-full); color: var(--body); font-size: 0.875rem; white-space: nowrap; }

  .wont { display: grid; gap: 14px; margin: 0; padding: 0; list-style: none; }
  .wont li { display: grid; grid-template-columns: 24px minmax(0, 1fr); gap: 12px; color: var(--body); }
  .wont li :global(.icon) { width: 20px; height: 20px; margin-top: 0.15em; color: var(--muted); }
</style>
