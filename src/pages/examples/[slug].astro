---
// The viewer for each example website (data/demo-sites.ts): the demo at /example-sites/<slug>/ in a frame, switchable
// between a computer and a phone, with what it shows and which services it demonstrates. The demo sites are made-up
// businesses; this page says so above the frame, and the demo itself says so in its banner and footer.
// Without JavaScript the frame simply fills the column at a fixed height, and the toggle stays hidden.
// Below the frame sits the case study (website levels brief): the level the concept shows, its objective, design
// direction, technology, automation, performance and phone notes, and what a real project like it would include.
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import { demoSites, type DemoSite } from "../../data/demo-sites";
import { serviceById } from "../../data/services";
import { levelById } from "../../data/tiers";

export function getStaticPaths() {
  return demoSites.map((demo, i) => ({ params: { slug: demo.slug }, props: { demo, i } }));
}
const { demo: d, i } = Astro.props as { demo: DemoSite; i: number };
const prev = demoSites[(i + demoSites.length - 1) % demoSites.length];
const next = demoSites[(i + 1) % demoSites.length];
const src = `/example-sites/${d.slug}/`;
const host = `${d.slug.split("-")[0]}.example`;
const services = d.services.map((id) => serviceById[id]);
const where = (id: string) => (id === "new-website" ? "/websites/#new-website" : id === "online-shop" ? "/ecommerce/" : `/solutions/#${id}`);
// The candle shop is a store, not a website: its title, platform note and quote link say so.
const store = d.project === "E-commerce store";
const kindTitle = d.kind.replace(/\b\w/g, (c) => c.toUpperCase());
const level = levelById[d.tier];
const steps = { Lower: 1, Moderate: 2, High: 3, Bespoke: 4 }[level.complexity];
// a Business example keeps the plain website quote; Signature and Immersive examples start that level's conversation
const cta = store || d.tier === "business"
  ? { href: store ? "/contact/?service=online-shop" : "/contact/?service=new-website", text: store ? "Get a Free Store Quote" : "Get a Free Website Quote" }
  : { href: level.href, text: level.cta };
---
<Base title={store ? `${kindTitle} Example · Nuxy Automation` : `${kindTitle} Website Example · Nuxy Automation`} description={`Demo ${store ? "store" : "website"} for a made-up ${d.summary.replace(/^A /, "").replace(/\.$/, "")}, on a computer and a phone.`} wide>
  <div class="wrap ex">
    <p class="crumbs"><a href="/portfolio/">Portfolio</a><span aria-hidden="true">/</span>{d.name}</p>
    <header class="ex-head">
      <div>
        <p class="eyebrow">{d.kind} · demonstration</p>
        <h1>{d.name}</h1>
        <p class="lead">{d.summary}</p>
      </div>
    </header>
    <p class="made-up"><Icon name="info" /><span><strong>Concept project created by Nuxy Automation to demonstrate our capabilities.</strong> {d.name} is a made-up business, not a client. This example shows the layout, features and finish we aim for. Forms on it send nothing{store ? ", and its checkout is a demo that never asks for a card, so nothing can be bought" : ""}.</span></p>

    <div class="toolbar">
      <div class="toggle" role="group" aria-label="Preview size" data-toggle hidden>
        <button type="button" data-mode="desktop" aria-pressed="true"><Icon name="desktop" />Computer</button>
        <button type="button" data-mode="phone" aria-pressed="false"><Icon name="deviceMobile" />Phone</button>
      </div>
      <a class="text-link" href={src} data-track="example_full">Open the full {store ? "store" : "site"}<Icon name="arrowRight" /></a>
    </div>

    <div class="stage" data-stage data-mode="desktop">
      <div class="device">
        <div class="bar" aria-hidden="true"><span class="dots"><i></i><i></i><i></i></span><span class="url">{host}</span></div>
        <div class="screen" data-screen>
          <iframe src={src} title={`${d.name}, demonstration ${store ? "store" : "website"}`} width="1280" height="800"></iframe>
        </div>
      </div>
    </div>
    <p class="note stage-note">{store ? "The preview is a live page: scroll it, filter the products, add some to the cart." : "The preview is a live page: scroll it, open the menu, try the form."}</p>

    <section class="case" aria-labelledby="case-h">
      <div class="case-head">
        <p class="eyebrow">Concept project · <a href={level.page}>{level.name} level</a></p>
        <h2 id="case-h">The case study</h2>
        <p class="case-complex"><span class="case-steps" aria-hidden="true">{[1, 2, 3, 4].map((n) => <i class:list={{ on: n <= steps }}></i>)}</span>{level.complexity} complexity</p>
      </div>
      <dl class="case-facts">
        <div><dt>Project</dt><dd>{d.project}</dd></div>
        <div><dt>Industry</dt><dd>{d.kind}</dd></div>
        <div><dt>Level</dt><dd><a href={level.page}>{level.name}</a> · {level.price}</dd></div>
        <div><dt>Objective</dt><dd>{d.objective}</dd></div>
        <div><dt>Design direction</dt><dd>{d.direction}</dd></div>
        <div><dt>Technology</dt><dd>{d.technology}</dd></div>
        <div><dt>Automation</dt><dd>{d.automation}</dd></div>
        <div><dt>Performance</dt><dd>{d.performance}</dd></div>
        <div><dt>Mobile</dt><dd>{d.mobile}</dd></div>
      </dl>
      <div class="case-inc panel">
        <h3>What a project like this would include</h3>
        <ul class="ticks">{d.includes.map((x) => <li><Icon name="check" />{x}</li>)}</ul>
        <p class="note">Your written plan sets the exact pages, features, price and timeline for your own project.</p>
      </div>
    </section>

    <div class="ex-info">
      <section id="features" aria-labelledby="shows-h">
        <h2 id="shows-h">Features</h2>
        <ul class="ticks">{d.shows.map((s) => <li><Icon name="check" />{s}</li>)}</ul>
      </section>
      <section aria-labelledby="svc-h">
        <h2 id="svc-h">Services it demonstrates</h2>
        <ul class="svc-list" role="list">
          {services.map((s) => (
            <li><a href={where(s.id)}><Icon name={s.icon} /><span>{s.name}</span><span class="svc-price">{s.price}</span></a></li>
          ))}
        </ul>
        <p class="note">{store
          ? "Your own store is built in your own Shopify or Square Online account, so the details follow what your store platform can do."
          : d.tier === "business"
            ? "A Business website is built in your own Squarespace or Wix account, so the details follow what your website builder can do."
            : "Every level can add automation; each one is priced on its own and named in your written plan."}</p>
      </section>
    </div>

    <section class="ex-cta panel" aria-labelledby="cta-h">
      <div>
        <h2 id="cta-h">Want {store ? "a store" : "a website"} like this?</h2>
        <p>Tell us about your business. Within one business day you’ll get a written plan and a fixed price, with nothing charged until you agree.</p>
      </div>
      <a class="button" href={cta.href} data-track="cta_example_quote">{cta.text}</a>
    </section>

    <nav class="ex-more" aria-label="Other examples">
      <a href={`/examples/${prev.slug}/`}><span class="dir"><Icon name="caretLeft" />Previous</span><span>{prev.name}</span></a>
      <a href={`/examples/${next.slug}/`} class="next"><span class="dir">Next<Icon name="caretRight" /></span><span>{next.name}</span></a>
    </nav>
  </div>
</Base>

<style>
  .ex { padding-block: clamp(28px, 4vw, 48px) clamp(64px, 8vw, 96px); }
  .crumbs { display: flex; flex-wrap: wrap; gap: 8px; color: var(--muted); font-size: 0.875rem; }
  .crumbs a { color: var(--link); }
  .ex-head { margin-top: 20px; }
  .ex-head h1 { margin-top: 6px; }
  .ex-head .lead { margin-top: 14px; max-width: 60ch; }
  .made-up { display: flex; align-items: flex-start; gap: 10px; margin-top: 20px; max-width: 72ch; padding: 12px 16px; border-radius: var(--r-md); background: var(--accent-soft); color: var(--body); font-size: 0.9375rem; }
  .made-up :global(.icon) { flex: none; margin-top: 0.2em; color: var(--link); }
  .made-up strong { color: var(--ink); }

  .toolbar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 20px; margin-top: 32px; }
  .toggle { display: inline-flex; padding: 4px; border-radius: var(--r-full); background: var(--panel); border: 1px solid var(--hairline); }
  .toggle[hidden] { display: none; }
  .toggle button { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 16px; border: 0; border-radius: var(--r-full); background: transparent; color: var(--body); font-weight: 600; font-size: 0.9375rem; cursor: pointer; transition: background 150ms var(--ease), color 150ms var(--ease); }
  .toggle button:hover { color: var(--ink); }
  .toggle button[aria-pressed="true"] { background: var(--button); color: #fff; }
  .toolbar .text-link { display: inline-flex; align-items: center; gap: 6px; min-height: 40px; }

  .stage { display: flex; justify-content: center; margin-top: 16px; }
  .device { width: 100%; border-radius: 14px; overflow: hidden; background: #0e1626; border: 1px solid var(--hairline-strong); box-shadow: var(--shadow); }
  .bar { display: flex; align-items: center; gap: 14px; height: 38px; padding: 0 14px; background: #1a2539; }
  .dots { display: flex; gap: 6px; }
  .dots i { width: 10px; height: 10px; border-radius: 50%; background: #34425c; }
  .url { flex: 0 1 320px; margin-inline: auto; padding: 3px 12px; border-radius: var(--r-full); background: #0e1626; color: var(--muted); font-size: 0.75rem; text-align: center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .screen { position: relative; overflow: hidden; background: #fff; }
  /* without JavaScript: the demo fills the column at its natural responsive layout */
  .screen iframe { display: block; width: 100%; height: min(760px, 75vh); border: 0; }
  /* with JavaScript: the demo renders at a real device size and is scaled to fit (script below) */
  .stage.fitted .screen iframe { position: absolute; top: 0; left: 0; transform-origin: 0 0; }
  .stage[data-mode="phone"] .device { width: auto; padding: 12px; border-radius: 46px; background: #05080f; box-shadow: var(--shadow), inset 0 0 0 2px #1f2a3d; }
  .stage[data-mode="phone"] .bar { display: none; }
  .stage[data-mode="phone"] .screen { border-radius: 34px; }
  .stage-note { margin-top: 12px; text-align: center; }

  .case { margin-top: clamp(48px, 6vw, 72px); display: grid; gap: 24px; }
  @media (min-width: 1024px) { .case { grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr); gap: 24px 56px; } .case-head { grid-column: 1 / -1; } }
  .case-head .eyebrow a { color: inherit; text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--hairline-strong); }
  .case-head h2 { font-size: 1.75rem; }
  .case-complex { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; margin-top: 10px; color: var(--body); font-size: 0.9375rem; }
  .case-steps { display: inline-grid; grid-template-columns: repeat(4, 16px); gap: 3px; }
  .case-steps i { height: 5px; border-radius: 2px; background: var(--hairline-strong); }
  .case-steps i.on { background: var(--link); }
  .case-facts { display: grid; margin: 0; border-top: 1px solid var(--hairline-soft); }
  .case-facts div { display: grid; gap: 4px; padding-block: 12px; border-bottom: 1px solid var(--hairline-soft); }
  @media (min-width: 600px) { .case-facts div { grid-template-columns: 10rem minmax(0, 1fr); gap: 16px; } }
  .case-facts dt { color: var(--muted); font-size: 0.875rem; font-weight: 600; }
  .case-facts dd { margin: 0; color: var(--ink); }
  .case-facts a { color: var(--link); }
  .case-inc { align-self: start; padding: 24px; }
  .case-inc h3 { font-size: 1.125rem; margin-bottom: 14px; }
  .case-inc .note { margin-top: 14px; }
  .ex-info { display: grid; gap: 32px; margin-top: clamp(48px, 6vw, 72px); }
  @media (min-width: 880px) { .ex-info { grid-template-columns: 1fr 1fr; gap: 56px; } }
  .ex-info h2 { font-size: 1.375rem; }
  .ex-info .ticks { margin-top: 16px; }
  .svc-list { display: grid; gap: 8px; margin: 16px 0 14px; padding: 0; list-style: none; }
  .svc-list a { display: flex; align-items: center; gap: 12px; min-height: 52px; padding: 10px 14px; border-radius: var(--r-md); background: var(--panel); border: 1px solid var(--hairline); color: var(--ink); text-decoration: none; transition: border-color 150ms var(--ease); }
  .svc-list a:hover { border-color: var(--hairline-strong); }
  .svc-list :global(.icon) { flex: none; color: var(--link); }
  .svc-price { margin-left: auto; color: var(--muted); font-size: 0.9375rem; white-space: nowrap; }

  .ex-cta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px 32px; margin-top: clamp(48px, 6vw, 72px); padding: clamp(22px, 4vw, 36px); }
  .ex-cta h2 { font-size: 1.5rem; }
  .ex-cta p { margin-top: 8px; max-width: 58ch; color: var(--body); }
  @media (max-width: 479px) { .ex-cta .button { flex: 1 1 100%; } }

  .ex-more { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 40px; }
  .ex-more a { display: grid; gap: 4px; min-height: 64px; padding: 14px 16px; border-radius: var(--r-md); border: 1px solid var(--hairline); color: var(--ink); font-weight: 600; text-decoration: none; transition: border-color 150ms var(--ease); }
  .ex-more a:hover { border-color: var(--hairline-strong); }
  .ex-more .next { text-align: right; }
  .dir { display: inline-flex; align-items: center; gap: 6px; color: var(--muted); font-size: 0.8125rem; font-weight: 500; }
  .next .dir { justify-self: end; }
</style>

<script>
  // Render the demo at a real device size (computer 1280x800, phone 390x780) and scale it down to fit the column.
  const stage = document.querySelector<HTMLElement>("[data-stage]");
  const toggle = document.querySelector<HTMLElement>("[data-toggle]");
  if (stage && toggle) {
    const screen = stage.querySelector<HTMLElement>("[data-screen]")!;
    const frame = screen.querySelector("iframe")!;
    const sizes = { desktop: [1280, 800], phone: [390, 780] } as const;
    type Mode = keyof typeof sizes;
    let mode: Mode = window.matchMedia("(max-width: 719px)").matches ? "phone" : "desktop";
    const fit = () => {
      const [w, h] = sizes[mode];
      const room = stage.clientWidth - (mode === "phone" ? 26 : 2); // the bezel (12px a side) or the 1px border
      // a phone also has to fit the window's height, so the whole screen is visible at once
      const scale = Math.min(1, room / w, mode === "phone" ? Math.max(0.5, (window.innerHeight - 140) / h) : 1);
      frame.style.width = `${w}px`;
      frame.style.height = `${h}px`;
      frame.style.transform = `scale(${scale})`;
      screen.style.width = `${Math.floor(w * scale)}px`;
      screen.style.height = `${Math.floor(h * scale)}px`;
    };
    const set = (next: Mode) => {
      mode = next;
      stage.dataset.mode = mode;
      toggle.querySelectorAll<HTMLButtonElement>("button").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.mode === mode)));
      fit();
    };
    toggle.hidden = false;
    stage.classList.add("fitted");
    toggle.addEventListener("click", (e) => {
      const b = (e.target as Element).closest<HTMLButtonElement>("button[data-mode]");
      if (b) set(b.dataset.mode as Mode);
    });
    new ResizeObserver(fit).observe(stage);
    set(mode);
  }
</script>
