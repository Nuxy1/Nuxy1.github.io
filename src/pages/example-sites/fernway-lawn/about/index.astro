---
// Fernway's about page: the (fictional) story, how the crew works and what it promises. No photos of people: a
// made-up business should not borrow real faces, so the one photo is of the work (an AI-generated example).
import Shell from "../../../../components/demo/fernway/Shell.astro";
import DemoPhoto from "../../../../components/demo/DemoPhoto.astro";
import { base, towns } from "../../../../data/demos/fernway";

const promises = [
  { title: "Same crew, same day", text: "You get two names, not a rotating cast. They learn the gate, the dog and the sprinkler heads." },
  { title: "Nothing silent", text: "A text the night before, a text if rain moves the day, a photo when the job is done." },
  { title: "Prices in writing", text: "A range on the site, a firm price by text before we start, and no surprise line items after." },
  { title: "Plants that last", text: "We pick for your sun, your soil and the deer, and replace anything that fails in its first season." },
];
---
<Shell title="About" current="about" description="The story of Fernway Lawn & Landscape, a fictional two-person-crew lawn company, and how it works. An interactive demonstration website by Nuxy Automation.">
  <section class="fw-section fw-a-hero" aria-labelledby="a-h">
    <div class="fw-wrap fw-a-hero-in">
      <div class="fw-head">
        <h1 id="a-h">One pickup, one mower, and a rule: always text first.</h1>
        <p class="fw-lead">Fernway started with a single street of neighbours who were tired of crews that turned up unannounced, or not at all. The rule hasn’t changed since.</p>
        <p class="fw-a-more">Today it’s crews of two, the same two people on your yard every visit, working {towns.length} towns on set days of the week.</p>
        <p class="fw-demo-note">Fernway is a fictional business, written for this demonstration.</p>
      </div>
      <figure class="fw-a-pic">
        <DemoPhoto name="fernway-mow" alt="A walk-behind mower crossing a freshly striped lawn" sizes="(min-width: 1024px) 44vw, calc(100vw - 40px)" priority />
        <figcaption>AI-generated example photo.</figcaption>
      </figure>
    </div>
  </section>

  <section class="fw-section" aria-labelledby="v-h">
    <div class="fw-wrap">
      <div class="fw-head">
        <h2 id="v-h">Four promises we can keep.</h2>
      </div>
      <ul class="fw-a-promises" role="list">
        {promises.map((v) => (
          <li>
            <h3>{v.title}</h3>
            <p>{v.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="fw-section fw-a-day" aria-labelledby="d-h">
    <div class="fw-wrap fw-a-day-in">
      <div class="fw-head">
        <h2 id="d-h">A Thursday in Alder Bend, from your side.</h2>
        <p class="fw-lead">What a weekly mowing visit looks like on your phone.</p>
      </div>
      <ol class="fw-a-time" role="list">
        <li><time>Wed 6:30 pm</time><p>Text: “Fernway tomorrow between 9 and 11. Gate unlatched, please.”</p></li>
        <li><time>Thu 9:40 am</time><p>Crew arrives, mows, trims the fence line and edges the drive.</p></li>
        <li><time>Thu 10:25 am</time><p>Clippings blown off, gate latched, a photo of the finished lawn sent.</p></li>
        <li><time>Thu 10:26 am</time><p>Card on file charged, receipt by email. Nothing for you to do.</p></li>
      </ol>
    </div>
  </section>

  <section class="fw-section fw-end">
    <div class="fw-wrap">
      <div class="fw-band">
        <h2>Want a Thursday like that?</h2>
        <p>Start with a demonstration estimate. It takes about a minute.</p>
        <a class="fw-btn fw-btn-lime" href={`${base}/quote/`}>Get my estimate</a>
      </div>
    </div>
  </section>
</Shell>

<style>
  .fw-a-hero { background: var(--fw-cream); }
  .fw-a-hero-in { display: grid; gap: 32px 56px; align-items: center; }
  @media (min-width: 1024px) { .fw-a-hero-in { grid-template-columns: 1.1fr 1fr; } }
  .fw-a-hero h1 { font-size: clamp(2.25rem, 5vw, 3.75rem); }
  .fw-a-hero .fw-head { margin-bottom: 0; }
  .fw-a-more { max-width: 56ch; }
  .fw-a-pic { display: grid; gap: 8px; margin: 0; }
  .fw-a-pic :global(.demo-photo) { aspect-ratio: 4 / 3; border-radius: var(--fw-radius); }
  .fw-a-pic figcaption { font-size: 0.8125rem; color: var(--fw-soft); }

  /* four promises as plain text under a straw rule: they are equal, not a sequence, so no numbers and no boxes */
  .fw-a-promises { display: grid; gap: 32px 40px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); }
  .fw-a-promises li { display: grid; gap: 8px; align-content: start; padding-top: 18px; border-top: 3px solid var(--fw-lime); }
  .fw-a-promises h3 { font-size: 1.25rem; }
  .fw-a-promises p { color: var(--fw-soft); }

  .fw-a-day { background: var(--fw-forest); color: #e6eee4; }
  .fw-a-day h2 { color: #fff; }
  .fw-a-day .fw-lead { color: #cfdccc; }
  .fw-a-day-in { display: grid; gap: 32px; }
  @media (min-width: 960px) { .fw-a-day-in { grid-template-columns: 0.9fr 1.1fr; } }
  .fw-a-time { display: grid; gap: 0; border-left: 2px solid rgba(226, 195, 107, 0.4); margin-left: 8px; }
  .fw-a-time li { position: relative; display: grid; gap: 4px; padding: 0 0 26px 26px; }
  .fw-a-time li::before { content: ""; position: absolute; left: -8px; top: 4px; width: 14px; height: 14px; border-radius: 50%; background: var(--fw-lime); box-shadow: 0 0 0 4px var(--fw-forest); }
  .fw-a-time time { font-weight: 700; color: var(--fw-lime); font-size: 0.9375rem; }
  .fw-a-time p { color: #dbe6d9; }
  .fw-end { padding-top: clamp(56px, 8vw, 104px); }
</style>
