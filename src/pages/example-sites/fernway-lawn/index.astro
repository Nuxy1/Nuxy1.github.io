  .fw-cal-track .start { border-radius: 999px 0 0 999px; margin-left: 3px; }
  .fw-cal-track .end { border-radius: 0 999px 999px 0; margin-right: 3px; }
  .fw-cal-track .start.end { border-radius: 999px; }
  .fw-cal-row.live .on { background: var(--fw-lime); }

  .fw-call { background: var(--fw-cream); }
  .fw-call-in { display: grid; gap: 40px; align-items: start; }
  /* side by side, the short heading block sits level with the middle of the taller form, not above an empty column */
  @media (min-width: 960px) { .fw-call-in { grid-template-columns: 0.8fr 1.2fr; align-items: center; } }
  /* the grid's gap spaces the head from the form; the Shell's margin under .fw-head would pull a centred head upward */
  .fw-call-in .fw-head { margin-bottom: 0; }
