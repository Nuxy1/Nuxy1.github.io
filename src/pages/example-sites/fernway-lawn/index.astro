  @media (max-width: 419px) { .fw-cal-months .fw-m-rest { display: none; } }
  .fw-cal-months > span { padding: 0 0 8px 4px; } /* only the month cell: the inner rest-of-name span gets no pad ("Jan", not "J an") */
  .fw-cal-months .now { color: var(--fw-lime); font-weight: 700; }
  .fw-cal-row { display: grid; gap: 8px; padding-block: 14px; border-top: 1px solid rgba(231, 236, 226, 0.14); }
  @media (min-width: 760px) { .fw-cal-row { grid-template-columns: var(--label) 1fr; align-items: center; gap: 0; } }
  .fw-cal-name { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; }
