  .fw-call-list li::before { content: ""; position: absolute; left: 2px; top: 0.6em; width: 10px; height: 2px; border-radius: 2px; background: var(--fw-leaf); }

  /* the one load sequence: the photo settles, then the headline, the line under it and the dock come up in turn */
  :global(:root[data-tier="1"]) .fw-hero :global(.fw-hero-photo img), :global(:root[data-tier="2"]) .fw-hero :global(.fw-hero-photo img) { animation: fw-settle 1600ms cubic-bezier(0.16, 1, 0.3, 1) both; }
  :global(:root[data-tier="1"]) .fw-hero h1, :global(:root[data-tier="2"]) .fw-hero h1 { animation: fw-up 700ms var(--fw-ease) 120ms both; }
