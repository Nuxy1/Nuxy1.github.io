  .fw-cal-name span { font-size: 0.875rem; color: #a9b8a6; }
  .fw-cal-name em { font-style: normal; font-size: 0.8125rem; font-weight: 700; color: var(--fw-lime); }
  .fw-cal-track { position: relative; height: 22px; background: repeating-linear-gradient(to right, rgba(231, 236, 226, 0.1) 0 1px, transparent 1px calc(100% / 12)); }
  .fw-cal-track::after { content: ""; position: absolute; top: -8px; bottom: -8px; left: calc((var(--now) - 1) * 100% / 12); width: calc(100% / 12); background: rgba(226, 195, 107, 0.12); box-shadow: inset 2px 0 0 var(--fw-lime); pointer-events: none; }
  .fw-cal-track span { margin-block: 3px; }
