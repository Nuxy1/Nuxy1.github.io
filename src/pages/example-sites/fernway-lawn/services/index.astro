---
// Fernway's services: the six services as a catalogue (photo, what each includes, when it runs, an example starting
// price), the year at a glance, and common questions. Prices come from lib/demo/fernway-quote.ts and are demo prices;
// the photos are AI-generated examples (docs/demo-photo-assets.md).
import Shell from "../../../../components/demo/fernway/Shell.astro";
import DemoPhoto from "../../../../components/demo/DemoPhoto.astro";
import { base, serviceList, faqs } from "../../../../data/demos/fernway";
import { usd } from "../../../../lib/demo/money";
import { FREQUENCIES, SIZES, fromPrice } from "../../../../lib/demo/fernway-quote";

const unit = { visit: "a visit", job: "a job", season: "a season" } as const;
const per = { visit: "per visit", job: "per job", season: "per season" } as const;
const sizes = ["small", "medium", "large"] as const;
const months = ["J", "F", "M", "A", "M", "J", "J", "A", "S", "O", "N", "D"];
const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
const now = 10; // November, when this demo was made; fixed so screenshots match the home page calendar
// months each service runs (0 = January), matching the season line on each row
const runs: Record<string, number[]> = {
  mowing: [3, 4, 5, 6, 7, 8, 9],
  cleanup: [3, 9],
  mulch: [4, 5],
  hedge: [5, 8],
  planting: [4, 5, 6, 7, 8],
  snow: [10, 11, 0, 1, 2],
};
---
<Shell title="Services" current="services" description="Fernway's six lawn and landscape services with what each includes, when it runs and example prices. A fictional business in a Nuxy Automation demonstration.">
  <section class="fw-section fw-s-hero" aria-labelledby="s-h" data-bar-clear>
    <div class="fw-wrap fw-s-hero-in">
      <div class="fw-head">
        <h1 id="s-h">Six jobs, done properly, on a schedule you can count on.</h1>
        <p class="fw-lead">Book one, or put the year on a plan and stop thinking about it.</p>
      </div>
      <!-- the crew's price sheet: each service with its season and the lowest a small yard is quoted (the same number
           the estimator starts from), each line a jump to that service below -->
      <nav class="fw-s-sheet" aria-label="Services, with starting prices">
        <ul role="list">
          {serviceList.map((s) => (
            <li><a href={`#${s.id}`}>
              <span class="fw-s-sheet-name">{s.name}</span>
              <span class="fw-s-sheet-price">From {usd(fromPrice(s.id))}<small>{unit[s.unit]}</small></span>
              <span class="fw-s-sheet-when">{s.season}{runs[s.id].includes(now) && <b>, booking now</b>}</span>
            </a></li>
          ))}
        </ul>
        <p class="fw-fine">Starting prices for a small yard. The estimate gives a range for yours.</p>
      </nav>
    </div>
  </section>

  <section class="fw-section fw-s-list" aria-label="All services">
    <div class="fw-wrap">
      {serviceList.map((s) => (
        <article class="fw-s-row" id={s.id} aria-labelledby={`${s.id}-h`}>
          <DemoPhoto name={s.photo} alt={s.alt} sizes="(min-width: 900px) 40vw, calc(100vw - 40px)" />
          <div class="fw-s-body">
            <div class="fw-s-title">
              <h2 id={`${s.id}-h`}>{s.name}</h2>
              <p class="fw-fine">{s.season}</p>
              {runs[s.id].includes(now) && <p class="fw-s-now">Booking now for this winter</p>}
            </div>
            <p class="fw-s-blurb">{s.blurb}</p>
            <ul class="fw-checks" role="list">{s.included.map((x) => <li>{x}</li>)}</ul>
            <p class="fw-s-freq"><span>Booked as</span> {s.freqs.map((f) => FREQUENCIES[f].label.toLowerCase()).join(", ")}</p>
            <div class="fw-s-foot">
              <!-- the price by yard size, drawn with the same yard plots the estimator's size step uses -->
              <div class="fw-s-ladder">
                <p class="fw-fine" id={`${s.id}-sz`}>Starting price {per[s.unit]}, by yard size</p>
                <ul role="list" aria-labelledby={`${s.id}-sz`}>
                  {sizes.map((k) => (
                    <li><span class="fw-s-plot" data-size={k} aria-hidden="true"><i></i></span><span>{SIZES[k].label}</span><b>{usd(fromPrice(s.id, k))}</b></li>
                  ))}
                </ul>
              </div>
              <a class="fw-btn fw-btn-sm" href={`${base}/quote/?service=${s.id}`}>Estimate {s.short.toLowerCase()}</a>
            </div>
          </div>
        </article>
      ))}
      <p class="fw-demo-note fw-s-note">Example pricing, and AI-generated example photos, for this demonstration.</p>
    </div>
  </section>

  <section class="fw-section fw-s-year" aria-labelledby="y-h">
    <div class="fw-wrap">
      <div class="fw-head">
        <h2 id="y-h">When each service runs.</h2>
        <p class="fw-lead">The crew’s year, so you can book the next job before its season starts.</p>
      </div>
      <div class="fw-cal-scroll" tabindex="0" role="region" aria-label="Service calendar, scrolls sideways on small screens">
        <table class="fw-cal">
          <caption class="sr-only">Months each Fernway service runs</caption>
          <thead><tr><th scope="col">Service</th>{months.map((m, i) => <th scope="col" class:list={{ now: i === now }}><abbr title={monthNames[i]}>{m}</abbr></th>)}</tr></thead>
          <tbody>
            {serviceList.map((s) => (
              <tr>
                <th scope="row">{s.short}</th>
                {months.map((_, i) => runs[s.id].includes(i)
                  ? <td class="on"><span class="sr-only">{monthNames[i]}: yes</span></td>
                  : <td><span class="sr-only">{monthNames[i]}: no</span></td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="fw-section fw-s-faq" aria-labelledby="f-h">
    <div class="fw-wrap fw-s-faq-in">
      <div class="fw-head">
        <h2 id="f-h">Before you book.</h2>
        <p class="fw-lead">Something else? <a class="fw-link" href={`${base}/contact/`}>Send us a message</a>.</p>
      </div>
      <div class="fw-faq">
        {faqs.map(([q, a]) => (
          <details>
            <summary>{q}<svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M10 4v12M4 10h12" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" /></svg></summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="fw-section fw-end">
    <div class="fw-wrap">
      <div class="fw-band">
        <h2>Not sure which you need?</h2>
        <p>Start the estimate with photos and let the crew suggest the right mix.</p>
        <a class="fw-btn fw-btn-lime" href={`${base}/quote/`}>Get my estimate</a>
      </div>
    </div>
  </section>
</Shell>

<style>
  .fw-s-hero { background: var(--fw-cream); padding-bottom: clamp(32px, 5vw, 56px); }
  .fw-s-hero h1 { font-size: clamp(2.25rem, 5.4vw, 4rem); max-width: 18ch; }
  /* the headline left and the price sheet right on wide screens; the sheet under the headline on phones */
  .fw-s-hero-in { display: grid; gap: clamp(24px, 4vw, 40px); }
  @media (min-width: 1000px) { .fw-s-hero-in { grid-template-columns: minmax(0, 1fr) minmax(0, 500px); align-items: center; column-gap: clamp(40px, 5vw, 72px); } }
  .fw-s-hero-in .fw-head { margin-bottom: 0; }
  .fw-s-sheet { display: grid; gap: 10px; }
  .fw-s-sheet ul { margin: 0; padding: 0; list-style: none; overflow: hidden; border-radius: var(--fw-radius); background: #fff; box-shadow: 0 0 0 1px var(--fw-line); }
  .fw-s-sheet li + li { border-top: 1px solid var(--fw-line); }
  .fw-s-sheet a { display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: "name price" "when price"; align-items: center; gap: 2px 16px; min-height: 60px; padding: 10px 20px; color: var(--fw-ink); text-decoration: none; transition: background-color 160ms ease-out; }
  .fw-s-sheet a:hover { background: var(--fw-paper); }
  .fw-s-sheet a:hover .fw-s-sheet-name { text-decoration: underline 1.5px var(--fw-moss); text-underline-offset: 4px; }
  .fw-s-sheet a:focus-visible { outline: 3px solid var(--fw-moss); outline-offset: -3px; }
  .fw-s-sheet-name { grid-area: name; font-weight: 650; }
  .fw-s-sheet-when { grid-area: when; color: var(--fw-soft); font-size: 0.875rem; }
  .fw-s-sheet-when b { color: #2c4a66; font-weight: 650; }
  .fw-s-sheet-price { grid-area: price; display: grid; justify-items: end; color: var(--fw-forest); font-weight: 700; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .fw-s-sheet-price small { color: var(--fw-soft); font-size: 0.8125rem; font-weight: 500; }

  /* the catalogue: photo left, details right on wide screens; photo on top on phones. One consistent row so the
     prices and buttons line up for scanning, rows split by a hairline rather than boxed as cards. */
  .fw-s-list { padding-top: clamp(24px, 4vw, 48px); }
  .fw-s-row { display: grid; gap: 20px 48px; padding-block: clamp(28px, 4vw, 48px); border-top: 1px solid var(--fw-line); scroll-margin-top: 88px; }
  .fw-s-row:first-child { border-top: 0; padding-top: 0; }
  .fw-s-row :global(.demo-photo) { aspect-ratio: 3 / 2; border-radius: var(--fw-radius); }
  @media (min-width: 900px) {
    .fw-s-row { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr); align-items: start; }
    .fw-s-row :global(.demo-photo) { aspect-ratio: 4 / 3; position: sticky; top: 104px; }
  }
  .fw-s-body { display: grid; gap: 16px; align-content: start; max-width: 560px; }
  .fw-s-title { display: grid; gap: 4px; }
  .fw-s-title h2 { font-size: clamp(1.625rem, 2.8vw, 2.25rem); }
  .fw-s-now { justify-self: start; margin-top: 6px; padding: 4px 12px; border-radius: 999px; background: #dfe7ef; color: #2c4a66; font-size: 0.875rem; font-weight: 650; }
  .fw-s-blurb { color: var(--fw-soft); font-size: 1.0625rem; }
  .fw-s-freq { font-size: 0.9375rem; }
  .fw-s-freq span { font-weight: 700; color: var(--fw-forest); }
  .fw-s-foot { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 16px; padding-top: 16px; border-top: 1px solid var(--fw-line); }
  .fw-s-ladder { display: grid; gap: 10px; flex: 1 1 250px; max-width: 340px; }
  .fw-s-ladder ul { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin: 0; padding: 0; list-style: none; }
  .fw-s-ladder li { display: grid; gap: 2px; justify-items: start; }
  .fw-s-ladder li > span:not(.fw-s-plot) { color: var(--fw-soft); font-size: 0.875rem; }
  .fw-s-ladder b { color: var(--fw-forest); font-size: 1.125rem; font-weight: 700; font-variant-numeric: tabular-nums; }
  /* a yard plot: the lawn drawn to the size's area on a patch of ground, as on the estimator's size cards */
  .fw-s-plot { display: grid; place-items: end start; width: 48px; height: 32px; margin-bottom: 4px; border-radius: 6px; background: #e6e2cf; overflow: hidden; }
  .fw-s-plot i { display: block; background: var(--fw-moss); border-radius: 3px 3px 0 0; }
  .fw-s-plot[data-size="small"] i { width: 30%; height: 45%; }
  .fw-s-plot[data-size="medium"] i { width: 60%; height: 65%; }
  .fw-s-plot[data-size="large"] i { width: 100%; height: 90%; }
  .fw-s-note { margin-top: 8px; }

  .fw-s-year { background: var(--fw-cream); }
  .fw-cal-scroll { position: relative; overflow-x: auto; border-radius: var(--fw-radius); background: #fff; box-shadow: 0 0 0 1px var(--fw-line); }
  .fw-cal-scroll:focus-visible { outline: 3px solid var(--fw-moss); outline-offset: 3px; }
  .fw-cal { width: 100%; min-width: 620px; border-collapse: separate; border-spacing: 4px; padding: 14px; }
  .fw-cal th { font-size: 0.8125rem; font-weight: 700; color: var(--fw-soft); text-align: center; padding: 6px 0; }
  .fw-cal thead th.now { color: var(--fw-forest); text-decoration: underline 2px var(--fw-lime); text-underline-offset: 5px; }
  .fw-cal abbr { text-decoration: none; }
  .fw-cal tbody th { text-align: left; color: var(--fw-ink); font-size: 0.9375rem; padding-right: 12px; white-space: nowrap; }
  .fw-cal td { height: 34px; border-radius: 8px; background: var(--fw-paper); }
  .fw-cal td.on { background: var(--fw-moss); }
  .fw-cal tr:last-child td.on { background: #5d7f9e; }

  .fw-s-faq-in { display: grid; gap: 32px; }
  @media (min-width: 960px) { .fw-s-faq-in { grid-template-columns: 0.8fr 1.2fr; } }
  .fw-faq { display: grid; gap: 10px; }
  .fw-faq details { border-radius: var(--fw-radius); background: #fff; box-shadow: 0 0 0 1px var(--fw-line); }
  .fw-faq summary { display: flex; justify-content: space-between; align-items: center; gap: 14px; min-height: 60px; padding: 14px 20px; font-weight: 650; cursor: pointer; list-style: none; }
  .fw-faq summary::-webkit-details-marker { display: none; }
  .fw-faq summary:focus-visible { outline: 3px solid var(--fw-moss); outline-offset: 2px; border-radius: var(--fw-radius); }
  .fw-faq summary svg { flex: none; transition: transform 220ms var(--fw-ease); color: var(--fw-moss); }
  .fw-faq details[open] summary svg { transform: rotate(45deg); }
  .fw-faq details p { padding: 0 20px 18px; color: var(--fw-soft); }
  .fw-end { padding-top: 0; }
</style>
