---
// Mossgate estimate (demonstration pricing: lib/demo/mossgate-estimate.ts holds the made-up rules). Home type, rooms,
// floor area, the clean, extras and how often on the left; on the right the same printed receipt as the home page,
// one ingredient a line (receipt()), adding up to the sum the range is built around. The form is a plain GET form to
// the booking page, so "Book this clean" carries the choices even without JavaScript; with it, the page also keeps
// them in its own address so a reload or a shared link reopens the same estimate. Links can pre-fill it
// (?home=house&bed=3 from the home page's receipt).
import Shell from "../../../../components/demo/mossgate/Shell.astro";
import { base } from "../../../../data/demos/mossgate";
import { HOMES, CLEANS, EXTRAS, FREQS, BEDS, BATHS, SQFT_MIN, SQFT_MAX, SQFT_STEP, DEFAULT, estimate, receipt, hoursLabel, priceLabel } from "../../../../lib/demo/mossgate-estimate";
import { range, usd } from "../../../../lib/demo/money";

const e0 = estimate(DEFAULT);
const lines0 = receipt(DEFAULT);
const sum0 = lines0.reduce((t, l) => t + l.amount, 0);
const money = (n: number) => (n < 0 ? `−${usd(-n)}` : usd(n));
const people = (n: number) => (n === 1 ? "1 cleaner" : `${n} cleaners`);
const entries = <T extends string, V>(o: Record<T, V>) => Object.entries(o) as [T, V][];
---
<Shell title="Instant cleaning estimate" current="estimate" description="Try Mossgate's demonstration estimator: home type, bedrooms, bathrooms, floor area, the clean, extras and how often, with every line of the price shown. Fictional company, demonstration pricing only.">
  <section class="mg-section mg-est-sec">
    <div class="mg-wrap mg-est">
      <div class="mg-est-main">
        <div class="mg-head mg-est-head">
          <h1 id="est-h">What will my clean cost?</h1>
          <p class="mg-lead">Tell us about your home. The receipt adds up every line as you choose, so you can see where each dollar comes from.</p>
          <p class="mg-demo-note">Demonstration pricing only. Mossgate is a fictional company.</p>
        </div>

        <form class="mg-est-form" id="est" method="get" action={`${base}/book/`} data-est aria-labelledby="est-h">
          <fieldset class="mg-set">
            <legend>Your home</legend>
            <div class="mg-picks mg-picks-3">
              {entries(HOMES).map(([id, h]) => (
                <label class="mg-pick"><input type="radio" name="home" value={id} checked={id === DEFAULT.home} /><span>{h.name}<small>{h.note}</small></span></label>
              ))}
            </div>
          </fieldset>

          <div class="mg-set-pair">
            <fieldset class="mg-set">
              <legend>Bedrooms</legend>
              <div class="mg-picks mg-picks-n">
                {BEDS.map((n) => <label class="mg-pick"><input type="radio" name="bed" value={n} checked={n === DEFAULT.bed} aria-label={n === 5 ? "5 or more bedrooms" : `${n} bedroom${n > 1 ? "s" : ""}`} /><span class="mg-num">{n === 5 ? "5+" : n}</span></label>)}
              </div>
            </fieldset>
            <fieldset class="mg-set">
              <legend>Bathrooms</legend>
              <div class="mg-picks mg-picks-n">
                {BATHS.map((n) => <label class="mg-pick"><input type="radio" name="bath" value={n} checked={n === DEFAULT.bath} aria-label={n === 4 ? "4 or more bathrooms" : `${n} bathroom${n > 1 ? "s" : ""}`} /><span class="mg-num">{n === 4 ? "4+" : n}</span></label>)}
              </div>
            </fieldset>
          </div>

          <fieldset class="mg-set">
            <legend>Floor area</legend>
            <div class="mg-sqft">
              <input type="range" name="sqft" min={SQFT_MIN} max={SQFT_MAX} step={SQFT_STEP} value={DEFAULT.sqft} aria-label="Floor area in square feet" aria-describedby="sqft-hint" data-sqft />
              <output class="mg-sqft-out mg-num" data-sqft-out aria-hidden="true">{DEFAULT.sqft.toLocaleString("en-US")} sq ft</output>
            </div>
            <p class="mg-fine" id="sqft-hint" data-sqft-hint>A typical size for {DEFAULT.bed} bedrooms. Move it if you know yours.</p>
          </fieldset>

          <fieldset class="mg-set">
            <legend>Kind of clean</legend>
            <div class="mg-picks mg-picks-4">
              {entries(CLEANS).map(([id, c]) => (
                <label class="mg-pick left"><input type="radio" name="clean" value={id} checked={id === DEFAULT.clean} /><span>{c.name}<small>{c.note}</small></span></label>
              ))}
            </div>
          </fieldset>

          <fieldset class="mg-set">
            <legend>Extras <span class="mg-legend-sub">optional</span></legend>
            <div class="mg-picks mg-picks-x">
              {entries(EXTRAS).map(([id, x]) => (
                <label class="mg-pick left mg-extra">
                  <input type="checkbox" name="extras" value={id} data-extra />
                  <span><span class="mg-extra-row">{x.name}<b class="mg-num" data-extra-add>+{usd(x.add)}</b></span><small data-extra-note>{x.note}</small></span>
                </label>
              ))}
            </div>
          </fieldset>

          <fieldset class="mg-set">
            <legend>How often</legend>
            <div class="mg-picks mg-picks-4">
              {entries(FREQS).map(([id, f]) => (
                <label class="mg-pick"><input type="radio" name="freq" value={id} checked={id === DEFAULT.freq} /><span>{f.name}<small>{f.note || "No plan"}</small></span></label>
              ))}
            </div>
            <p class="mg-est-note" data-freq-note hidden>Repeat plans are for standard cleans. Most homes start with one deep clean, then switch to a plan.</p>
          </fieldset>
        </form>
      </div>

      <aside class="mg-est-out" aria-labelledby="out-h" data-out>
        <div class="mg-receipt-wrap">
          <div class="mg-receipt mg-est-rc">
            <div class="mg-rc-top">
              <h2 id="out-h">Your price, added up</h2>
              <p>Mossgate Home Cleaning estimate</p>
            </div>
            <div class="mg-rc-sum-wrap">
              <dl class="mg-rc-lines" data-lines>
                {lines0.map((l) => <div class:list={{ neg: l.amount < 0 }}><dt>{l.label}</dt><dd>{money(l.amount)}</dd></div>)}
              </dl>
              <p class="mg-rc-sum"><span data-sum-label>{priceLabel(DEFAULT.freq)}</span><span data-sum>{usd(sum0)}</span></p>
              <p class="mg-rc-total" aria-live="polite" aria-atomic="true"><span>Estimated range</span><strong data-range>{range(e0.low, e0.high)}</strong></p>
            </div>
            <p class="mg-rc-meta" data-meta>{people(e0.crew)}, about {hoursLabel(e0.hours)} on site.</p>
            <p class="mg-est-note" data-morning hidden>A clean this long starts in a morning window, so it finishes the same day.</p>
            <p class="mg-rc-why">The range runs from 8% under that sum to 10% over, rounded to $5, because no home is priced to the dollar unseen.</p>
            <div class="mg-rc-btns">
              <button class="mg-btn" type="submit" form="est">Book this clean</button>
            </div>
            <p class="mg-rc-demo">Demonstration pricing only. A real company would confirm the price before the first clean.</p>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <div class="mg-est-bar" data-bar aria-hidden="true" hidden>
    <span><strong class="mg-num" data-bar-range>{range(e0.low, e0.high)}</strong><small>demo price, per clean</small></span>
    <button class="mg-btn mg-btn-sm" type="submit" form="est" tabindex="-1">Book this clean</button>
  </div>
</Shell>

<style>
  .mg-est-sec { padding-top: clamp(40px, 6vw, 80px); }
  .mg-est-head { margin-bottom: clamp(28px, 4vw, 44px); }
  .mg-est-head h1 { max-width: 14ch; }
  .mg-est-rc .mg-rc-sum-wrap { padding-top: 0; border-top: 0; }
  .mg-est { display: grid; gap: 28px; align-items: start; }
  @media (min-width: 1024px) { .mg-est { grid-template-columns: minmax(0, 1fr) 400px; gap: 48px; } }

  /* the questions sit straight on the page, divided by hairlines; the receipt is the only paper object */
  .mg-est-form { display: grid; gap: 0; }
  .mg-set { display: grid; gap: 12px; min-width: 0; margin: 0; padding: 26px 0; border: 0; border-top: 1px solid var(--mg-line); }
  .mg-est-form > .mg-set:first-child { border-top: 0; padding-top: 0; }
  /* floated, the legend is an ordinary first row (not drawn into the top border), so the hairline stays whole */
  .mg-set legend { float: left; width: 100%; margin: 0; padding: 0; font-weight: 620; font-size: 1.125rem; letter-spacing: -0.01em; color: var(--mg-ink); }
  .mg-set-pair { display: grid; border-top: 1px solid var(--mg-line); }
  .mg-set-pair .mg-set { border-top: 0; }
  @media (min-width: 720px) { .mg-set-pair { grid-template-columns: 1.25fr 1fr; gap: 32px; } }
  @media (max-width: 719px) { .mg-set-pair .mg-set + .mg-set { border-top: 1px solid var(--mg-line); } }
  .mg-picks { display: grid; gap: 8px; }
  .mg-picks-3 { grid-template-columns: repeat(auto-fit, minmax(min(100%, 170px), 1fr)); }
  .mg-picks-4 { grid-template-columns: repeat(auto-fit, minmax(min(100%, 140px), 1fr)); }
  .mg-picks-n { grid-template-columns: repeat(auto-fit, minmax(48px, 1fr)); }
  .mg-picks-n .mg-pick > span { font-size: 1.125rem; }
  /* the extras' own styles (.mg-picks-x, .mg-extra) are shared with the booking, in the Shell */

  .mg-sqft { display: grid; grid-template-columns: 1fr auto; gap: 16px; align-items: center; }
  .mg-sqft-out { min-width: 7.5em; padding: 10px 14px; border-radius: 12px; background: var(--mg-sky); font-weight: 650; color: var(--mg-sky-ink); text-align: center; }
  .mg-sqft input { --p: 24%; width: 100%; height: 44px; margin: 0; background: transparent; -webkit-appearance: none; appearance: none; cursor: pointer; }
  .mg-sqft input::-webkit-slider-runnable-track { height: 6px; border-radius: 6px; background: linear-gradient(90deg, var(--mg-cobalt) var(--p), var(--mg-line) var(--p)); }
  .mg-sqft input::-moz-range-track { height: 6px; border-radius: 6px; background: var(--mg-line); }
  .mg-sqft input::-moz-range-progress { height: 6px; border-radius: 6px; background: var(--mg-cobalt); }
  .mg-sqft input::-webkit-slider-thumb { -webkit-appearance: none; width: 28px; height: 28px; margin-top: -11px; border-radius: 50%; background: var(--mg-paper); box-shadow: 0 0 0 3px var(--mg-cobalt), 0 4px 10px rgba(36, 34, 31, 0.2); }
  .mg-sqft input::-moz-range-thumb { width: 24px; height: 24px; border: 3px solid var(--mg-cobalt); border-radius: 50%; background: var(--mg-paper); }
  .mg-sqft input:focus-visible { outline: 3px solid var(--mg-cobalt); outline-offset: 4px; border-radius: 8px; }
  .mg-est-note { padding: 10px 14px; border-radius: 10px; background: var(--mg-linen); font-size: 0.9375rem; color: var(--mg-ink); }

  /* a receipt is a narrow slip of paper: on tablets it keeps that width instead of spanning the page */
  .mg-est-out { display: grid; width: 100%; max-width: 520px; }
  @media (min-width: 1024px) { .mg-est-out { position: sticky; top: 96px; } }
  .mg-est-rc { gap: 18px; }

  /* phones: the range rides along at the foot of the screen while the receipt is out of sight */
  .mg-est-bar { position: fixed; left: 12px; right: 12px; bottom: calc(12px + env(safe-area-inset-bottom)); z-index: 35; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 8px 8px 8px 20px; border-radius: 999px; background: var(--mg-ink); color: var(--mg-paper); box-shadow: 0 16px 36px rgba(36, 34, 31, 0.3); transition: transform 240ms var(--mg-ease), opacity 240ms var(--mg-ease); }
  .mg-est-bar[hidden] { display: flex; transform: translateY(140%); opacity: 0; pointer-events: none; }
  .mg-est-bar span { display: grid; line-height: 1.15; }
  .mg-est-bar strong { font-size: 1.25rem; font-weight: 650; font-variant-numeric: tabular-nums; }
  .mg-est-bar small { font-size: 0.8125rem; color: var(--mg-oat); }
  .mg-est-bar .mg-btn { background: var(--mg-paper); color: var(--mg-ink); }
  @media (min-width: 1024px) { .mg-est-bar, .mg-est-bar[hidden] { display: none; } }
  /* the fixed price bar must not cover the last field or the submit button when they scroll into view */
  @media (max-width: 1023px) { :global(html) { scroll-padding-bottom: calc(88px + env(safe-area-inset-bottom, 0px)); } }
  @media (max-width: 1023px) { .mg-est-sec { padding-bottom: 120px; } }
</style>

<script>
  import { estimate, receipt, normalise, fromQuery, toQuery, hoursLabel, typicalSqft, priceLabel, CLEANS, EXTRAS, DEFAULT, type Choice, type Extra } from "../../../../lib/demo/mossgate-estimate";
  import { range, usd } from "../../../../lib/demo/money";

  const form = document.querySelector<HTMLFormElement>("[data-est]");
  if (form) {
    const $ = <T extends HTMLElement = HTMLElement>(s: string) => document.querySelector<T>(s)!;
    const radios = (n: string) => [...form.querySelectorAll<HTMLInputElement>(`input[name="${n}"]`)];
    const val = (n: string) => radios(n).find((r) => r.checked)?.value;
    const money = (n: number) => (n < 0 ? `−${usd(-n)}` : usd(n));
    const sqft = $<HTMLInputElement>("[data-sqft]"), sqftOut = $("[data-sqft-out]"), sqftHint = $("[data-sqft-hint]");
    const extras = [...form.querySelectorAll<HTMLInputElement>("[data-extra]")];
    const lines = $("[data-lines]"), price = $("[data-range]"), bar = $("[data-bar]"), barRange = $("[data-bar-range]");
    let sqftTouched = false;
    let urlTimer: ReturnType<typeof setTimeout> | undefined;
    // the extras the visitor ticked; an extra the clean includes shows ticked and disabled (so it is neither priced
    // nor submitted twice), and their own choice comes back if they switch to a lighter clean
    const picked = new Set<string>();
    let freqPick: string = DEFAULT.freq; // likewise the plan, kept while a one-off clean is chosen
    let shown = [...lines.children].map((d) => d.textContent);

    const read = (): Choice => normalise({
      home: val("home"), bed: val("bed"), bath: val("bath"), sqft: sqft.value, clean: val("clean"), freq: freqPick,
      extras: [...picked],
    });
    const write = (c: Choice) => {
      for (const [n, v] of [["home", c.home], ["bed", String(c.bed)], ["bath", String(c.bath)], ["clean", c.clean], ["freq", c.freq]] as const) {
        const r = radios(n).find((x) => x.value === v); if (r) r.checked = true;
      }
      sqft.value = String(c.sqft);
      if (c.freq !== "once" || CLEANS[c.clean].repeat) freqPick = c.freq;
      picked.clear();
      for (const x of c.extras) picked.add(x);
    };

    const render = (glint: boolean) => {
      const c = read();
      const inc = CLEANS[c.clean].includes;
      for (const x of extras) {
        const included = inc.includes(x.value as Extra);
        x.disabled = included;
        x.checked = included || picked.has(x.value);
        const box = x.closest("label")!;
        box.querySelector("[data-extra-add]")!.textContent = included ? "Included" : `+${usd(EXTRAS[x.value as Extra].add)}`;
        box.querySelector("[data-extra-note]")!.textContent = included ? `Part of a ${CLEANS[c.clean].name.toLowerCase()} clean` : EXTRAS[x.value as Extra].note;
      }
      const repeat = CLEANS[c.clean].repeat;
      for (const r of radios("freq")) { r.disabled = !repeat && r.value !== "once"; r.checked = r.value === c.freq; }
      $("[data-freq-note]").hidden = repeat;

      const p = (c.sqft - +sqft.min) / (+sqft.max - +sqft.min);
      sqft.style.setProperty("--p", `${p * 100}%`);
      sqftOut.textContent = `${c.sqft.toLocaleString("en-US")} sq ft`;
      sqft.setAttribute("aria-valuetext", sqftOut.textContent);
      sqftHint.textContent = sqftTouched ? "Your floor area. It adds $3 per 100 sq ft before the home type and the clean." : `A typical size for ${c.bed === 5 ? "5 or more" : c.bed} bedroom${c.bed > 1 ? "s" : ""}. Move it if you know yours.`;

      const e = estimate(c), rows = receipt(c);
      const rowEls = rows.map((r) => {
        const d = document.createElement("div"), dt = document.createElement("dt"), dd = document.createElement("dd");
        if (r.amount < 0) d.className = "neg";
        dt.textContent = r.label; dd.textContent = money(r.amount);
        d.append(dt, dd);
        if (glint && !shown.includes(d.textContent)) d.classList.add("is-new");
        return d;
      });
      lines.replaceChildren(...rowEls);
      shown = rowEls.map((d) => d.textContent);
      $("[data-sum]").textContent = usd(rows.reduce((t, r) => t + r.amount, 0));
      $("[data-sum-label]").textContent = priceLabel(c.freq);
      const r = range(e.low, e.high);
      if (price.textContent !== r) price.textContent = r;
      barRange.textContent = r;
      $("[data-meta]").textContent = `${e.crew === 1 ? "1 cleaner" : `${e.crew} cleaners`}, about ${hoursLabel(e.hours)} on site.`;
      $("[data-morning]").hidden = !e.morningOnly;
      // the slider fires many times a second and browsers rate-limit replaceState: write the address once it settles
      clearTimeout(urlTimer);
      urlTimer = setTimeout(() => history.replaceState(history.state, "", `${location.pathname}?${toQuery(c)}`), 250);
    };

    const start = fromQuery(location.search);
    if (start) { sqftTouched = new URLSearchParams(location.search).has("sqft"); write(start); }
    form.addEventListener("change", (ev) => {
      const t = ev.target as HTMLInputElement;
      if (t.name === "bed" && !sqftTouched) sqft.value = String(typicalSqft(+t.value));
      if (t.name === "freq") freqPick = t.value;
      if (t.name === "extras" && !t.disabled) { if (t.checked) picked.add(t.value); else picked.delete(t.value); }
      render(true);
    });
    // the slider changes one line many times a second: no glint while it moves
    sqft.addEventListener("input", () => { sqftTouched = true; render(false); });
    render(false);

    // the price bar on phones shows while the receipt is out of sight
    new IntersectionObserver(([en]) => { bar.hidden = en.isIntersecting; }, { threshold: 0.15 }).observe($("[data-out]"));
  }
</script>
