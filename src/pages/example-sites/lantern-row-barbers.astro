---
// Example website: Lantern Row Barbers, a made-up barber shop (data/demo-sites.ts). Shows a Book now button on every
// screen, services and prices at a glance, a three-step booking widget, hours, walk-in policy and directions, and a
// review request (no reviews are shown: a made-up shop has none). Prices and details are invented for the demonstration.
import DemoSite from "../../layouts/DemoSite.astro";

const phone = "(507) 555-0187";
const menu = [
  { id: "cut", name: "Haircut", note: "Scissor or clipper, wash and style", price: 28, mins: 30 },
  { id: "fade", name: "Skin fade", note: "Blended to the skin, finished with a razor line", price: 32, mins: 40 },
  { id: "beard", name: "Beard trim & shape", note: "Lined, shaped and oiled", price: 18, mins: 20 },
  { id: "shave", name: "Hot towel shave", note: "Two hot towels, straight razor, cold finish", price: 35, mins: 40 },
  { id: "combo", name: "Cut + beard", note: "Any haircut with a beard trim", price: 42, mins: 50 },
  { id: "kids", name: "Kids cut", note: "12 and under", price: 20, mins: 25 },
];
const hours = [["Monday", "Closed"], ["Tuesday", "9 am – 7 pm"], ["Wednesday", "9 am – 7 pm"], ["Thursday", "9 am – 7 pm"], ["Friday", "9 am – 7 pm"], ["Saturday", "8 am – 4 pm"], ["Sunday", "Closed"]];
const times = ["9:00", "9:40", "10:20", "11:00", "11:40", "1:00", "1:40", "2:20", "3:00", "3:40", "4:20", "5:00"];
// a fixed pattern of "already booked" times, so the widget looks like a real day without random numbers
const taken = new Set(["9:40", "11:00", "1:40", "3:00"]);
---
<DemoSite slug="lantern-row-barbers" theme="#141210" description="Lantern Row Barbers is a made-up barber shop: a demonstration website by Nuxy Automation.">
  <header class="top">
    <div class="in top-in">
      <a class="logo" href="#home">
        <svg viewBox="0 0 32 40" width="26" height="32" aria-hidden="true"><path d="M10 6h12M12 6V3h8v3M8 10h16l-2 22H10Z" fill="none" stroke="#c9a45c" stroke-width="2" stroke-linejoin="round" /><path d="M16 15c3 4 3 8 0 11-3-3-3-7 0-11Z" fill="#c9a45c" /><path d="M10 36h12" stroke="#c9a45c" stroke-width="2" stroke-linecap="round" /></svg>
        <span><b>Lantern Row</b> <small>Barbers</small></span>
      </a>
      <nav class="nav" aria-label="Main">
        <a href="#services">Services</a>
        <a href="#visit">Hours &amp; visit</a>
      </nav>
      <a class="btn small" href="#book">Book now</a>
    </div>
  </header>

  <main id="home">
    <section class="hero">
      <div class="in hero-in">
        <div class="hero-copy">
          <p class="kicker">Barber shop · Three chairs</p>
          <h1>Classic cuts.<br /> Booked in <span class="nowrap">thirty seconds.</span></h1>
          <p class="hero-lead">Pick your time online, day or night, and skip the phone tag. Walk-ins are welcome whenever a chair is free.</p>
          <div class="hero-btns">
            <a class="btn" href="#book">Book now</a>
            <a class="btn line" href="#services">See prices</a>
          </div>
          <ul class="hero-facts" role="list">
            <li><b>Tue–Fri</b> 9–7</li>
            <li><b>Sat</b> 8–4</li>
            <li><b>Walk-ins</b> until 4 pm</li>
          </ul>
        </div>
        <svg class="hero-art" viewBox="0 0 440 440" role="img" aria-label="Illustration of a barber chair under a hanging lantern">
          <rect width="440" height="440" rx="220" fill="#1e1b17" />
          <circle cx="220" cy="220" r="186" fill="none" stroke="#3a3328" stroke-width="2" />
          <path d="M220 34v58" stroke="#6b5a3a" stroke-width="3" />
          <path d="M196 92h48l-6 12h-36Z" fill="#c9a45c" /><path d="M200 104h40l-4 58h-32Z" fill="#2a251e" stroke="#c9a45c" stroke-width="3" />
          <path d="M220 118c9 12 9 24 0 34-9-10-9-22 0-34Z" fill="#f2c46b" /><circle cx="220" cy="136" r="48" fill="rgba(242,196,107,.10)" />
          <path d="M204 162h32" stroke="#c9a45c" stroke-width="3" stroke-linecap="round" />
          <rect x="150" y="214" width="140" height="40" rx="14" fill="#8a2f2a" /><rect x="160" y="168" width="120" height="56" rx="18" fill="#a3382f" />
          <rect x="138" y="250" width="164" height="44" rx="16" fill="#a3382f" /><rect x="128" y="236" width="22" height="58" rx="10" fill="#8a2f2a" /><rect x="290" y="236" width="22" height="58" rx="10" fill="#8a2f2a" />
          <rect x="210" y="294" width="20" height="62" fill="#9c9387" /><path d="M162 368h116l-14-12h-88Z" fill="#c9a45c" />
          <path d="M150 312h28v12h-28z" fill="#c9a45c" />
        </svg>
      </div>
    </section>

    <section class="block" id="services" aria-labelledby="services-h">
      <div class="in">
        <p class="kicker">Services</p>
        <h2 id="services-h">Prices, plainly</h2>
        <ul class="menu" role="list">
          {menu.map((m) => (
            <li>
              <div class="menu-line"><h3>{m.name}</h3><span class="dots" aria-hidden="true"></span><span class="menu-price">${m.price}</span></div>
              <p>{m.note} · {m.mins} min</p>
              <a class="menu-book" href="#book" data-pick={m.id}>Book {m.name.toLowerCase()}<span aria-hidden="true">→</span></a>
            </li>
          ))}
        </ul>
        <p class="menu-note">Card, tap or cash. No booking fee, and you can cancel or move your time from the reminder text.</p>
      </div>
    </section>

    <section class="block book" id="book" aria-labelledby="book-h">
      <div class="in book-in">
        <div class="book-copy">
          <p class="kicker">Book online</p>
          <h2 id="book-h">Pick a service, a day and a time</h2>
          <p>You’ll get a confirmation straight away and a reminder text the day before. Running late? Reply to the text.</p>
        </div>
        <div class="book-card">
          <form method="dialog" data-demo-form="lr-sent" class="form" data-booking>
            <label>Service
              <select name="service" required data-service>
                {menu.map((m) => <option value={m.id}>{m.name} · ${m.price}</option>)}
              </select>
            </label>
            <fieldset>
              <legend>Day</legend>
              <div class="days" data-days>
                {["Tue", "Wed", "Thu", "Fri", "Sat"].map((d, i) => (
                  <label class="pick"><input type="radio" name="day" value={d} required={i === 0} /><span><b>{d}</b></span></label>
                ))}
              </div>
            </fieldset>
            <fieldset>
              <legend>Time</legend>
              <div class="times">
                {times.map((t, i) => (
                  <label class="pick"><input type="radio" name="time" value={t} required={i === 0} disabled={taken.has(t)} /><span>{t}{taken.has(t) && <span class="sr-only"> (booked)</span>}</span></label>
                ))}
              </div>
            </fieldset>
            <div class="row2">
              <label>Your name<input name="name" autocomplete="name" required /></label>
              <label>Mobile number<input name="tel" type="tel" autocomplete="tel" required /><small>For your reminder text</small></label>
            </div>
            <button class="btn wide" type="submit">Book appointment</button>
            <p class="demo-hint">Demo only: nothing is booked.</p>
          </form>
          <div class="demo-sent" id="lr-sent" tabindex="-1" hidden>
            <strong>Demo only — no appointment was booked.</strong>
            <p>On a real Lantern Row website, this would book straight into the shop’s calendar and text you a reminder the day before.</p>
            <button class="btn line" type="button" data-demo-again>Book another</button>
          </div>
        </div>
      </div>
    </section>

    <section class="block" id="visit" aria-labelledby="visit-h">
      <div class="in visit-in">
        <div>
          <p class="kicker">Hours &amp; visit</p>
          <h2 id="visit-h">Find us on Lantern Row</h2>
          <table class="hours">
            <caption class="sr-only">Opening hours</caption>
            <tbody>
              {hours.map(([d, h]) => <tr><th scope="row">{d}</th><td class={h === "Closed" ? "closed" : undefined}>{h}</td></tr>)}
            </tbody>
          </table>
          <p class="walkin"><b>Walk-ins:</b> welcome until 4 pm when a chair is free. Booked clients go first, so booking is the surest way in.</p>
        </div>
        <div class="visit-side">
          <svg class="map" viewBox="0 0 360 240" role="img" aria-label="Map of Lantern Row with the shop marked, parking behind">
            <rect width="360" height="240" rx="18" fill="#26221c" />
            <path d="M0 120h360" stroke="#3a3328" stroke-width="26" /><path d="M200 0v240" stroke="#3a3328" stroke-width="18" />
            <rect x="40" y="40" width="120" height="56" rx="6" fill="#2f2a22" /><rect x="228" y="40" width="96" height="56" rx="6" fill="#2f2a22" /><rect x="40" y="146" width="120" height="60" rx="6" fill="#2f2a22" />
            <rect x="228" y="146" width="96" height="60" rx="6" fill="#34405a" /><text x="276" y="181" text-anchor="middle" font-size="13" font-weight="700" fill="#cbd5e1">P</text>
            <circle cx="120" cy="104" r="12" fill="#c9a45c" /><circle cx="120" cy="104" r="5" fill="#141210" />
            <text x="66" y="72" font-size="12" font-weight="600" fill="#f2eadb">Lantern Row</text>
          </svg>
          <p class="addr">112 Lantern Row · free parking behind the shop</p>
          <div class="visit-btns">
            <a class="btn line" href="#directions" data-demo-action="Demo: on a real site this opens directions in your maps app.">Get directions</a>
            <a class="btn line" href="#call" data-demo-action={`Demo: on a real site this button calls the shop at ${phone}.`}>Call {phone}</a>
          </div>
        </div>
      </div>
    </section>

    <section class="block review" aria-labelledby="review-h">
      <div class="in review-in">
        <div>
          <h2 id="review-h">Had a good cut?</h2>
          <p>A quick review helps a small shop more than you’d think. It takes a minute.</p>
        </div>
        <a class="btn" href="#review" data-demo-action="Demo: on a real site this opens the shop’s review page. A made-up shop has no reviews to show.">Leave a review</a>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="in foot-in">
      <div>
        <p class="foot-name">Lantern Row Barbers</p>
        <p>112 Lantern Row · {phone} · hello@lanternrow.example</p>
      </div>
      <p>Lantern Row Barbers is a fictional business. This is a demonstration website made by <a href="/websites/" target="_top">Nuxy Automation</a>.</p>
    </div>
  </footer>

  <nav aria-label="Quick action"><a class="dock" href="#book">Book now</a></nav>
</DemoSite>

<style>
  :global(body) { background: #141210; color: #f2eadb; }
  .in { width: 100%; max-width: 1120px; margin-inline: auto; padding-inline: clamp(16px, 4vw, 40px); }
  .kicker { color: #c9a45c; font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; }
  h1, h2, h3, .logo b { font-family: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif; font-weight: 600; }
  h2 { margin-top: 10px; font-size: clamp(1.875rem, 1.3rem + 2vw, 2.75rem); line-height: 1.12; }

  .btn { white-space: nowrap; display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 24px; border: 0; border-radius: 6px; background: #c9a45c; color: #141210; font-weight: 700; letter-spacing: 0.02em; text-decoration: none; transition: background 150ms ease-out; }
  .btn:hover { background: #dbb873; }
  .btn.small { min-height: 44px; padding: 0 18px; font-size: 0.9375rem; }
  .btn.wide { width: 100%; }
  .btn.line { background: transparent; color: #f2eadb; box-shadow: inset 0 0 0 1.5px #6b5a3a; }
  .btn.line:hover { box-shadow: inset 0 0 0 1.5px #c9a45c; }

  .top { position: sticky; top: 0; z-index: 20; background: rgba(20, 18, 16, 0.96); border-bottom: 1px solid #2c2720; }
  .top-in { display: flex; align-items: center; gap: 20px; min-height: 66px; }
  .logo { display: flex; align-items: center; gap: 10px; color: inherit; text-decoration: none; margin-right: auto; }
  .logo b { display: block; font-size: 1.25rem; line-height: 1; }
  .logo small { display: block; margin-top: 3px; color: #c9a45c; font-size: 0.6875rem; letter-spacing: 0.3em; text-transform: uppercase; }
  .nav { display: none; gap: 26px; }
  .nav a { color: #d8cfbf; text-decoration: none; font-size: 0.9375rem; }
  .nav a:hover { color: #fff; }
  @media (min-width: 760px) { .nav { display: flex; } }

  .hero { padding-block: clamp(36px, 7vw, 88px); }
  .hero-in { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 880px) { .hero-in { grid-template-columns: 1.15fr 0.85fr; } }
  .nowrap { white-space: nowrap; }
  .hero h1 { margin-top: 14px; font-size: clamp(2.375rem, 1.5rem + 3.6vw, 3.75rem); line-height: 1.06; text-wrap: balance; }
  .hero-lead { margin-top: 18px; max-width: 46ch; color: #d8cfbf; font-size: 1.125rem; }
  .hero-btns { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
  .hero-facts { display: flex; flex-wrap: wrap; gap: 8px 22px; margin-top: 28px; color: #a99f8e; font-size: 0.9375rem; }
  .hero-facts b { color: #f2eadb; font-weight: 600; }
  .hero-art { width: min(100%, 420px); height: auto; justify-self: center; }
  @media (max-width: 879px) { .hero-art { width: min(100%, 280px); } }

  .block { padding-block: clamp(56px, 8vw, 96px); border-top: 1px solid #2c2720; }
  .menu { display: grid; gap: 0 56px; margin-top: 32px; }
  @media (min-width: 820px) { .menu { grid-template-columns: 1fr 1fr; } }
  .menu li { display: grid; gap: 4px; padding-block: 18px; border-bottom: 1px solid #2c2720; }
  .menu-line { display: flex; align-items: baseline; gap: 10px; }
  .menu h3 { font-size: 1.25rem; }
  .dots { flex: 1; border-bottom: 2px dotted #4a4135; transform: translateY(-4px); }
  .menu-price { color: #c9a45c; font-size: 1.25rem; font-weight: 700; }
  .menu p { color: #a99f8e; font-size: 0.9375rem; }
  .menu-book { justify-self: start; min-height: 32px; display: inline-flex; align-items: center; gap: 5px; color: #dbb873; font-size: 0.875rem; font-weight: 600; text-underline-offset: 3px; }
  .menu-note { margin-top: 24px; color: #a99f8e; }

  .book { background: #1b1814; }
  .book-in { display: grid; gap: 36px; align-items: start; }
  @media (min-width: 900px) { .book-in { grid-template-columns: 0.8fr 1.2fr; } }
  .book-copy p { margin-top: 14px; color: #d8cfbf; max-width: 40ch; }
  .book-card { padding: clamp(20px, 3vw, 32px); border-radius: 12px; background: #221e19; border: 1px solid #3a3328; }
  .form { display: grid; gap: 18px; }
  .form > label, .row2 label, .form legend { display: grid; gap: 6px; color: #f2eadb; font-weight: 600; font-size: 0.9375rem; }
  .form legend { margin-bottom: 8px; }
  .row2 { display: grid; gap: 16px; }
  @media (min-width: 560px) { .row2 { grid-template-columns: 1fr 1fr; } }
  .form input:not([type="radio"]), .form select { width: 100%; min-height: 46px; padding: 10px 12px; border: 1px solid #4a4135; border-radius: 6px; background: #141210; color: #f2eadb; font-weight: 400; }
  .form input:focus, .form select:focus { border-color: #c9a45c; outline: 3px solid rgba(201, 164, 92, 0.35); outline-offset: 0; }
  .form small { color: #a99f8e; font-weight: 400; font-size: 0.8125rem; }
  .days, .times { display: grid; gap: 8px; }
  .days { grid-template-columns: repeat(5, minmax(0, 1fr)); }
  .times { grid-template-columns: repeat(auto-fill, minmax(76px, 1fr)); }
  .pick { position: relative; display: block; }
  .pick input { position: absolute; inset: 0; opacity: 0; margin: 0; }
  .pick > span { display: grid; place-items: center; gap: 2px; min-height: 44px; padding: 6px 4px; border: 1px solid #4a4135; border-radius: 6px; background: #141210; font-size: 0.9375rem; text-align: center; }
  .days .pick > span { min-height: 60px; }
  .pick :global(small) { color: #a99f8e; font-size: 0.8125rem; font-weight: 400; }
  .pick input:checked + span { border-color: #c9a45c; background: #c9a45c; color: #141210; }
  .pick input:checked + span :global(small) { color: #3a3328; }
  .pick input:disabled + span { border-style: dashed; color: #6b6255; text-decoration: line-through; }
  .pick input:focus-visible + span { outline: 3px solid #7cb3ff; outline-offset: 2px; }
  .demo-hint { color: #a99f8e; font-size: 0.8125rem; text-align: center; }
  .book-card :global(.demo-sent) { color: #dbb873; }
  .book-card :global(.demo-sent p) { color: #d8cfbf; }
  .book-card :global(.demo-sent .btn) { justify-self: start; }

  .visit-in { display: grid; gap: 40px; align-items: start; }
  @media (min-width: 880px) { .visit-in { grid-template-columns: 1fr 1fr; } }
  .hours { width: 100%; max-width: 420px; margin-top: 24px; border-collapse: collapse; }
  .hours th, .hours td { padding: 10px 0; border-bottom: 1px solid #2c2720; text-align: left; font-weight: 400; }
  .hours th { color: #d8cfbf; }
  .hours td { text-align: right; color: #f2eadb; font-weight: 600; }
  .hours td.closed { color: #8f8574; font-weight: 400; }
  .walkin { margin-top: 20px; max-width: 46ch; color: #d8cfbf; }
  .walkin b { color: #f2eadb; }
  .map { width: 100%; height: auto; }
  .addr { margin-top: 14px; color: #d8cfbf; }
  .visit-btns { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 16px; }

  .review { background: #1b1814; }
  .review-in { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px 32px; }
  .review h2 { margin-top: 0; }
  .review p { margin-top: 8px; color: #d8cfbf; }

  .foot { padding-block: 36px 104px; border-top: 1px solid #2c2720; color: #a99f8e; font-size: 0.9375rem; }
  @media (min-width: 720px) { .foot { padding-bottom: 36px; } }
  .foot-in { display: grid; gap: 16px; }
  @media (min-width: 760px) { .foot-in { grid-template-columns: 1fr 1fr; align-items: end; } }
  .foot-name { color: #f2eadb; font-weight: 700; }
  .foot a { color: #dbb873; }

  .dock { position: fixed; inset: auto 12px calc(12px + env(safe-area-inset-bottom)); z-index: 30; display: grid; place-items: center; min-height: 52px; border-radius: 8px; background: #c9a45c; color: #141210; font-weight: 700; letter-spacing: 0.02em; text-decoration: none; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45); }
  @media (min-width: 720px) { .dock { display: none; } }
</style>

<script>
  // The next five open days (closed Sunday and Monday), starting tomorrow, so the widget never offers a date or a
  // time that has already passed.
  const box = document.querySelector<HTMLElement>("[data-days]");
  if (box) {
    const fmt = (d: Date, o: Intl.DateTimeFormatOptions) => d.toLocaleDateString("en-US", o);
    const days: Date[] = [];
    const d = new Date();
    d.setDate(d.getDate() + 1); // by calendar day, so a daylight-saving change can't land it on today
    for (; days.length < 5; d.setDate(d.getDate() + 1)) if (d.getDay() > 1) days.push(new Date(d));
    box.querySelectorAll("label").forEach((label, i) => {
      const input = label.querySelector("input")!;
      input.value = days[i].toDateString();
      label.querySelector("span")!.innerHTML = `<b>${fmt(days[i], { weekday: "short" })}</b><small>${fmt(days[i], { month: "short", day: "numeric" })}</small>`;
    });
  }
  // "Book haircut" links pick that service in the widget.
  const select = document.querySelector<HTMLSelectElement>("[data-service]");
  document.querySelectorAll<HTMLAnchorElement>("[data-pick]").forEach((a) =>
    a.addEventListener("click", () => { if (select) select.value = a.dataset.pick!; }),
  );
</script>
