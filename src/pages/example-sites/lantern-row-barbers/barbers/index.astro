---
// Lantern Row's three barbers (all fictional): what each is known for, a photo of their signature style from the
// style book, today's board and a "Book with" link that opens the booking with that barber chosen.
import Shell from "../../../../components/demo/lantern/Shell.astro";
import DemoPhoto from "../../../../components/demo/DemoPhoto.astro";
import { base, barbers, board, gallery, slotLabel } from "../../../../data/demos/lantern";

// each barber's signature is a style-book entry that has a photo
const signature = { marcus: "drop-fade", eli: "crop", julian: "full-beard" } as const;
---
<Shell title="The barbers" current="barbers" description="Meet Marcus, Eli and Julian, the three fictional barbers at Lantern Row: their specialties, signature styles and today's open chairs, with booking.">
  <section class="lr-section lr-team-top">
    <div class="lr-wrap">
      <div class="lr-head">
        <h1>Three chairs, three sets of hands.</h1>
        <p class="lr-lead">Book the barber who knows your hair, or take whoever is free first. Everyone does every cut on the menu.</p>
      </div>

      <ul class="lr-bios" role="list">
        {barbers.map((b) => {
          const g = gallery.find((x) => x.id === signature[b.id])!;
          const times = board[b.id];
          return (
            <li class="lr-bio" style={`--tone:${b.tone}`} id={b.id}>
              <figure class="lr-bio-art">
                <DemoPhoto name={g.photo!} alt={`${b.name}'s signature style: ${g.name.toLowerCase()}`} sizes="(min-width: 760px) 300px, min(420px, 100vw - 40px)" class="lr-bio-ph" />
                <figcaption>Signature: {g.name.toLowerCase()}</figcaption>
              </figure>
              <div class="lr-bio-copy">
                <p class="lr-bio-chair">Chair {b.chair}, {b.years} years cutting</p>
                <h2>{b.name}</h2>
                <p class="lr-bio-line">{b.line}</p>
                <p class="lr-bio-known">Known for {b.known.toLowerCase()}.</p>
                {/* the board's times open the booking with this barber, the board day and that time already chosen
                    (the same links as the home page's board); the script names the day as the board does */}
                {times.length
                  ? <p class="lr-bio-today"><span data-board-day="Available">Available today</span>{times.map((t) => <a class="lr-bio-time" href={`${base}/booking/?barber=${b.id}&day=0&time=${t}`}>{slotLabel(t)}<span class="sr-only">: book with {b.name}</span></a>)}</p>
                  : <p class="lr-bio-today"><span data-board-day="Fully booked" data-board-end=".">Fully booked today.</span> <a href={`${base}/booking/?barber=${b.id}#waitlist`}>Join the cancellation list</a></p>}
                <a class="lr-btn lr-btn-ox" href={`${base}/booking/?barber=${b.id}`}>Book with {b.name}</a>
              </div>
            </li>
          );
        })}
      </ul>
      <p class="lr-fine">Lantern Row and its barbers are fictional. The board shows demonstration times, and the style photos were generated for this demo.</p>
    </div>
  </section>

  <section class="lr-section lr-rule" aria-labelledby="any-h">
    <div class="lr-wrap">
      <div class="lr-band">
        <h2 id="any-h">No preference? Take the first free chair.</h2>
        <p>“First available” shows every open time across all three chairs.</p>
        <a class="lr-btn lr-btn-ox" href={`${base}/booking/?barber=any`}>Book first available</a>
      </div>
    </div>
  </section>
</Shell>

<style>
  .lr-team-top { padding-top: clamp(40px, 6vw, 80px); }
  .lr-bios { display: grid; margin: 8px 0 28px; border-top: 1px solid var(--lr-line-soft); }
  .lr-bio { display: grid; gap: 24px; padding: clamp(28px, 4vw, 48px) 0; border-bottom: 1px solid var(--lr-line-soft); scroll-margin-top: 96px; }
  .lr-bio-art { display: grid; gap: 10px; width: min(420px, 100%); margin: 0; }
  .lr-bio-art :global(.lr-bio-ph) { aspect-ratio: 4 / 5; border: 1px solid var(--lr-line-soft); }
  .lr-bio-art figcaption { font-size: 0.9375rem; color: var(--lr-mute); }
  .lr-bio-copy { display: grid; gap: 14px; justify-items: start; align-content: center; }
  .lr-bio-chair { font-family: "Bodoni Moda", Georgia, serif; font-size: 1.125rem; color: var(--tone); }
  .lr-bio-copy h2 { font-size: clamp(2.75rem, 6vw, 4.5rem); line-height: 1; color: var(--lr-cream); }
  .lr-bio-line { font-family: "Bodoni Moda", Georgia, serif; font-style: italic; font-size: clamp(1.25rem, 2vw, 1.5rem); color: var(--lr-cream); max-width: 34ch; }
  .lr-bio-known { color: var(--lr-soft); max-width: 52ch; }
  .lr-bio-today { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; color: var(--lr-soft); }
  .lr-bio-today a { display: inline-flex; align-items: center; min-height: 44px; color: var(--lr-brass-2); }
  .lr-bio-today a.lr-bio-time { display: inline-flex; align-items: center; min-height: 44px; padding: 0 14px; border: 1px solid var(--lr-brass); font-family: "Sofia XC", "Arial Narrow", sans-serif; font-weight: 700; font-size: 1.25rem; letter-spacing: 0.03em; font-variant-numeric: tabular-nums; text-decoration: none; transition: background-color 160ms ease-out, color 160ms ease-out; }
  .lr-bio-today a.lr-bio-time:hover { background: var(--lr-brass); color: var(--lr-ink); }
  .lr-bio .lr-btn { margin-top: 6px; }
  @media (min-width: 760px) {
    .lr-bio { grid-template-columns: 300px minmax(0, 1fr); gap: clamp(32px, 5vw, 72px); align-items: center; }
    .lr-bio-art { width: 100%; }
  }
</style>

<script>
  import { boardDay, dayName } from "../../../../data/demos/lantern";
  // the board's day, named as the home page names it: today until Marcus's 2:30 has gone, then the next open day
  const now = new Date();
  const d = dayName(boardDay(now), now);
  const when = d === "Today" ? "today" : d === "Tomorrow" ? "tomorrow" : d;
  for (const el of document.querySelectorAll<HTMLElement>("[data-board-day]")) el.textContent = `${el.dataset.boardDay} ${when}${el.dataset.boardEnd ?? ""}`;
</script>
