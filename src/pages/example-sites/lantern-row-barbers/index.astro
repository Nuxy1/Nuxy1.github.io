---
// Lantern Row Barbers, home: the shop at dusk with today's board, the menu (each line books that cut; on wide screens
// a photo of the style answers hover and focus), how booking works, the three chairs, a strip of style photos and the
// closing band (book, where to find the shop, whether it is open right now). A fictional shop (data/demos/lantern.ts); the photos were generated for the demo and show no clients.
import Shell from "../../../components/demo/lantern/Shell.astro";
import LanternHero from "../../../components/demo/lantern/LanternHero.astro";
import DemoPhoto from "../../../components/demo/DemoPhoto.astro";
import { base, services, barbers, gallery, address, barberById } from "../../../data/demos/lantern";

const strip = gallery.filter((g) => g.photo);
// the menu's photo at rest is one the style strip further down does not show (the razor still life), so no photo
// appears twice on a first read of the page
const rest = Math.max(0, services.findIndex((s) => !strip.some((g) => g.photo === s.photo)));
const how = [
  { n: "I", title: "Pick a cut and a chair", text: "Five cuts, three barbers, or “first available” if you just want in." },
  { n: "II", title: "Take an open time", text: "Only real open times show, so there is no back-and-forth." },
  { n: "III", title: "Get a reminder", text: "A text the day before with a link to move or cancel. A freed slot goes to the cancellation list." },
];
---
<Shell description="Lantern Row Barbers, a fictional three-chair barber shop: see today's open chairs, the menu and the barbers, and try the demonstration booking.">
  <LanternHero />

  <section class="lr-section" aria-labelledby="menu-h">
    <div class="lr-wrap lm">
      <div class="lm-list">
        <div class="lr-head">
          <h2 id="menu-h">The menu, priced on the wall.</h2>
          <p class="lr-lead">Every cut ends with a hot-lather neck shave. Pick a line to book it.</p>
        </div>
        <ul class="lm-items" role="list">
          {services.map((s) => (
            <li>
              <a class="lm-link" href={`${base}/booking/?service=${s.id}`} data-lm={s.id} data-shows={s.shows}>
                <DemoPhoto name={s.photo} alt="" sizes="76px" class="lm-thumb" />
                <span class="lm-text">
                  <span class="lr-item-line"><span class="lm-name"><span class="sr-only">Book the </span>{s.name}</span><span class="lr-dots" aria-hidden="true"></span><span class="lr-price">${s.price}</span></span>
                  <span class="lm-note">{s.note}. {s.mins} minutes.</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
        <div class="lm-end">
          <a class="lr-link" href={`${base}/services/`}>Full menu and house rules</a>
          <a class="lr-btn lr-btn-ox" href={`${base}/booking/`}>Book a chair</a>
        </div>
      </div>
      <figure class="lm-preview" aria-hidden="true" data-lm-preview>
        <div class="lm-frame">
          {services.map((s, i) => <DemoPhoto name={s.photo} alt="" sizes="(min-width: 1240px) 440px, 36vw" class={`lm-ph${i === rest ? " on" : ""}`} />)}
        </div>
        <figcaption><span data-lm-cap>{services[rest].shows}</span><small>Style photos made for this demo, not clients.</small></figcaption>
      </figure>
    </div>
  </section>

  <section class="lr-section lr-how" aria-labelledby="how-h">
    <div class="lr-wrap">
      <div class="lr-head">
        <h2 id="how-h">Booked before your coffee cools.</h2>
      </div>
      <ol class="lr-how-list" role="list">
        {how.map((h) => (
          <li>
            <span class="lr-how-n" aria-hidden="true">{h.n}</span>
            <h3>{h.title}</h3>
            <p>{h.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="lr-section" aria-labelledby="team-h">
    <div class="lr-wrap">
      <div class="lr-head">
        <h2 id="team-h">Three chairs. Pick yours.</h2>
        <p class="lr-lead">Each barber keeps their own book. No preference? The booking page finds the first open chair.</p>
      </div>
      <ul class="lr-roster" role="list">
        {barbers.map((b) => (
          <li style={`--tone:${b.tone}`}>
            <p class="lr-roster-chair"><small>Chair</small>{b.chair}</p>
            <div class="lr-roster-who">
              <h3>{b.name}</h3>
              <p>{b.years} years cutting</p>
            </div>
            <div class="lr-roster-say">
              <p class="lr-roster-line">{b.line}</p>
              <p>Known for {b.known.toLowerCase()}.</p>
            </div>
            <a class="lr-btn lr-btn-line lr-btn-sm" href={`${base}/booking/?barber=${b.id}`}>Book with {b.name}</a>
          </li>
        ))}
      </ul>
      <p class="lr-roster-more"><a class="lr-link" href={`${base}/barbers/`}>Meet the barbers</a></p>
    </div>
  </section>

  <section class="lr-section lr-styles" aria-labelledby="styles-h">
    <div class="lr-wrap lr-styles-head">
      <div class="lr-head">
        <h2 id="styles-h">Show us, don’t tell us.</h2>
        <p class="lr-lead">Bring a picture, or point at one of these. Each style opens in the style book with the barber who cuts it best.</p>
      </div>
      <a class="lr-link" href={`${base}/gallery/`}>Open the style book</a>
    </div>
    <ul class="lr-strip" role="list">
      {strip.map((g) => (
        <li>
          <a href={`${base}/gallery/?style=${g.style}`}>
            <DemoPhoto name={g.photo!} alt="" sizes="(min-width: 900px) 340px, 72vw" class="lr-strip-ph" />
            <span class="lr-strip-cap"><strong>{g.name}</strong><span>{barberById[g.by].name}’s chair</span></span>
          </a>
        </li>
      ))}
    </ul>
    <p class="lr-wrap lr-strip-note">Style photos were generated for this demonstration. They show no real clients.</p>
  </section>

  <section class="lr-section" aria-labelledby="band-h">
    <div class="lr-wrap">
      <div class="lr-band">
        <h2 id="band-h">See you under the lantern.</h2>
        <p>Choose a cut, a barber and a time. In this demonstration nothing is reserved and nothing is sent.</p>
        <a class="lr-btn lr-btn-ox" href={`${base}/booking/`}>Book a chair</a>
        <dl class="lr-band-facts">
          <div>
            <dt class="lr-label">Find us</dt>
            <dd>{address}, under the brass lantern. Free parking behind the shop off Mill Lane.</dd>
            <dd><a class="lr-link" href={`${base}/contact/`}>Map, hours and directions</a></dd>
          </div>
          <div>
            <dt class="lr-label">Right now</dt>
            <dd class="lr-band-now" data-open-now><span class="lr-band-dot" aria-hidden="true"></span><span data-open-text>Open Tuesday to Saturday from 9:00 am.</span></dd>
          </div>
          <div>
            <dt class="lr-label">Walk-ins</dt>
            <dd>Welcome until 4 pm whenever a chair is free. Booked clients go first.</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>
</Shell>

<style>
  /* menu: a price board; each line books that cut. Phones get a thumbnail per line, wide screens one large photo */
  .lm { display: grid; gap: 56px; }
  .lm-items { border-top: 1px solid var(--lr-line-soft); }
  .lm-link { display: grid; grid-template-columns: 76px minmax(0, 1fr); align-items: center; gap: 18px; padding-block: 18px; border-bottom: 1px solid var(--lr-line-soft); color: inherit; text-decoration: none; }
  .lm-link :global(.lm-thumb) { width: 76px; aspect-ratio: 3 / 4; }
  .lm-text { display: grid; gap: 6px; min-width: 0; }
  .lm-name { font-family: "Bodoni Moda", Georgia, serif; font-size: clamp(1.5rem, 2.3vw, 2rem); font-weight: 500; line-height: 1.1; }
  .lm-note { color: var(--lr-mute); }
  .lm-link .lr-dots { transition: border-color 200ms ease-out; }
  .lm-link .lr-price { transition: color 200ms ease-out; }
  .lm-link:hover .lr-dots, .lm-link:focus-visible .lr-dots, .lm-link.on .lr-dots { border-bottom-color: var(--lr-brass); }
  .lm-link:hover .lr-price, .lm-link:focus-visible .lr-price { color: var(--lr-cream); }
  .lm-end { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; margin-top: 32px; }
  .lm-preview { display: none; }

  @media (min-width: 900px) {
    .lm { grid-template-columns: minmax(0, 1.3fr) minmax(300px, 0.85fr); gap: clamp(48px, 6vw, 96px); align-items: start; }
    .lm-link { grid-template-columns: minmax(0, 1fr); padding-block: 22px; }
    .lm-link :global(.lm-thumb) { display: none; }
    .lm-preview { display: grid; gap: 14px; position: sticky; top: 120px; margin: 0; }
    .lm-frame { position: relative; aspect-ratio: 4 / 5; overflow: hidden; background: var(--lr-panel); border: 1px solid var(--lr-line-soft); }
    .lm-frame :global(.lm-ph) { position: absolute; inset: 0; opacity: 0; transition: opacity 260ms ease-out; }
    .lm-frame :global(.lm-ph.on) { opacity: 1; }
    .lm-preview figcaption { display: grid; gap: 4px; font-family: "Bodoni Moda", Georgia, serif; font-size: 1.125rem; font-style: italic; color: var(--lr-soft); }
    .lm-preview small { font-style: normal; font-size: 0.9375rem; color: var(--lr-mute); }
  }
  @media (prefers-reduced-motion: reduce) { .lm-frame :global(.lm-ph) { transition: none; } }

  .lr-how { background: var(--lr-ink); }
  .lr-how-list { display: grid; gap: 0; border-top: 1px solid var(--lr-line); }
  .lr-how-list li { display: grid; grid-template-columns: 64px minmax(0, 1fr); gap: 6px 20px; padding-block: 24px; border-bottom: 1px solid var(--lr-line-soft); }
  .lr-how-n { grid-row: span 2; font-family: "Bodoni Moda", Georgia, serif; font-size: 2.5rem; line-height: 1; color: var(--lr-brass); }
  .lr-how-list h3 { font-size: 1.625rem; }
  .lr-how-list p { color: var(--lr-soft); max-width: 46ch; }
  @media (min-width: 900px) {
    .lr-how-list { grid-template-columns: repeat(3, 1fr); gap: 48px; border-bottom: 0; }
    .lr-how-list li { grid-template-columns: minmax(0, 1fr); padding-block: 28px 0; border-bottom: 0; }
    .lr-how-n { grid-row: auto; font-size: 3rem; }
  }

  /* the chairs as a roster, one row per barber */
  .lr-roster { border-top: 1px solid var(--lr-line); }
  .lr-roster li { display: grid; grid-template-columns: 64px minmax(0, 1fr); gap: 12px 20px; padding-block: 28px; border-bottom: 1px solid var(--lr-line); }
  .lr-roster-chair { grid-row: span 3; display: grid; justify-items: start; align-content: start; font-family: "Bodoni Moda", Georgia, serif; font-size: 3.5rem; line-height: 0.9; color: var(--tone); }
  .lr-roster-chair small { font-family: "Sofia XC", "Arial Narrow", sans-serif; font-weight: 700; font-size: 1rem; letter-spacing: 0.03em; line-height: 1.4; color: var(--lr-mute); }
  .lr-roster-who h3 { font-size: clamp(1.875rem, 3vw, 2.5rem); }
  .lr-roster-who p { color: var(--lr-soft); }
  .lr-roster-say { display: grid; gap: 4px; }
  .lr-roster-line { font-family: "Bodoni Moda", Georgia, serif; font-size: 1.25rem; font-style: italic; line-height: 1.35; color: var(--lr-cream); }
  .lr-roster-say p:not(.lr-roster-line) { color: var(--lr-soft); }
  .lr-roster .lr-btn { justify-self: start; }
  .lr-roster-more { margin-top: 20px; }
  @media (min-width: 900px) {
    /* fixed outer columns so every row lines up with the one above */
    .lr-roster li { grid-template-columns: 96px minmax(0, 0.8fr) minmax(0, 1.5fr) 12rem; align-items: center; gap: 32px; }
    .lr-roster-chair { grid-row: auto; }
    .lr-roster .lr-btn { justify-self: end; }
  }

  /* style strip: portraits in a scrolling row, every other one dropped a step like prints pinned to a wall */
  .lr-styles { background: var(--lr-ink); overflow: hidden; }
  .lr-styles-head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 8px 24px; margin-bottom: clamp(28px, 4vw, 48px); }
  .lr-styles-head .lr-head { margin-bottom: 0; }
  .lr-strip { --pad: max(20px, (100% - 1240px) / 2); display: grid; grid-auto-flow: column; grid-auto-columns: clamp(220px, 70vw, 300px); gap: 20px; overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; padding: 4px var(--pad) 24px; scroll-padding-inline: var(--pad); scrollbar-width: thin; scrollbar-color: var(--lr-line) transparent; }
  .lr-strip li { scroll-snap-align: start; }
  .lr-strip a { display: grid; gap: 12px; color: inherit; text-decoration: none; }
  .lr-strip a :global(.lr-strip-ph) { aspect-ratio: 3 / 4; border: 1px solid var(--lr-line-soft); transition: border-color 200ms ease-out; }
  .lr-strip a :global(.lr-strip-ph img) { transition: transform 500ms var(--lr-ease); }
  .lr-strip a:hover :global(.lr-strip-ph) { border-color: var(--lr-brass); }
  .lr-strip a:hover :global(.lr-strip-ph img) { transform: scale(1.03); }
  .lr-strip-cap { display: grid; gap: 2px; }
  .lr-strip-cap strong { font-family: "Bodoni Moda", Georgia, serif; font-size: 1.375rem; font-weight: 500; }
  .lr-strip-cap span { color: var(--lr-mute); font-size: 0.9375rem; font-weight: 500; }
  .lr-strip-note { margin-top: 4px; font-size: 0.9375rem; font-weight: 500; color: var(--lr-mute); }
  @media (min-width: 900px) {
    .lr-strip { grid-auto-columns: clamp(240px, 24vw, 320px); gap: 28px; }
    .lr-strip li:nth-child(even) { padding-top: 56px; }
  }
  /* wide screens: all four fit inside the page column, so the strip stops scrolling */
  @media (min-width: 1100px) {
    .lr-strip { grid-auto-flow: row; grid-template-columns: repeat(4, minmax(0, 1fr)); width: min(1240px, 100% - 40px); margin-inline: auto; padding: 4px 0 24px; overflow: visible; }
  }
  @media (prefers-reduced-motion: reduce) { .lr-strip a :global(.lr-strip-ph img) { transition: none; } .lr-strip a:hover :global(.lr-strip-ph img) { transform: none; } }

  /* the closing band also says where the shop is and whether it is open, across its full width under a hairline */
  .lr-band-facts { justify-self: stretch; display: grid; gap: 24px; margin-top: 12px; padding-top: 28px; border-top: 1px solid var(--lr-line); }
  .lr-band-facts div { display: grid; gap: 6px; align-content: start; }
  .lr-band-facts dd { color: var(--lr-soft); max-width: 36ch; text-wrap: pretty; }
  .lr-band-facts dd:has(.lr-link) { margin-top: -6px; }
  .lr-band-facts .lr-band-now { display: flex; align-items: baseline; gap: 10px; color: var(--lr-cream); }
  .lr-band-dot { flex: none; width: 9px; height: 9px; border-radius: 50%; background: var(--lr-mute); transform: translateY(-1px); }
  .lr-band-now.is-open .lr-band-dot { background: #7cc58c; box-shadow: 0 0 0 4px rgba(124, 197, 140, 0.18); }
  @media (min-width: 768px) { .lr-band-facts { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; } }
  @media (min-width: 900px) { .lr-band > .lr-band-facts { grid-column: 1 / -1; grid-row: 5; margin-left: 0; } }
</style>

<script>
  import { hours } from "../../../data/demos/lantern";
  import { openStatus } from "../../../lib/demo/lantern-hours";
  // the menu's photo follows the pointer and the keyboard (wide screens; the figure is hidden on phones)
  const fig = document.querySelector<HTMLElement>("[data-lm-preview]");
  const cap = fig?.querySelector<HTMLElement>("[data-lm-cap]");
  const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-lm]")];
  const photos = fig ? [...fig.querySelectorAll<HTMLElement>(".lm-ph")] : []; // same order as the menu lines
  const show = (a: HTMLAnchorElement) => {
    if (!fig || !cap) return;
    const at = links.indexOf(a);
    photos.forEach((ph, i) => ph.classList.toggle("on", i === at));
    for (const l of links) l.classList.toggle("on", l === a);
    cap.textContent = a.dataset.shows ?? "";
  };
  for (const a of links) {
    a.addEventListener("pointerenter", () => show(a));
    a.addEventListener("focus", () => show(a));
  }
  links[photos.findIndex((ph) => ph.classList.contains("on"))]?.classList.add("on");

  // "Right now" in the closing band, from the visitor's clock (nothing is kept); without JS the weekly line stays
  const now = document.querySelector<HTMLElement>("[data-open-now]");
  if (now) {
    const s = openStatus(hours, new Date());
    now.querySelector("[data-open-text]")!.textContent = s.text;
    now.classList.toggle("is-open", s.open);
  }
</script>
