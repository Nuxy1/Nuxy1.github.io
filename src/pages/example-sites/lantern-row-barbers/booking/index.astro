---
// Lantern Row booking (a demonstration: nothing is reserved, stored or sent). Six steps: cut, barber (or first
// available), day, time, details, review; ends with "Demo appointment created." and what a real build would do next.
// Links can pick ahead: ?service=fade, ?barber=marcus|any, ?day=0 (the board day) and ?time=2:30 (the board's times).
// The days come from the visitor's own clock, so the script labels them; without JavaScript every step shows at once
// with the shop's standard times. Below it, the cancellation list (#waitlist), also a demo that keeps nothing.
import Shell from "../../../../components/demo/lantern/Shell.astro";
import DemoComplete from "../../../../components/demo/DemoComplete.astro";
import { services, barbers, slots, slotLabel, hours } from "../../../../data/demos/lantern";

const steps = ["Cut", "Barber", "Day", "Time", "Details", "Review"];
const flow = [
  { title: "Calendar booking", text: "The time goes into the shop's booking calendar and is blocked for that barber, so nobody else can take it." },
  { title: "Confirmation text", text: "A text confirms the cut, the barber and the time, with a link to move or cancel." },
  { title: "Reminder", text: "A reminder goes out the day before, which cuts no-shows." },
  { title: "Review request", text: "After the visit, a short thank-you asks for a review." },
  { title: "Cancellation list", text: "If anyone cancels, the freed time is offered to the cancellation list first." },
];
const openDays = hours.filter((h) => h.open).map((h) => h.day);
---
<Shell title="Book a chair" current="booking" description="Try the Lantern Row demonstration booking: pick a cut, a barber or first available, a day and an open time. Nothing is reserved or sent.">
  <section class="lr-section lr-b-sec">
    <div class="lr-wrap">
      <div class="lr-head">
        <p class="lr-kicker">Book a chair</p>
        <h1 id="b-h">Book in under a minute.</h1>
        <p class="lr-lead">Pick a cut, a barber and an open time. You pay in the shop.</p>
        <p class="lr-demo-note">Demonstration booking: nothing is reserved, and nothing you type is sent or kept.</p>
      </div>

      <div class="lr-b" data-b-wrap>
        <form class="lr-b-form" method="dialog" data-lr-book aria-labelledby="b-h">
          <ol class="lr-b-prog" data-progress role="list" aria-label="Steps">
            {steps.map((s, i) => <li><button type="button"><span aria-hidden="true">{i + 1}</span>{s}</button></li>)}
          </ol>
          <p class="sr-only" data-step-status aria-live="polite"></p>
          <p class="lr-b-mini" data-b-mini aria-hidden="true"></p>

          <fieldset class="lr-b-step" data-step aria-labelledby="b1-h">
            <h2 id="b1-h" data-step-title>Which cut?</h2>
            <p class="lr-b-hold" data-b-hold hidden></p>
            <div class="lr-b-grid lr-b-svc">
              {services.map((s, i) => (
                <label class="lr-pick">
                  <input type="radio" name="service" value={s.id} required checked={i === 0} data-error="Pick a cut." />
                  <span><span class="lr-b-row"><strong>{s.name}</strong><em>${s.price}</em></span><small>{s.note} · about {s.mins} min</small></span>
                </label>
              ))}
            </div>
            <p class="lr-err" id="b-err-1" data-step-error role="alert"></p>
            <div class="lr-b-nav"><button class="lr-btn" type="button" data-next>Continue</button></div>
          </fieldset>

          <fieldset class="lr-b-step" data-step aria-labelledby="b2-h">
            <h2 id="b2-h" data-step-title>Who would you like?</h2>
            <div class="lr-b-grid lr-b-barbers">
              <label class="lr-pick">
                <input type="radio" name="barber" value="any" required checked data-error="Pick a barber, or “First available”." />
                <span><strong>First available</strong><small>Every open time across all three chairs</small></span>
              </label>
              {barbers.map((b) => (
                <label class="lr-pick" style={`--tone:${b.tone}`}>
                  <input type="radio" name="barber" value={b.id} />
                  <span><span class="lr-b-row"><strong>{b.name}</strong><i class="lr-b-mono" aria-hidden="true">{b.name[0]}</i></span><small>Chair {b.chair} · {b.known}</small></span>
                </label>
              ))}
            </div>
            <p class="lr-err" id="b-err-2" data-step-error role="alert"></p>
            <div class="lr-b-nav"><button class="lr-btn lr-btn-line" type="button" data-back>Back</button><button class="lr-btn" type="button" data-next>Continue</button></div>
          </fieldset>

          <fieldset class="lr-b-step" data-step aria-labelledby="b3-h">
            <h2 id="b3-h" data-step-title>Which day?</h2>
            <div class="lr-b-grid lr-b-days">
              {Array.from({ length: 6 }, (_, i) => (
                <label class="lr-pick">
                  <input type="radio" name="day" value={String(i)} required data-error="Pick a day." />
                  <span><strong data-day-name>{i === 0 ? "First open day" : `Open day ${i + 1}`}</strong><small><span data-day-date></span> <span class="lr-b-count" data-day-count></span></small></span>
                </label>
              ))}
            </div>
            <p class="lr-b-full" data-b-full hidden><span data-b-full-text></span> <a href="#waitlist" data-wl-link>Join the cancellation list</a></p>
            <p class="lr-fine">Open {openDays.join(", ")}. Demonstration calendar: the open times follow a fixed pattern.</p>
            <p class="lr-err" id="b-err-3" data-step-error role="alert"></p>
            <div class="lr-b-nav"><button class="lr-btn lr-btn-line" type="button" data-back>Back</button><button class="lr-btn" type="button" data-next>Continue</button></div>
          </fieldset>

          <fieldset class="lr-b-step" data-step aria-labelledby="b4-h">
            <h2 id="b4-h" data-step-title>What time?</h2>
            <p class="lr-b-sub" data-b-time-sub></p>
            <div class="lr-b-grid lr-b-times" data-b-times>
              {slots.map((t) => (
                <label class="lr-pick"><input type="radio" name="time" value={t} required /><span><strong>{slotLabel(t)}</strong></span></label>
              ))}
            </div>
            <p class="lr-b-full" data-b-none hidden>No open chairs that day. <a href="#waitlist" data-wl-link>Join the cancellation list</a> or go back and pick another day.</p>
            <p class="lr-err" id="b-err-4" data-step-error role="alert"></p>
            <div class="lr-b-nav"><button class="lr-btn lr-btn-line" type="button" data-back>Back</button><button class="lr-btn" type="button" data-next>Continue</button></div>
          </fieldset>

          <fieldset class="lr-b-step" data-step aria-labelledby="b5-h">
            <h2 id="b5-h" data-step-title>Your details</h2>
            <div class="lr-fields">
              <label class="lr-field"><span>First name</span><input name="name" required autocomplete="given-name" maxlength="40" data-error="Add a first name, or press “Use sample details”." /></label>
              <label class="lr-field"><span>Mobile number</span><input name="mobile" type="tel" inputmode="tel" required autocomplete="tel-national" maxlength="20" placeholder="(507) 555-0100" data-error="Add a 10-digit mobile number, or press “Use sample details”." /><small>For the confirmation text. In this demo nothing is sent.</small></label>
            </div>
            <p class="lr-err" id="b-err-5" data-step-error role="alert"></p>
            <div class="lr-b-nav">
              <button class="lr-btn lr-btn-line" type="button" data-back>Back</button>
              <button class="lr-btn lr-btn-line" type="button" data-b-sample>Use sample details</button>
              <button class="lr-btn" type="button" data-next>Review</button>
            </div>
          </fieldset>

          <fieldset class="lr-b-step" data-step aria-labelledby="b6-h">
            <h2 id="b6-h" data-step-title>Check and confirm</h2>
            <dl class="lr-b-review" data-b-review></dl>
            <p class="lr-fine">Pay in the shop. Free to move or cancel up to two hours before.</p>
            <p class="lr-err" id="b-err-6" data-step-error role="alert"></p>
            <div class="lr-b-nav"><button class="lr-btn lr-btn-line" type="button" data-back>Back</button><button class="lr-btn" type="submit">Confirm demo booking</button></div>
          </fieldset>
        </form>

        <aside class="lr-b-side" aria-labelledby="b-side-h">
          <div class="lr-b-ticket">
            <p class="lr-label" id="b-side-h">Your chair</p>
            <dl class="lr-b-sum">
              <div><dt>Cut</dt><dd data-b-sum="service">Classic Cut</dd></div>
              <div><dt>Barber</dt><dd data-b-sum="barber">First available</dd></div>
              <div><dt>Day</dt><dd data-b-sum="day">Not picked</dd></div>
              <div><dt>Time</dt><dd data-b-sum="time">Not picked</dd></div>
            </dl>
            <p class="lr-b-price"><span>Pay in the shop</span><strong data-b-sum="price">${services[0].price}</strong></p>
            <p class="lr-b-disclaim">Demonstration booking: nothing is reserved.</p>
          </div>
        </aside>
      </div>

      <DemoComplete id="b-done" heading="Demo appointment created." lead="Nothing was reserved, saved or sent. Your name and number were cleared from the page." flow={flow} restart="Book another" />
    </div>
  </section>

  <section class="lr-section lr-rule lr-wl" id="waitlist" aria-labelledby="wl-h">
    <div class="lr-wrap lr-wl-in">
      <div class="lr-head">
        <p class="lr-kicker">Fully booked?</p>
        <h2 id="wl-h">Join cancellation list</h2>
        <p class="lr-lead">Tell us who and when. When a matching chair frees up, the list gets a text, first come first served.</p>
        <p class="lr-demo-note">Demonstration form: nothing is saved or sent.</p>
      </div>
      <div>
        <form class="lr-wl-form" method="dialog" data-demo-form="wl-sent" aria-labelledby="wl-h">
          <div class="lr-fields">
            <label class="lr-field"><span>First name</span><input name="wl-name" required autocomplete="given-name" maxlength="40" /></label>
            <label class="lr-field"><span>Mobile number</span><input name="wl-mobile" type="tel" inputmode="tel" required autocomplete="tel-national" maxlength="20" placeholder="(507) 555-0100" /></label>
            <label class="lr-field lr-field-wide"><span>Barber</span>
              <select name="wl-barber" data-wl-barber>
                <option value="any">Any barber</option>
                {barbers.map((b) => <option value={b.id}>{b.name}</option>)}
              </select>
            </label>
          </div>
          <fieldset class="lr-wl-set">
            <legend>Days that work</legend>
            <div class="lr-wl-chips">
              {openDays.map((d) => <label class="lr-pick"><input type="checkbox" name="wl-days" value={d} /><span>{d.slice(0, 3)}</span></label>)}
            </div>
          </fieldset>
          <fieldset class="lr-wl-set">
            <legend>Time of day</legend>
            <div class="lr-wl-chips">
              {["Any time", "Morning", "Afternoon"].map((t, i) => <label class="lr-pick"><input type="radio" name="wl-when" value={t} checked={i === 0} /><span>{t}</span></label>)}
            </div>
          </fieldset>
          <button class="lr-btn" type="submit">Join the list</button>
        </form>
        <div class="lr-wl-sent" id="wl-sent" hidden tabindex="-1" role="status">
          <p class="lr-label">Demo only</p>
          <h3>You're on the list, in this demo.</h3>
          <p>Nothing was saved or sent, and the form has been cleared. On a real build, a cancellation that matches your barber, days and time would text you a link to take the chair.</p>
          <button class="lr-btn lr-btn-line lr-btn-sm" type="button" data-demo-again>Add another</button>
        </div>
      </div>
    </div>
  </section>
</Shell>

<style>
  .lr-b-sec { padding-top: clamp(40px, 6vw, 80px); }
  .lr-b { display: grid; gap: 28px; align-items: start; }
  @media (min-width: 1024px) { .lr-b { grid-template-columns: minmax(0, 1fr) 320px; gap: 40px; } }
  .lr-b-form { container: bform / inline-size; display: grid; gap: 22px; padding: clamp(20px, 4vw, 40px); background: var(--lr-panel); border: 1px solid var(--lr-line-soft); border-top: 2px solid var(--lr-brass); }

  .lr-b-prog { display: none; }
  .lr-b-form.is-stepped .lr-b-prog { display: flex; gap: 4px; margin: -4px -4px 0; padding: 4px; }
  .lr-b-prog li { flex: 1 0 auto; }
  .lr-b-prog button { display: flex; align-items: center; gap: 8px; width: 100%; min-height: 44px; padding: 0 12px; border: 0; border-bottom: 2px solid var(--lr-line); background: transparent; color: var(--lr-mute); font: inherit; font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; white-space: nowrap; cursor: pointer; }
  .lr-b-prog button span { font-family: "Bodoni Moda", Georgia, serif; font-size: 1rem; letter-spacing: 0; text-transform: none; }
  .lr-b-prog button:disabled { cursor: default; }
  .lr-b-prog li:not(.done):not([aria-current]) button:disabled { opacity: 0.55; }
  .lr-b-prog li.done button { color: var(--lr-soft); border-bottom-color: #6b5a3a; }
  .lr-b-prog li.done button:hover { color: var(--lr-cream); }
  .lr-b-prog li[aria-current] button { color: var(--lr-cream); border-bottom-color: var(--lr-brass); opacity: 1; }
  .lr-b-prog li[aria-current] button span { color: var(--lr-brass-2); }
  .lr-b-prog button:focus-visible { outline: 2px solid #8ab4ff; outline-offset: 2px; }
  @container bform (max-width: 719px) { .lr-b-prog button { font-size: 0; gap: 0; justify-content: center; padding: 0; } .lr-b-prog li[aria-current] button { font-size: 0.8125rem; gap: 8px; padding: 0 10px; } .lr-b-prog li { flex: 1 1 36px; } .lr-b-prog li[aria-current] { flex: 0 0 auto; } }
  @container bform (max-width: 299px) { .lr-b-prog li, .lr-b-prog li[aria-current] { flex: 1 1 0; min-width: 0; } .lr-b-prog li[aria-current] button { font-size: 0; gap: 0; padding: 0; } }

  .lr-b-mini { display: none; }
  @media (max-width: 1023px) { .lr-b-form.is-stepped .lr-b-mini:not(:empty) { display: block; padding: 10px 14px; border: 1px solid var(--lr-line); color: var(--lr-soft); font-size: 0.9375rem; } }

  .lr-b-step { display: grid; gap: 16px; border: 0; padding: 0; margin: 0; min-width: 0; }
  .lr-b-step + .lr-b-step { padding-top: 28px; border-top: 1px solid var(--lr-line-soft); }
  .lr-b-form.is-stepped .lr-b-step + .lr-b-step { padding-top: 0; border-top: 0; }
  .lr-b-step h2 { font-size: clamp(1.75rem, 3.4vw, 2.5rem); outline: none; }
  :global(:root[data-tier="1"]) .lr-b-form.is-stepped .lr-b-step:not([hidden]), :global(:root[data-tier="2"]) .lr-b-form.is-stepped .lr-b-step:not([hidden]) { animation: lr-b-in 280ms var(--lr-ease) both; }
  @keyframes lr-b-in { from { opacity: 0; transform: translateY(8px); } }

  .lr-b-grid { display: grid; gap: 10px; }
  .lr-b-svc, .lr-b-barbers { grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); }
  .lr-b-days { grid-template-columns: repeat(auto-fill, minmax(min(100%, 150px), 1fr)); }
  .lr-b-times { grid-template-columns: repeat(auto-fill, minmax(min(100%, 128px), 1fr)); }
  .lr-b-grid .lr-pick > span { padding: 14px 16px; }
  .lr-b-grid strong { font-size: 1.0625rem; color: var(--lr-cream); }
  .lr-b-grid small { color: var(--lr-mute); font-size: 0.875rem; line-height: 1.35; }
  .lr-b-row { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .lr-b-row em { font-style: normal; font-family: "Bodoni Moda", Georgia, serif; font-size: 1.25rem; color: var(--lr-brass-2); }
  .lr-b-mono { display: grid; place-items: center; width: 30px; height: 30px; border: 1px solid var(--tone); border-radius: 50%; color: var(--tone); font-style: normal; font-family: "Bodoni Moda", Georgia, serif; }
  .lr-b-count { color: var(--lr-brass-2); }
  .lr-pick input:disabled + span .lr-b-count, .lr-pick input:disabled + span strong { color: #6f6656; }
  .lr-pick input:disabled + span strong { text-decoration: line-through; text-decoration-thickness: 1px; }
  .lr-b-times .lr-pick > span { justify-items: start; }
  .lr-b-hold, .lr-b-full { padding: 12px 16px; border: 1px dashed var(--lr-brass); color: var(--lr-cream); }
  .lr-b-full a, .lr-b-hold a { color: var(--lr-brass-2); }
  .lr-b-sub { color: var(--lr-soft); }
  .lr-b-sub:empty { display: none; }

  .lr-b-review { display: grid; border-top: 1px solid var(--lr-line); }
  .lr-b-review div { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 16px; padding: 14px 0; border-bottom: 1px solid var(--lr-line-soft); }
  .lr-b-review dt { color: var(--lr-mute); }
  .lr-b-review dd { color: var(--lr-cream); font-weight: 600; text-align: right; }

  .lr-b-nav { display: flex; flex-wrap: wrap; gap: 10px; padding-top: 6px; }
  .lr-b-nav [data-next], .lr-b-nav [type="submit"] { margin-left: auto; }
  @media (max-width: 479px) { .lr-b-nav .lr-btn { flex: 1 1 auto; } .lr-b-nav [type="submit"], .lr-b-nav [data-next] { flex-basis: 100%; } }
  .lr-b-form:not(.is-stepped) .lr-b-nav [data-next], .lr-b-form:not(.is-stepped) .lr-b-nav [data-back] { display: none; }

  .lr-b-side { display: grid; gap: 14px; }
  @media (min-width: 1024px) { .lr-b-side { position: sticky; top: 96px; } }
  .lr-b-ticket { display: grid; gap: 16px; padding: 26px; background: var(--lr-ink); border: 1px solid var(--lr-line); outline: 1px solid var(--lr-line-soft); outline-offset: -8px; }
  .lr-b-sum { display: grid; gap: 10px; }
  .lr-b-sum div { display: flex; justify-content: space-between; gap: 12px; font-size: 0.9375rem; }
  .lr-b-sum dt { color: var(--lr-mute); }
  .lr-b-sum dd { text-align: right; font-weight: 600; color: var(--lr-cream); }
  .lr-b-price { display: flex; justify-content: space-between; align-items: baseline; padding-top: 14px; border-top: 1px solid var(--lr-line); color: var(--lr-soft); }
  .lr-b-price strong { font-family: "Bodoni Moda", Georgia, serif; font-size: 2.25rem; font-weight: 600; color: var(--lr-brass-2); font-variant-numeric: lining-nums; }
  .lr-b-disclaim { font-size: 0.875rem; color: var(--lr-mute); }

  .lr-b-sec :global(.dc) { --dc-bg: #1d1914; --dc-ink: #f3ead8; --dc-soft: #c7bba5; --dc-line: #3a3128; --dc-accent: #c9a45c; --dc-on-accent: #14110e; --dc-panel: #14110e; --dc-radius: 2px; margin-top: 8px; }
  .lr-b-sec :global(.dc h2) { font-family: "Bodoni Moda", Georgia, serif; }

  .lr-wl { background: var(--lr-ink); scroll-margin-top: 80px; }
  .lr-wl-in { display: grid; gap: 32px; align-items: start; }
  @media (min-width: 960px) { .lr-wl-in { grid-template-columns: 1fr 1.2fr; gap: 56px; } }
  .lr-wl-form { display: grid; gap: 20px; padding: clamp(20px, 3vw, 32px); background: var(--lr-panel); border: 1px solid var(--lr-line-soft); }
  .lr-wl-set { display: grid; gap: 10px; border: 0; padding: 0; margin: 0; min-width: 0; }
  .lr-wl-set legend { margin-bottom: 10px; font-weight: 600; font-size: 0.9375rem; }
  .lr-wl-chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .lr-wl-chips .lr-pick > span { min-height: 44px; padding: 10px 16px; }
  .lr-wl-form > .lr-btn { justify-self: start; }
  .lr-wl-sent { display: grid; gap: 12px; justify-items: start; padding: clamp(20px, 3vw, 32px); background: var(--lr-panel); border: 1px solid var(--lr-brass); outline: none; }
  .lr-wl-sent h3 { font-size: 1.75rem; }
  .lr-wl-sent p:not(.lr-label) { color: var(--lr-soft); }
</style>

<script>
  import { stepper, firstInvalid, flag, type Stepper } from "../../../../lib/demo/stepper";
  import { showComplete, onRestart } from "../../../../lib/demo/complete";
  import { slots, openTimes, board, barbers, barberById, serviceById, bookingDays, dayName, slotLabel, type BarberId, type ServiceId } from "../../../../data/demos/lantern";

  const form = document.querySelector<HTMLFormElement>("[data-lr-book]");
  if (form) {
    const $ = <T extends HTMLElement = HTMLElement>(s: string, root: ParentNode = document) => root.querySelector<T>(s)!;
    const now = new Date();
    const days = bookingDays(now);
    const wrap = $("[data-b-wrap]"), done = $("#b-done");
    const radios = (name: string) => [...form.querySelectorAll<HTMLInputElement>(`input[name="${name}"]`)];
    const val = (name: string) => radios(name).find((r) => r.checked)?.value ?? "";
    const mins = (t: string) => { const [h, m] = t.split(":").map(Number); return (h < 9 ? h + 12 : h) * 60 + m; };
    type Slot = { time: string; barber: BarberId | null };

    /** Every time to show for a barber (or "any") on a day: the standard times plus the board's, each with the barber
     *  who has it open (the first free chair, for "any") or null when it is booked. */
    const timesFor = (who: string, day: number): Slot[] => {
      const all = [...new Set([...slots, ...(day === 0 ? Object.values(board).flat() : [])])].sort((a, b) => mins(a) - mins(b));
      const ids = who === "any" ? barbers.map((b) => b.id) : [who as BarberId];
      return all.map((time) => ({ time, barber: ids.find((b) => openTimes(b, day).includes(time)) ?? null }));
    };
    const openCount = (who: string, day: number) => timesFor(who, day).filter((s) => s.barber).length;

    // the days, named from the visitor's own clock
    radios("day").forEach((r, i) => {
      const box = r.closest("label")!;
      $("[data-day-name]", box).textContent = dayName(days[i], now);
      $("[data-day-date]", box).textContent = days[i].toLocaleDateString("en-US", { month: "short", day: "numeric" });
    });

    const fullNote = $("[data-b-full]"), fullText = $("[data-b-full-text]");
    const drawDays = () => {
      const who = val("barber") || "any";
      const full: number[] = [];
      radios("day").forEach((r, i) => {
        const n = openCount(who, i);
        r.disabled = n === 0;
        if (r.disabled) { r.checked = false; full.push(i); }
        $("[data-day-count]", r.closest("label")!).textContent = n ? `· ${n} open` : "· Full";
      });
      fullNote.hidden = !full.length || who === "any";
      if (!fullNote.hidden) fullText.textContent = `${barberById[who as BarberId].name} is fully booked ${full.map((i) => dayName(days[i], now)).join(" and ")}.`;
    };

    const timesBox = $("[data-b-times]"), none = $("[data-b-none]"), timeSub = $("[data-b-time-sub]");
    const drawTimes = () => {
      const who = val("barber") || "any", day = val("day"), keep = val("time");
      timesBox.replaceChildren();
      none.hidden = true;
      if (day === "") { timeSub.textContent = "Pick a day first."; return; }
      timeSub.textContent = `${dayName(days[+day], now, true)}${who === "any" ? ", any barber" : `, with ${barberById[who as BarberId].name}`}.`;
      const list = timesFor(who, +day);
      for (const s of list) {
        const label = document.createElement("label");
        label.className = "lr-pick";
        const input = document.createElement("input");
        input.type = "radio";
        input.name = "time";
        input.required = true;
        input.dataset.error = "Pick a time, or go back and choose another day.";
        input.value = s.barber ? `${s.barber}@${s.time}` : s.time;
        input.disabled = !s.barber;
        input.checked = !!s.barber && input.value === keep;
        const span = document.createElement("span");
        const strong = document.createElement("strong");
        strong.textContent = slotLabel(s.time);
        const small = document.createElement("small");
        small.textContent = !s.barber ? "Booked" : who === "any" ? `with ${barberById[s.barber].name}` : "Open";
        span.append(strong, small);
        label.append(input, span);
        timesBox.append(label);
      }
      none.hidden = list.some((s) => s.barber);
    };

    const pickedTime = () => { const v = val("time"); const [b, t] = v.split("@"); return t ? { barber: b as BarberId, time: t } : null; };
    const sumOut = (k: string) => $(`[data-b-sum="${k}"]`);
    const mini = $("[data-b-mini]"), review = $("[data-b-review]"), hold = $("[data-b-hold]");
    const name = $<HTMLInputElement>("input[name=name]"), mobile = $<HTMLInputElement>("input[name=mobile]");
    const facts = () => {
      const s = serviceById[val("service") as ServiceId];
      const who = val("barber"), day = val("day"), t = pickedTime();
      const barber = t ? barberById[t.barber].name + (who === "any" ? " (first available)" : "") : who && who !== "any" ? barberById[who as BarberId].name : "First available";
      return { s, barber, day: day === "" ? "" : dayName(days[+day], now), longDay: day === "" ? "" : dayName(days[+day], now, true), time: t ? slotLabel(t.time) : "" };
    };
    let steps: Stepper | undefined;
    // 10 digits (an optional leading 1) read back as (507) 555-0100; anything else is shown as typed
    const phoneLabel = (v: string) => {
      const d = v.replace(/\D/g, "").replace(/^1(?=\d{10}$)/, "");
      return d.length === 10 ? `(${d.slice(0, 3)}) ${d.slice(3, 6)}-${d.slice(6)}` : v.trim();
    };
    const sync = () => {
      const f = facts();
      sumOut("service").textContent = f.s?.name ?? "Not picked";
      sumOut("barber").textContent = f.barber;
      sumOut("day").textContent = f.day || "Not picked";
      sumOut("time").textContent = f.time || "Not picked";
      sumOut("price").textContent = f.s ? `$${f.s.price}` : "";
      mini.textContent = [f.s?.name, f.barber, f.day, f.time].filter(Boolean).join(" · ");
      const rows: [string, string][] = [["Cut", f.s ? `${f.s.name}, $${f.s.price}` : ""], ["Barber", f.barber], ["When", f.longDay && f.time ? `${f.longDay} at ${f.time}` : ""], ["Name", name.value.trim()], ["Mobile", phoneLabel(mobile.value)]];
      review.replaceChildren(...rows.map(([k, v]) => {
        const row = document.createElement("div"), dt = document.createElement("dt"), dd = document.createElement("dd");
        dt.textContent = k; dd.textContent = v || "Not given";
        row.append(dt, dd);
        return row;
      }));
    };

    // a 10-digit number (an optional leading 1); the browser's own required check covers an empty field
    const checkMobile = () => { const n = mobile.value.replace(/\D/g, "").replace(/^1(?=\d{10}$)/, "").length; mobile.setCustomValidity(mobile.value && n !== 10 ? "Add a 10-digit mobile number." : ""); };
    mobile.addEventListener("input", checkMobile);

    form.addEventListener("change", (e) => {
      const n = (e.target as HTMLInputElement).name;
      if (n === "barber") { drawDays(); drawTimes(); }
      else if (n === "day") drawTimes();
      sync();
    });
    form.addEventListener("input", sync);

    // links can choose ahead (the board, "Book with Marcus", "Book this"); only values that match a choice are used
    const q = new URLSearchParams(location.search);
    const pick = (n: string, v: string | null, match = (r: HTMLInputElement) => r.value === v) => {
      const r = v ? radios(n).find((x) => !x.disabled && match(x)) : undefined;
      if (r) r.checked = true;
      return !!r;
    };
    const filled = [pick("service", q.get("service")), pick("barber", q.get("barber"))];
    drawDays();
    filled.push(pick("day", q.get("day")));
    drawTimes();
    filled.push(filled[2] && pick("time", q.get("time"), (r) => r.value.endsWith(`@${q.get("time")}`)));
    // open on the first choice still to make; the choices already made after it are passed over on the way
    let start = filled.indexOf(false);
    if (start < 0) start = 4;
    const skip = new Set(filled.flatMap((ok, i) => (ok && i > start ? [i] : [])));
    const t0 = pickedTime();
    if (skip.size && t0) {
      const dn = dayName(days[+val("day")], now);
      const when = dn === "Today" || dn === "Tomorrow" ? dn.toLowerCase() : `on ${dn}`;
      hold.textContent = `${barberById[t0.barber].name} at ${slotLabel(t0.time)} ${when} is picked. Choose a cut and you go straight to your details.`;
      hold.hidden = false;
    }

    let last = 0;
    steps = stepper(form, {
      check: (i) => (i === 3 && !radios("time").some((r) => !r.disabled) ? "No open chairs that day. Go back and pick another day, or join the cancellation list below." : null),
      onStep: (i) => {
        const forward = i > last;
        last = i;
        if (i > 0) hold.hidden = true;
        sync();
        if (forward && skip.delete(i) && steps) steps.go(i + 1);
      },
    });
    sync();
    if (start > 0) { last = start; steps.go(start, false); }

    for (const a of document.querySelectorAll<HTMLAnchorElement>("[data-wl-link]")) a.addEventListener("click", () => {
      const who = val("barber");
      $<HTMLSelectElement>("[data-wl-barber]").value = who && who !== "any" ? who : "any";
    });
    const wlBarber = q.get("barber");
    if (wlBarber && wlBarber in barberById) $<HTMLSelectElement>("[data-wl-barber]").value = wlBarber;

    $("[data-b-sample]").addEventListener("click", () => {
      name.value = "Sam";
      mobile.value = "(507) 555-0100";
      for (const f of [name, mobile]) { f.dispatchEvent(new Event("input", { bubbles: true })); }
      form.querySelector<HTMLButtonElement>("[data-b-sample] ~ [data-next]")!.focus();
    });

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const bad = firstInvalid(form);
      if (bad) {
        steps!.go([...form.querySelectorAll("[data-step]")].findIndex((s) => s.contains(bad)));
        flag(bad);
        return;
      }
      const f = facts();
      showComplete(done, [
        ["Cut", `${f.s.name}, $${f.s.price} (pay in the shop)`],
        ["Barber", f.barber],
        ["When", `${f.longDay} at ${f.time}`],
        ["Name", name.value.trim()],
        ["Confirmation text", "Would go to the number you gave. Nothing was sent."],
      ], [wrap]);
      // nothing personal is kept: the details go as soon as the summary is shown
      name.value = "";
      mobile.value = "";
      sync();
    });

    onRestart(done, () => {
      form.reset();
      wrap.hidden = false;
      skip.clear();
      drawDays();
      drawTimes();
      sync();
      last = 0;
      steps!.go(0);
    });
  }
</script>
