---
// Lantern Row visit page: an illustrated street map (a fictional street), whether the shop is open right now (from
// the visitor's own clock), hours, call and directions (demo actions: nothing dials or opens), walk-ins, parking and
// a review request. A fictional shop.
import Shell from "../../../../components/demo/lantern/Shell.astro";
import { base, address, phone, email, hours, callNote, directionsNote } from "../../../../data/demos/lantern";
---
<Shell title="Visit" current="contact" description="Find Lantern Row Barbers, a fictional shop: an illustrated map, opening hours, parking, walk-ins and how to call or book.">
  <section class="lr-section lr-ct-top">
    <div class="lr-wrap lr-ct">
      <div class="lr-ct-copy">
        <div class="lr-head">
          <p class="lr-kicker">Visit</p>
          <h1>{address}.</h1>
          <p class="lr-lead">Halfway down Lantern Row, under the brass lantern. Free parking behind the shop off Mill Lane.</p>
        </div>
        <p class="lr-ct-now" data-open-now hidden><span class="lr-ct-dot" aria-hidden="true"></span><span data-open-text></span></p>
        <div class="lr-ct-acts">
          <a class="lr-btn" href={`${base}/booking/`}>Book a chair</a>
          <a class="lr-btn lr-btn-line" href="#call" data-demo-action={callNote}>Call {phone}</a>
          <a class="lr-btn lr-btn-line" href="#directions" data-demo-action={directionsNote}>Get directions</a>
        </div>
        <p class="lr-demo-note">Demo: the call and directions buttons explain what they would do; nothing dials or opens.</p>
      </div>

      <figure class="lr-map">
        <svg viewBox="0 0 560 440" role="img" aria-labelledby="map-t" focusable="false">
          <title id="map-t">Illustrated map of the fictional Lantern Row, with the shop halfway along it and parking behind on Mill Lane</title>
          <defs>
            <pattern id="map-hatch" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><path d="M0 0v6" stroke="#2a241d" stroke-width="2" /></pattern>
          </defs>
          <rect width="560" height="440" fill="#1a1612" />
          <!-- blocks -->
          <g fill="#211c16" stroke="#3a3128" stroke-width="1">
            <rect x="24" y="24" width="150" height="120" /><rect x="214" y="24" width="140" height="120" /><rect x="394" y="24" width="142" height="120" />
            <rect x="24" y="214" width="150" height="90" /><rect x="394" y="214" width="142" height="90" />
            <rect x="24" y="344" width="150" height="72" /><rect x="214" y="344" width="140" height="72" /><rect x="394" y="344" width="142" height="72" />
          </g>
          <rect x="214" y="214" width="140" height="90" fill="url(#map-hatch)" stroke="#3a3128" />
          <!-- the river along the top-right corner -->
          <path d="M420 0c-10 40 30 70 70 84s70 30 70 30V0Z" fill="#1f2a2c" opacity="0.9" />
          <!-- streets -->
          <g fill="none" stroke-linecap="square">
            <path d="M0 179H560" stroke="#3a3128" stroke-width="34" />
            <path d="M0 179H560" stroke="#c9a45c" stroke-width="1.5" stroke-dasharray="10 10" opacity="0.6" />
            <path d="M194 0V440M374 0V440" stroke="#2c251e" stroke-width="22" />
            <path d="M0 324H560" stroke="#2c251e" stroke-width="18" />
          </g>
          <!-- parking behind the shop -->
          <g transform="translate(264 248)">
            <rect x="-6" y="-6" width="52" height="40" fill="#14110e" stroke="#8a7d66" />
            <text x="20" y="22" text-anchor="middle" fill="#c7bba5" font-family="Inter, sans-serif" font-size="20" font-weight="700">P</text>
          </g>
          <!-- street names -->
          <g fill="#c7bba5" font-family="Inter, sans-serif" font-size="12" font-weight="600" letter-spacing="2">
            <text x="40" y="183">LANTERN ROW</text>
            <text x="440" y="183">LANTERN ROW</text>
            <text x="40" y="328" font-size="10">MILL LANE</text>
            <text transform="translate(198 120) rotate(-90)" font-size="10">ASH STREET</text>
            <text transform="translate(378 300) rotate(-90)" font-size="10">CANAL ROAD</text>
          </g>
          <!-- the shop -->
          <g class="lr-map-pin" transform="translate(284 162)">
            <circle class="lr-map-ring" r="22" fill="none" stroke="#c9a45c" stroke-width="1.5" />
            <path d="M0 22c-12-16-18-26-18-36a18 18 0 0 1 36 0c0 10-6 20-18 36Z" transform="translate(0 -40)" fill="#c9a45c" stroke="#14110e" stroke-width="2" />
            <path d="M-5 -60h10l2 6v10l-2 4h-10l-2-4v-10Z" fill="#14110e" />
            <circle cx="0" cy="-49" r="3" fill="#f5c46a" />
          </g>
          <g transform="translate(316 120)">
            <rect width="168" height="34" fill="#14110e" stroke="#c9a45c" />
            <text x="12" y="22" fill="#f3ead8" font-family="Bodoni Moda, Georgia, serif" font-size="15" font-weight="600">Lantern Row Barbers</text>
          </g>
          <!-- compass -->
          <g transform="translate(510 390)" fill="none" stroke="#8a7d66" stroke-width="1.2">
            <circle r="18" /><path d="M0 -14 4 0 0 14 -4 0Z" fill="#c9a45c" stroke="none" />
            <text y="-24" text-anchor="middle" fill="#8a7d66" stroke="none" font-family="Inter, sans-serif" font-size="10" font-weight="700">N</text>
          </g>
        </svg>
        <figcaption class="lr-fine">Illustrated map of a fictional street. Not to scale.</figcaption>
      </figure>
    </div>
  </section>

  <section class="lr-section lr-rule" aria-labelledby="hrs-h">
    <div class="lr-wrap lr-ct-info">
      <div>
        <p class="lr-kicker">Hours</p>
        <h2 id="hrs-h">When the chairs are open.</h2>
        <dl class="lr-hours lr-ct-hours" data-hours>{hours.map((h) => <div data-d={h.d}><dt>{h.day}</dt><dd class={h.open ? undefined : "off"}>{h.open ?? "Closed"}</dd></div>)}</dl>
      </div>
      <dl class="lr-ct-facts">
        <div><dt>Walk-ins</dt><dd>Welcome until 4 pm whenever a chair is free. Booked clients go first.</dd></div>
        <div><dt>Parking</dt><dd>Free behind the shop, entrance off Mill Lane. Two-hour street parking on Lantern Row.</dd></div>
        <div><dt>Getting in</dt><dd>Step-free entrance and one chair that lowers for wheelchair transfers.</dd></div>
        <div><dt>Write to us</dt><dd><a href="#email" data-demo-action={`Demo: on a real site this writes to ${email}.`}>{email}</a></dd></div>
      </dl>
    </div>
  </section>

  <section class="lr-section" aria-labelledby="rev-h">
    <div class="lr-wrap">
      <div class="lr-band">
        <p class="lr-kicker">Been in the chair?</p>
        <h2 id="rev-h">Tell the next person.</h2>
        <p>On a real build, a review link goes out by text after each visit. This one explains itself instead.</p>
        <a class="lr-btn" href="#review" data-demo-action="Demo: on a real site this opens the shop's review page. Lantern Row is fictional, so there is nothing to review.">Leave a review</a>
      </div>
    </div>
  </section>
</Shell>

<style>
  .lr-ct-top { padding-top: clamp(40px, 6vw, 80px); }
  .lr-ct { display: grid; gap: clamp(32px, 5vw, 64px); align-items: center; }
  @media (min-width: 960px) { .lr-ct { grid-template-columns: 1fr 1.15fr; } }
  .lr-ct-copy { display: grid; gap: 20px; justify-items: start; }
  .lr-ct-copy .lr-head { margin-bottom: 0; }
  .lr-ct-now { display: inline-flex; align-items: center; gap: 10px; padding: 8px 14px; border: 1px solid var(--lr-line); color: var(--lr-cream); font-weight: 600; }
  .lr-ct-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--lr-mute); }
  .lr-ct-now.is-open .lr-ct-dot { background: #7cc58c; box-shadow: 0 0 0 4px rgba(124, 197, 140, 0.18); }
  .lr-ct-acts { display: flex; flex-wrap: wrap; gap: 10px; }
  @media (max-width: 479px) { .lr-ct-acts .lr-btn { flex: 1 1 100%; } }

  .lr-map { display: grid; gap: 10px; margin: 0; }
  .lr-map svg { display: block; width: 100%; height: auto; border: 1px solid var(--lr-line); }
  :global(:root[data-tier="1"]) .lr-map-ring, :global(:root[data-tier="2"]) .lr-map-ring { transform-box: fill-box; transform-origin: center; animation: lr-ping 2.6s ease-out 4 forwards; }
  @keyframes lr-ping { from { transform: scale(0.6); opacity: 0.9; } to { transform: scale(2.2); opacity: 0; } }

  .lr-ct-info { display: grid; gap: 40px; align-items: start; }
  @media (min-width: 900px) { .lr-ct-info { grid-template-columns: 1fr 1fr; gap: 64px; } }
  .lr-ct-info h2 { margin: 12px 0 24px; }
  .lr-ct-hours div.is-today dt, .lr-ct-hours div.is-today dd { color: var(--lr-brass-2); font-weight: 700; }
  .lr-ct-facts { display: grid; gap: 1px; background: var(--lr-line-soft); border: 1px solid var(--lr-line-soft); }
  .lr-ct-facts div { display: grid; gap: 6px; padding: 22px 24px; background: var(--lr-bg); }
  .lr-ct-facts dt { font-family: "Bodoni Moda", Georgia, serif; font-size: 1.375rem; font-weight: 600; }
  .lr-ct-facts dd { color: var(--lr-soft); }
  .lr-ct-facts a { color: var(--lr-brass-2); }
</style>

<script>
  import { hours } from "../../../../data/demos/lantern";
  // "Open now" from the visitor's clock and the shop's hours (the clock is read, nothing is kept)
  const box = document.querySelector<HTMLElement>("[data-open-now]");
  if (box) {
    const now = new Date();
    const toMin = (s: string) => { const m = /(\d+):(\d+)\s*(am|pm)/.exec(s)!; return ((+m[1] % 12) + (m[3] === "pm" ? 12 : 0)) * 60 + +m[2]; };
    const today = hours.find((h) => h.d === now.getDay())!;
    document.querySelector(`[data-hours] [data-d="${today.d}"]`)?.classList.add("is-today");
    const t = now.getHours() * 60 + now.getMinutes();
    let text = "";
    if (today.open) {
      const [a, b] = today.open.split("–").map((x) => x.trim());
      if (t >= toMin(a) && t < toMin(b)) { text = `Open now, until ${b}`; box.classList.add("is-open"); }
      else if (t < toMin(a)) text = `Closed now. Opens today at ${a}`;
    }
    if (!text) {
      for (let i = 1; i <= 7; i++) {
        const next = hours.find((h) => h.d === (now.getDay() + i) % 7)!;
        if (next.open) { text = `Closed now. Opens ${i === 1 ? "tomorrow" : next.day} at ${next.open.split("–")[0].trim()}`; break; }
      }
    }
    box.querySelector("[data-open-text]")!.textContent = text;
    box.hidden = false;
  }
</script>
