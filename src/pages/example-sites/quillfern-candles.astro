---
// Example store: Quillfern Candle Co., a made-up candle maker (data/demo-sites.ts). Shows a product grid with
// collections and filters, a product page with scent notes, sizes and stock, and a cart that explains shipping and
// pickup before checkout. Built as plain pages to show the design: there is no shop behind it. The cart lives only in
// this page's memory, and checkout is switched off and says so, so nothing can be bought. Products, prices and the
// brand story are invented for the demonstration.
import DemoSite from "../../layouts/DemoSite.astro";

const phone = "(507) 555-0178";
const freeOver = 60;
const shipFee = 8;

type Size = { label: string; price: number; burn: string };
type Product = { id: string; name: string; collection: "everyday" | "seasonal" | "gift"; notes: string[]; includes?: string[]; sizes: Size[]; stock: "in" | "out"; blurb: string; glass: string; label: string };
const jarSizes: Size[] = [
  { label: "8 oz", price: 22, burn: "about 45 hours" },
  { label: "12 oz", price: 30, burn: "about 70 hours" },
];
const products: Product[] = [
  { id: "cedar-smoke", name: "Cedar & Smoke", collection: "everyday", notes: ["Smoked birch", "Cedarwood", "Vanilla bean"], sizes: jarSizes, stock: "in", glass: "#5b4a42", label: "#eadcc5",
    blurb: "Warm and woodsy, for the first cold evenings: like a cabin after the fire has burned down." },
  { id: "linen-line", name: "Linen Line", collection: "everyday", notes: ["Lemon peel", "Line-dried cotton", "White musk"], sizes: jarSizes, stock: "in", glass: "#e4dccf", label: "#a9bfca",
    blurb: "Clean and bright, like sheets brought in from the line on a breezy morning." },
  { id: "prairie-rain", name: "Prairie Rain", collection: "everyday", notes: ["Petrichor", "Sage", "Vetiver"], sizes: jarSizes, stock: "in", glass: "#8fa38c", label: "#f2ead9",
    blurb: "Green and earthy: the fields after a summer storm, with the windows open." },
  { id: "honey-oat", name: "Honey & Oat", collection: "everyday", notes: ["Oat milk", "Wildflower honey", "Beeswax"], sizes: jarSizes, stock: "in", glass: "#d6a35a", label: "#fbf3e3",
    blurb: "Soft and a little sweet, like warm oatmeal with honey on a slow Sunday." },
  { id: "orchard-fig", name: "Orchard Fig", collection: "seasonal", notes: ["Pear", "Fig leaf", "Brown sugar"], sizes: jarSizes, stock: "in", glass: "#7a4f5a", label: "#f1dfd2",
    blurb: "Ripe fruit and green leaves, for the weeks when the orchards are picked." },
  { id: "winter-pine", name: "Winter Pine", collection: "seasonal", notes: ["Orange peel", "Balsam fir", "Clove"], sizes: jarSizes, stock: "out", glass: "#3f5a4b", label: "#efe4cf",
    blurb: "A walk through snowy pines, then home to oranges studded with cloves." },
  { id: "ember-clove", name: "Ember & Clove", collection: "seasonal", notes: ["Cinnamon bark", "Clove", "Amber"], sizes: jarSizes, stock: "in", glass: "#9a4b30", label: "#f6e7d4",
    blurb: "Spiced and glowing, for long dinners and the darkest evenings of the year." },
  { id: "little-trio", name: "The Little Trio", collection: "gift", notes: [], includes: ["Cedar & Smoke", "Linen Line", "Honey & Oat"], sizes: [{ label: "Three 4 oz candles", price: 36, burn: "about 25 hours each" }], stock: "in", glass: "#d6a35a", label: "#fbf3e3",
    blurb: "Three small candles in a gift box with a handwritten card: an easy present, ready to give." },
];
const collections = [
  { id: "all", name: "All" },
  { id: "everyday", name: "Everyday" },
  { id: "seasonal", name: "Seasonal" },
  { id: "gift", name: "Gift sets" },
];
const kindName: Record<string, string> = { everyday: "Everyday candle", seasonal: "Seasonal candle", gift: "Gift set" };
const count = (id: string) => (id === "all" ? products.length : products.filter((p) => p.collection === id).length);
const featured = products[0];
const stockText = (p: Product) => (p.stock === "in" ? "In stock, ready to ship or pick up" : "Sold out for now: the next batch is being poured");

// The jars are drawn here as SVG (no photos, no outside requests), from the same shape at any size.
const r = (n: number) => Math.round(n * 10) / 10;
function jar(x: number, y: number, w: number, h: number, glass: string, label: string, lit = false) {
  const cx = x + w / 2, rim = y + h * 0.12, wax = y + h * 0.19, wick = y + h * 0.1;
  const lx = x + w * 0.16, ly = y + h * 0.44, lw = w * 0.68, lh = h * 0.36;
  const ink = "#3b2b22";
  const flame = (s: number, fill: string) => {
    const fh = h * 0.17 * s, fw = w * 0.1 * s, top = wick - fh;
    return `<path d="M${r(cx)} ${r(top)}C${r(cx + fw)} ${r(top + fh * 0.5)} ${r(cx + fw * 0.8)} ${r(wick)} ${r(cx)} ${r(wick)}C${r(cx - fw * 0.8)} ${r(wick)} ${r(cx - fw)} ${r(top + fh * 0.5)} ${r(cx)} ${r(top)}Z" fill="${fill}"/>`;
  };
  return [
    `<ellipse cx="${r(cx)}" cy="${r(y + h)}" rx="${r(w * 0.56)}" ry="${r(Math.max(3, h * 0.04))}" fill="#2d221c" opacity=".1"/>`,
    `<rect x="${r(x)}" y="${r(rim)}" width="${r(w)}" height="${r(h * 0.88)}" rx="${r(w * 0.16)}" fill="${glass}"/>`,
    `<ellipse cx="${r(cx)}" cy="${r(wax)}" rx="${r(w * 0.42)}" ry="${r(h * 0.045)}" fill="#f6eddd"/>`,
    `<rect x="${r(x + w * 0.07)}" y="${r(y + h * 0.26)}" width="${r(w * 0.06)}" height="${r(h * 0.6)}" rx="${r(w * 0.03)}" fill="#fff" opacity=".26"/>`,
    `<rect x="${r(lx)}" y="${r(ly)}" width="${r(lw)}" height="${r(lh)}" rx="${r(w * 0.04)}" fill="${label}"/>`,
    `<path d="M${r(cx)} ${r(ly + lh * 0.6)}V${r(ly + lh * 0.14)}M${r(cx)} ${r(ly + lh * 0.48)}l${r(-lw * 0.1)} ${r(-lh * 0.12)}M${r(cx)} ${r(ly + lh * 0.48)}l${r(lw * 0.1)} ${r(-lh * 0.12)}M${r(cx)} ${r(ly + lh * 0.32)}l${r(-lw * 0.07)} ${r(-lh * 0.1)}M${r(cx)} ${r(ly + lh * 0.32)}l${r(lw * 0.07)} ${r(-lh * 0.1)}" fill="none" stroke="${ink}" stroke-width="${r(Math.max(1.2, w * 0.018))}" stroke-linecap="round"/>`,
    `<rect x="${r(cx - lw * 0.25)}" y="${r(ly + lh * 0.72)}" width="${r(lw * 0.5)}" height="${r(lh * 0.07)}" rx="1" fill="${ink}" opacity=".6"/>`,
    `<rect x="${r(cx - lw * 0.16)}" y="${r(ly + lh * 0.85)}" width="${r(lw * 0.32)}" height="${r(lh * 0.05)}" rx="1" fill="${ink}" opacity=".35"/>`,
    `<path d="M${r(cx)} ${r(wax)}V${r(wick)}" stroke="#3a2b22" stroke-width="${r(Math.max(1.4, w * 0.025))}" stroke-linecap="round"/>`,
    lit ? `<g class="flame">${flame(1, "#f2a33a")}${flame(0.55, "#ffe3a3")}</g>` : "",
  ].join("");
}
const cardArt = (p: Product) => {
  const inner = p.includes
    ? [jar(22, 64, 50, 76, "#5b4a42", "#eadcc5"), jar(75, 64, 50, 76, "#e4dccf", "#a9bfca"), jar(128, 64, 50, 76, "#d6a35a", "#fbf3e3")].join("")
    : jar(60, 22, 80, 118, p.glass, p.label);
  return `<svg viewBox="0 0 200 160" aria-hidden="true" focusable="false">${inner}</svg>`;
};
// a fern sprig beside the hero jars: leaflets along a curved stem
const stem: [number, number][] = [[63, 300], [60, 283], [56, 266], [51, 250], [45, 235], [39, 222], [33, 211]];
const fern = stem.map(([x, y], i) => {
  const s = 1 - i * 0.09;
  return `<ellipse cx="${x - 12 * s}" cy="${y - 5}" rx="${r(15 * s)}" ry="${r(5 * s)}" transform="rotate(-28 ${x - 12 * s} ${y - 5})" fill="#6f8a6a"/><ellipse cx="${x + 12 * s}" cy="${y - 8}" rx="${r(14 * s)}" ry="${r(5 * s)}" transform="rotate(32 ${x + 12 * s} ${y - 8})" fill="#7f9a78"/>`;
}).join("");
const heroArt = `<svg viewBox="16 56 488 300" role="img" aria-label="Three lit candles in glass jars on a wooden shelf, beside a fern sprig">
  <circle cx="262" cy="200" r="132" fill="#f7d9a8" opacity=".5"/>
  <path d="M66 318C60 282 50 248 30 206" fill="none" stroke="#5f7a5b" stroke-width="3" stroke-linecap="round"/>${fern}
  ${jar(92, 196, 98, 122, "#d6a35a", "#fbf3e3", true)}${jar(198, 150, 128, 168, "#5b4a42", "#eadcc5", true)}${jar(336, 186, 98, 132, "#8fa38c", "#f2ead9", true)}
  <rect x="40" y="318" width="440" height="14" rx="7" fill="#c79a6b"/><rect x="62" y="332" width="396" height="8" rx="4" fill="#2d221c" opacity=".06"/>
</svg>`;

const questions = [
  ["How long does shipping take?", `Orders leave our studio within 2 business days and usually arrive 3 to 5 days later. Shipping is $${shipFee} anywhere in the US, and free on orders over $${freeOver}.`],
  ["How does local pickup work?", "Choose pickup in the cart and we’ll email you when your order is ready, usually the next business day. Pickup is always free."],
  ["How do I get the best burn?", "Let the first burn melt the wax all the way to the edge of the jar, about 2 to 3 hours, and trim the wick to a quarter inch before each light."],
  ["Can I return a candle?", "Unused candles can be sent back within 30 days. If a jar arrives broken, send us a photo and we’ll send a new one."],
];
const data = JSON.stringify(products.map(({ glass, label, ...p }) => p));
---
<DemoSite slug="quillfern-candles" theme="#2d221c" description="Quillfern Candle Co. is a made-up candle maker: a demonstration online store by Nuxy Automation. Nothing can be bought.">
  <header class="top">
    <div class="in top-in">
      <a class="logo" href="#home">
        <svg viewBox="0 0 36 36" width="34" height="34" aria-hidden="true"><rect width="36" height="36" rx="10" fill="#2d221c" /><path d="M12 15h12v11a3 3 0 0 1-3 3h-6a3 3 0 0 1-3-3Z" fill="#eadcc5" /><path d="M18 15v-3" stroke="#eadcc5" stroke-width="1.6" stroke-linecap="round" /><path d="M18 5.5c1.6 1.7 2.2 3 2.2 4a2.2 2.2 0 0 1-4.4 0c0-1 .6-2.3 2.2-4Z" fill="#f2a33a" /></svg>
        <span><b>Quillfern</b> <small>Candle Co.</small></span>
      </a>
      <nav class="nav" aria-label="Main">
        <a href="#shop">Shop</a>
        <a href="#story">Our story</a>
        <a href="#custom">Custom orders</a>
        <a href="#faq">Questions</a>
      </nav>
      <a class="cart-link" href="#cart">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M5 8h14l-1.2 11.1a2 2 0 0 1-2 1.9H8.2a2 2 0 0 1-2-1.9Z M9 8V6.5a3 3 0 0 1 6 0V8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></svg>
        <span>Cart</span> <span class="count" data-cart-count>0</span><span class="sr-only"> items</span>
      </a>
    </div>
  </header>

  <main id="home">
    <section class="hero">
      <div class="in hero-in">
        <div class="hero-copy">
          <p class="kicker">Small-batch soy candles</p>
          <h1>Candles poured by hand, for slow evenings at home.</h1>
          <p class="hero-lead">Soy wax, cotton wicks and scents built from real notes, poured in small batches. Shipped anywhere in the US, or picked up free from our studio.</p>
          <div class="hero-btns">
            <a class="btn" href="#shop">Shop candles</a>
            <a class="btn soft" href="#custom">Custom orders</a>
          </div>
          <ul class="hero-facts" role="list">
            <li>Free shipping over ${freeOver}</li>
            <li>Free local pickup</li>
            <li>Reusable glass jars</li>
          </ul>
        </div>
        <div class="hero-art"><Fragment set:html={heroArt} /></div>
      </div>
    </section>

    <section class="block" id="shop" aria-labelledby="shop-h">
      <div class="in">
        <div class="shop-head">
          <div>
            <p class="kicker">Shop</p>
            <h2 id="shop-h">All candles</h2>
          </div>
          <p class="shown" data-shown aria-live="polite">{products.length} products</p>
        </div>
        <form class="filters" method="dialog" data-filters aria-label="Filter and sort" hidden>
          <fieldset class="chips">
            <legend class="sr-only">Collection</legend>
            {collections.map((c, i) => (
              <label class="chip"><input type="radio" name="collection" value={c.id} checked={i === 0} /><span>{c.name} <small>{count(c.id)}</small></span></label>
            ))}
          </fieldset>
          <div class="filter-row">
            <label class="check"><input type="checkbox" name="instock" /><span>In stock only</span></label>
            <label class="sort">Sort
              <select name="sort">
                <option value="featured">Featured</option>
                <option value="low">Price: low to high</option>
                <option value="high">Price: high to low</option>
              </select>
            </label>
          </div>
        </form>
        <ul class="grid" role="list" data-grid data-products={data}>
          {products.map((p, i) => (
            <li class="card" data-card={p.id} data-collection={p.collection} data-stock={p.stock} data-price={p.sizes[0].price} data-order={i}>
              <span class="card-art"><Fragment set:html={cardArt(p)} />{p.stock === "out" && <span class="badge">Sold out</span>}</span>
              <div class="card-body">
                <span class="card-kind">{kindName[p.collection]}</span>
                <h3 class="card-name"><a href="#product" data-pick={p.id}>{p.name}</a></h3>
                <span class="card-notes">{(p.includes ?? p.notes).join(" · ")}</span>
                <span class="card-price">{p.sizes.length > 1 ? `From $${p.sizes[0].price}` : `$${p.sizes[0].price}`}</span>
              </div>
            </li>
          ))}
        </ul>
        <div class="empty" data-empty hidden>
          <p>Nothing matches those filters.</p>
          <button class="btn soft small" type="button">Show everything</button>
        </div>
      </div>
    </section>

    <section class="block alt" id="product" aria-labelledby="product-h">
      <div class="in product-in" data-detail={featured.id}>
        <div class="product-art" data-p-art><Fragment set:html={cardArt(featured)} /></div>
        <div class="product-copy">
          <p class="kicker" data-p-kicker>{kindName[featured.collection]}</p>
          <h2 id="product-h" tabindex="-1" data-p-name>{featured.name}</h2>
          <p class="product-blurb" data-p-blurb>{featured.blurb}</p>
          <dl class="notes" data-p-notes>
            {featured.includes
              ? <div><dt>Inside</dt><dd>{featured.includes.join(", ")}</dd></div>
              : ["Top", "Heart", "Base"].map((t, i) => <div><dt>{t}</dt><dd>{featured.notes[i]}</dd></div>)}
          </dl>
          <form class="buy" method="dialog" data-buy>
            <fieldset>
              <legend>Size</legend>
              <div class="sizes" data-p-sizes>
                {featured.sizes.map((s, i) => (
                  <label class="size"><input type="radio" name="size" value={i} checked={i === 0} /><span class="size-name"><b>{s.label}</b><small>{s.burn}</small></span><span class="size-price">${s.price}</span></label>
                ))}
              </div>
            </fieldset>
            <div class="buy-row">
              <label class="qty">Quantity<input type="number" name="qty" value="1" min="1" max="9" inputmode="numeric" /></label>
              <button class="btn" type="submit" data-add disabled={featured.stock !== "in"}>{featured.stock === "in" ? "Add to cart" : "Sold out"}</button>
            </div>
            <p class:list={["stock", { out: featured.stock !== "in" }]} data-p-stock>{stockText(featured)}</p>
            <p class="added"><span role="status" data-added></span> <a href="#cart" data-added-link hidden>View cart</a></p>
          </form>
        </div>
      </div>
    </section>

    <section class="block" id="cart" aria-labelledby="cart-h">
      <div class="in cart-in">
        <div class="cart-main">
          <p class="kicker">Your cart</p>
          <h2 id="cart-h">Cart</h2>
          <p class="cart-empty" data-cart-empty>Your cart is empty. <a href="#shop">Browse the candles</a></p>
          <ul class="lines" role="list" data-cart-lines hidden></ul>
          <div class="ways">
            <h3>How you’ll get it</h3>
            <p><b>Shipping:</b> ${shipFee} anywhere in the US, free on orders over ${freeOver}. Orders leave the studio within 2 business days.</p>
            <p><b>Local pickup:</b> free. We email you when it’s ready, usually the next business day.</p>
          </div>
        </div>
        <aside class="summary" aria-label="Order summary">
          <form method="dialog" data-delivery>
            <fieldset>
              <legend>Delivery</legend>
              <label class="way"><input type="radio" name="how" value="ship" checked /><span><b>Ship to me</b><small>${shipFee}, free over ${freeOver}</small></span></label>
              <label class="way"><input type="radio" name="how" value="pickup" /><span><b>Pick up at the studio</b><small>Free, usually next business day</small></span></label>
            </fieldset>
          </form>
          <dl class="totals">
            <div><dt>Subtotal</dt><dd data-subtotal>$0</dd></div>
            <div><dt>Delivery</dt><dd data-delivery-cost>Free</dd></div>
            <div class="total"><dt>Total</dt><dd data-total>$0</dd></div>
          </dl>
          <p class="ship-note" data-ship-note hidden></p>
          <p class="tax">Sales tax, if any, is added at checkout.</p>
          <div class="checkout-off" role="note">
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><rect x="5" y="10.5" width="14" height="10" rx="2" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M8.5 10.5V8a3.5 3.5 0 0 1 7 0v2.5" fill="none" stroke="currentColor" stroke-width="1.8" /></svg>
            <p><strong>Checkout is switched off.</strong> This is a demonstration store for a made-up business: nothing can be bought, and no payment details are ever asked for.</p>
          </div>
          <button class="btn off wide" type="button" data-demo-action="Demo: checkout is switched off, so nothing can be bought. On a real store, this button opens the platform’s secure checkout.">Checkout switched off (demo)</button>
        </aside>
      </div>
    </section>

    <section class="block alt" id="story" aria-labelledby="story-h">
      <div class="in story-in">
        <div>
          <p class="kicker">Our story</p>
          <h2 id="story-h">Small batches, poured by hand</h2>
          <p class="sub">Quillfern started at a kitchen table with one scent and a market stall. Every candle is still poured by hand, 24 at a time, and cured for two weeks before it’s sold.</p>
        </div>
        <ul class="points" role="list">
          <li><b>Soy wax and cotton wicks</b><span>No paraffin, and a clean, even burn.</span></li>
          <li><b>Cured for two weeks</b><span>So the scent fills the room, not just the jar.</span></li>
          <li><b>Jars worth keeping</b><span>Wash one out for a plant, pens or a refill.</span></li>
        </ul>
      </div>
    </section>

    <section class="block" id="custom" aria-labelledby="custom-h">
      <div class="in custom-in">
        <div>
          <p class="kicker">Custom orders</p>
          <h2 id="custom-h">Favors, gifts and your own scent</h2>
          <p class="sub">Wedding favors, client gifts or a scent made for your shop. Tell us what you have in mind and we’ll reply with options and a price.</p>
        </div>
        <div class="form-card">
          <form method="dialog" data-demo-form="qf-sent" class="form">
            <div class="row2">
              <label>Your name<input name="name" autocomplete="name" required /></label>
              <label>Email<input type="email" name="email" autocomplete="email" required /></label>
            </div>
            <label>What’s it for?
              <select name="occasion" required>
                <option value="">Choose one</option>
                <option>Wedding or event favors</option>
                <option>Gifts for clients or staff</option>
                <option>A scent for my shop</option>
                <option>Something else</option>
              </select>
            </label>
            <label><span>About how many? <span class="opt">(optional)</span></span><input name="howmany" inputmode="numeric" /></label>
            <label><span>Tell us more <span class="opt">(optional)</span></span><textarea name="notes" rows="3" placeholder="Date, colors, scents you like…"></textarea></label>
            <button class="btn wide" type="submit">Send my request</button>
            <p class="demo-hint">Demo only: this form sends nothing.</p>
          </form>
          <div class="demo-sent" id="qf-sent" tabindex="-1" hidden>
            <strong>Demo only — nothing was sent.</strong>
            <p>On a real Quillfern store, this request would reach the studio’s inbox, and you’d get a reply with options and a price.</p>
            <button class="btn soft" type="button" data-demo-again>Start again</button>
          </div>
        </div>
      </div>
    </section>

    <section class="block alt" id="faq" aria-labelledby="faq-h">
      <div class="in faq-in">
        <h2 id="faq-h">Questions</h2>
        <div class="faq">
          {questions.map(([q, a]) => (
            <details>
              <summary>{q}</summary>
              <p>{a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="in foot-in">
      <div>
        <p class="foot-name">Quillfern Candle Co.</p>
        <p>Studio pickup Tue–Sat, 10 am – 5 pm · <a href="#call" data-demo-action={`Demo: on a real site this button calls the studio at ${phone}.`}>{phone}</a> · hello@quillfern.example</p>
      </div>
      <p>Quillfern Candle Co. is a fictional business. This is a demonstration store made by <a href="/ecommerce/" target="_top">Nuxy Automation</a>.</p>
    </div>
  </footer>
</DemoSite>

<style>
  :global(body) { background: #fbf7f1; color: #4d3f36; }
  .in { width: 100%; max-width: 1120px; margin-inline: auto; padding-inline: clamp(16px, 4vw, 40px); }
  h1, h2, h3, .logo b { color: #2d221c; font-family: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif; letter-spacing: -0.01em; text-wrap: balance; }
  h2 { margin-top: 6px; font-size: clamp(1.75rem, 1.3rem + 1.8vw, 2.5rem); line-height: 1.15; font-weight: 600; }
  .kicker { color: #a8502f; font-size: 0.8125rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
  .sub { margin-top: 12px; max-width: 52ch; }
  .alt { background: #f3eadf; }
  .block { padding-block: clamp(56px, 8vw, 96px); }

  .btn { white-space: nowrap; display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 24px; border: 0; border-radius: 8px; background: #a8502f; color: #fff; font-weight: 650; text-decoration: none; transition: background 150ms ease-out; }
  .btn:hover { background: #8a3f23; }
  .btn.soft { background: #f3e1d4; color: #7a361d; }
  .btn.soft:hover { background: #ecd2c0; }
  .btn.small { min-height: 44px; padding: 0 18px; font-size: 0.9375rem; }
  .btn.wide { width: 100%; }
