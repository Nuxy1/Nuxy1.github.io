<script>
  // The store's behaviour, all inside this page: filters and sorting, the product view, and a cart kept only in
  // memory. Nothing is saved or sent, and checkout is a demo button (DemoSite.astro shows its note).
  type Size = { label: string; price: number; burn: string };
  type Product = { id: string; name: string; collection: string; notes: string[]; includes?: string[]; sizes: Size[]; stock: "in" | "out"; blurb: string };
  const products: Product[] = JSON.parse(document.querySelector<HTMLElement>("[data-products]")!.dataset.products!);
  const byId = new Map(products.map((p) => [p.id, p]));
  const kindName: Record<string, string> = { everyday: "Everyday candle", seasonal: "Seasonal candle", gift: "Gift set" };
  const money = (n: number) => `$${n}`;
  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?: string) => {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text !== undefined) e.textContent = text;
    return e;
  };
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

  // filters and sorting (the bar stays hidden without JavaScript, when every product simply shows)
  const filters = document.querySelector<HTMLFormElement>("[data-filters]")!;
  const grid = document.querySelector<HTMLElement>("[data-grid]")!;
  const cards = [...grid.querySelectorAll<HTMLElement>("[data-card]")];
  const shown = document.querySelector<HTMLElement>("[data-shown]")!;
  const empty = document.querySelector<HTMLElement>("[data-empty]")!;
  const apply = () => {
    const f = new FormData(filters);
    const col = String(f.get("collection") ?? "all"), inStock = f.get("instock") !== null, sort = String(f.get("sort") ?? "featured");
    const num = (c: HTMLElement, k: string) => Number(c.dataset[k]);
    const sorted = [...cards].sort((a, b) => (sort === "featured" ? 0 : (sort === "low" ? 1 : -1) * (num(a, "price") - num(b, "price"))) || num(a, "order") - num(b, "order"));
    let n = 0;
    for (const c of sorted) {
      const ok = (col === "all" || c.dataset.collection === col) && (!inStock || c.dataset.stock === "in");
      c.hidden = !ok;
      if (ok) n++;
      grid.append(c);
    }
    shown.textContent = n === cards.length ? `${n} products` : `Showing ${n} of ${cards.length} products`;
    empty.hidden = n > 0;
  };
  filters.hidden = false;
  filters.addEventListener("change", apply);
  empty.querySelector("button")!.addEventListener("click", () => { filters.reset(); apply(); });

  // the product view
  const detail = document.querySelector<HTMLElement>("[data-detail]")!;
  const buy = detail.querySelector<HTMLFormElement>("[data-buy]")!;
  const add = buy.querySelector<HTMLButtonElement>("[data-add]")!;
  const added = buy.querySelector<HTMLElement>("[data-added]")!;
  const addedLink = buy.querySelector<HTMLElement>("[data-added-link]")!;
  const heading = detail.querySelector<HTMLElement>("[data-p-name]")!;
  const part = (k: string) => detail.querySelector<HTMLElement>(`[data-p-${k}]`)!;
  let current = byId.get(detail.dataset.detail!)!;
  const show = (p: Product) => {
    current = p;
    detail.dataset.detail = p.id;
    part("art").replaceChildren(document.querySelector(`[data-card="${p.id}"] svg`)!.cloneNode(true));
    part("kicker").textContent = kindName[p.collection];
    heading.textContent = p.name;
    part("blurb").textContent = p.blurb;
    const rows = p.includes ? [["Inside", p.includes.join(", ")]] : ["Top", "Heart", "Base"].map((t, i) => [t, p.notes[i]]);
    part("notes").replaceChildren(...rows.map(([t, d]) => { const row = el("div"); row.append(el("dt", "", t), el("dd", "", d)); return row; }));
    part("sizes").replaceChildren(...p.sizes.map((s, i) => {
      const label = el("label", "size"), input = el("input"), name = el("span", "size-name");
      Object.assign(input, { type: "radio", name: "size", value: String(i), checked: i === 0 });
      name.append(el("b", "", s.label), el("small", "", s.burn));
      label.append(input, name, el("span", "size-price", money(s.price)));
      return label;
    }));
    const inStock = p.stock === "in";
    add.disabled = !inStock;
    add.textContent = inStock ? "Add to cart" : "Sold out";
    const stock = part("stock");
    stock.textContent = inStock ? "In stock, ready to ship or pick up" : "Sold out for now: the next batch is being poured";
    stock.classList.toggle("out", !inStock);
    added.textContent = "";
    addedLink.hidden = true;
  };
  for (const a of document.querySelectorAll<HTMLAnchorElement>("[data-pick]")) {
    a.addEventListener("click", (e) => {
      e.preventDefault();
      show(byId.get(a.dataset.pick!)!);
      detail.scrollIntoView({ behavior: reduced ? "auto" : "smooth", block: "start" });
      heading.focus({ preventScroll: true });
    });
  }

  // the cart, in memory only
  type Line = { id: string; size: number; qty: number };
  const cart: Line[] = [];
  const freeOver = 60, shipFee = 8;
  const lines = document.querySelector<HTMLElement>("[data-cart-lines]")!;
  const cartEmpty = document.querySelector<HTMLElement>("[data-cart-empty]")!;
  const delivery = document.querySelector<HTMLFormElement>("[data-delivery]")!;
  const out = (k: string) => document.querySelector<HTMLElement>(`[data-${k}]`)!;
  const render = () => {
    const sub = cart.reduce((s, l) => s + byId.get(l.id)!.sizes[l.size].price * l.qty, 0);
    const items = cart.reduce((s, l) => s + l.qty, 0);
    for (const c of document.querySelectorAll("[data-cart-count]")) c.textContent = String(items);
    lines.replaceChildren(...cart.map((l, i) => {
      const p = byId.get(l.id)!, s = p.sizes[l.size];
      const li = el("li"), info = el("div"), side = el("div", "line-side");
      info.append(el("p", "line-name", p.name), el("p", "line-meta", `${s.label} · ${money(s.price)} × ${l.qty}`));
      const remove = el("button", "line-remove", "Remove");
      remove.type = "button";
      remove.setAttribute("aria-label", `Remove ${p.name}, ${s.label}`);
      remove.addEventListener("click", () => { cart.splice(i, 1); render(); cartEmpty.querySelector("a")?.focus(); });
      side.append(el("p", "line-price", money(s.price * l.qty)), remove);
      li.append(info, side);
      return li;
    }));
    lines.hidden = cart.length === 0;
    cartEmpty.hidden = cart.length > 0;
    const ship = new FormData(delivery).get("how") === "ship";
    const fee = ship && sub > 0 && sub < freeOver ? shipFee : 0;
    out("subtotal").textContent = money(sub);
    out("delivery-cost").textContent = fee ? money(fee) : ship ? "Free" : "Free (pickup)";
    out("total").textContent = money(sub + fee);
    const note = out("ship-note");
    note.hidden = !(ship && sub > 0);
    note.textContent = sub >= freeOver ? "Your order ships free." : `Add ${money(freeOver - sub)} more for free shipping.`;
  };
  delivery.addEventListener("change", render);
  buy.addEventListener("submit", (e) => {
    e.preventDefault();
    if (current.stock !== "in") return;
    const f = new FormData(buy);
    const size = Number(f.get("size") ?? 0);
    const qty = Math.min(9, Math.max(1, Math.round(Number(f.get("qty"))) || 1));
    const line = cart.find((l) => l.id === current.id && l.size === size);
    if (line) line.qty = Math.min(9, line.qty + qty);
    else cart.push({ id: current.id, size, qty });
    render();
    added.textContent = `Added to your cart: ${current.name}, ${current.sizes[size].label} × ${qty}.`;
    addedLink.hidden = false;
  });
  render();
</script>
