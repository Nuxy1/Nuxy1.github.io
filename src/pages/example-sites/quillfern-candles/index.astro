---
// Quillfern Candle Co., home (a fictional candle maker: data/demo-sites.ts). A photographed candle that lights itself
// once (the page's one cinematic moment, PhotoHero), the six candles in their two families, how a batch is made,
// shipping and pickup, and a plain demonstration enquiry form for gifts and events that sends nothing.
import Shell from "../../../components/demo/quillfern/Shell.astro";
import PhotoHero from "../../../components/demo/quillfern/PhotoHero.astro";
import CandlePic from "../../../components/demo/quillfern/CandlePic.astro";
import photos from "../../../data/demo-photos.json";
import { base, studio, faq } from "../../../data/demos/quillfern";
import { CANDLES, FAMILIES, SIZES, SHIP, type Family } from "../../../lib/demo/quillfern-cart";

const steps = [
  { t: "Melt and scent", d: "Coconut-soy wax is melted in small kettles and the fragrance goes in at exactly 82 °C, so it binds instead of burning off." },
  { t: "Pour by hand", d: "Forty-eight jars at a time, each wick centred with a wooden clip so it burns down the middle." },
  { t: "Cure for two weeks", d: "The wax sets slowly on open shelves. Curing is what makes the scent carry when the candle is lit." },
  { t: "Trim, label, pack", d: "Every wick is trimmed to ¼ inch and every jar is checked before it gets its arch label." },
];

// each family leads with its first photographed candle; the second family mirrors the first on wide screens
const families = (Object.keys(FAMILIES) as Family[]).map((f, i) => {
  const items = CANDLES.filter((c) => c.family === f);
  const lead = items.find((c) => `quillfern-${c.id}` in photos) ?? items[0];
  return { f, lead, rest: items.filter((c) => c !== lead), flip: i % 2 === 1 };
});
const from = SIZES.tin.price;
---
<Shell description="Quillfern Candle Co. is a fictional candle maker: an interactive demonstration store by Nuxy Automation with a candle you can light, a scent finder, a cart and a three-step demo checkout.">
  <PhotoHero />

  <section class="qf-section qf-coll" aria-labelledby="six-h">
    <div class="qf-wrap">
      <div class="qf-head">
        <h2 id="six-h">Six candles, two moods.</h2>
        <p class="qf-lead">Three warm and woody, three fresh and light. Every scent comes as a travel tin, a classic jar or a large jar. The photographs are AI-generated&nbsp;examples.</p>
      </div>

      {families.map(({ f, lead, rest, flip }) => (
        <section class:list={["qf-fam", { "is-flip": flip }]} aria-labelledby={`fam-${f}`}>
          <header class="qf-fam-head">
            <h3 id={`fam-${f}`}>{FAMILIES[f].name}</h3>
            <p>{FAMILIES[f].note}</p>
          </header>
          <div class="qf-fam-grid">
            <article class="qf-it qf-feat">
              <CandlePic candle={lead} decorative sizes="(min-width: 900px) min(720px, 58vw), calc(100vw - 32px)" class="qf-feat-pic" />
              <div class="qf-it-body">
                <h4 class="qf-it-name"><a href={`${base}/candles/${lead.id}/`}>{lead.name}</a></h4>
                <p class="qf-it-tag">{lead.tagline}</p>
                <p class="qf-it-blurb">{lead.blurb}</p>
                <p class="qf-it-meta qf-ui"><span>{lead.mood}</span><span class="qf-num">From ${from}</span></p>
              </div>
            </article>
            <div class="qf-side">
              {rest.map((c) => (
                <article class="qf-it qf-mini">
                  <CandlePic candle={c} decorative sizes="(min-width: 900px) 220px, calc(50vw - 24px)" class="qf-mini-pic qf-arch" />
                  <div class="qf-it-body">
                    <h4 class="qf-it-name"><a href={`${base}/candles/${c.id}/`}>{c.name}</a></h4>
                    <p class="qf-it-tag">{c.tagline}</p>
                    <p class="qf-it-meta qf-ui"><span>{c.mood}</span><span class="qf-num">From ${from}</span></p>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </section>
      ))}

      <p class="qf-coll-more"><a class="qf-link" href={`${base}/shop/#scents`}>Not sure which? Find your scent by the notes you like</a></p>
    </div>
  </section>

  <section class="qf-section qf-story" id="story" aria-labelledby="story-h">
    <div class="qf-wrap qf-story-in">
      <div class="qf-head">
        <h2 id="story-h">One kitchen, then one studio, still one batch at a time.</h2>
        <p class="qf-lead">Quillfern started with a single cedar candle made for a cold first winter in an old house. Friends asked for more; the markets came next. Now the studio pours six scents, and every jar is still poured by hand.</p>
        <p class="qf-fine">Sample story: Quillfern and everyone in it are made up for this demonstration.</p>
      </div>
      <ol class="qf-steps" role="list" aria-label="How a batch is made">
        {steps.map((s) => (
          <li>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="qf-section qf-get" id="get" aria-labelledby="get-h">
    <div class="qf-wrap qf-get-in">
      <h2 id="get-h">Shipped in two days, or ready at the studio on its next open day.</h2>
      <div class="qf-get-cards">
        <div class="qf-get-card">
          <h3>Shipping</h3>
          <p>${SHIP.standard} standard, free over ${SHIP.freeOver}. Express (1–2 days) ${SHIP.express}. Every jar travels in a paper-pulp sleeve.</p>
        </div>
        <div class="qf-get-card">
          <h3>Pickup at the studio</h3>
          <p>{studio.street}, {studio.town} <span class="qf-fine">(a made-up town)</span>. Always free; we text you when it’s ready.</p>
          <dl class="qf-mini-hours qf-ui">{studio.hours.map(([d, h]) => <div><dt>{d}</dt><dd>{h}</dd></div>)}</dl>
        </div>
      </div>
    </div>
  </section>

  <section class="qf-section qf-gift" aria-labelledby="gift-h">
    <div class="qf-wrap qf-gift-in">
      <div class="qf-head">
        <h2 id="gift-h">Candles for a wedding, a team or a shop shelf?</h2>
        <p class="qf-lead">Orders of six or more can have their own label and a scent chosen with you. Tell us roughly what you need and the studio replies within a day.</p>
      </div>
      <div class="qf-gift-box">
        <form class="qf-gift-form" method="dialog" data-demo-form="gift-sent" aria-labelledby="gift-form-h">
          <h3 id="gift-form-h">Ask about a larger order</h3>
          <p class="qf-fine">Demo form: nothing you type leaves this page.</p>
          <div class="qf-fields two" data-step>
            <label class="qf-field"><span>First name</span><input name="name" required autocomplete="off" maxlength="40" data-error="Add your first name." /></label>
            <label class="qf-field"><span>Occasion</span>
              <select name="occasion" required data-error="Choose an occasion.">
                <option value="">Choose one</option>
                <option>Wedding favours</option>
                <option>Team or client gifts</option>
                <option>Shop or café stockist</option>
                <option>Something else</option>
              </select>
            </label>
            <label class="qf-field"><span>About how many?</span><input name="qty" type="number" inputmode="numeric" min="6" max="500" step="1" required data-error="Enter a quantity from 6 to 500." /><small>Six or more</small></label>
            <label class="qf-field qf-field-wide"><span>Anything else <small>(optional)</small></span><textarea name="notes" rows="3" maxlength="500" autocomplete="off"></textarea></label>
            <p class="qf-err qf-field-wide" id="gift-err" data-step-error role="alert"></p>
          </div>
          <button class="qf-btn" type="submit">Send enquiry</button>
        </form>
        <div class="qf-gift-sent demo-sent" id="gift-sent" hidden tabindex="-1">
          <strong>Demo only: nothing was sent.</strong>
          <p>On a real Quillfern site the enquiry would land in the studio inbox with a draft reply and a price for the quantity, ready to check and send.</p>
          <p>The form has been cleared and nothing was stored.</p>
          <button class="qf-btn qf-btn-line" type="button" data-demo-again>Ask about another order</button>
        </div>
      </div>
    </div>
  </section>

  <section class="qf-section qf-faq" aria-labelledby="faq-h">
    <div class="qf-wrap qf-faq-in">
      <h2 id="faq-h">Before you order.</h2>
      <div class="qf-faq-list">
        {faq.map(([q, a]) => (
          <details>
            <summary>{q}</summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Shell>

<style>
  /* the collection: two family chapters, each a large studio photo with its two sisters beside it */
  .qf-coll { padding-top: clamp(56px, 7vw, 104px); }
  .qf-fam { display: grid; gap: clamp(20px, 2.4vw, 32px); padding-block: clamp(28px, 4vw, 48px) clamp(40px, 5vw, 64px); border-top: 1px solid var(--qf-line-2); }
  .qf-fam-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 4px 24px; }
  .qf-fam-head h3 { font-size: clamp(1.75rem, 1.2rem + 1.6vw, 2.625rem); font-weight: 500; }
  .qf-fam-head p { font-style: italic; color: var(--qf-mute); }
  .qf-fam-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(24px, 3.4vw, 56px); align-items: start; }
  .qf-fam.is-flip .qf-fam-grid { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
  .qf-fam.is-flip .qf-feat { order: 2; }

  .qf-it { position: relative; display: grid; gap: 16px; align-content: start; }
  .qf-it-body { display: grid; gap: 6px; align-content: start; }
  .qf-it-name { font-size: 1.625rem; font-weight: 540; line-height: 1.1; }
  .qf-it-name a { text-decoration: underline; text-decoration-color: transparent; text-decoration-thickness: 1.5px; text-underline-offset: 6px; transition: text-decoration-color 180ms ease-out; }
  /* the whole entry is the link's target, but the link's name stays the candle's name */
  .qf-it-name a::after { content: ""; position: absolute; inset: 0; }
  .qf-it:hover .qf-it-name a, .qf-it-name a:focus-visible { text-decoration-color: var(--qf-copper); }
  .qf-it-name a:focus-visible { outline: 0; }
  .qf-it:has(a:focus-visible) { outline: 3px solid var(--demo-ring); outline-offset: 6px; border-radius: 4px; }
  .qf-it-tag { color: var(--qf-soft); }
  .qf-it-blurb { max-width: 48ch; color: var(--qf-soft); font-style: italic; }
  .qf-it-meta { display: flex; flex-wrap: wrap; gap: 4px 20px; margin-top: 4px; font-size: 0.9375rem; color: var(--qf-mute); }
  .qf-it-meta .qf-num { color: var(--qf-copper); font-weight: 650; }

  .qf-feat :global(.qf-feat-pic) { aspect-ratio: 5 / 4; border-radius: 4px; }
  .qf-feat .qf-it-name { font-size: clamp(2rem, 1.4rem + 1.6vw, 2.75rem); font-weight: 500; }
  /* two square photos and their gap come to about the height of the 5:4 lead photo, so the side column ends level
     with it and the lead's text sits alone underneath */
  .qf-side { display: grid; gap: clamp(24px, 3vw, 40px); }
  .qf-mini { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 20px; align-items: center; }
  .qf-mini .qf-it-name { font-size: 1.5rem; }
  .qf-mini :global(.qf-mini-pic) { aspect-ratio: 1; }
  .qf-coll-more { margin-top: 8px; }

  @media (max-width: 899px) {
    .qf-fam-grid, .qf-fam.is-flip .qf-fam-grid { grid-template-columns: 1fr; }
    .qf-fam.is-flip .qf-feat { order: 0; }
    .qf-side { grid-template-columns: 1fr 1fr; gap: 20px 16px; }
    .qf-mini { grid-template-columns: 1fr; align-items: start; gap: 12px; }
    .qf-mini .qf-it-name { font-size: 1.375rem; }
  }
  @media (max-width: 379px) { .qf-mini .qf-it-tag { font-size: 0.9375rem; } }

  .qf-story { background: var(--qf-wax); }
  .qf-story-in { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(32px, 5vw, 80px); align-items: start; }
  @media (max-width: 899px) { .qf-story-in { grid-template-columns: 1fr; } }
  /* a pour diary: short named entries in the serif, set apart by dotted rules like ruled journal lines */
  .qf-steps { display: grid; gap: 0; margin: 0; padding: 0; list-style: none; border-top: 1.5px dotted var(--qf-copper-line); }
  .qf-steps li { display: grid; gap: 6px; padding: 22px 0; border-bottom: 1.5px dotted var(--qf-copper-line); }
  .qf-steps h3 { font-size: 1.625rem; font-style: italic; font-weight: 500; color: var(--qf-umber); }
  .qf-steps p { color: var(--qf-soft); max-width: 52ch; }

  /* a pale fern band, the botanical half of the palette, kept light so the page stays one paper stock; it also parts
     the wax story band above from the paper gift section below */
  .qf-get { background: var(--qf-fern-soft); color: var(--qf-ink); }
  .qf-get-in { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(32px, 5vw, 72px); align-items: start; }
  @media (max-width: 899px) { .qf-get-in { grid-template-columns: 1fr; } }
  .qf-get-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  @media (max-width: 619px) { .qf-get-cards { grid-template-columns: 1fr; } }
  .qf-get-card { display: grid; gap: 10px; align-content: start; padding: 44px 26px 26px; border-radius: 999px 999px 6px 6px / 90px 90px 6px 6px; background: var(--qf-cream); box-shadow: 0 0 0 1px var(--qf-line); }
  .qf-get-card p { color: var(--qf-soft); }
  .qf-mini-hours div { display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap; padding: 6px 0; border-top: 1px solid var(--qf-line); font-size: 0.875rem; }
  .qf-mini-hours dt { font-weight: 650; }

  .qf-gift-in { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(32px, 5vw, 72px); align-items: start; }
  @media (max-width: 899px) { .qf-gift-in { grid-template-columns: 1fr; } }
  .qf-gift-box { padding: clamp(22px, 3vw, 36px); border-radius: 6px; background: var(--qf-cream); box-shadow: 0 0 0 1px var(--qf-line); }
  .qf-gift-form { display: grid; gap: 18px; }
  .qf-gift-form .qf-btn { justify-self: start; }
  .qf-gift-sent { display: grid; gap: 12px; }
  .qf-gift-sent[hidden] { display: none; }
  .qf-gift-sent strong { font-size: 1.375rem; font-weight: 560; color: var(--qf-umber); }
  .qf-gift-sent p { color: var(--qf-soft); }
  .qf-gift-sent .qf-btn { justify-self: start; }

  .qf-faq { padding-top: 0; }
  .qf-faq-in { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(32px, 5vw, 72px); }
  @media (max-width: 899px) { .qf-faq-in { grid-template-columns: 1fr; } }
  .qf-faq-list { border-top: 1px solid var(--qf-line-2); }
  .qf-faq-list details { border-bottom: 1px solid var(--qf-line-2); }
  .qf-faq-list summary { display: flex; justify-content: space-between; align-items: center; gap: 16px; min-height: 64px; padding: 14px 0; font-size: 1.1875rem; font-weight: 520; color: var(--qf-umber); cursor: pointer; list-style: none; text-wrap: balance; }
  .qf-faq-list summary::-webkit-details-marker { display: none; }
  .qf-faq-list summary::after { content: "+"; flex: none; font-family: var(--qf-ui); font-size: 1.5rem; font-weight: 400; color: var(--qf-copper); transition: transform 200ms var(--qf-ease); }
  .qf-faq-list details[open] summary::after { transform: rotate(45deg); }
  .qf-faq-list details p { padding: 0 0 20px; color: var(--qf-soft); max-width: 60ch; }
</style>

<script>
  import { inlineErrors } from "../../../lib/demo/stepper";
  const gift = document.querySelector<HTMLFormElement>("form.qf-gift-form");
  if (gift) inlineErrors(gift);
</script>
