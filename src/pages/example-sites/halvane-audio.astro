---
// Halvane Audio, LUMEN ONE: a made-up speaker brand (demonstration website, Nuxy Automation).
// Built on the GetLayers template Artefakt (style Obsidian Luxe) and its scene Pendulum Wave: artefakt.css and
// artefakt.js are the template's own source, ported by tools/port-artefakt.mjs; halvane.css adds only what the
// template has no part for. The template's script renders no markup, so every row, card and leader is drawn here.
// The page works without JavaScript (posters), without WebGL and under reduced motion (stills, no scene). With
// WebGL on tiers 1-2 the Blender-built model takes over the stage and the pendulums run in Act 04.
import DemoSite from "../../layouts/DemoSite.astro";
import layers from "../../lib/halvane/layers.json";
import "../../lib/halvane/artefakt.css";
import "../../lib/halvane/halvane.css";


const B = "/3d/halvane/";
const G = "/3d/halvane/gl/";
// a number never wraps away from its unit ("19 mm", "45 Hz", "6.5-inch"): a no-break space, or a word joiner after the hyphen
const NBSP = String.fromCharCode(0xa0), WJ = String.fromCharCode(0x2060);
const nb = (s: string) => s.replace(/(\d) (?=\S)/g, `$1${NBSP}`).replace(/(\d)-(?=[a-z])/g, `$1-${WJ}`);
const srcset = (f: string, s: string) => [800, 1000, 1200, 1600].map((w) => `${B}posters/${f}-${s}-${w}.webp ${w}w`).join(", ");

const finishes = [
  { id: "walnut", name: "Walnut", note: "Oiled walnut" },
  { id: "chalk", name: "Chalk", note: "Lacquered oak" },
  { id: "graphite", name: "Graphite", note: "Stained ash" },
];
const views = [
  { shot: "showroom", label: "Show the front and side" },
  { shot: "drivers", label: "Show the drivers" },
  { shot: "grain", label: "Show the grain up close" },
];
const specs = [
  ["Type", "Two-way bookshelf speaker with a front slot port"],
  ["Drivers", "6.5-inch paper-composite woofer, 1-inch aluminium dome tweeter"],
  ["Frequency response", "45 Hz – 22 kHz (±3 dB)"],
  ["Sensitivity", "87 dB (2.83 V at 1 m)"],
  ["Impedance", "6 Ω nominal"],
  ["Size", "21 × 33 × 26 cm (W × H × D)"],
  ["Weight", "7.4 kg each"],
  ["Price", `$1,180 a pair (demonstration${NBSP}price)`],
].map(([k, v]) => [k, nb(v)]);
const details = [
  { h: "Voices sound like people", p: "The 6.5-inch cone is paper composite: light and naturally damped, so speech stays warm and unforced.", icon: "woofer" },
  { h: "Treble that reaches the sofa", p: "A shallow waveguide around the tweeter spreads the treble across the room, not only to the chair in the middle.", icon: "dispersion" },
  { h: "Happy close to the wall", p: "The port is a slot along the bottom of the front, so the bass still breathes on a crowded shelf.", icon: "wall" },
].map((d) => ({ ...d, p: nb(d.p) }));

// Technology walk: the template's card and leader geometry (app.js CARD_INSET, ARTWORK, ARTWORK_TOP), in its
// 16-unit frame. Each leader runs from the part's projected anchor on the reel to the side of its card.
const u = (v: number) => `calc(${+v.toFixed(3)} / 16 * var(--u))`;
const CARD_INSET = 457, ARTWORK = 619, ARTWORK_TOP = 136, MARKER = 8;
const cards = layers.map((l) => {
  const offset = (l.anchorFx - 0.5) * ARTWORK;
  const anchorY = ARTWORK_TOP + l.anchorFy * ARTWORK;
  const desc = anchorY < l.cardSideY;
  const left = l.side === "left";
  const top = u(Math.min(anchorY, l.cardSideY));
  const height = `max(1px, ${u(Math.abs(l.cardSideY - anchorY))})`;
  const svg = left
    ? `left:${u(CARD_INSET)};top:${top};width:calc(50% - ${u(CARD_INSET - offset)});height:${height}`
    : `left:calc(50% + ${u(offset)});top:${top};width:calc(50% - ${u(CARD_INSET + offset)});height:${height}`;
  const line = left ? (desc ? [100, 0] : [0, 100]) : (desc ? [0, 100] : [100, 0]);
  return {
    ...l,
    body: nb(l.body),
    left,
    svg,
    y1: line[0],
    y2: line[1],
    marker: `left:calc(50% + ${u(offset - MARKER / 2)});top:${u(anchorY - MARKER / 2)};width:${u(MARKER)};height:${u(MARKER)}`,
    card: `top:${u(l.cardTop)}`,
  };
});
---

<DemoSite slug="halvane-audio" theme="#0a0a0c" bodyClass="hv-body" description="Halvane Audio is a made-up speaker brand: a demonstration website by Nuxy Automation." fonts={["/fonts/newsreader-display-var.woff2", "/fonts/albert-sans-var.woff2"]}>
  <div class="hvx">
    <div class="shell lattice-shell">
      <div class="lattice-beam" aria-hidden="true"></div>
      <div class="lattice-bars" aria-hidden="true"></div>
      <div class="page">
        <div class="header-pin lattice-panel">
          <header class="site-header rise" style="--rise:-8px">
            <a class="logo tap" href="#main" translate="no">Halvane <span>Audio</span></a>
            <nav aria-label="Primary">
              <ul>
                <li class="nav-item"><a class="nav-label tap" href="#details"><span data-scramble data-delay="0">The speaker</span></a></li>
                <li class="nav-item has-menu">
                  <div>
                    <button class="nav-label tap" type="button" aria-expanded="false" aria-controls="menu-collections"><span data-scramble data-delay="60">Finishes</span><img class="nav-caret" src={`${G}hero/hero-caret.svg`} alt="" aria-hidden="true" width="6" height="5" /></button>
                    <div class="nav-panel-wrap">
                      <ul class="nav-panel lattice-panel" id="menu-collections">
                        {finishes.map((f) => <li><a href={`#finish-${f.id}`} tabindex="-1">{f.name}</a></li>)}
                      </ul>
                    </div>
                  </div>
                </li>
                <li class="nav-item"><a class="nav-label tap" href="#technology"><span data-scramble data-delay="120">Inside</span></a></li>
                <li class="nav-item"><a class="nav-label tap" href="#sound"><span data-scramble data-delay="180">Listen</span></a></li>
              </ul>
            </nav>
            <a class="cart tap" href="#reserve"><span data-scramble data-delay="240">Reserve a pair</span></a>
            <div class="burger-slot">
              <button class="menu-toggle" id="burger" type="button" aria-expanded="false" aria-controls="site-menu" aria-label="Open menu"><span class="menu-glyph" aria-hidden="true"><i></i><i></i><i></i></span></button>
            </div>
          </header>
        </div>

        <main id="main">
          <div id="product-region" data-product-region>
            <div id="product-canvas" class="stage-mask hv-stage" data-pointer-frame style="visibility:hidden">
              <div id="product-photo">
                <img id="product-poster" data-finish="walnut" src={`${B}posters/walnut-showroom-1200.webp`} srcset={srcset("walnut", "showroom")} sizes="(min-width: 1024px) 64vw, 100vw" width="1600" height="1600" fetchpriority="high" decoding="async" elementtiming="hero-poster" alt="The Lumen One speaker in walnut, turned to show its front and side." />
                <canvas id="product-orbit" aria-hidden="true" hidden></canvas>
              </div>
              <div id="product-hit" aria-hidden="true"></div>
            </div>

            <div id="product-screens">
              {/* ACT 01: arrival */}
              <section id="hero" aria-labelledby="hero-title">
                <div class="frame-box">
                  <div class="markers">
                    <div class="marker start">
                      <span class="bracket b1"><img class="rise" style="--rise:0px;--delay:120ms" src={`${G}hero/hero-bracket.svg`} alt="" aria-hidden="true" width="11" height="11" /></span>
                      <p>
                        <span class="block" data-scramble data-delay="140">A two-way</span>
                        <span class="block" data-scramble data-delay="220">bookshelf speaker</span>
                        <span class="block" data-scramble data-delay="300">in solid hardwood.</span>
                      </p>
                      <span class="bracket b2"><img class="rise" style="--rise:0px;--delay:120ms" src={`${G}hero/hero-bracket.svg`} alt="" aria-hidden="true" width="11" height="11" /></span>
                    </div>
                    <div class="marker end">
                      <span class="bracket b1"><img class="rise" style="--rise:0px;--delay:120ms" src={`${G}hero/hero-bracket.svg`} alt="" aria-hidden="true" width="11" height="11" /></span>
                      <p>
                        <span class="block" data-scramble data-delay="140">Paper woofer.</span>
                        <span class="block" data-scramble data-delay="220">Aluminium tweeter.</span>
                        <span class="block" data-scramble data-delay="300">Brass ring.</span>
                      </p>
                      <span class="bracket b2"><img class="rise" style="--rise:0px;--delay:120ms" src={`${G}hero/hero-bracket.svg`} alt="" aria-hidden="true" width="11" height="11" /></span>
                    </div>
                  </div>

                  <div id="hero-stage" data-hero-stage>
                    <div id="wordmark" aria-hidden="true">
                      <div class="wm-box">
                        <div class="wm-plate" style="opacity:.2" translate="no">Halvane</div>
                        <div class="wm-window"><div class="wm-inner"><div class="wm-lit" translate="no">Halvane</div></div></div>
                      </div>
                    </div>
                  </div>

                  <div class="hero-claim">
                    <h1 id="hero-title" class="rise">
                      <span data-scramble data-keep-sentences data-delay="260">Built by hand.</span>
                      <span data-scramble data-keep-sentences data-delay="370">Tuned by ear.</span>
                    </h1>
                    <div id="hero-cta" class="rise" style="--delay:240ms">
                      <a class="btn lattice-panel" href="#reserve"><i></i><i></i><i></i><i></i><span data-scramble data-delay="420">Reserve a pair</span><img class="arrow" src={`${G}ui/arrow-right.svg`} alt="" aria-hidden="true" width="10" height="6" /></a>
                    </div>
                  </div>

                  <div id="hero-badges">
                    <div class="badge start rise" style="--delay:300ms">
                      <div class="media"><span class="num">1</span></div>
                      <span class="rule" aria-hidden="true"></span>
                      <p class="copy badge-text">
                        <span class="block" data-scramble data-delay="320">small workshop.</span>
                        <span class="block" data-scramble data-delay="380">Every pair built and</span>
                        <span class="block" data-scramble data-delay="440">voiced by hand.</span>
                      </p>
                    </div>
                    <div class="badge end rise" style="--delay:360ms">
                      <div class="media"><span class="num">200</span></div>
                      <span class="rule" aria-hidden="true"></span>
                      <p class="copy badge-text">
                        <span class="block" data-scramble data-delay="380">pairs in the</span>
                        <span class="block" data-scramble data-delay="440">first run.</span>
                      </p>
                    </div>
                  </div>
                </div>
              </section>

              {/* ACT 02: the reveal. The sticky stage turns the speaker and draws the woofer forward. */}
              <section id="details" class="section" aria-labelledby="details-heading">
                <div class="frame-box">
                  <div id="details-intro">
                    <h2 id="details-heading" class="display rise" style="--rise:20px"><span data-scramble data-tie data-reveal>Turn it round.</span></h2>
                    <p class="t-stand muted prose-even rise">
                      <span data-scramble data-tie data-reveal data-delay="120">Solid hardwood, a paper woofer and an aluminium tweeter in a brass ring. Three choices decide how it sounds.</span>
                    </p>
                  </div>
                  <ol id="details-rows">
                    {details.map((d, i) => (
                      <li class="spec-row lattice-panel rise" style={`--rise:16px;--delay:${i * 80}ms`}>
                        <div class="rail"><img src={`${G}parts/${d.icon}.svg`} alt="" aria-hidden="true" width="32" height="32" /></div>
                        <div class="copy">
                          <h3><span data-scramble data-tie data-reveal data-delay={String(i * 80)}>{d.h}</span></h3>
                          <p class="t-prose muted prose-even"><span data-scramble data-tie data-reveal data-delay={String(i * 80 + 60)}>{d.p}</span></p>
                        </div>
                      </li>
                    ))}
                  </ol>
                  <div id="details-cta" class="rise">
                    <a class="btn lattice-panel" href="#technology"><i></i><i></i><i></i><i></i><span data-scramble data-delay="120">See inside</span><img class="arrow" src={`${G}ui/arrow-right.svg`} alt="" aria-hidden="true" width="10" height="6" /></a>
                  </div>
                </div>
              </section>
            </div>
          </div>

          {/* ACT 03: engineered detail. 61 frames of an AI-generated studio clip (Seedance 2.5), stabilised on the
              speaker and keyed, scrubbed by scroll: the light comes up as the cards walk the five parts. */}
          <section id="technology" aria-labelledby="technology-h" style="--technology-region:2.6">
            <div class="stage">
              <div class="stage-inner">
                <div id="technology-head">
                  <h2 id="technology-h" class="display rise"><span data-scramble data-tie data-reveal>Five parts,</span><br aria-hidden="true" /> <span data-scramble data-tie data-reveal data-delay="80">nothing extra.</span></h2>
                  <p id="technology-note" class="t-stand muted prose-even rise">
                    <span data-scramble data-tie data-reveal data-delay="140">The light comes up as you scroll.</span><br class="frame-only" aria-hidden="true" /> <span data-scramble data-tie data-reveal data-delay="200">The crossover sits behind the back panel.</span>
                  </p>
                </div>
                <div id="reel-box">
                  <img id="reel-poster" src={`${G}reel/lo/040.webp`} data-src={`${G}reel/lo/000.webp`} alt="Lumen One in walnut on a dark studio floor, seen from the front left: the tweeter in its brass ring, the woofer below it and the port slot along the bottom of the front." width="768" height="768" loading="lazy" decoding="async" />
                  <canvas id="reel-canvas" aria-hidden="true"></canvas>
                </div>
                <div id="technology-cards">
                  {cards.map((c) => (
                    <div>
                      <div class="leader" aria-hidden="true">
                        <svg viewBox="0 0 100 100" preserveAspectRatio="none" style={c.svg}><line x1="0" y1={c.y1} x2="100" y2={c.y2} stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke" /></svg>
                        <span style={c.marker}></span>
                      </div>
                      <div class:list={["layer-card lattice-panel", { "is-left": c.left }]} style={c.card}>
                        <div class="rail"><span class="t-body faint" aria-hidden="true">{c.index}</span><img src={c.icon} alt="" aria-hidden="true" width="32" height="32" /></div>
                        <div class="copy">
                          <h3 data-card-title data-tie>{c.title}</h3>
                          <p class="t-prose muted" data-card-body data-tie>{c.body}</p>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
                <ol id="technology-list">
                  {cards.map((c, i) => (
                    <li class="spec-row lattice-panel rise" style={`--rise:16px;--delay:${i * 80}ms`}>
                      <div class="rail"><span class="t-body faint" aria-hidden="true">{c.index}</span><img src={c.icon} alt="" aria-hidden="true" width="32" height="32" /></div>
                      <div class="copy">
                        <h3><span data-scramble data-tie data-reveal data-delay={String(i * 80)}>{c.title}</span></h3>
                        <p class="t-prose muted prose-even"><span data-scramble data-tie data-reveal data-delay={String(i * 80 + 60)}>{c.body}</span></p>
                      </div>
                    </li>
                  ))}
                </ol>
              </div>
            </div>
          </section>

          {/* ACT 04: sound, visualised (GetLayers scene pendulum-wave). Audio only after the Sound button. */}
          <section id="sound" class="section" aria-labelledby="sound-h">
            <div class="frame-box">
              <h2 id="sound-h" class="display rise" style="--rise:20px"><span data-scramble data-tie data-reveal>Out of step, and back.</span></h2>
              <p id="sound-note" class="t-stand muted prose-even rise">
                <span data-scramble data-tie data-reveal data-delay="120">A speaker is mostly a matter of timing: two drivers have to arrive together. Fifteen pendulums, each a little longer than the last, show how quickly things drift out of step and back.</span>
              </p>
              <div class="sound-stage">
                <img id="sound-still" src={`${G}sound/sound-still-1600.webp`} srcset={`${G}sound/sound-still-800.webp 800w, ${G}sound/sound-still-1200.webp 1200w, ${G}sound/sound-still-1600.webp 1600w`} sizes="(min-width: 1024px) 70vw, 100vw" width="1600" height="1200" loading="lazy" decoding="async" alt="Fifteen pendulums of rising length swinging out of step, their bobs tracing a slow wave." />
                <canvas id="sound-canvas" hidden aria-hidden="true"></canvas>
              </div>
              <div id="sound-controls">
                <button id="sound-release" class="btn lattice-panel" type="button" hidden><i></i><i></i><i></i><i></i><span>Release the pendulums</span></button>
                <button id="sound-toggle" class="sound-toggle" type="button" hidden aria-pressed="false"><span>Sound</span><span class="state" aria-hidden="true"></span></button>
              </div>
            </div>
          </section>

          {/* ACT 05: the experience. */}
          <section id="room" aria-labelledby="room-heading">
            <picture>
              <source media="(orientation: portrait)" srcset={`${B}room/room-mobile-800.webp 800w, ${B}room/room-mobile-1200.webp 1200w`} sizes="100vw" width="1200" height="1500" />
              <img src={`${B}room/room-desktop-1600.webp`} srcset={`${B}room/room-desktop-1600.webp 1600w, ${B}room/room-desktop-2400.webp 2400w`} sizes="100vw" width="2400" height="1350" loading="lazy" decoding="async" alt="A pair of Lumen One speakers in walnut on a long walnut sideboard against a concrete wall, a turntable and records between them, with a pine forest at dusk through the window." />
            </picture>
            <div class="room-copy">
              <h2 id="room-heading" class="display rise" style="--rise:20px"><span data-scramble data-tie data-reveal>At home by the wall.</span></h2>
              <p class="t-stand muted prose-even rise"><span data-scramble data-tie data-reveal data-delay="120">The port is on the front, so Lumen One can sit close to the wall, beside the records, where speakers actually end up.</span></p>
            </div>
          </section>

          {/* ACT 05b: light across the walnut. An AI-generated studio clip (Seedance 2.5), self-hosted and played forward
              then back so it loops without a cut. Its file is attached by stage.js on tiers 1-2 only, when the section
              comes near; it plays only while on screen and the Moving light button pauses it. Tier 3 and no-JS keep the still. */}
          <section id="sweep" aria-labelledby="sweep-h">
            <div class="sweep-media">
              <video id="sweep-video" muted playsinline loop preload="none" disablepictureinpicture poster={`${B}sweep/lightsweep-poster-1280.webp`} data-src={`${B}sweep/lightsweep-720.mp4`} width="1280" height="720" aria-hidden="true" tabindex="-1"></video>
            </div>
            <div class="sweep-copy">
              <h2 id="sweep-h" class="display rise" style="--rise:20px"><span data-scramble data-tie data-reveal>Light finds the grain.</span></h2>
              <p class="t-stand muted prose-even rise"><span data-scramble data-tie data-reveal data-delay="120">A low lamp crosses the front: oiled walnut, the brass ring around the tweeter, the cast frame of the woofer. The finish is made to look right in evening light, not only under a showroom’s.</span></p>
              <button id="sweep-toggle" class="sound-toggle" type="button" hidden aria-pressed="true"><span>Moving light</span><span class="state" aria-hidden="true"></span></button>
            </div>
          </section>

          {/* ACT 06: the collection. */}
          <section id="collections" class="section" aria-labelledby="collections-h">
            <div class="frame-box">
              <div id="collections-head">
                <h2 id="collections-h" class="display rise" style="--rise:20px"><span data-scramble data-tie data-reveal>Three finishes.</span></h2>
                <p id="collections-lede" class="t-stand muted prose-even rise"><span data-scramble data-tie data-reveal data-delay="120">The same speaker inside each one. Every pair is matched by grain or colour batch before it leaves the workshop.</span></p>
              </div>
              <ol id="collections-cards">
                {finishes.map((f, i) => (
                  <li class="product rise" id={`finish-${f.id}`} style={`--rise:20px;--delay:${i * 80}ms`}>
                    <div class="panel">
                      <div class="layer" aria-hidden="true">
                        {views.map((v, s) => (
                          <img src={`${B}posters/${f.id}-${v.shot}-1200.webp`} srcset={srcset(f.id, v.shot)} sizes="(min-width: 1024px) 24vw, (min-width: 768px) 46vw, 90vw" width="1600" height="1600" loading="lazy" decoding="async" alt="" data-shot={v.shot} data-shown={s === 0 ? "1" : "0"} />
                        ))}
                      </div>
                      <div class="head">
                        <div class="row"><img src={`${G}collections/collections-corner.svg`} alt="" aria-hidden="true" width="13" height="13" /></div>
                        <div class="name">
                          <h3><span data-scramble data-reveal data-delay={String(i * 80)}>{f.name}</span></h3>
                          <span class="price t-body muted"><span data-scramble data-reveal data-delay={String(i * 80 + 40)}>$1,180 a pair</span></span>
                        </div>
                      </div>
                      <div class="swatches" role="group" aria-label={`${f.name} view`}>
                        {views.map((v, s) => <button type="button" class="tap" aria-label={v.label} aria-pressed={s === 0 ? "true" : "false"}></button>)}
                      </div>
                      <div class="band">
                        <ul class="chips">
                          <li><span data-scramble data-reveal data-delay={String(i * 80 + 80)}>{f.note}</span></li>
                          <li><span data-scramble data-reveal data-delay={String(i * 80 + 80)}>Demo price</span></li>
                        </ul>
                        <a class="shop" href="#reserve" data-choose-finish={f.id}>Reserve in {f.name.toLowerCase()}<img src={`${G}ui/arrow-right.svg`} alt="" aria-hidden="true" width="10" height="6" /></a>
                      </div>
                    </div>
                  </li>
                ))}
              </ol>
              <div id="collections-cta" class="rise" style="--delay:460ms">
                <a class="btn lattice-panel" href="#specs"><i></i><i></i><i></i><i></i><span data-scramble data-delay="120">Compare the numbers</span><img class="arrow" src={`${G}ui/arrow-right.svg`} alt="" aria-hidden="true" width="10" height="6" /></a>
              </div>
            </div>
          </section>

          <section id="specs" class="flow" aria-labelledby="specs-heading">
            <div class="flow-head">
              <h2 id="specs-heading" class="display rise" style="--rise:20px"><span data-scramble data-tie data-reveal>The numbers, plainly.</span></h2>
              <p class="t-stand muted prose-even rise"><span data-scramble data-tie data-reveal data-delay="120">Lumen One is a fictional product, so these are its design figures, not test results. A pair would come with cotton dust covers and a printed tuning card signed by the person who voiced it.</span></p>
            </div>
            <dl class="specs-list rise" style="--rise:16px;--delay:120ms">
              {specs.map(([k, v]) => <div class="spec-line"><dt class="muted">{k}</dt><dd>{v}</dd></div>)}
            </dl>
          </section>

          {/* ACT 06c: out of the dark. 57 frames of an AI-generated Seedance 2.5 clip, scrubbed by scroll while the
              stage is pinned: the light comes up on the speaker, falls away, and the plinth photo (Nano Banana Pro)
              rises out of the black. One line of type per beat. Tier 3 and no-JS get the plinth photo and all four
              lines, unpinned. Wired in stage.js (wireFinale). */}
          <section id="finale" aria-labelledby="finale-h">
            <div class="finale-stage">
              <div class="finale-media">
                <canvas id="finale-canvas" aria-hidden="true"></canvas>
                <img class="finale-reveal" src={`${B}finale/reveal-1920.webp`} srcset={`${B}finale/reveal-960.webp 960w, ${B}finale/reveal-1920.webp 1920w`} sizes="100vw" alt="Lumen One in walnut on a dark stone plinth under a single soft light." width="1920" height="1072" loading="lazy" decoding="async" />
              </div>
              <div class="finale-copy">
