---
// AI & business automation: the flagship (lead response & follow-up), then the lead, booking and sales services
// (#leads, where the homepage's fourth primary service links), the AI Voice Receptionist with its comparison and a
// labelled simulated call (#voice), admin automations (#admin) and AI and custom systems (#ai), how automations are
// kept safe, the working examples and the questions. Services and prices come from data/services.ts (published).
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import ServiceCard from "../../components/ServiceCard.astro";
import CinematicLoop from "../../components/CinematicLoop.astro";
import VideoUpsell from "../../components/VideoUpsell.astro";
import { serviceById, variantById, keep, faqs, dollars, money, statusWords, plans } from "../../data/services";
import type { Service } from "../../data/services";
import { examples } from "../../data/examples";
import type { IconName } from "../../components/Icon.astro";

const site = "https://nuxyautomation.com";
// The automation services split by the job they do for this page. (The Google profile sits with websites, and store
// automations, ordering and gift cards with e-commerce: the tiles below point there.)
type Part = { title: string; lead: string; items: Service[] };
const pick = (ids: string[]): Service[] => ids.map((id) => serviceById[id]);
const leads: Part = { title: "Get more customers", lead: "Answer every inquiry fast, follow up on quotes, make booking easy and keep in touch with the customers you have.", items: pick(["follow-up", "missed-calls", "quotes", "estimate-follow-up", "booking", "reviews", "re-engagement", "email-list", "cold-outreach"]) };
const admin: Part = { title: "Save admin time", lead: "Fewer hours of typing, chasing and copying between apps.", items: pick(["invoices", "deposits", "onboarding", "reports", "data"]) };
const ai: Part = { title: "AI and custom systems", lead: "Drafted replies you approve, leads sorted by your rules, and connections or a CRM for when your tools can’t do it on their own.", items: pick(["ai-replies", "lead-qualification", "integrations", "crm-system"]) };
const flagship = serviceById["follow-up"];
const textBack = serviceById["missed-calls"];
const voice = serviceById["ai-receptionist"];
const advanced = variantById["ai-receptionist-advanced"];
const starter = plans.find((p) => p.kind === "automation")!;

// Lowest published price in a group, for the hero's "from $X" (every price string carries one dollar amount)
const from = (g: Part) => money(Math.min(...g.items.map((s) => dollars(s.price))));
const parts: [string, string, string, IconName][] = [
  ["#leads", "Leads, quotes & follow-ups", `${leads.items.length} services, from ${from(leads)}`, "chatsCircle"],
  ["#voice", voice.name, `Setup ${voice.price}, after consultation`, "headset"],
  ["#admin", "Admin automations", `${admin.items.length} services, from ${from(admin)}`, "receipt"],
  ["#ai", ai.title, `${ai.items.length} services, from ${from(ai)}`, "sparkle"],
];

const flow: [string, string][] = [
  ["An inquiry comes in", "From your website form, your email, Facebook or Instagram, at any hour."],
  ["The customer gets a reply in seconds", "In your words, written in advance: thanks, when you’ll be in touch, and what happens next."],
  ["You get the details at once", "One alert with the name, the job and the best time to call back. No digging through emails."],
  ["A friendly follow-up if it goes quiet", "At most 2, and they stop the moment the customer replies, so you take over the conversation."],
];

// Text-back, receptionist and advanced side by side. Prices and the monthly line come from the data.
const compare: [string, string, string, string][] = [
  ["What it does", "Sends one text after a call you couldn’t answer", "An AI voice answers the call and talks with the caller", "The same, with more call types and routing"],
  ["Talks with the caller", "No: it’s a text, not a conversation", "Yes, and it says it’s an AI", "Yes, and it says it’s an AI"],
  ["Answers questions", "No", "From the information you approve", "From the information you approve"],
  ["Books appointments", "Sends your booking or quote link", "Books into your calendar where your tool allows", "Books into your calendar where your tool allows"],
  ["Hands calls to a person", "No: you get an alert and call back", "Transfers by your rules; anything it isn’t sure about goes to a person", "Transfers with more routing rules"],
  ["After the call", "An alert to you with the caller’s number", "A summary of every call, sent to you", "Call details saved in your CRM, plus the summary"],
  ["Phone numbers", "Your existing number", "One number", "More than one number"],
  ["Setup", `${textBack.price} one-time`, `${voice.price}, quoted in writing`, `${advanced.price}, quoted in writing`],
  ["Monthly", `None needed (optional plan from ${starter.price})`, `Optional management ${voice.monthly}`, `Optional management ${advanced.monthly}`],
  ["Other companies’ costs", "Carrier texting registration, where your phone tool needs it", "Phone minutes and AI usage, billed to your own accounts", "Phone minutes and AI usage, billed to your own accounts"],
  ["Available", "Now", statusWords[voice.status], statusWords[voice.status]],
];

// A made-up call, shown as an example of the design. Not a recording, a live demo or a customer's system.
const call: ["ai" | "caller", string][] = [
  ["ai", "Thanks for calling Example Heating Co. You’re speaking with the company’s AI assistant. I can answer common questions, book a visit or take a message. How can I help?"],
  ["caller", "I’d like to get my furnace tuned up before winter."],
  ["ai", "I can book that. A tune-up visit takes about an hour. Which town are you in?"],
  ["caller", "Northfield."],
  ["ai", "Northfield is in the service area. The next openings are Tuesday at 9 a.m. or Wednesday at 1 p.m. Which suits you?"],
  ["caller", "Tuesday at 9."],
  ["ai", "Tuesday at 9 a.m. it is. What name should I put on the booking?"],
  ["caller", "Sam. And do you offer financing on a new furnace?"],
  ["ai", "I don’t have approved answers about financing, so I won’t guess. I’ll ask someone from the office to call you back about it. Is this the best number?"],
  ["caller", "Yes, it is."],
  ["ai", "You’re booked for a furnace tune-up on Tuesday at 9 a.m. You’ll get a text to confirm, and the office will call you about financing."],
];
const summary: [string, string][] = [
  ["Booked", "Furnace tune-up, Tuesday 9 a.m., Northfield"],
  ["Caller", "Sam (made up) and the number they called from"],
  ["Needs a person", "Asked about financing: not in the approved answers, callback promised"],
  ["Sent", "Booking confirmation by text"],
];
const limits: [IconName, string][] = [
  ["warningCircle", "It doesn’t give medical, legal or financial advice and doesn’t dispatch emergencies. Those calls go straight to a person or your normal line, by your rules."],
  ["lockSimple", "Calls are recorded only if you choose that, and callers are told at the start."],
  ["arrowsClockwise", "If the AI or a connection is down, calls ring through to your normal line or voicemail."],
  ["listChecks", "Before anything is built, a consultation checks that your phone system, calendar and CRM work with it, what the minutes will cost, and the texting and carrier rules."],
];

const asked = ["What’s the difference between missed-call text-back and the AI Voice Receptionist?", "Do you need my passwords?", "What if something breaks after launch?", "Do I have to sign up for a monthly plan?", "Do we need to get on a call?"];
const questions = asked.map((q) => faqs.find(([fq]) => fq === q)!);

const data = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${site}/automation/#service`,
  name: "Business automation and lead follow-up",
  serviceType: "Business process automation",
  url: `${site}/automation/`,
  provider: { "@id": `${site}/#business` },
  hasOfferCatalog: { "@id": `${site}/solutions/#catalog` },
};
---
<Base title="Business Automation, Lead Follow-Up & AI Receptionist · Nuxy Automation" description={`Lead follow-up (${flagship.price}), missed-call text-back (${textBack.price}), booking, invoice reminders and an AI Voice Receptionist, built in your own accounts.`} wide>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(data)} />

  <section class="au-hero cine-host">
    <CinematicLoop id="automation" backdrop eager />
    <div class="wrap au-grid">
      <div>
      <p class="eyebrow">AI &amp; business automation</p>
      <h1>Automations that answer, remind and follow up for you.</h1>
      <p class="lead">Every inquiry answered in seconds, missed calls texted back, quotes followed up, bookings with reminders and invoices that chase themselves. Built in the accounts you already have, at a price agreed in writing before you pay.</p>
      <div class="hero-actions">
        <a class="button" href="/contact/?want=automation" data-track="cta_automation_hero">Get My Free Automation Plan<Icon name="arrowRight" /></a>
        <a class="button secondary" href="/demos/#try"><Icon name="play" />Try the lead demo</a>
      </div>
      <ul class="hero-facts" role="list">
        <li><Icon name="lockSimple" />Built in your own accounts</li>
        <li><Icon name="bellSimple" />Every failure alerts us</li>
        <li><Icon name="shieldCheck" />An off switch you control</li>
      </ul>
      </div>
      <nav class="parts panel" aria-label="Automation services on this page">
        <ul role="list">
          {parts.map(([href, name, note, icon]) => (
            <li><a href={href}><Icon name={icon} /><span><strong>{name}</strong><span>{note}</span></span><Icon name="arrowRight" /></a></li>
          ))}
        </ul>
      </nav>
    </div>
  </section>

  <section class="section band" id="lead-response" aria-labelledby="flag-h">
    <div class="wrap flag">
      <div class="flag-copy">
        <p class="eyebrow">Most asked for</p>
        <h2 id="flag-h">{flagship.name}</h2>
        <p class="flag-fixes">Fixes: {flagship.fixes.charAt(0).toLowerCase() + flagship.fixes.slice(1)}</p>
        <p>{flagship.text}</p>
        <p class="flag-price"><strong>{flagship.price}</strong> one time</p>
        <p class="flag-costs">Other companies’ costs: {flagship.costs.charAt(0).toLowerCase() + flagship.costs.slice(1)}</p>
        <div class="flag-actions">
          <a class="button" href={`/contact/?service=${flagship.id}`} data-track="flagship_ask">Ask about lead follow-up</a>
          <a class="text-link" href="/demos/#try">Watch it handle one inquiry<Icon name="arrowRight" /></a>
        </div>
      </div>
      <ol class="flow" role="list">
        {flow.map(([title, text], i) => (
          <li>
            <span class="flow-num" aria-hidden="true">{i + 1}</span>
            <div><h3>{title}</h3><p>{text}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" id="leads" aria-labelledby="leads-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Leads, quotes &amp; customer follow-ups</p>
        <h2 id="leads-h">{leads.title}</h2>
        <p>{leads.lead}</p>
      </div>
      <div class="grid-3 cards">
        {leads.items.map((s) => <ServiceCard service={s} compact shownAbove={s.id === flagship.id ? "#lead-response" : undefined} />)}
      </div>
      <p class="note more-note">Want to be found on Google too? <a href="/solutions/#google-profile">{serviceById["google-profile"].name}</a> ({serviceById["google-profile"].price}) is part of our <a href="/websites/">website services</a>. Several of these together cost less as a <a href="/pricing/#bundles">bundle</a>.</p>
    </div>
  </section>

  <section class="section band" id="voice" aria-labelledby="voice-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Phone calls</p>
        <h2 id="voice-h">{voice.name}</h2>
        <p>{voice.text}</p>
      </div>
      <div class="voice-top">
        <div class="voice-offer panel">
          <span class="chip plain">{statusWords[voice.status]}</span>
          <p class="voice-price"><strong>{voice.price}</strong> setup; optional management {voice.monthly}</p>
          <p>{advanced.name}: {advanced.price} setup; optional management {advanced.monthly}. {advanced.text}</p>
          <p class="voice-costs">Other companies’ costs: {voice.costs.charAt(0).toLowerCase() + voice.costs.slice(1)}</p>
          <a class="button" href={`/contact/?service=${voice.id}`} data-track="voice_ask">Ask about a consultation</a>
        </div>
        <ul class="limits" role="list">
          {limits.map(([icon, text]) => <li><Icon name={icon} /><span>{text}</span></li>)}
        </ul>
      </div>

      <h3 class="voice-sub" id="voice-compare-h">Text-back, receptionist or advanced?</h3>
      <div class="table-scroll" role="region" aria-labelledby="voice-compare-h" tabindex="0">
        <table class="compare">
          <thead><tr><td></td><th scope="col">{textBack.name}</th><th scope="col">{voice.name}</th><th scope="col">Advanced receptionist</th></tr></thead>
          <tbody>{compare.map(([row, a, b, c]) => <tr><th scope="row">{row}</th><td>{a}</td><td>{b}</td><td>{c}</td></tr>)}</tbody>
        </table>
      </div>

      <article class="sim" aria-labelledby="sim-h">
        <div class="sim-head">
          <span class="chip plain">Simulated example</span>
          <h3 id="sim-h">How a receptionist is designed to handle a call</h3>
          <p>Example Heating Co. and its caller are made up. This is a written example of the design, not a recording, a live demo or a customer’s system.</p>
        </div>
        <div class="sim-body">
          <ol class="call" role="list" aria-label="Example call, made up">
            {call.map(([who, line]) => (
              <li class={who}><span class="who">{who === "ai" ? "AI receptionist" : "Caller"}</span><p>{line}</p></li>
            ))}
          </ol>
          <div class="sim-summary panel">
            <p class="sum-title"><Icon name="envelopeSimple" />Summary sent to the owner</p>
            <dl>
              {summary.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
            </dl>
          </div>
        </div>
      </article>
    </div>
  </section>

  <section class="section" id="admin" aria-labelledby="admin-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Admin automations</p>
        <h2 id="admin-h">{admin.title}</h2>
        <p>{admin.lead}</p>
      </div>
      <div class="grid-3 cards">
        {admin.items.map((s) => <ServiceCard service={s} compact />)}
        <div class="tile">
          <Icon name="question" />
          <h3>Something else eating your week?</h3>
          <p>Describe the task you keep repeating. If it can be automated safely you’ll get a written plan and price; if it isn’t worth automating, we’ll say so.</p>
          <a class="text-link" href="/contact/" data-track="cta_automation_other">Describe the problem<Icon name="arrowRight" /></a>
        </div>
        <div class="tile">
          <Icon name="storefront" />
          <h3>Selling online?</h3>
          <p>{serviceById.store.name} ({serviceById.store.price}), online ordering and gift cards are on the e-commerce page, next to the online shop itself.</p>
          <a class="text-link" href="/ecommerce/#extras">E-commerce services<Icon name="arrowRight" /></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section band" id="ai" aria-labelledby="ai-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">AI, used carefully</p>
        <h2 id="ai-h">{ai.title}</h2>
        <p>{ai.lead}</p>
      </div>
      <div class="grid-3 cards">
        {ai.items.map((s) => <ServiceCard service={s} compact />)}
        <div class="tile">
          <Icon name="sealCheck" />
          <h3>How AI is used here</h3>
          <ul class="ticks ai-ticks" role="list">
            <li><Icon name="check" /><span><strong>AI drafts, you approve.</strong> A drafted answer waits in your inbox for you to approve.</span></li>
            <li><Icon name="check" /><span><strong>Nothing is sent without your rules.</strong> What goes out on its own is named in your written plan first.</span></li>
            <li><Icon name="check" /><span><strong>Unsure or sensitive goes to a person.</strong> The AI hands it over instead of guessing.</span></li>
            <li><Icon name="check" /><span><strong>Tested on your real, messy data first.</strong> A dry run on a copy of your records before anything goes live.</span></li>
          </ul>
          <a class="text-link" href="/about/#how-we-work" data-track="ai_how_we_work">How a job runs<Icon name="arrowRight" /></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="safe-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">After launch</p>
        <h2 id="safe-h">How an automation keeps working</h2>
      </div>
      <ul class="keep" role="list">
        {keep.map((k) => (
          <li>
            <Icon name={k.icon} />
            <div><h3>{k.title}</h3><p>{k.text}</p></div>
          </li>
        ))}
      </ul>
      <p class="more-line"><a class="text-link" href="/pricing/#plans">Optional monthly plans, from {starter.price}<Icon name="arrowRight" /></a></p>
    </div>
  </section>

  <section class="section band" aria-labelledby="ex-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Working examples</p>
        <h2 id="ex-h">Four of these, running on made-up businesses</h2>
        <p>Each example shows a week of what came in, what went out and how messy data was handled. The code is open source.</p>
      </div>
      <ul class="ex-list" role="list">
        {examples.map((e) => (
          <li><a href={`/work/${e.slug}/`}><span>{e.title}</span><Icon name="arrowRight" /></a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-h">
    <div class="wrap faq-wrap">
      <div class="section-head">
        <p class="eyebrow">Questions</p>
        <h2 id="faq-h">Before you ask</h2>
      </div>
      <div class="faq">
        {questions.map(([q, a]) => (
          <details>
            <summary><span>{q}</span><Icon name="plus" /></summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
      <p class="more-line"><a class="text-link" href="/pricing/#faq">Questions about prices and paying<Icon name="arrowRight" /></a></p>
    </div>
  </section>

  <VideoUpsell />

  <section class="section">
    <div class="wrap">
      <div class="cta-band">
        <div>
          <h2>Find out what you could automate</h2>
          <p>Tell us what takes up your time. You’ll get a written plan and a price within one business day, or an honest “this isn’t worth automating”.</p>
        </div>
        <div class="cta-actions">
          <a class="button" href="/contact/?want=automation" data-track="cta_automation">Get My Free Automation Plan</a>
          <a class="button secondary" href="/pricing/">See prices</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .more-note { margin-top: 24px; }
  .au-hero { padding-block: clamp(40px, 6vw, 80px) clamp(48px, 7vw, 88px); }
  .au-grid { display: grid; gap: 40px 64px; }
  @media (min-width: 1024px) { .au-grid { grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); align-items: center; } }
  .parts { padding: 8px; }
  .parts ul { display: grid; margin: 0; padding: 0; list-style: none; }
  .parts li + li { border-top: 1px solid var(--hairline-soft); }
  .parts a { display: grid; grid-template-columns: 40px minmax(0, 1fr) auto; align-items: center; gap: 14px; min-height: 64px; padding: 12px 14px; border-radius: var(--r-md); color: var(--ink); text-decoration: none; }
  .parts a:hover { background: var(--surface-strong); color: var(--ink); }
  .parts a > :global(.icon:first-child) { width: 40px; height: 40px; padding: 9px; border-radius: 10px; background: var(--accent-soft); color: var(--link); }
  .parts a > span { display: grid; gap: 2px; }
  .parts a > span > span { color: var(--muted); font-size: 0.875rem; }
  .parts a > :global(.icon:last-child) { color: var(--link); }
  .au-hero h1 { max-width: 18ch; font-size: clamp(2.125rem, 1.5rem + 2.6vw, 3.25rem); }
  .au-hero .lead { margin-top: 18px; max-width: 60ch; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  @media (max-width: 479px) { .hero-actions .button { width: 100%; } }
  .hero-facts { display: flex; flex-wrap: wrap; gap: 10px 24px; margin: 28px 0 0; padding: 0; list-style: none; color: var(--body); font-size: 0.9375rem; }
  .hero-facts li { display: inline-flex; align-items: center; gap: 8px; }
  .hero-facts :global(.icon) { color: var(--cyan); }

  .flag { display: grid; gap: clamp(32px, 4vw, 56px); }
  @media (min-width: 960px) { .flag { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; } }
  .flag-copy { display: grid; gap: 14px; justify-items: start; color: var(--body); }
  .flag-copy .eyebrow { margin: 0; }
  .flag-copy h2 { color: var(--ink); }
  .flag-fixes { color: var(--cyan); font-weight: 500; }
  .flag-price { color: var(--muted); font-size: 0.9375rem; }
  .flag-price strong { margin-right: 4px; color: var(--ink); font-size: 1.75rem; font-weight: 700; letter-spacing: -0.02em; }
  .flag-costs { margin-top: -8px; color: var(--muted); font-size: 0.875rem; }
  .flag-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; margin-top: 6px; }
  .flag-actions .text-link { min-height: 44px; }
  @media (max-width: 479px) { .flag-actions .button { width: 100%; } }
  .flow { display: grid; gap: 0; margin: 0; padding: 0; list-style: none; }
  .flow li { position: relative; display: grid; grid-template-columns: 40px minmax(0, 1fr); gap: 16px; padding-bottom: 24px; }
  .flow li:not(:last-child)::before { content: ""; position: absolute; left: 19px; top: 44px; bottom: 4px; width: 2px; background: var(--hairline); }
  .flow-num { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--button); color: #fff; font-weight: 700; font-variant-numeric: tabular-nums; }
  .flow h3 { padding-top: 8px; font-size: 1.0625rem; }
  .flow p { margin-top: 4px; color: var(--body); font-size: 0.9375rem; }

  /* The receptionist: offer and limits, the comparison, then the labelled simulated call. */
  #voice .section-head p { max-width: 72ch; }
  .voice-top { display: grid; gap: 28px 48px; }
  @media (min-width: 960px) { .voice-top { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; } }
  .voice-offer { display: grid; gap: 12px; justify-items: start; padding: 24px; color: var(--body); font-size: 0.9375rem; }
  .voice-price { color: var(--muted); }
  .voice-price strong { margin-right: 4px; color: var(--ink); font-size: 1.5rem; font-weight: 700; letter-spacing: -0.02em; }
  .voice-costs { color: var(--muted); font-size: 0.875rem; }
  .voice-offer .button { margin-top: 4px; }
  @media (max-width: 479px) { .voice-offer .button { width: 100%; } }
  .limits { display: grid; gap: 16px; margin: 0; padding: 0; list-style: none; color: var(--body); font-size: 0.9375rem; }
  .limits li { display: grid; grid-template-columns: 24px minmax(0, 1fr); gap: 12px; align-items: start; }
  .limits :global(.icon) { width: 22px; height: 22px; margin-top: 1px; color: var(--cyan); }
  .voice-sub { margin: clamp(40px, 5vw, 56px) 0 14px; font-size: 1.25rem; }
  .table-scroll { overflow-x: auto; }
  .compare { width: 100%; min-width: 680px; border-collapse: collapse; font-size: 0.9375rem; }
  .compare th, .compare td { padding: 11px 14px 11px 0; border-top: 1px solid var(--hairline); text-align: left; vertical-align: top; }
  .compare tbody tr:last-child > * { border-bottom: 1px solid var(--hairline); }
  .compare thead th { width: 27%; color: var(--ink); font-weight: 650; }
  .compare tbody th { width: 19%; color: var(--muted); font-weight: 600; }
  .compare td { color: var(--body); }

  .sim { margin-top: clamp(40px, 5vw, 56px); padding: clamp(20px, 3vw, 32px); border: 1px dashed var(--hairline-strong); border-radius: var(--r-lg); }
