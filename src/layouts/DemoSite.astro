---
// Frame for the example websites at /example-sites/<slug>/ (data/demo-sites.ts). Each one is a made-up business, so
// this frame makes that impossible to miss and keeps it out of everything real:
// - a slim "Interactive demonstration by Nuxy Automation — fictional business." bar on every page, with "About this
//   demo" (the Built by Nuxy drawer), and a fictional-business line in every footer;
// - noindex,nofollow, and the sitemap leaves /example-sites/ out (pages/sitemap.xml.ts);
// - no analytics, no outside requests, .example email addresses and 555-01xx phone numbers;
// - every form uses method="dialog", so even with JavaScript off nothing leaves the browser; with JavaScript on,
//   submitting shows "Demo only: nothing was sent". Call, text, book and review buttons show a note instead.
// Each business brings its own look (fonts, colours, layout), so the Nuxy site styles are not loaded here. Pages move
// with the browser's cross-document view transitions (CSS only, 260 ms, never delaying the next page), switched off
// under reduced motion. lib/demo/tier.ts sets <html data-tier> for the effects (it runs before any of them).
import { createHash } from "node:crypto";
import { demoSiteBySlug } from "../data/demo-sites";

interface Props {
  slug: string;
  description: string;
  theme: string;
  /** the page's own name ("Get a quote"); the home page leaves it out */
  title?: string;
  /** font files to preload (the ones the first screen uses) */
  fonts?: string[];
  /** a class on <body>, for the business's own styles */
  bodyClass?: string;
}
const { slug, description, theme, title, fonts = ["/fonts/inter-var-latin.woff2"], bodyClass } = Astro.props;
const demo = demoSiteBySlug[slug];
const fullTitle = `${title ? `${title} · ` : ""}${demo.name} (demonstration) · Nuxy Automation`;
const about = `/examples/${slug}/`;
// The view-transition opt-in sits in a tiny inline style at the top of <head>, not in the bundled stylesheet: Chromium
// settles the opt-in on its first style pass, and on pages whose external stylesheets were not active yet it found
// none and aborted the transition ("ViewTransition opt-in disabled", fix row 25). Its hash goes into the page's CSP.
const optIn = "@view-transition{navigation:auto}";
Astro.csp?.insertStyleHash(`sha256-${createHash("sha256").update(optIn).digest("base64")}`);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <style is:inline set:html={optIn}></style>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content={theme} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    {fonts.map((f) => <link rel="preload" href={f} as="font" type="font/woff2" crossorigin />)}
  </head>
  <body class={bodyClass}>
    <a class="nx-skip" href="#main">Skip to content</a>
    <section class="demo-banner" aria-label="Demonstration notice">
      <p><strong><span class="nx-long">Interactive demonstration by Nuxy Automation</span><span class="nx-short">Demo by Nuxy Automation</span> — fictional business.</strong>
        <span class="nx-more">Nothing can be booked or bought, and nothing you type is sent.</span></p>
      <a class="nx-about" href={about} target="_top" data-nuxy-open>About this demo</a>
    </section>
    <slot />
    <a class="nx-pill" href={about} target="_top" data-nuxy-open aria-label="Built by Nuxy: what this demo shows">
      <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="M4 16V4l12 12V4" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
      Built by Nuxy
    </a>
    <dialog class="nx-drawer" aria-labelledby="nx-drawer-title" data-nuxy-drawer>
      <div class="nx-drawer-in">
        <div class="nx-drawer-top">
          <p class="nx-eyebrow">Built by Nuxy Automation</p>
          <button type="button" class="nx-close" data-nuxy-close aria-label="Close">
            <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="m5 5 10 10M15 5 5 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
          </button>
        </div>
        <h2 id="nx-drawer-title">What This Demo Shows</h2>
        <p class="nx-lead"><strong>{demo.name}</strong> is a fictional business. Nuxy Automation built this site to show
          what a {demo.project.toLowerCase()} can do, working end to end.</p>
        <ul class="nx-caps" role="list">
          {demo.capabilities.map((c) => <li><svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="m4.5 10.5 3.5 3.5 7.5-8" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>{c}</li>)}
        </ul>
        <div class="nx-safe">
          <p class="nx-safe-h">Switched off in this demo</p>
          <p>No payments, bookings, texts or emails are made. Nothing you type leaves this page, and photos stay in your browser.</p>
        </div>
        <div class="nx-ctas">
          <a class="nx-cta" href="/contact/" target="_top">Build something like this</a>
          <a class="nx-cta ghost" href={demo.cta.href} target="_top">{demo.cta.label}</a>
          <a class="nx-cta ghost" href={about} target="_top">About this example</a>
        </div>
      </div>
    </dialog>
    <div class="demo-toast" role="status" aria-live="polite" data-demo-toast></div>
  </body>
</html>

<style is:global>
  @font-face { font-family: "Inter"; src: url("/fonts/inter-var-latin.woff2") format("woff2"); font-weight: 100 900; font-style: normal; font-display: swap; }
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; text-size-adjust: 100%; scroll-behavior: smooth; scroll-padding-top: 96px; }
  body { margin: 0; font-family: "Inter", system-ui, -apple-system, "Segoe UI", sans-serif; line-height: 1.55; -webkit-font-smoothing: antialiased; }
  h1, h2, h3, h4, p, ul, ol, figure, dl, dd, fieldset, blockquote { margin: 0; }
  ul[role="list"], ol[role="list"] { list-style: none; padding: 0; }
  fieldset { border: 0; padding: 0; min-width: 0; }
  legend { padding: 0; }
  img, svg, canvas { display: block; max-width: 100%; }
  input, select, textarea, button { font: inherit; color: inherit; }
  button { cursor: pointer; }
  button:disabled { cursor: default; }
  :focus-visible { outline: 3px solid #2563eb; outline-offset: 2px; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  [hidden] { display: none !important; } /* page styles such as .form { display: grid } must not beat the hidden attribute */

  /* Reduced motion: no animation, no transition, and no delays either (a staggered list must not pop in piece by
     piece). Ambient loops in each demo are only switched on for tiers 1-2 (html[data-tier]), never by default. */
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { transition-duration: 0.01ms !important; transition-delay: 0s !important; animation-duration: 0.01ms !important; animation-delay: 0s !important; animation-iteration-count: 1 !important; }
  }

  /* Page to page: a short fade and rise, drawn by the browser after the next page has loaded (navigation is never
     held for it; the opt-in itself is the inline style at the top of <head>). The demo bar and each business's header
     stay still. Browsers without it simply change page. */
  ::view-transition-old(root) { animation: 140ms ease-in both nx-fade-out; }
  ::view-transition-new(root) { animation: 260ms cubic-bezier(0.2, 0.7, 0.2, 1) both nx-rise-in; }
  @keyframes nx-fade-out { to { opacity: 0; } }
  @keyframes nx-rise-in { from { opacity: 0; transform: translateY(8px); } }
  .demo-banner { view-transition-name: nx-bar; }
  @media (prefers-reduced-motion: reduce) { ::view-transition-group(*), ::view-transition-old(*), ::view-transition-new(*) { animation: none !important; } }
  :root[data-tier="3"]::view-transition-old(root), :root[data-tier="3"]::view-transition-new(root) { animation: none; }

  .nx-skip { position: absolute; left: 12px; top: -80px; z-index: 100; padding: 12px 16px; border-radius: 8px; background: #0e1311; color: #fff; font: 600 0.9375rem/1.2 "Inter", system-ui, sans-serif; text-decoration: none; }
  .nx-skip:focus { top: 52px; }

  /* the demonstration bar: slim, the same on all four sites, never hidden */
  .demo-banner { position: relative; z-index: 40; display: flex; align-items: center; justify-content: center; gap: 4px 14px; flex-wrap: wrap; min-height: 44px; padding: 0 12px; background: #0e1311; color: #f4f6f4; font: 500 0.8125rem/1.4 "Inter", system-ui, sans-serif; text-align: center; }
  .demo-banner p { padding: 6px 0; }
  .demo-banner strong { font-weight: 650; }
  .nx-more { color: #b9c2bd; margin-left: 4px; }
  .nx-short { display: none; }
  @media (max-width: 1099px) { .nx-more { display: none; } }
  @media (max-width: 599px) { .nx-long { display: none; } .nx-short { display: inline; } .demo-banner { justify-content: space-between; flex-wrap: nowrap; text-align: left; } .demo-banner p { flex: 1 1 auto; min-width: 0; } }
  .nx-about { display: inline-flex; align-items: center; min-height: 44px; color: #9fd3ff; font-weight: 650; text-underline-offset: 3px; white-space: nowrap; }
  .nx-about:hover { color: #cfe8ff; }

  .nx-pill { position: fixed; left: 20px; bottom: 20px; z-index: 45; display: none; align-items: center; gap: 8px; min-height: 40px; padding: 0 16px 0 12px; border-radius: 999px; background: #0e1311; color: #f4f6f4; font: 650 0.8125rem/1 "Inter", system-ui, sans-serif; text-decoration: none; box-shadow: 0 8px 24px rgba(0, 0, 0, 0.28), 0 0 0 1px rgba(255, 255, 255, 0.08) inset; transition: transform 180ms ease-out, box-shadow 180ms ease-out; }
  .nx-pill:hover { transform: translateY(-2px); box-shadow: 0 12px 28px rgba(0, 0, 0, 0.32), 0 0 0 1px rgba(255, 255, 255, 0.16) inset; }
  .nx-pill svg { color: #8ee4b4; }
  @media (min-width: 900px) { .nx-pill { display: inline-flex; } }
  /* Out of the way while the visitor scrolls down through the content (fix row 22); back on scroll up, near the top,
     and whenever it has keyboard focus. Opacity and transform only, so it never shifts the layout. */
  .nx-pill { transition: transform 220ms ease-out, opacity 220ms ease-out, box-shadow 180ms ease-out; }
  .nx-pill.is-away { opacity: 0; transform: translateY(16px); pointer-events: none; }
  .nx-pill.is-away:focus-visible { opacity: 1; transform: none; pointer-events: auto; }
  @media (prefers-reduced-motion: reduce) { .nx-pill { transition: none; } }

  /* the Built by Nuxy drawer: Nuxy's own look, whichever business it sits on */
  .nx-drawer { position: fixed; inset: auto 0 0 auto; width: min(440px, 100vw); max-width: 100vw; height: 100dvh; max-height: 100dvh; margin: 0; padding: 0; border: 0; background: #0e1311; color: #eef2ef; font-family: "Inter", system-ui, sans-serif; box-shadow: -24px 0 60px rgba(0, 0, 0, 0.35); overflow-y: auto; overscroll-behavior: contain; }
  .nx-drawer::backdrop { background: rgba(6, 9, 8, 0.55); }
  .nx-drawer[open] { animation: nx-drawer-in 280ms cubic-bezier(0.2, 0.7, 0.2, 1); }
  .nx-drawer[open]::backdrop { animation: nx-fade-in 280ms ease-out; }
  @keyframes nx-drawer-in { from { transform: translateX(40px); opacity: 0; } }
  @keyframes nx-fade-in { from { opacity: 0; } }
  @media (max-width: 599px) {
    .nx-drawer { inset: auto 0 0 0; width: 100vw; height: auto; max-height: 88dvh; border-radius: 18px 18px 0 0; }
    @keyframes nx-drawer-in { from { transform: translateY(40px); opacity: 0; } }
  }
  .nx-drawer-in { display: grid; align-content: start; gap: 18px; min-height: 100%; padding: 22px 24px 28px; }
  .nx-drawer-top { display: flex; align-items: center; justify-content: space-between; }
  .nx-eyebrow { font-size: 0.8125rem; font-weight: 650; letter-spacing: 0.08em; text-transform: uppercase; color: #8ee4b4; }
  .nx-close { display: grid; place-items: center; width: 44px; height: 44px; border: 0; border-radius: 10px; background: rgba(255, 255, 255, 0.06); color: #eef2ef; }
  .nx-close:hover { background: rgba(255, 255, 255, 0.12); }
  .nx-drawer :is(h2, h3, p, a, button) { font-family: inherit; }
  .nx-drawer h2 { font-size: 1.5rem; line-height: 1.2; font-weight: 700; letter-spacing: -0.01em; }
  .nx-lead { color: #c3ccc7; font-size: 0.9375rem; }
  .nx-lead strong { color: #fff; }
  .nx-caps { display: grid; gap: 10px; }
  .nx-caps li { display: grid; grid-template-columns: 18px 1fr; gap: 10px; align-items: start; font-size: 0.9375rem; }
  .nx-caps svg { margin-top: 2px; color: #8ee4b4; }
  .nx-safe { padding: 14px 16px; border-radius: 12px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.08); font-size: 0.875rem; color: #c3ccc7; }
  .nx-safe-h { color: #fff; font-weight: 650; margin-bottom: 4px; }
  .nx-ctas { display: grid; gap: 10px; }
  .nx-cta { display: flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 18px; border-radius: 12px; background: #8ee4b4; color: #06140c; font-weight: 700; text-decoration: none; transition: background-color 160ms ease-out, transform 160ms ease-out; }
  .nx-cta:hover { background: #b2f0cc; transform: translateY(-1px); }
  .nx-cta.ghost { background: transparent; color: #eef2ef; box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.18) inset; }
  .nx-cta.ghost:hover { background: rgba(255, 255, 255, 0.06); }

  .demo-sent { display: grid; gap: 10px; padding: 20px; border-radius: 12px; border: 1px solid currentColor; }
  .demo-sent strong { font-size: 1.0625rem; }

  .demo-toast { position: fixed; left: 50%; bottom: 88px; z-index: 60; width: max-content; max-width: calc(100vw - 32px); padding: 12px 16px; border-radius: 10px; background: #0e1311; color: #f4f6f4; font: 500 0.9375rem/1.4 "Inter", system-ui, sans-serif; box-shadow: 0 12px 32px rgba(0, 0, 0, 0.3); transform: translate(-50%, 12px); opacity: 0; pointer-events: none; transition: opacity 180ms ease-out, transform 220ms ease-out; }
  .demo-toast.show { opacity: 1; transform: translate(-50%, 0); }
  .demo-toast:empty { padding: 0; }
</style>

<script>
  import "../lib/demo/tier";

  // Demo actions: say what the button would do on a real site, instead of calling or booking anything.
  const toast = document.querySelector<HTMLElement>("[data-demo-toast]")!;
  let timer = 0;
  const say = (text: string) => {
    toast.textContent = text;
    toast.classList.add("show");
    clearTimeout(timer);
    timer = window.setTimeout(() => toast.classList.remove("show"), 4200);
  };
  document.addEventListener("demo:say", (e) => say((e as CustomEvent<string>).detail));
  document.addEventListener("click", (e) => {
    const el = (e.target as Element).closest<HTMLElement>("[data-demo-action]");
    if (!el) return;
    e.preventDefault();
    say(el.dataset.demoAction!);
  });

  // Demo forms: the browser checks required fields first (no novalidate), then the answers are cleared and the
  // "nothing was sent" panel takes the form's place.
  for (const form of document.querySelectorAll<HTMLFormElement>("form[data-demo-form]")) {
    const sent = document.getElementById(form.dataset.demoForm!) as HTMLElement | null;
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      form.reset();
      form.dispatchEvent(new Event("demo-reset"));
      if (!sent) return say("Demo only — nothing was sent.");
      form.hidden = true;
      sent.hidden = false;
      sent.focus();
    });
    sent?.querySelector("[data-demo-again]")?.addEventListener("click", () => {
      sent.hidden = true;
      form.hidden = false;
      form.querySelector<HTMLElement>("input, select, textarea")?.focus();
    });
  }

  // The Built by Nuxy drawer. Without JavaScript its openers are plain links to the example's page.
  const drawer = document.querySelector<HTMLDialogElement>("[data-nuxy-drawer]")!;
  let opener: HTMLElement | null = null;
  document.addEventListener("click", (e) => {
    const t = e.target as Element;
    const open = t.closest<HTMLElement>("[data-nuxy-open]");
    if (open && typeof drawer.showModal === "function") {
      e.preventDefault();
      opener = open;
      drawer.showModal();
      return;
    }
    if (t.closest("[data-nuxy-close]") || t === drawer) drawer.close(); // a click on the backdrop lands on the dialog itself
  });
  drawer.addEventListener("close", () => opener?.focus());

  // The pill steps aside while the page scrolls down, so it never sits on a card or a form field (fix row 22).
  const pill = document.querySelector<HTMLElement>(".nx-pill");
  if (pill) {
    let lastY = scrollY, queued = false;
    const place = () => {
      queued = false;
      const y = scrollY;
      if (y < 240 || y < lastY - 4) pill.classList.remove("is-away");
      else if (y > lastY + 4) pill.classList.add("is-away");
      lastY = y;
    };
    addEventListener("scroll", () => { if (!queued) { queued = true; requestAnimationFrame(place); } }, { passive: true });
  }
</script>
