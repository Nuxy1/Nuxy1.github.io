---
// Frame for the example websites at /example-sites/<slug>/ (data/demo-sites.ts). Each one is a made-up business, so
// this frame makes that impossible to miss and keeps it out of everything real:
// - a "Demonstration website" banner at the top of every page and a fictional-business line in every footer;
// - noindex,nofollow, and the sitemap leaves /example-sites/ out (pages/sitemap.xml.ts);
// - no analytics, no outside requests, .example email addresses and 555-01xx phone numbers;
// - every form uses method="dialog", so even with JavaScript off nothing leaves the browser; with JavaScript on,
//   submitting shows "Demo only: nothing was sent". Call, text, book and review buttons show a note instead.
// The pages bring their own look (each business has its own brand), so the Nuxy site styles are not loaded here.
import { demoSiteBySlug } from "../data/demo-sites";

interface Props { slug: string; description: string; theme: string }
const { slug, description, theme } = Astro.props;
const demo = demoSiteBySlug[slug];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{demo.name} (demonstration website) · Nuxy Automation</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content={theme} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/inter-var-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <section class="demo-banner" aria-label="Demonstration notice">
      <p><strong>Demonstration website by Nuxy Automation — not a real business.</strong> <span>Nothing here can be booked or bought, and forms send nothing.</span> <a href={`/examples/${slug}/`} target="_top">About this example</a></p>
    </section>
    <slot />
    <div class="demo-toast" role="status" aria-live="polite" data-demo-toast></div>
  </body>
</html>

<style is:global>
  @font-face { font-family: "Inter"; src: url("/fonts/inter-var-latin.woff2") format("woff2"); font-weight: 100 900; font-style: normal; font-display: swap; }
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; text-size-adjust: 100%; scroll-behavior: smooth; scroll-padding-top: 88px; }
  body { margin: 0; font-family: "Inter", system-ui, -apple-system, "Segoe UI", sans-serif; line-height: 1.55; -webkit-font-smoothing: antialiased; }
  h1, h2, h3, h4, p, ul, ol, figure, dl, dd, fieldset { margin: 0; }
  ul[role="list"], ol[role="list"] { list-style: none; padding: 0; }
  fieldset { border: 0; padding: 0; min-width: 0; }
  img, svg { display: block; max-width: 100%; }
  input, select, textarea, button { font: inherit; color: inherit; }
  button { cursor: pointer; }
  :focus-visible { outline: 3px solid #2563eb; outline-offset: 2px; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } *, *::before, *::after { transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; } }

  .demo-banner { background: #0b1220; color: #f8fafc; font: 500 0.875rem/1.45 "Inter", system-ui, sans-serif; text-align: center; }
  .demo-banner p { max-width: 1200px; margin: 0 auto; padding: 10px 16px; }
  .demo-banner strong { font-weight: 650; }
  .demo-banner span { color: #cbd5e1; }
  @media (max-width: 599px) { .demo-banner span { display: none; } }
  .demo-banner a { color: #7cb3ff; font-weight: 600; text-underline-offset: 3px; white-space: nowrap; }
  .demo-banner a:hover { color: #a5cbff; }

  .demo-sent { display: grid; gap: 10px; padding: 20px; border-radius: 12px; border: 1px solid currentColor; }
  [hidden] { display: none !important; } /* page styles such as .form { display: grid } must not beat the hidden attribute */
  .demo-sent strong { font-size: 1.0625rem; }

  .demo-toast { position: fixed; left: 50%; bottom: 88px; z-index: 50; width: max-content; max-width: calc(100vw - 32px); padding: 12px 16px; border-radius: 10px; background: #0b1220; color: #f8fafc; font: 500 0.9375rem/1.4 "Inter", system-ui, sans-serif; box-shadow: 0 12px 32px rgba(0, 0, 0, 0.3); transform: translate(-50%, 12px); opacity: 0; pointer-events: none; transition: opacity 180ms ease-out, transform 220ms ease-out; }
  .demo-toast.show { opacity: 1; transform: translate(-50%, 0); }
  .demo-toast:empty { padding: 0; }
</style>

<script>
  // Demo actions: say what the button would do on a real site, instead of calling or booking anything.
  const toast = document.querySelector<HTMLElement>("[data-demo-toast]")!;
  let timer = 0;
  const say = (text: string) => {
    toast.textContent = text;
    toast.classList.add("show");
    clearTimeout(timer);
    timer = window.setTimeout(() => toast.classList.remove("show"), 4200);
  };
  document.addEventListener("click", (e) => {
    const el = (e.target as Element).closest<HTMLElement>("[data-demo-action]");
    if (!el) return;
    e.preventDefault();
    say(el.dataset.demoAction!);
  });

  // Demo forms: the browser checks required fields first (no novalidate), then the answers are cleared and the
  // "nothing was sent" panel takes the form's place.
  for (const form of document.querySelectorAll<HTMLFormElement>("form[data-demo-form]")) {
    const sent = document.getElementById(form.dataset.demoForm!) as HTMLElement | null;
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      form.reset();
      form.dispatchEvent(new Event("demo-reset"));
      if (!sent) return say("Demo only — nothing was sent.");
      form.hidden = true;
      sent.hidden = false;
      sent.focus();
    });
    sent?.querySelector("[data-demo-again]")?.addEventListener("click", () => {
      sent.hidden = true;
      form.hidden = false;
      form.querySelector<HTMLElement>("input, select, textarea")?.focus();
    });
  }
</script>
