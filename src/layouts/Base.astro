---
// Every page's frame: head tags, the design tokens (DESIGN.md), header, footer, old-link redirects and the
// anonymous page counter. `wide` pages lay out their own sections; other pages get the reading column (.page).
import Mark from "../components/Mark.astro";
import Icon from "../components/Icon.astro";
import MotionControl from "../components/MotionControl.astro";
import "../styles/motion.css";
import { inbox } from "../data/site";
import { groups, plans, retired } from "../data/services";

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
  noindex?: boolean;
  image?: string;
}
const {
  title,
  description = "Websites, online stores and automations for small businesses, built in your own accounts at fixed, published prices. Faribault, MN.",
  wide = false,
  noindex = false,
  image = "/og.jpg",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const path = Astro.url.pathname;

// Five things in the header (conversion brief, 2026-11): Services opens a short list, the rest are single pages.
// Home is the name on the left and Contact is the quote button; both are also in the phone menu and the footer.
const serviceNav: [string, string][] = [
  ["AI & Business Automation", "/automation/"],
  ["AI Voice Receptionist", "/automation/#voice"],
  ["Business Websites", "/websites/"],
  ["E-Commerce", "/ecommerce/"],
  ["Website Repairs & Security", "/website-security/"],
  ["Video & Creative Studio", "/creative-studio/"],
  ["All Services", "/solutions/"],
];
const nav: [string, string][] = [
  ["Pricing", "/pricing/"],
  ["Demos", "/demos/"],
  ["Our Work", "/portfolio/"],
  ["About", "/about/"],
];
const current = (href: string) => (href === "/" ? path === "/" : !href.includes("#") && path.startsWith(href));
const inServices = serviceNav.some(([, href]) => current(href)) || path.startsWith("/get-a-website/");

// The old one-page site's anchors (outreach emails link to /#<service id>): sent on to where each now lives.
const legacy: Record<string, string> = { request: "/contact/", services: "/solutions/", kinds: "/solutions/", plans: "/pricing/#plans", faq: "/pricing/#faq", work: "/demos/#technical", keep: "/about/#how-we-work", "reviews-from-clients": "/",
  // homepage sections that were renamed or moved in the conversion upgrade (2026-11)
  "what-we-build": "/#what-we-do", why: "/#why-nuxy", ownership: "/websites/#ownership" };
for (const g of groups) {
  for (const s of g.items) legacy[s.id] = `/solutions/#${s.id}`;
  for (const old of g.legacy) legacy[old] = `/solutions/#${g.id}`;
}
for (const p of plans) legacy[p.id] = `/pricing/#${p.id}`;
for (const [old, now] of Object.entries(retired)) legacy[old] = `/pricing/#${now}`;
const isHome = path === "/";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#0B1220" />
    <meta name="color-scheme" content="dark" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Nuxy Automation" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/inter-var-latin.woff2" as="font" type="font/woff2" crossorigin />
    {isHome && <script is:inline define:vars={{ legacy }}>
      // (runs before the page draws, so an old link never flashes the homepage first)
      // (only the old names listed above: "constructor" and the like are on every object and are not a link, and a
      // badly encoded hash is ignored)
      try {
        var old = decodeURIComponent(location.hash.slice(1));
        if (Object.prototype.hasOwnProperty.call(legacy, old) && typeof legacy[old] === "string") location.replace(legacy[old]);
      } catch (e) {}
    </script>}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-head">
      <div class="wrap head-row">
        <a class="brand" href="/" aria-label="Nuxy Automation, home"><Mark class="brand-mark" label="" /><span>Nuxy Automation</span></a>
        <nav class="nav" aria-label="Main">
          <ul class="nav-list">
            <li>
              {/* (a plain <details>: it opens by click, tap, Enter or Space and needs no script; the script below
                  adds Escape, a click outside and closing when focus moves on) */}
              <details class="drop" data-drop>
                <summary class:list={["nav-link", { "is-current": inServices }]}>Services<Icon name="caretDown" /></summary>
                <ul class="drop-panel">
                  {serviceNav.map(([name, href]) => <li><a href={href} aria-current={current(href) ? "page" : undefined}>{name}</a></li>)}
                </ul>
              </details>
            </li>
            {nav.map(([name, href]) => <li><a class="nav-link" href={href} aria-current={current(href) ? "page" : undefined}>{name}</a></li>)}
          </ul>
        </nav>
        <a class="button small head-cta" href="/contact/" data-track="cta_header">Get a Free Quote</a>
        <details class="menu" data-menu>
          <summary aria-label="Menu"><Icon name="list" /><Icon name="x" /></summary>
          <div class="menu-panel">
            <p class="menu-label" id="menu-services">Services</p>
            <ul aria-labelledby="menu-services">
              {serviceNav.map(([name, href]) => <li><a href={href} aria-current={current(href) ? "page" : undefined}>{name}</a></li>)}
            </ul>
            <p class="menu-label" id="menu-more">Nuxy</p>
            <ul aria-labelledby="menu-more">
              {[...nav, ["Contact", "/contact/"]].map(([name, href]) => <li><a href={href} aria-current={current(href) ? "page" : undefined}>{name}</a></li>)}
            </ul>
            <a class="button" href="/contact/" data-track="cta_menu">Get a Free Quote</a>
          </div>
        </details>
      </div>
    </header>

    <main id="main" class={wide ? "" : "wrap page"}>
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap">
        <div class="foot-top">
          <div class="foot-brand">
            <a class="brand" href="/"><Mark class="brand-mark" label="" /><span>Nuxy Automation</span></a>
            <p>Websites, online stores and automations for small businesses, built in the tools you already use. Based in Faribault, Minnesota, working with southern Minnesota, the Twin Cities and remotely across the US.</p>
            <a class="foot-mail" href={`mailto:${inbox}`}><Icon name="envelopeSimple" />{inbox}</a>
          </div>
          <nav class="foot-cols" aria-label="Footer">
            <div>
              <h2>Services</h2>
              <ul>
                <li><a href="/websites/">Business websites</a></li>
                <li><a href="/websites/#redesign">Website redesign</a></li>
                <li><a href="/ecommerce/">E-commerce stores</a></li>
                <li><a href="/automation/">Business automation</a></li>
                <li><a href="/website-security/">Website security &amp; repairs</a></li>
                <li><a href="/creative-studio/">Video &amp; creative studio</a></li>
                <li><a href="/get-a-website/">No website yet?</a></li>
                <li><a href="/solutions/">All services</a></li>
              </ul>
            </div>
            <div>
              <h2>Company</h2>
              <ul>
                <li><a href="/about/#how-we-work">How it works</a></li>
                <li><a href="/pricing/">Pricing and plans</a></li>
                <li><a href="/about/">About</a></li>
                <li><a href="/contact/">Contact</a></li>
              </ul>
            </div>
            <div>
              <h2>See the work</h2>
              <ul>
                <li><a href="/portfolio/">Portfolio</a></li>
                <li><a href="/demos/">Interactive demos</a></li>
                <li><a href="/demos/#technical">Technical projects</a></li>
                <li><a href="/docs/">Docs</a></li>
              </ul>
            </div>
          </nav>
        </div>
        <div class="legal">
          <p>© 2026 Nuxy Automation, Faribault, Minnesota</p>
          <MotionControl />
          <p><a href="/policies/">Policies and privacy</a><span aria-hidden="true">·</span>No cookies, no personal tracking<span aria-hidden="true">·</span><a href="https://github.com/Nuxy1">GitHub</a></p>
        </div>
      </div>
    </footer>

    <script>
      // Astro builds this script and lists its hash in the page's security policy (astro.config.mjs), so the
      // browser runs it; a script typed straight into the page (is:inline) would be blocked unless it sits above
      // the policy in <head>, like the old-link redirect.
      import { hitUrl } from "../data/site";

      // The phone menu and the Services list: each closes on a link, a click outside or Escape (focus goes back to
      // its button), and the Services list also closes when the keyboard moves on past it.
      for (const menu of document.querySelectorAll<HTMLDetailsElement>("[data-menu], [data-drop]")) {
        menu.addEventListener("click", (e) => { if ((e.target as Element).closest("a")) menu.open = false; });
        document.addEventListener("click", (e) => { if (menu.open && !menu.contains(e.target as Node)) menu.open = false; });
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && menu.open) { menu.open = false; menu.querySelector("summary")?.focus(); }
        });
        if (menu.hasAttribute("data-drop")) menu.addEventListener("focusout", (e) => {
          const to = (e as FocusEvent).relatedTarget as Node | null;
          if (to && !menu.contains(to)) menu.open = false;
        });
      }

      // Anonymous counts: an event name and the page path, sent to our own server, counted per day. No cookies, no
      // IP address stored, nothing typed into a form, and nothing at all when the browser asks not to be tracked. Only
      // the real site counts, so local previews, tests and copies of the site add nothing.
      const hit = import.meta.env.DEV ? "" : hitUrl;
      const host = new URL(import.meta.env.SITE).hostname;
      const real = location.hostname === host || location.hostname === "www." + host;
      const nav = navigator as Navigator & { globalPrivacyControl?: boolean };
      const off = !hit || !real || nav.doNotTrack === "1" || nav.globalPrivacyControl === true || !nav.sendBeacon;
      const send = (e: string) => {
        if (off) return;
        const body = new URLSearchParams({ e, p: location.pathname });
        if (e === "view") {
          try { const h = new URL(document.referrer).hostname; if (h && h !== location.hostname) body.set("r", h); } catch {}
        }
        try { nav.sendBeacon(hit, body); } catch {}
      };
      (window as unknown as { nuxyTrack: (e: string) => void }).nuxyTrack = send;
      send("view");
      document.addEventListener("click", (ev) => {
        const t = (ev.target as Element).closest?.<HTMLElement>("[data-track], a[href^='mailto:']");
        if (t) send(t.dataset.track || "email_click");
      });
    </script>
    <script>
      // Motion level, section reveals and the footer's Motion choice (src/scripts/motion.ts)
      import "../scripts/motion";
    </script>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Inter";
    src: url("/fonts/inter-var-latin.woff2") format("woff2");
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  /* Arial sized to Inter's metrics, so the swap moves nothing (CLS 0) */
  @font-face {
    font-family: "Inter Fallback";
    src: local("Arial");
    ascent-override: 90.49%;
    descent-override: 22.56%;
    line-gap-override: 0%;
    size-adjust: 107.06%;
  }

  :root {
    color-scheme: dark;
    /* brief palette */
    --bg: #0b1220;
    --bg-2: #111c30;
    --panel: #162238;
    --blue: #3b82f6;
    --cyan: #22d3ee;
    --ink: #f8fafc;
    --muted: #94a3b8;
    /* derived */
    --body: #cbd5e1;
    --surface: var(--bg-2);
    --surface-strong: #1c2a44;
    --hairline: #233350;
    --hairline-soft: #1a2741;
    --hairline-strong: #33466b;
    --accent: var(--blue);
    --accent-soft: rgba(59, 130, 246, 0.16);
    --on-accent: #ffffff;
    --button: #2563eb;
    --button-hover: #1d4ed8;
    --link: #7cb3ff;
    --focus: #93c5fd;
    --ok: #34d399;
    --warn: #fbbf24;
    --bad: #f87171;
    --shadow: 0 1px 2px rgba(2, 6, 23, 0.5), 0 12px 32px rgba(2, 6, 23, 0.35);
    --r-sm: 8px;
    --r-md: 12px;
    --r-lg: 18px;
    --r-full: 999px;
    --nav-h: 64px;
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
    --font: "Inter", "Inter Fallback", ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    --mono: ui-monospace, "Cascadia Code", "SF Mono", Menlo, Consolas, monospace;
  }

  *, *::before, *::after { box-sizing: border-box; }
  [hidden] { display: none !important; }
  html { -webkit-text-size-adjust: 100%; text-size-adjust: 100%; scroll-padding-top: calc(var(--nav-h) + 16px); }
  @media (prefers-reduced-motion: no-preference) { html { scroll-behavior: smooth; } }
  body {
    margin: 0; min-height: 100vh; display: flex; flex-direction: column;
    background: var(--bg); color: var(--body);
    font: 400 1rem/1.6 var(--font); font-feature-settings: "cv11", "ss01";
    -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale;
  }
  main { flex: 1; }
  img, svg, video { display: block; max-width: 100%; }
  img, video { height: auto; }
  h1, h2, h3, h4 { color: var(--ink); margin: 0; font-weight: 650; letter-spacing: -0.02em; line-height: 1.2; text-wrap: balance; }
  h1 { font-size: clamp(2.25rem, 1.3rem + 3.6vw, 3.75rem); font-weight: 700; letter-spacing: -0.035em; line-height: 1.06; }
  h2 { font-size: clamp(1.75rem, 1.25rem + 1.9vw, 2.5rem); letter-spacing: -0.03em; line-height: 1.12; }
  h3 { font-size: 1.1875rem; }
  h4 { font-size: 1.0625rem; }
  p { margin: 0; text-wrap: pretty; }
  a { color: var(--link); text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
  a:hover { color: var(--ink); }
  strong { color: var(--ink); font-weight: 600; }
  ul, ol { margin: 0; padding: 0; }
  button, input, select, textarea { font: inherit; color: inherit; }
  :focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; border-radius: 4px; }
  ::selection { background: rgba(59, 130, 246, 0.4); color: #fff; }

  .wrap { width: 100%; max-width: 1200px; margin-inline: auto; padding-inline: clamp(16px, 4vw, 40px); }
  .icon { width: 1.25em; height: 1.25em; flex: none; }
  .sr-only { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  .skip { position: absolute; left: 16px; top: -80px; z-index: 100; padding: 10px 16px; border-radius: var(--r-sm); background: var(--ink); color: var(--bg); font-weight: 600; }
  .skip:focus { top: 12px; }

  /* Buttons */
  .button {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    min-height: 48px; padding: 0 22px; border: 1px solid transparent; border-radius: 10px;
    background: var(--button); color: #fff; font-weight: 600; font-size: 1rem; line-height: 1.2; text-align: center;
    text-decoration: none; cursor: pointer; transition: background-color 160ms ease-out, border-color 160ms ease-out, transform 160ms var(--ease);
  }
  .button:hover { background: var(--button-hover); color: #fff; }
  .button:active { transform: translateY(1px); }
  .button.secondary { background: transparent; border-color: var(--hairline-strong); color: var(--ink); }
  .button.secondary:hover { background: rgba(148, 163, 184, 0.08); border-color: #46608f; }
  .button.small { min-height: 44px; padding: 0 16px; font-size: 0.9375rem; }
  .button.wide { width: 100%; }
  .button.pill { border-radius: var(--r-full); }
  .button .icon { width: 1.1em; height: 1.1em; }
  .text-link { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; text-decoration: none; }
  .text-link .icon { width: 1em; height: 1em; transition: transform 160ms var(--ease); }
  .text-link:hover .icon { transform: translateX(3px); }

  /* Shared section pieces */
  .section { padding-block: clamp(64px, 9vw, 112px); }
  .section.tight { padding-block: clamp(48px, 6vw, 72px); }
  .band { background: var(--bg-2); border-block: 1px solid var(--hairline-soft); }
  .section-head { max-width: 720px; margin-bottom: clamp(32px, 4vw, 48px); }
  .section-head.center { margin-inline: auto; text-align: center; }
  .section-head p:not(.eyebrow) { margin-top: 14px; font-size: 1.125rem; color: var(--muted); }
  .eyebrow { display: inline-flex; align-items: center; gap: 8px; margin: 0 0 14px; color: var(--cyan); font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; }
  .panel { background: var(--panel); border: 1px solid var(--hairline); border-radius: var(--r-lg); }
  .chip { display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: var(--r-full); background: rgba(34, 211, 238, 0.1); color: var(--cyan); font-size: 0.8125rem; font-weight: 600; line-height: 1.3; }
  .chip.blue { background: var(--accent-soft); color: var(--link); }
  .chip.plain { background: var(--surface-strong); color: var(--body); }
  .ticks { display: grid; gap: 10px; list-style: none; }
  .ticks li { display: flex; gap: 10px; align-items: flex-start; }
  .ticks .icon { color: var(--cyan); margin-top: 0.15em; width: 1.15em; height: 1.15em; }
  .note { font-size: 0.9375rem; color: var(--muted); }
  .grid-2 { display: grid; gap: 20px; }
  .grid-3 { display: grid; gap: 20px; }
  .grid-4 { display: grid; gap: 20px; }
  @media (min-width: 720px) { .grid-2, .grid-3, .grid-4 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .grid-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); } .grid-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); } }

  /* Questions (a list of details) and the closing call-to-action band, shared by the service and pricing pages */
  .faq-wrap { max-width: 860px; }
  .faq { display: grid; margin-top: 24px; border-top: 1px solid var(--hairline); }
  .faq details { border-bottom: 1px solid var(--hairline); }
  .faq summary { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 18px 0; min-height: 44px; color: var(--ink); font-weight: 600; cursor: pointer; list-style: none; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary .icon { flex: none; color: var(--muted); transition: transform 200ms var(--ease); }
  .faq details[open] summary .icon { transform: rotate(45deg); }
  .faq details p { padding: 0 0 20px; max-width: 70ch; color: var(--body); }
  @media (prefers-reduced-motion: reduce) { .faq summary .icon { transition: none; } }

  .cta-band { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px 32px; padding: clamp(24px, 4vw, 40px); border: 1px solid rgba(59, 130, 246, 0.4); border-radius: var(--r-lg); background: rgba(37, 99, 235, 0.1); }
  .cta-band h2 { font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2rem); }
  .cta-band p { margin-top: 8px; max-width: 60ch; color: var(--body); }
  .cta-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  @media (max-width: 559px) { .cta-actions, .cta-actions .button { width: 100%; } }

  /* (.reveal, the gentle scroll-in, is in styles/motion.css: it runs once, set off by src/scripts/motion.ts) */

  /* Header */
  .site-head {
    position: sticky; top: 0; z-index: 50; height: var(--nav-h);
    background: rgba(11, 18, 32, 0.86); border-bottom: 1px solid var(--hairline-soft);
    backdrop-filter: saturate(140%) blur(12px);
  }
  .head-row { display: flex; align-items: center; gap: 16px; height: 100%; }
  .brand { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); font-weight: 650; font-size: 1.0625rem; letter-spacing: -0.01em; text-decoration: none; white-space: nowrap; }
  .brand:hover { color: var(--ink); }
  .brand-mark { width: 30px; height: 30px; }
  .nav { display: none; margin-left: auto; }
  .nav-list { display: flex; gap: 4px; list-style: none; }
  .nav-link { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; padding: 0 14px; border-radius: var(--r-sm); color: var(--body); font-size: 0.9375rem; font-weight: 500; text-decoration: none; white-space: nowrap; transition: color var(--dur-1) ease, background-color var(--dur-1) ease; }
  .nav-link:hover { color: var(--ink); background: rgba(148, 163, 184, 0.08); }
  .nav-link[aria-current="page"], .nav-link.is-current { color: var(--ink); background: rgba(148, 163, 184, 0.1); }
  /* Services: a short list under its button */
  .drop { position: relative; }
  .drop > summary { cursor: pointer; list-style: none; user-select: none; }
  .drop > summary::-webkit-details-marker { display: none; }
  .drop > summary .icon { width: 14px; height: 14px; transition: transform var(--dur-1) ease; }
  .drop[open] > summary { color: var(--ink); background: rgba(148, 163, 184, 0.1); }
  .drop[open] > summary .icon { transform: rotate(180deg); }
  .drop-panel {
    position: absolute; top: calc(100% + 10px); left: 0; z-index: 60; display: grid; min-width: 272px; padding: 8px;
    list-style: none; border: 1px solid var(--hairline-strong); border-radius: var(--r-md); background: var(--panel); box-shadow: var(--shadow);
  }
  .drop[open] > .drop-panel { animation: drop-in var(--dur-1) var(--ease-out); }
  @keyframes drop-in { from { opacity: 0; transform: translateY(-4px); } }
  .drop-panel a { display: flex; align-items: center; min-height: 44px; padding: 0 12px; border-radius: var(--r-sm); color: var(--ink); font-size: 0.9375rem; font-weight: 500; text-decoration: none; white-space: nowrap; }
  .drop-panel a:hover { background: rgba(148, 163, 184, 0.1); }
