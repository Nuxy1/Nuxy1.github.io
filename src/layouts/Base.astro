---
// The page frame: white canvas, near-black ink, one coral accent, soft rounded shapes (DESIGN.md). Light or dark
// follows the visitor's system. No client-side JavaScript is needed to read or use any page.
// wide: the page lays out its own full-width sections (the homepage); otherwise a readable column.
import Mark from "../components/Mark.astro";
import Icon from "../components/Icon.astro";

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
}
const { title, description = "Automations, integrations and websites for small businesses of every kind. Fixed prices, no calls. Faribault, Minnesota.", wide = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImage = new URL(`${base}/og.jpg`, Astro.site);
const inbox = "nuxy@nuxyautomation.com";
const sections = [["Services", "services"], ["Plans", "plans"], ["How it works", "how"], ["Projects", "work"]];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Nuxy Automation" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Nuxy Automation: never lose a booking while you’re with a client." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121212" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={`${base}/favicon.ico`} sizes="48x48" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="preload" href={`${base}/fonts/figtree-var.woff2`} as="font" type="font/woff2" crossorigin />
    <style is:global>
      @font-face { font-family: "Figtree"; font-weight: 300 900; font-display: swap; src: url("/fonts/figtree-var.woff2") format("woff2"); }
      :root {
        --bg: #ffffff; --surface: #f7f7f7; --surface-strong: #f0f0f0;
        --ink: #222222; --body: #3f3f3f; --muted: #6a6a6a; --hairline: #dddddd; --hairline-soft: #ebebeb;
        --accent: #dc2453; --accent-press: #b8143f; --accent-text: #c81d4a; --accent-soft: #fdecf0; --on-accent: #ffffff;
        /* the one shadow: cards when lifted, the menu, the request card */
        --shadow: 0 0 0 1px rgb(0 0 0 / 0.02), 0 2px 6px rgb(0 0 0 / 0.04), 0 4px 8px rgb(0 0 0 / 0.1);
        --shadow-lift: 0 0 0 1px rgb(0 0 0 / 0.02), 0 6px 16px rgb(0 0 0 / 0.08), 0 12px 24px rgb(0 0 0 / 0.1);
        --r-sm: 8px; --r-md: 14px; --r-lg: 20px; --r-full: 999px;
        --font: "Figtree", -apple-system, system-ui, "Segoe UI", Roboto, "Helvetica Neue", sans-serif;
        --nav-h: 72px;
        --ease: cubic-bezier(0.16, 1, 0.3, 1);
        color-scheme: light dark;
        accent-color: var(--accent);
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #121212; --surface: #1b1b1b; --surface-strong: #262626;
          --ink: #f3f3f3; --body: #d2d2d2; --muted: #a3a3a3; --hairline: #343434; --hairline-soft: #282828;
          --accent-text: #ff7d97; --accent-soft: #3b1621;
          --shadow: 0 0 0 1px rgb(255 255 255 / 0.06), 0 2px 6px rgb(0 0 0 / 0.3), 0 4px 8px rgb(0 0 0 / 0.4);
          --shadow-lift: 0 0 0 1px rgb(255 255 255 / 0.08), 0 6px 16px rgb(0 0 0 / 0.4), 0 12px 24px rgb(0 0 0 / 0.45);
        }
      }
      *, *::before, *::after { box-sizing: border-box; }
      html { scroll-behavior: smooth; -webkit-tap-highlight-color: transparent; -webkit-text-size-adjust: 100%; }
      @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
      body { margin: 0; background: var(--bg); color: var(--body); font: 400 1rem/1.55 var(--font); -webkit-font-smoothing: antialiased; }
      h1, h2, h3, h4 { color: var(--ink); text-wrap: balance; letter-spacing: -0.012em; }
      p, li { text-wrap: pretty; }
      ::selection { background: var(--accent-soft); color: var(--ink); }
      a { color: var(--ink); text-decoration-thickness: from-font; text-underline-offset: 0.18em; }
      a:hover { color: var(--accent-text); }
      a, button, summary, label { touch-action: manipulation; }
      :focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; border-radius: 4px; }
      [id] { scroll-margin-top: calc(var(--nav-h) + 20px); }
      img, video { display: block; max-width: 100%; height: auto; }
      .wrap { max-width: 1200px; margin-inline: auto; padding-inline: clamp(16px, 4vw, 40px); }
      .icon { width: 1.25em; height: 1.25em; flex: none; }
      .skip { position: absolute; left: 16px; top: -100px; z-index: 30; background: var(--ink); color: var(--bg); padding: 10px 16px; border-radius: var(--r-sm); text-decoration: none; }
      .skip:focus { top: 12px; color: var(--bg); }

      /* Buttons: coral for the one action (Request a setup), outlined for everything else. */
      .button {
        display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 48px; padding: 0 24px;
        border: 0; border-radius: var(--r-sm); background: var(--accent); color: var(--on-accent); font: 600 1rem/1.25 var(--font);
        text-decoration: none; white-space: nowrap; cursor: pointer;
        transition: background-color 160ms ease-out, box-shadow 160ms ease-out, transform 120ms ease-out;
      }
      .button:hover { background: var(--accent-press); color: var(--on-accent); }
      .button:active { transform: scale(0.98); }
      .button.secondary { background: transparent; color: var(--ink); box-shadow: inset 0 0 0 1px var(--ink); }
      .button.secondary:hover { background: var(--surface); color: var(--ink); }
      .button.pill { min-height: 40px; padding: 0 18px; border-radius: var(--r-full); font-size: 0.9375rem; }
      @media (prefers-reduced-motion: reduce) { .button { transition: none; } .button:active { transform: none; } }

      /* Sections rise into place as they scroll in (browsers with scroll-driven animations; elsewhere they're simply there). */
      @media (prefers-reduced-motion: no-preference) {
        @supports (animation-timeline: view()) {
          .reveal { animation: rise linear both; animation-timeline: view(); animation-range: entry 0% entry 40%; }
        }
      }
      @keyframes rise { from { opacity: 0; transform: translateY(28px); } }

      .site-head { position: sticky; top: 0; z-index: 20; background: var(--bg); border-bottom: 1px solid var(--hairline-soft); }
      .head-inner { height: var(--nav-h); display: flex; align-items: center; justify-content: space-between; gap: 16px; }
      .brand { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); font-weight: 700; font-size: 1.125rem; letter-spacing: -0.015em; text-decoration: none; white-space: nowrap; }
      .brand:hover { color: var(--ink); }
      .brand svg { width: 34px; height: 34px; }
      .nav { display: flex; align-items: center; gap: 4px; }
      .nav-link { padding: 10px 14px; border-radius: var(--r-full); color: var(--ink); font-weight: 600; font-size: 0.9375rem; text-decoration: none; transition: background-color 160ms ease-out; }
      .nav-link:hover { background: var(--surface); color: var(--ink); }
      .nav .button { margin-left: 8px; }
      .menu { display: none; position: relative; }
      .menu summary {
        display: grid; place-items: center; width: 44px; height: 44px; border-radius: var(--r-full); list-style: none; cursor: pointer;
        color: var(--ink); box-shadow: inset 0 0 0 1px var(--hairline); transition: box-shadow 160ms ease-out;
      }
      .menu summary::-webkit-details-marker { display: none; }
      .menu summary:hover, .menu[open] summary { box-shadow: inset 0 0 0 1px var(--hairline), var(--shadow); }
      .menu-panel {
        position: absolute; right: 0; top: calc(100% + 10px); min-width: 230px; padding: 8px 0; margin: 0; list-style: none;
        background: var(--bg); border-radius: var(--r-md); box-shadow: var(--shadow-lift);
      }
      .menu-panel a { display: block; padding: 12px 18px; color: var(--ink); font-weight: 500; text-decoration: none; }
      .menu-panel a:hover { background: var(--surface); }
      .menu-panel li + li.split { border-top: 1px solid var(--hairline-soft); margin-top: 8px; padding-top: 8px; }
      @media (max-width: 860px) {
        .nav-link { display: none; }
        .menu { display: block; }
      }
      @media (max-width: 520px) { .nav .button { display: none; } }

      /* Inner pages: a readable column. */
      .page { max-width: 760px; margin: 0 auto; padding: 40px clamp(16px, 4vw, 24px) 88px; }
      .page h1 { font-size: clamp(2rem, 4.2vw, 2.75rem); line-height: 1.1; letter-spacing: -0.025em; margin: 8px 0 16px; }
      .page h2 { font-size: 1.5rem; line-height: 1.2; margin: 48px 0 12px; }
      .page h3 { font-size: 1.125rem; line-height: 1.3; margin: 32px 0 8px; }
      .page ul, .page ol { padding-left: 1.25em; }
      .page li + li { margin-top: 8px; }
      .page img { border-radius: var(--r-md); }
      .lead { font-size: 1.1875rem; line-height: 1.55; color: var(--body); max-width: 62ch; }
      pre { background: var(--surface); border: 1px solid var(--hairline-soft); border-radius: var(--r-md); padding: 16px; overflow-x: auto; font-size: 0.85rem; line-height: 1.5; }
      code { font-family: ui-monospace, "Cascadia Code", Consolas, monospace; font-size: 0.9em; }
      :not(pre) > code { background: var(--surface-strong); border-radius: 6px; padding: 0.1em 0.35em; }
      table { border-collapse: collapse; width: 100%; display: block; overflow-x: auto; font-size: 0.875rem; font-variant-numeric: tabular-nums; }
      th, td { border-bottom: 1px solid var(--hairline); padding: 8px 12px; text-align: left; vertical-align: top; }
      th { color: var(--ink); font-weight: 600; }

      .site-foot { background: var(--surface); border-top: 1px solid var(--hairline-soft); padding: 48px 0 28px; font-size: 0.9375rem; }
      .foot-cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px 24px; }
      .foot-cols h2 { font-size: 0.9375rem; font-weight: 600; margin: 0 0 14px; }
      .foot-cols ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
      .foot-cols a { color: var(--body); text-decoration: none; display: inline-flex; align-items: center; gap: 8px; }
      .foot-cols a:hover { color: var(--ink); text-decoration: underline; }
      .legal { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; margin-top: 40px; padding-top: 20px; border-top: 1px solid var(--hairline); color: var(--muted); font-size: 0.875rem; }
      @media (max-width: 720px) { .foot-cols { grid-template-columns: 1fr; } }
    </style>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-head">
      <div class="wrap head-inner">
        <a class="brand" href={`${base}/`} translate="no"><Mark />Nuxy Automation</a>
        <nav class="nav" aria-label="Main">
          {sections.map(([label, id]) => <a class="nav-link" href={`${base}/#${id}`}>{label}</a>)}
          <a class="button pill" href={`${base}/#request`}>Request a setup</a>
          <details class="menu">
            <summary aria-label="Menu"><Icon name="list" /></summary>
            <ul class="menu-panel">
              {sections.map(([label, id]) => <li><a href={`${base}/#${id}`}>{label}</a></li>)}
              <li><a href={`${base}/demo/`}>Demo salon</a></li>
              <li class="split"><a href={`${base}/#request`}>Request a setup</a></li>
            </ul>
          </details>
        </nav>
      </div>
    </header>
    <main id="main" class={wide ? undefined : "page"}><slot /></main>
    <footer class="site-foot">
      <div class="wrap">
        <div class="foot-cols">
          <section aria-labelledby="foot-packages">
            <h2 id="foot-packages">Services</h2>
            <ul>
              <li><a href={`${base}/#kinds`}>By kind of business</a></li>
              <li><a href={`${base}/#services`}>Most requested</a></li>
              <li><a href={`${base}/#customers`}>Win and keep customers</a></li>
              <li><a href={`${base}/#admin`}>Less admin</a></li>
              <li><a href={`${base}/#integrations`}>Custom integrations</a></li>
              <li><a href={`${base}/#add-ons`}>Add-ons</a></li>
              <li><a href={`${base}/#plans`}>Monthly plans</a></li>
            </ul>
          </section>
          <section aria-labelledby="foot-about">
            <h2 id="foot-about" translate="no">Nuxy Automation</h2>
            <ul>
              <li><a href={`${base}/#how`}>How it works</a></li>
              <li><a href={`${base}/demo/`}>Demo salon</a></li>
              <li><a href={`${base}/#work`}>Projects</a></li>
              <li><a href={`${base}/docs/`}>Docs</a></li>
              <li><a href={`${base}/policies/`}>Refunds, terms &amp; privacy</a></li>
            </ul>
          </section>
          <section aria-labelledby="foot-contact">
            <h2 id="foot-contact">Contact</h2>
            <ul>
              <li><a href={`mailto:${inbox}`}><Icon name="envelopeSimple" />{inbox}</a></li>
              <li><a href="https://github.com/Nuxy1"><Icon name="githubLogo" />github.com/Nuxy1</a></li>
            </ul>
          </section>
        </div>
        <p class="legal"><span>© 2026 <span translate="no">Nuxy Automation</span>, Faribault, Minnesota</span><span>No cookies, no tracking.</span></p>
      </div>
    </footer>
    <script is:inline>
      // The small-screen menu closes once a link in it is chosen, or on a tap anywhere else.
      document.querySelectorAll("details.menu").forEach((menu) => {
        menu.addEventListener("click", (e) => { if (e.target.closest("a")) menu.open = false; });
        document.addEventListener("click", (e) => { if (menu.open && !menu.contains(e.target)) menu.open = false; });
        document.addEventListener("keydown", (e) => { if (e.key === "Escape" && menu.open) { menu.open = false; menu.querySelector("summary").focus(); } });
      });
    </script>
  </body>
</html>
