---
// The page frame: pink card stock printed in one green ink, self-hosted faces, no client-side JavaScript.
// bare: the page draws its own letterhead (the homepage prints it on its hero card).
import Mark from "../components/Mark.astro";
import paper from "../../assets/plates/paper.png";
import grain from "../../assets/plates/grain.png";

interface Props {
  title: string;
  description?: string;
  bare?: boolean;
}
const { title, description = "Nuxy Automation: online booking, instant lead replies, reminders and review requests for salons, spas, studios and groomers. Fixed prices, no calls needed.", bare = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#f4b4c4" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="preload" href={`${base}/fonts/sofia-xc-700.woff2`} as="font" type="font/woff2" crossorigin />
    <style is:global define:vars={{ paper: `url(${paper.src})`, grain: `url(${grain.src})` }}>
      @font-face { font-family: "Sofia Sans Extra Condensed"; font-weight: 700; font-display: swap; src: url("/fonts/sofia-xc-700.woff2") format("woff2"); }
      @font-face { font-family: "Almarai"; font-weight: 400; font-display: swap; src: url("/fonts/almarai-400.woff2") format("woff2"); }
      @font-face { font-family: "Almarai"; font-weight: 700; font-display: swap; src: url("/fonts/almarai-700.woff2") format("woff2"); }
      @font-face { font-family: "Kalam"; font-weight: 400; font-display: swap; src: url("/fonts/kalam-400.woff2") format("woff2"); }
      :root {
        --card: #f4b4c4; --card-hi: #f9cfd9; --mint: #b9e2cf; --gold: #f1c04a;
        --ink: #0f4a32; --ink-soft: #2c5f47; --pen: #15228f; --stamp: #c62027;
        --display: "Sofia Sans Extra Condensed", "Arial Narrow", sans-serif;
        --text: "Almarai", system-ui, sans-serif;
        --hand: "Kalam", cursive;
        color-scheme: light;
        accent-color: var(--ink);
        scrollbar-color: var(--ink) var(--card);
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } .button { transition: none; } }
      body {
        margin: 0; color: var(--ink); font: 18px/1.6 var(--text);
        background: var(--card) var(--paper) repeat; background-size: 91.1vw auto;
        caret-color: var(--stamp);
      }
      ::selection { background: var(--ink); color: var(--card); }
      a { color: var(--ink); text-decoration-thickness: 0.08em; text-underline-offset: 0.18em; }
      a:hover { color: var(--stamp); }
      :focus-visible { outline: 3px solid var(--stamp); outline-offset: 3px; border-radius: 2px; }
      .button {
        display: inline-flex; align-items: center; justify-content: center; background: var(--ink); color: var(--card);
        font: 400 1.15rem/1.25 var(--text); text-align: center; padding: 0.95em 1.4em; border-radius: 0.35rem; text-decoration: none;
        box-shadow: 0 2px 6px rgb(28 20 22 / 0.22); transition: background-color 160ms ease-out, transform 160ms ease-out;
      }
      .button:hover { background: #0a3826; color: var(--card); transform: translateY(-1px); }
      .button:active { transform: translateY(1px); box-shadow: 0 1px 2px rgb(28 20 22 / 0.3); }

      /* Inner pages (docs): the letterhead and a readable column printed on the card. */
      .letterhead { display: flex; justify-content: space-between; align-items: center; gap: 12px 24px; flex-wrap: wrap; max-width: 1040px; margin: 0 auto; padding: 22px 20px; }
      .brand { display: inline-flex; align-items: center; gap: 0.55em; font-weight: 700; text-decoration: none; }
      .brand svg { width: 1.9em; height: 1.9em; }
      .letterhead nav { display: flex; gap: 6px 22px; flex-wrap: wrap; }
      .letterhead nav a { text-decoration: none; }
      .letterhead nav a:hover { text-decoration: underline; }
      .page { max-width: 820px; margin: 0 auto; padding: 0 20px 64px; }
      .page h1 { font: 700 clamp(2.8rem, 8vw, 4.5rem)/0.92 var(--display); text-transform: uppercase; margin: 24px 0 18px; }
      .page h2 { font: 700 2.1rem/1 var(--display); text-transform: uppercase; margin: 48px 0 12px; }
      .page h3 { margin: 0 0 6px; font-size: 1.1rem; }
      .lead { font-size: 1.2rem; max-width: 62ch; }
      .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; }
      .card { background: var(--card-hi); border-top: 2px solid var(--ink); padding: 16px 18px; box-shadow: 0 2px 8px rgb(28 20 22 / 0.12); }
      .card p { margin: 6px 0 0; color: var(--ink-soft); font-size: 0.95rem; }
      .page img { max-width: 100%; height: auto; border: 2px solid var(--ink); }
      pre { background: var(--card-hi); border-left: 1px solid var(--ink); padding: 14px; overflow-x: auto; font-size: 14px; }
      code { font-family: ui-monospace, "Cascadia Code", Consolas, monospace; font-size: 0.88em; }
      table { border-collapse: collapse; width: 100%; display: block; overflow-x: auto; font-size: 15px; font-variant-numeric: tabular-nums; }
      th, td { border-bottom: 1px solid var(--ink); padding: 7px 10px; text-align: left; vertical-align: top; }

      .site-foot { background: var(--ink); color: var(--card); font-size: 0.95rem; padding: 28px 20px 36px; text-align: center; }
      .site-foot a { color: var(--card); }
      .site-foot a:hover { color: #fff; }
    </style>
  </head>
  <body>
    {bare ? <slot /> : (
      <>
        <header class="letterhead">
          <a class="brand" href={`${base}/`}><Mark />Nuxy Automation</a>
          <nav aria-label="Main">
            <a href={`${base}/#packages`}>Packages</a>
            <a href={`${base}/#how`}>How it works</a>
            <a href={`${base}/#work`}>Projects</a>
            <a href={`${base}/#request`}>Request a setup</a>
          </nav>
        </header>
        <main class="page"><slot /></main>
      </>
    )}
    <footer class="site-foot">Nuxy Automation · Faribault, Minnesota · <a href="mailto:nuxy@nuxyautomation.com">nuxy@nuxyautomation.com</a> · <a href={`${base}/policies/`}>Refunds, terms &amp; privacy</a> · Code: <a href="https://github.com/Nuxy1">github.com/Nuxy1</a></footer>
  </body>
</html>
