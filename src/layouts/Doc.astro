---
// A docs page: a project's README rendered as a page of the site (scripts/sync-docs.mjs copies them in).
import Base from "./Base.astro";
const { frontmatter } = Astro.props;
---
<Base title={`${frontmatter.title} · Docs · Nuxy Automation`} description={frontmatter.description}>
  <p><a href={`https://github.com/Nuxy1/${frontmatter.repo}`}>Code on GitHub</a></p>
  <slot />
</Base>
